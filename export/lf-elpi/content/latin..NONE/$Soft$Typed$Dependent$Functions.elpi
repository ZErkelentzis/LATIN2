/* generated from fun_typing : {A,B,F}({x}ded (of x A)⟶ded (of (F x) (B x)))⟶ded (of (lambda F) (softfun A B)) */

ded X3 (of (lambda F) (softfun A B)) :- help/fun_typing A B F X2 X3 , (pi x \ pi x1 \ ded/hyp x1 (of x A) => ded (X2 x x1) (of (F x) (B x))).

help/fun_typing A B F (x \ x1 \ prodcert (X2/1 x x1) (X2/2 x x1)) (prodcert X3/1 X3/2) :- help/fun_typing A B F X2/1 X3/1 , help/fun_typing A B F X2/2 X3/2.

help/fun_typing A B F (x \ x2 \ idcert X1) (idcert X3) :- X3 > 0 , X1 is X3 - 1.

