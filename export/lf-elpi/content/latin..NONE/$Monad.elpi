/* generated from identLeft : {a,b,f:tm a⟶tm (applyType b),x}ded (equal (applyType b) (Bind a b (Return a x) f) (f x)) */

ded X1 (equal (applyType b) (Bind a b (Return a x) f) (f x)) :- help/identLeft a b f x X1.

help/identLeft a b f x (prodcert X1/1 X1/2) :- help/identLeft a b f x X1/1 , help/identLeft a b f x X1/2.

help/identLeft a b f x (idcert X2) :- X2 > 0 , X1 is X2 - 1.

help/identLeft a b f x (ptcert (identLeft a b f x)).

