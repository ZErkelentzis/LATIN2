accumulate "/home/jfs/mmt/content/MathHub/MMT/LATIN2/export/lf-elpi/content/latin..NONE/$Simple$Functions".

/* generated from exten : {A,B,F,G:tm (simpfun A B)}({x}ded (equal B (simpapply A B F x) (simpapply A B G x)))⟶ded (equal (simpfun A B) F G) */

ded X2 (equal (simpfun A B) F G) :- help/exten A B F G X1 X2 , (pi x \ ded (X1 x) (equal B (simpapply A B F x) (simpapply A B G x))).

help/exten A B F G (x \ prodcert (X1/1 x) (X1/2 x)) (prodcert X2/1 X2/2) :- help/exten A B F G X1/1 X2/1 , help/exten A B F G X1/2 X2/2.

help/exten A B F G (x \ idcert X1) (idcert X2) :- X2 > 0 , X1 is X2 - 1.

help/exten A B F G (x \ ptcert X1) (ptcert (exten A B F G X1)).

