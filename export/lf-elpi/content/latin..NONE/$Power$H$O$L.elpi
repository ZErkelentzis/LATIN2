/* generated from [PowerTypes]/compute : {A,P,x:tm A}ded (equiv (([A,x,S]simpapply A bool S x) A x (([A,P]simplambda A bool P) A P)) (P x)) */

ded X1 (equiv ((A \ x \ S \ simpapply A bool S x) A x ((A \ P \ simplambda A bool P) A P)) (P x)) :- help/[PowerTypes]/compute A P x X1.

help/[PowerTypes]/compute A P x (pair X1/1 X1/2) :- help/[PowerTypes]/compute/1 A P x X1/1 , help/[PowerTypes]/compute/2 A P x X1/2.

/* generated from [PowerTypes]/expand : {A,S:tm (([a]simpfun a bool) A)}ded (equal (([a]simpfun a bool) A) S (([A,P]simplambda A bool P) A [x]([A,x,S]simpapply A bool S x) A x S)) */

ded X1 (equal ((a \ simpfun a bool) A) S ((A \ P \ simplambda A bool P) A x \ (A \ x \ S \ simpapply A bool S x) A x S)) :- help/[PowerTypes]/expand A S X1.

help/[PowerTypes]/expand A S (pair X1/1 X1/2) :- help/[PowerTypes]/expand/1 A S X1/1 , help/[PowerTypes]/expand/2 A S X1/2.

