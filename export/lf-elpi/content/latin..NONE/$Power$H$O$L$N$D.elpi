/* generated from [PowerTypes]/compute : {A,P,x:tm A}ded (equiv (simpapply A bool (simplambda A bool P) x) (P x)) */

ded X1 (equiv (simpapply A bool (simplambda A bool P) x) (P x)) :- help/[PowerTypes]/compute X1 A P x.

help/[PowerTypes]/compute (prodcert X2/1 X2/2) A P x :- help/[PowerTypes]/compute X2/1 A P x , help/[PowerTypes]/compute X2/2 A P x.

help/[PowerTypes]/compute (idcert X3) A P x :- X3 > 0 , X2 is X3 - 1.

help/[PowerTypes]/compute (ptcert ([PowerTypes]/compute A P x)) A P x.

