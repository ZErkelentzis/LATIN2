accumulate "/home/jfs/mmt/content/MathHub/MMT/LATIN2/export/lf-elpi/content/latin..NONE/$Type$Operator".

/* generated from applyFun : {a,b}(tm a⟶tm b)⟶tm (applyType a)⟶tm (applyType b) */

/* type applyFun pi a \ pi b \ tm a -> tm b -> tm (applyType a) -> tm (applyType b). */

/* generated from applyId : {a,xs:tm (applyType a)}ded (equal (applyType a) (applyFun a a ([x]x) xs) xs) */

ded X1 (equal (applyType a) (applyFun a a (x \ x) xs) xs) :- help/applyId a xs X1.

help/applyId a xs (prodcert X1/1 X1/2) :- help/applyId a xs X1/1 , help/applyId a xs X1/2.

help/applyId a xs (idcert X2) :- X2 > 0 , X1 is X2 - 1.

help/applyId a xs (ptcert (applyId a xs)).

/* generated from applyComp : {a,b,c,f:tm a⟶tm b,g:tm b⟶tm c,xs:tm (applyType a)}ded (equal (applyType c) (applyFun b c g (applyFun a b f xs)) (applyFun a c ([x]g (f x)) xs)) */

ded X1 (equal (applyType c) (applyFun b c g (applyFun a b f xs)) (applyFun a c (x \ g (f x)) xs)) :- help/applyComp a b c f g xs X1.

help/applyComp a b c f g xs (prodcert X1/1 X1/2) :- help/applyComp a b c f g xs X1/1 , help/applyComp a b c f g xs X1/2.

help/applyComp a b c f g xs (idcert X2) :- X2 > 0 , X1 is X2 - 1.

help/applyComp a b c f g xs (ptcert (applyComp a b c f g xs)).

