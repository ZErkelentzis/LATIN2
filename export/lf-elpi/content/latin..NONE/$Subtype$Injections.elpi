/* generated from inject_refl : {A,x:tm A}ded (equal A (inject A A (subtype_preorder/[latin:/?Reflexivity]/refl A) x) x) */

ded X1 (equal A (inject A A (subtype_preorder/[Reflexivity]/refl A) x) x) :- help/inject_refl X1 A x.

help/inject_refl (prodcert X2/1 X2/2) A x :- help/inject_refl X2/1 A x , help/inject_refl X2/2 A x.

help/inject_refl (idcert X3) A x :- X3 > 0 , X2 is X3 - 1.

help/inject_refl (ptcert (inject_refl A x)) A x.

