not a rule: {A,B}ded (subtype A B)⟶tm A⟶tm B */

/* generated from inject_refl : {A,x:tm A}ded (equal A (inject A A (subtype_preorder/[latin:/?Reflexivity]/refl A) x) x) */

ded X1 (equal A (inject A A (subtype_preorder/[Reflexivity]/refl A) x) x) :- help/inject_refl A x X1.

help/inject_refl A x (pair X1/1 X1/2) :- help/inject_refl/1 A x X1/1 , help/inject_refl/2 A x X1/2.

/* generated from inject_trans : {A,B,C,x:tm A,P:ded (subtype A B),Q:ded (subtype B C)}ded (equal C (inject A C (subtype_preorder/[latin:/?Transitivity]/trans A B C P Q) x) (inject B C Q (inject A B P x))) */

ded X1 (equal C (inject A C (subtype_preorder/[Transitivity]/trans A B C P Q) x) (inject B C Q (inject A B P x))) :- help/inject_trans A B C x P Q X1.

help/inject_trans A B C x P Q (pair X1/1 X1/2) :- help/inject_trans/1 A B C x P Q X1/1 , help/inject_trans/2 A B C x P Q X1/2.

