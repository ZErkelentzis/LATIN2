accumulate "/home/jfs/mmt/content/MathHub/MMT/LATIN2/export/lf-elpi/content/latin..NONE/$Logic".

/* generated from equal : {A:type}A⟶A⟶prop */

/* type equal pi (A \ A -> A -> prop). */

/* generated from refl : {A,x:A}ded (equal A x x) */

ded X1 (equal A x x) :- help/refl X1 A x.

help/refl (prodcert X2/1 X2/2) A x :- help/refl X2/1 A x , help/refl X2/2 A x.

help/refl (idcert X3) A x :- X3 > 0 , X2 is X3 - 1.

help/refl (ptcert (refl A x)) A x.

/* Can't create helper for ucert: no hypotheses found */

help/refl (hdcert X2) A x.

help/refl (bccert X3) A x :- bc/pos X3 , X2 is X3 - 1.

/* generated from transport : {A,x,y}ded (equal A x y)⟶{T:A⟶type}T x⟶T y */

/* type transport pi (A \ pi (x \ pi (y \ ded (equal A x y) -> (pi (T \ T x -> T y))))). */

/* generated from cong : {A,B,x,y}ded (equal A x y)⟶{F:A⟶B}ded (equal B (F x) (F y)) */

ded X2 (equal B (F x) (F y)) :- help/cong X2 A B x y X1 F , ded X1 (equal A x y).

help/cong (prodcert X3/1 X3/2) A B x y F (prodcert X2/1 X2/2) :- help/cong X3/1 A B x y F X2/1 , help/cong X3/2 A B x y F X2/2.

help/cong (idcert X3) A B x y F (idcert X2) :- X3 > 0 , X2 is X3 - 1.

help/cong (ptcert (cong A B x y F X2)) A B x y F (ptcert X2).

help/cong (ucert X2) A B x y F (ucert (prep (ded X3 (equal A x y)) X2)) :- ded X3 (equal A x y) , occatmost (ded X3 (equal A x y)) 1 X2.

help/cong (hdcert X2) A B x y F (hdcert X2).

help/cong (bccert X3) A B x y F (bccert X2) :- bc/pos X3 , X2 is X3 - 1.

