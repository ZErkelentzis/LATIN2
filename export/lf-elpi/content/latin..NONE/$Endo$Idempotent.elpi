/* generated from idempotent : {a,x:tm (applyType a)}ded (equal (applyType a) (op a x x) x) */

ded X1 (equal (applyType a) (op a x x) x) :- help/idempotent a x X1.

help/idempotent a x (prodcert X1/1 X1/2) :- help/idempotent a x X1/1 , help/idempotent a x X1/2.

help/idempotent a x (idcert X2) :- X2 > 0 , X1 is X2 - 1.

help/idempotent a x (ptcert (idempotent a x)).

