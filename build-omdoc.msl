// Build MMT/OMDoc and Scala parts of LATIN2
// To be precise, this build script only builds the parts of LATIN2
// which can actually be built successfully at time of writing.

server on 8080

log html build.html
file build_config.msl

// Build the mmt files, tricky due to mutual dependencies
// Sometimes we even need to build a folder twice as the first run will run into an interdependency situation it cannot resolve (think of LaTeX and bibliography - it also needs multiple runs)

file source/fundamentals/build.msl

file source/logic/propositional/build.msl
file source/logic/metalogic/build.msl
file source/logic/fol_like/build.msl

file source/type_theory/buildNoEndo.msl

file source/logic/hol_like/build.msl
file source/logic/model_theory/build.msl

build MMT/LATIN2 mmt-omdoc category_theory

file source/type_theory/endofunctors/build.msl

file source/set_theory/build.msl

file source/logic_extensions/build.msl

build MMT/LATIN2 mmt-omdoc topology
// AS: logic-to-type-theory leads to an error
build MMT/LATIN2 mmt-omdoc curry-howard

// AS: nat-induct leads to an error, so I only build nat.mmt for now
build MMT/LATIN2 mmt-omdoc numbers/nat.mmt

file source/algebra/build.msl

build MMT/LATIN2 mmt-omdoc algebraic_logic/pl_semilattice.mmt

// AS: this folder should not need a specific build order
build MMT/LATIN2 mmt-omdoc source/type_to_set

// TODO:
// build MMT/LATIN2 lf-scala

// build scala-bin scala
