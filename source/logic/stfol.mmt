namespace latin:/❚

fixmeta ur:?LFS❚

theory SoftTypedDefinedFOL =
	// include ?InternalTypes ❙
  include ?SoftTypedLogic ❙
	include ?Conjunction ❙
	include ?Negation ❙
	include ?Truth ❙
	include ?Falsity ❙
	include ?Equality ❙
	include ?UniversalQuantification ❙

	or: prop ⟶ prop ⟶ prop❘= [a,b] ¬ (¬ a ∧ ¬ b) ❘# 1 ∨ 2 prec 15 ❙
	implies: prop ⟶ prop ⟶ prop ❘# 1 ⇒ 2 prec 10 ❘ = [a,b] ¬ (a ∧ (¬ b)) ❙
	iff: prop ⟶ prop ⟶ prop ❘ = [a,b] (a ⇒ b) ∧ (b ⇒ a) ❘ # 1 ⇔ 2 prec 15 ❙	
  exists: (term ⟶ prop) ⟶ prop ❘ = [p] ¬ (∀ ([x] (¬ (p x)))) ❘# ∃ 1 ❙
	existsUnique: (term ⟶ prop) ⟶ prop ❘ = [pred] (∃ pred) ∧ (∀ [x:term] ∀ [y:term] (pred x ⇒ pred y ⇒ (x ≐ y))) ❙
	for: {A:tp, p: term ⟶ prop} prop ❘= [A, p] ∀ [x] x ⦂ A ⇒ p x ❙
	ex: {A:tp, p: term ⟶ prop} prop ❘= [A, p] ∃ [x] (x ⦂ A) ∧ (p x) ❙
❚

theory SoftTypedFOL =
  include ?SoftTypedLogic ❙
	include ?IFOLEQ ❙
	include ?UniqueExistentialQuantification ❙
	include ?RelativizedExistentialQuantification ❙
	include ?RelativizedUniversalQuantification ❙
❚

view MizarView : ?SoftTypedFOL → ?SoftTypedDefinedFOL =
	include ?SoftTypedLogic ❙
	include ?Conjunction ❙
	include ?Negation ❙
	include ?Truth ❙
	include ?Falsity ❙
	include ?Equality ❙
	include ?UniversalQuantification ❙

	or = or ❙
	impl = implies ❙
	equiv = iff ❙
	exists = exists ❙
	existsUnique = existsUnique ❙
	rforall  = for ❙
	rexists = ex ❙
❚
