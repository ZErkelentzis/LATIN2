namespace latin:/linear❚

import rules scala://substructural.latin2❚

// This was copied here from MMT/examples. It still needs to be adjusted and should not be built yet.
The same applies to the corresponding Scala rules, which are currently commented out.
❚

// Linear logic
   Syntax: intuitionistic linear logic
   Proof theory: resource semantics based on Frank Pfenning's lecture notes
   (http://www.cs.cmu.edu/~fp/courses/15816-s10/schedule.html, Lecture 23-24) resource semantics
❚

theory Syntax : ur:?LF =
   include ☞latin:/?Propositions❙
   multrue : prop❘# %D1❙
   mulfalse : prop ❘# ⊥❙
   mulconj : prop ⟶ prop ⟶ prop ❘# 1 ⊗ 2 prec 100❙
   muldisj : prop ⟶ prop ⟶ prop ❘# 1 ⅋ 2 prec 100❙
   addtrue : prop❘# ⊤❙
   addfalse : prop❘# %D0❙
   addconj : prop ⟶ prop ⟶ prop ❘# 1 & 2 prec 100❙
   adddisj : prop ⟶ prop ⟶ prop ❘# 1 ⊕ 2 prec 100❙
   linimp : prop ⟶ prop ⟶ prop ❘# 1 ⊸ 2 prec 80❙
   bang : prop ⟶ prop      ❘# ! 1 prec 110❙
   
   imp : prop ⟶ prop ⟶ prop ❘# 1 ⇒ 2 prec 80❘
     = [x,y] !x ⊸ y❙
❚

// We use untyped first-order logic with equality to define the semantics.
   The values of the first-order universe are the worlds, and propositions may hold at different worlds.❚

fixmeta latin:/?FOLEQND❚

theory Worlds = 
   include ?Syntax❙
   // worlds contain resources ❙
   world : type❘= term❙
   // composition of worlds, corresponds to multiset union of resources ❙
   union : world ⟶ world ⟶ world ❘# 1 * 2 prec 100❙
   // empty world with no resources ❙
   empty : world❘# ε❙

   // * is a monoid❙
   neutL  : {P} ⊦ ε*P =ͧ P❙
   neutR  : {P} ⊦ P*ε =ͧ P❙
   assoc  : {P,Q,R} ⊦ (P*Q)*R =ͧ P*(Q*R)❙
   
   // A @ P: A can be produced by using all resources available in world P❙
   at : prop ⟶ world ⟶ prop❙
   At : prop ⟶ world ⟶ type❘ = [p,w] ⊦ at p w❘# 1 @ 2 prec 50❘role Judgment❙
   // a formula is valid if it holds in the empty world❙
   valid : prop ⟶ type ❘= [A] A @ ε❘# valid 1 prec -10❙
❚

// Apart from the monoid/multiset structure, there is no way to introduce worlds.
   The set of worlds is the freely-generated T over the bound world variables.
   Here T is the theory imposed on worlds, T is an extension of the monoid theory.

   Different extensions allow modeling different structural rules.
   The following gives three extensions, but only Exchange is used later on.❚

// Exchange corresponds to commutativity.❚
theory Exchange =
  include ?Worlds❙
   comm : {P,Q} ⊦ P*Q =ͧ Q*P❙

   // We add two special type-checking rules that mechanize the monoid+commutativity axiom.
      Their implementations are given in the folder scala (sibling of source).❙
   
   // A simplification rule for *-terms: it normalizes bracketing of *, drops ε, and reorders the arguments❙
   rule rules?NormalizeWorlds❙

   test : {p,q,r} ⊦ r*(p*q)*ε*r =ͧ r*(r*(q*p)) ❘= [p,q,r] urefl❙

   // An equality-checking rule for equations involving *: it normalizes both sides and solves meta-variables of type world.
      For example, it can reduce v*w=v*w' to w=w'.
      Situations like this came up in several of the examples below.
      This rule is admissible for solving meta-variables but not derivable from the monoid+commutativity axioms.
      Effectively, it works in the freely-generated commutative monoid.
      Because it is only admissible, it breaks modularity: e.g., it cannot be easily combined with a corresponding rule for idempotence.❙
   rule rules?EquateWorlds❙
❚

// Contraction corresponds to idempotence.❚
theory Contraction =
  include ?Worlds❙
  idem : {P} ⊦ P*P =ͧ P❙
❚

// Weakening corresponds to the empty world being the least element.❚
theory Weakening =
  include ?Worlds❙
   // ordering with monotonicity❙
   weaker : world ⟶ world ⟶ prop ❘ # 1 ≤ 2 prec 80❙
   wk_refl   : {P} ⊦ P ≤ P❙
   wk_antisym: {P,Q} ⊦ P ≤ Q ⟶ ⊦ Q ≤ P ⟶ ⊦ P=ͧQ❙
   wk_trans  : {P,Q,R} ⊦ P≤Q ⟶ ⊦ Q≤R ⟶ ⊦ P≤R ❙
   wk_monotone: {a,b,c,d} ⊦ a ≤ b ⟶ ⊦ c ≤ d ⟶ ⊦ a*c ≤ b*d❙ 

   // least world (without this, the order is trivial, i.e., there is no weakening)❙
   wk_least : {P} ⊦ ε ≤ P❙

   // TODO: This should be a subtyping rule so that it does not occur in proofs.❙
   weaken: {A,v,w} A @ v ⟶ ⊦v≤w ⟶ A @ w❙
   
   divisibility: {P,Q} ⊦ P ≤ P*Q ❘
               = [P,Q] eq/congT neutR ([u]u≤P*Q) (wk_monotone wk_refl wk_least)❙ 
❚

// Now proofs of the linear sequent A1, ..., An |- A are represented as terms of type
   (A1 ⊗ ... ⊗ An) ⊸ A  @  ε, where @ is the binary holds-at relation between propositions and worlds.❚
theory ResourceSemantics =
   include ?Worlds❙
   include ?Exchange❙

   mulconj_R  : {A,B,a,b} A @ a ⟶ B @ b ⟶ A ⊗ B @ a*b❙
   mulconj_L  : {A,B,C,u,v} A ⊗ B @ u ⟶ ({a}{b} A @ a ⟶ B @ b ⟶ C @ a*b*v) ⟶ C @ u*v❘
   # mulconj_L 6 7❙

   multrue_R : 1 @ ε❙
   multrue_L : {C,u,v} 1 @ u ⟶ C @ v ⟶ C @ u*v❙

   addconj_R  : {A,B,w} A @ w ⟶ B @ w ⟶ A & B @ w❙
   addconj_Ll : {A,B,C,u,v} A & B @ u ⟶ ({a} A @ a ⟶ C @ a*v) ⟶ C @ u*v❙
   addconj_Lr : {A,B,C,u,v} A & B @ u ⟶ ({b} B @ b ⟶ C @ b*v) ⟶ C @ u*v❙

   addtrue_R  : {w} ⊤ @ w❙
   
   adddisj_Rl : {A,B,w} A @ w ⟶ A ⊕ B @ w❙
   adddisj_Rr : {A,B,w} B @ w ⟶ A ⊕ B @ w❙
   adddisj_L  : {A,B,C,u,v} A ⊕ B @ u ⟶ ({a} A @ a ⟶ C @ a*v) ⟶ ({b} B @ b ⟶ C @ b*v) ⟶ C @ u*v❙  

   addfalse_L  : {C,u,v} 0 @ u ⟶ C @ u*v❙ 
   
   linimp_R  : {A,B,w} ({a} A @ a ⟶ B @ a*w) ⟶ A ⊸ B @ w❙
   linimp_L  : {A,B,C,u,a,v} A ⊸ B @ u ⟶ A @ a ⟶ ({b} B @ b ⟶ C @ b*v) ⟶ C @ u*a*v❙
   // alternatively
   linimp_E  : A ⊸ B @ P ⟶ A @ Q ⟶ B @ P*Q
   linimp_L : A ⊸ B @ H ⟶ A @ P ⟶ ({b} B @ b ⟶ C @ b*Q) ⟶ C @ H*P*Q
      = [p][q][f] f (H*P) (⊸E p q)
   ❙

   bang_R : {A} A @ ε ⟶ ! A @ ε❙
   bang_L : {A,C,u,v} ! A @ u ⟶ (A @ ε ⟶ C @ v) ⟶ C @ u*v❙
   
   
   // In the remainder, we prove some derivable rules to exercise the calculus.❙
   
   mulconj_commute : {A,B} valid A⊗B ⊸ B⊗A❘
      = [A,B] linimp_R [ab,h] mulconj_L h [a,b,p,q] mulconj_R q p❙

   // needs to solve abc * X = abc and ab * Y * X = ab * c, solution: X = epsilon, Y = c❙ 
   mulconj_assoc1 : {A,B,C} valid (A⊗B)⊗C ⊸ A⊗(B⊗C)❘
        = [A,B,C] linimp_R [abc,h] mulconj_L h 
              [ab,c,pq,r] mulconj_L pq
                 ([a,b,p,q] mulconj_R p (mulconj_R q r))❙
      
   mulconj_assoc2 : {A,B,C} valid A⊗(B⊗C) ⊸ (A⊗B)⊗C❘
        = [A,B,C] linimp_R [abc,h] mulconj_L h 
              [a,bc,p,qr] mulconj_L qr
                 ([b,c,q,r] mulconj_R (mulconj_R p q) r)❙

   mulconj_neutral1 : {A} valid A⊗1 ⊸ A❘
      = [A] linimp_R [ao,h] mulconj_L h [a,b,p,q] multrue_L q p❙
   mulconj_neutral2 : {A} valid A ⊸ A⊗1❘
      = [A] linimp_R [a,h] mulconj_R h multrue_R❙
      
   adddisj_commute : {A,B} valid A⊕B ⊸ B⊕A❘
      = [A,B] linimp_R [ab,h] adddisj_L h ([a,p] adddisj_Rr p) ([b,q] adddisj_Rl q)❙

   adddisj_neutral1 : {A} valid A⊕0 ⊸ A❘
    = [A] linimp_R [az,h] adddisj_L h ([a,p] p) ([z,q] addfalse_L q)❙
   adddisj_neutral2 : {A} valid A ⊸ A⊕0❘
      = [A] linimp_R [a,h] adddisj_Rl h❙
   
      
   bang_over_adddisj : {A,B} valid (!A⊕!B) ⊸ !(A⊕B)❘
            = [A,B] linimp_R [ab,h] adddisj_L h ([a,p] bang_L p ([pE] bang_R (adddisj_Rl pE)))
                                     ([b,q] bang_L q ([qE] bang_R (adddisj_Rr qE)))❙
   bang_over_addconj : {A,B} valid !(A&B) ⊸ (!A&!B)❘
          // TODO: This proof unexpectedly does not type-check, eventually failing at a=ε and b=ε.
             Further investigation is needed to determine if the proof is in fact wrong or
             if the type-checker is led astray by the EquateWorlds rule.❙
          //  = [A,B] linimp_R [ab,h] &_R (bang_L h [pqE] &_Ll pqE ([a,p] bang_R p))
                                   (bang_L h [pqE] &_Lr pqE ([b,q] bang_R q))❙
   bang_idempotent1 : {A} valid !!A ⊸ !A❘
                 = [A] linimp_R [a,h] bang_L h [k] bang_L k [l] bang_R l❙ 
   bang_idempotent2 : {A} valid !A ⊸ !!A❘
                 = [A] linimp_R [a,h] bang_L h [k] bang_R (bang_R k)❙
   bang_weaken : {A} valid !A ⊸ A❘
            = [A] linimp_R [a,h] bang_L h [k] k❙
❚