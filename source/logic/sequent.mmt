namespace latin:/❚

fixmeta ur:?LF ❚

import rules scala://sequents.latin2 ❚

theory Contexts =
  include ?Propositions❙
  context : type ❘ // = List prop ❙
  empty_ctx : context ❘ // = nil ❘ # ∅ ❙
  context_extension : context ⟶ prop ⟶ context ❘ // = [Γ,A] cons Γ A ❘ # 1 , 2 prec 5 ❙
  context_concat : context ⟶ context ⟶ context ❘ // = [Γ, Δ]  Γ ++ Δ ❘ # 1 ; 2 prec 4 ❙
❚

theory SequentProofs =
  include ?Contexts ❙
  /T Judgement as types (enter notation by "jvdash", not "jder") ❙
  ded   : context ⟶ context ⟶ type❘# 1 ⊢ 2  prec -5❘role Judgment ❙

  structure Ded : ?Proofs =
    include ?Propositions ❙
    ded = [A] ∅ ⊢ ∅, A ❘ # ⊦ 1 ❙
  ❚
❚

theory SequentBase =
   include ?SequentProofs ❙

    base_proof : {A} ∅, A ⊢ ∅, A ❙
❚

theory InContext =
   include ?SequentBase ❙
   in_context : prop ⟶ context ⟶ type ❘ # 1 ∈ 2 prec 1 ❙

   inContext : {Γ, Δ, A} A ∈ Γ ⟶ Γ ⊢ Δ,A ❘ # from_context 1 2 3 %I4 ❙
   in_context_proof ❙
   rule rules?InContextRule ❙
   rule rules?InContextProofType ❙
❚

// Structural Rules ------------------------------------------------------------------- ❚

theory Cut =
    include ?SequentProofs ❙

    cut : { Γ1, Γ2, Δ1, Δ2, A} Γ1 ⊢ Δ1, A ⟶ Γ2, A ⊢ Δ2 ⟶ Γ1 ; Γ2 ⊢ Δ1 ; Δ2 ❙
❚

theory Weakening =
    rule rules?Weakening ❙
❚

theory Contraction =
    rule rules?Contraction ❙
❚

theory Exchange =
    rule rules?Exchange ❙
❚

// Truth ------------------------------------------------------------------- ❚

theory SequentTruthLeft =
    include ?SequentProofs ❙
    include ?Truth ❙

    true_left : {Γ, Δ} Γ ⊢ Δ ⟶ Γ, true ⊢ Δ ❙
❚

theory SequentTruthRight =
    include ?SequentProofs ❙
    include ?Truth ❙

    true_right : ∅ ⊢ ∅, true ❙
❚

theory SequentTruth =
    include ?SequentTruthLeft ❙
    include ?SequentTruthRight ❙
❚

// Falsity ------------------------------------------------------------------- ❚

theory SequentFalsityLeft =
    include ?SequentProofs ❙
    include ?Falsity ❙

    false_left : ∅, false ⊢ ∅ ❙
❚

theory SequentFalsityRight =
    include ?SequentProofs ❙
    include ?Falsity ❙

    false_right : {Γ, Δ} Γ ⊢ Δ ⟶ Γ ⊢ Δ, false ❙
❚

theory SequentFalsity =
    include ?SequentFalsityLeft ❙
    include ?SequentFalsityRight ❙
❚

// Negation ------------------------------------------------------------------- ❚

theory SequentNegationLeft =
    include ?SequentProofs ❙
    include ?Negation ❙

    negation_left : {Γ, Δ, A} Γ ⊢ Δ,A ⟶ Γ, ¬A ⊢ Δ ❘ # notL 4 ❙
❚

theory SequentNegationRight =
    include ?SequentProofs ❙
    include ?Negation ❙

    negation_right : {Γ, Δ, A} Γ, A ⊢ Δ ⟶ Γ ⊢ Δ, ¬A ❘ # notR 4 ❙
❚

theory SequentNegation =
    include ?SequentNegationLeft ❙
    include ?SequentNegationRight ❙
❚

// Conjunction ------------------------------------------------------------------- ❚

theory SequentConjunctionLeft =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_left : {Γ, Δ, A, B} Γ,A,B ⊢ Δ ⟶ Γ, A ∧ B ⊢ Δ ❘ # andL 5 ❙
❚

theory SequentConjunctionRightSimple =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_right : {Γ, Δ, A,B} Γ ⊢ Δ,A ⟶ Γ ⊢ Δ,B ⟶ Γ ⊢ Δ,A ∧ B ❘ # andRs 5 6 ❙
❚

theory SequentConjunctionRightCompositional =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_right : {Γ1, Γ2, Δ1, Δ2, A,B} Γ1 ⊢ Δ1,A ⟶ Γ2 ⊢ Δ2,B ⟶ Γ1; Γ2 ⊢ Δ1; Δ2 ,A ∧ B ❘ # andRc 7 8 ❙
❚

theory SequentConjunctionSimple =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightSimple ❙
❚

theory SequentConjunctionCompositional =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightCompositional ❙
❚

theory SequentConjunction =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightSimple ❙
    include ?SequentConjunctionRightCompositional ❙
❚



theory SequentDisjunction =
    include ?SequentProofs ❙
    include ?Disjunction ❙

    disjunction_left : {Γ, Δ, A, B} Γ,A ⊢ Δ ⟶ Γ,B ⊢ Δ ⟶ Γ,A ∨ B ⊢ Δ ❘ # orL 5 6 ❙
    disjunction_right : {Γ, Δ, A,B} Γ ⊢ Δ,A,B ⟶ Γ ⊢ Δ,A ∨ B ❘ # orR 5 ❙
❚

theory SequentImplication =
    include ?SequentProofs ❙
    include ?Implication ❙

    implication_left : {Γ, Δ, A, B} Γ ⊢ Δ,A ⟶ Γ,B ⊢ Δ ⟶ Γ,A ⇒ B ⊢ Δ ❘ # implL 5 6 ❙
    implication_right : {Γ, Δ, A,B} Γ,A ⊢ Δ,B ⟶ Γ ⊢ Δ,A ⇒ B ❘ # implR 5 ❙
❚

theory Test =
    include ?SequentConjunction ❙
    include ?SequentImplication ❙
    include ?Weakening ❙
    include ?Exchange ❙
    include ?Weakening ❙
    include ?InContext ❙

    test : {A,B} ⊦ A ∧ B ⇒ B ∧ A ❘
        = [A,B] implR (
                    andRs
                        (andL (from_context (∅,A,B) ∅ B))
                        (andL (from_context (∅,A,B) ∅ A))
                ) ❙
❚

theory SequentUniversalQuantification =
    include ?SequentProofs ❙
    include ?UniversalQuantification ❙

    forall_left : {t,A,Γ, Δ} Γ,(A t) ⊢ Δ ⟶ Γ,(∀ A) ⊢ Δ ❙
    forall_right : {Γ, Δ, A} ({x} Γ ⊢ Δ, (A x)) ⟶ Γ ⊢ Δ, (∀ A) ❙
❚

theory SequentExistentialQuantification =
    include ?SequentProofs ❙
    include ?ExistentialQuantification ❙

    existential_left : {Γ, Δ, A} ({x} Γ,(A x) ⊢ Δ) ⟶ Γ,(∃ A) ⊢ Δ ❙
    existential_right : {t, Γ, Δ, A} Γ ⊢ Δ, (A t) ⟶ Γ ⊢ Δ, (∃ A) ❙
❚

theory ABA =
  include ?InContext ❙
  include ?Weakening ❙
  include ?Exchange ❙
  include ☞http://gl.mathhub.info/MMT/LFX/Sigma?LFSigma ❙

  subcontext : context ⟶ context ⟶ type ❘ = [Γ,Δ] {A} A ∈ Γ ⟶ A ∈ Δ ❘ # 1 ⊆ 2 ❙

  theory Framework > T : context, Ab : context, neg : prop ⟶ prop ❘ =
    attack_prop : {Γ} Γ ⊆ Ab ⟶ prop ⟶ type ❘ = [Γ,p,A] T;Γ ⊢ ∅, neg A ❘ # attackp 1 3 ❙
    attack_ctx : {Γ} Γ ⊆ Ab ⟶ context ⟶ type ❘ = [Γ,p, Δ] Σ A : prop . A ∈ Δ × attack_prop Γ p A ❘ # attackctx 1 3 ❙
  ❚
❚

theory A = a : type ❙ ❚
theory B = include ?A ❙ b : a ❙ ❚
theory C = include ?B ❙ c : a ❙ ❚
theory D = include ?A ❙ structure S : ?C = include ?A ❚ ❚