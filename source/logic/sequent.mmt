namespace latin:/❚

fixmeta http://gl.mathhub.info/MMT/LFX/Patterns?PatternLF ❚

import rules scala://sequents.latin2 ❚

theory Contexts =
  include ?Propositions❙
  context : type ❘ // = List prop ❙
  empty_ctx : context ❘ // = nil ❘ # ∅ ❙
  context_extension : context ⟶ prop ⟶ context ❘ // = [Γ,A] cons Γ A ❘ # 1 , 2 prec 5 ❙
  context_concat : context ⟶ context ⟶ context ❘ // = [Γ, Δ]  Γ ++ Δ ❘ # 1 ; 2 prec 4 ❙

   rule rules?ContextEquality ❙
❚

theory ContextMap =
    include ?Contexts ❙

    map : context ⟶ (prop ⟶ prop) ⟶ context ❘ # 2 @ 1 ❙

   rule rules?MapCompute ❙
   rule rules?MapPattern ❙
❚

theory ContextFold =
    include ?Contexts ❙

    fold : context ⟶ prop ⟶ (prop ⟶ prop ⟶ prop) ⟶ prop ❙
   rule rules?FoldCompute ❙
   rule rules?FoldPattern ❙
❚

theory SequentProofs =
  include ?Contexts ❙
  /T Judgement as types (enter notation by "jvdash", not "jder") ❙
  ded   : context ⟶ context ⟶ type❘# 1 ⊢ 2  prec -5❘role Judgment ❙

  structure Ded : ?Proofs =
    include ?Propositions ❙
    ded = [A] ∅ ⊢ ∅, A ❘ # ⊦ 1 ❙
  ❚
❚

theory SequentBase =
   include ?SequentProofs ❙

    base_proof : {A} ∅, A ⊢ ∅, A ❘ # baseP 1 ❙
❚

theory InContext =
   include ?SequentBase ❙
   inContext : {A}{[Γ] Γ,A}{[Δ] Δ,A} Γ,A ⊢ Δ,A ❘ # from_context 1 %I2 %I3 ❙
   in_context_proof ❙
   rule rules?InContextRule ❙
   rule rules?InContextProofType ❙
❚

theory InContextTest =
    include ?InContext ❙

    A : prop ❙
    B : prop ❙
    contA = ∅, B, A ❙
    contB = ∅,A ❙
    test : contA ⊢ contB ❘ = from_context A ❙
❚

// Structural Rules ------------------------------------------------------------------- ❚

theory Cut =
    include ?SequentProofs ❙

    cut : {A, Γ1, Δ2}{ [Δ1] Δ1,A} {[Γ2] Γ2,A} Γ1 ⊢ Δ1,A ⟶ Γ2,A ⊢ Δ2 ⟶ Γ1 ; Γ2 ⊢ Δ1 ; Δ2 ❘ # cut 6 7 ❙
❚

theory CutTest =
    include ?Cut ❙

    A : prop ❙
    Δ1 : context ❙
    Δ2 : context ❙
    Γ1 : context ❙
    D2 : context ❙
    Γ2 : context ❙
    p1 : Γ1 ⊢ Δ1,A ❙
    p2 : Γ2,A ⊢ Δ2 ❙
    proof : Γ1; Γ2 ⊢ Δ1; Δ2 ❘ = cut p1 p2 ❙
❚

theory Weakening =
    rule rules?Weakening ❙
❚

theory Contraction =
    rule rules?Contraction ❙
❚

theory Exchange =
    rule rules?ExchangeEquality ❙
    rule rules?ExchangePattern ❙
❚

// Truth ------------------------------------------------------------------- ❚

theory SequentTruthLeft =
    include ?SequentProofs ❙
    include ?Truth ❙

    true_left : {Γ, Δ} Γ ⊢ Δ ⟶ Γ, true ⊢ Δ ❘ # trueL 3 ❙
❚

theory SequentTruthRight =
    include ?SequentProofs ❙
    include ?Truth ❙

    true_right : ∅ ⊢ ∅, true ❘ # trueR ❙
❚

theory SequentTruthRightWeakened =
    include ?SequentProofs ❙
    include ?Truth ❙

    true_right_w : {Γ} Γ ⊢ ∅, true ❘ # trueRW 1 ❙
❚

theory SequentTruth =
    include ?SequentTruthLeft ❙
    include ?SequentTruthRight ❙
❚

// Falsity ------------------------------------------------------------------- ❚

theory SequentFalsityLeft =
    include ?SequentProofs ❙
    include ?Falsity ❙

    false_left : ∅, false ⊢ ∅ ❘ # falseL ❙
❚

theory SequentFalsityRight =
    include ?SequentProofs ❙
    include ?Falsity ❙

    false_right : {Γ, Δ} Γ ⊢ Δ ⟶ Γ ⊢ Δ, false ❘ # falseR 3 ❙
❚

theory SequentFalsity =
    include ?SequentFalsityLeft ❙
    include ?SequentFalsityRight ❙
❚

// Negation ------------------------------------------------------------------- ❚

theory SequentNegationLeft =
    include ?SequentProofs ❙
    include ?Negation ❙

    negation_left : {Γ,A}{[Δ] Δ, A} Γ ⊢ Δ,A ⟶ Γ, ¬A ⊢ Δ ❘ # notL 4 ❙
    negation_leftP : {Γ,A}{[Δ] Δ, A} Γ ⊢ Δ,A ⟶ Γ, ¬A ⊢ Δ ❘ # notLP 2 4 ❘
        = [Γ,A] case [Δ] Δ,A ↦ [p] notL p ❙
❚

theory NLTest =
    include ?SequentNegationLeft ❙
    A : prop ❙
    B : prop ❙
    p : ∅,A,B,A ⊢ ∅,A,B,A ❙
    test : ∅,A,B,A,¬A ⊢ ∅,A,B ❘ = notL p ❙
❚

theory SequentNegationRight =
    include ?SequentProofs ❙
    include ?Negation ❙

    negation_right : {A}{[Γ] Γ,A}{Δ} Γ, A ⊢ Δ ⟶ Γ ⊢ Δ, ¬A ❘ # notR 4 ❙
    negation_rightP : {A}{[Γ] Γ,A}{Δ} Γ, A ⊢ Δ ⟶ Γ ⊢ Δ, ¬A ❘ # notRP 1 4 ❘
        = [A] case [Γ] Γ,A ↦ [D,p] notR p ❙
❚


theory SequentNegation =
    include ?SequentNegationLeft ❙
    include ?SequentNegationRight ❙
❚

// Conjunction ------------------------------------------------------------------- ❚

theory SequentConjunctionLeft =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_left : {A,B}{[Γ] Γ,A,B}{Δ} Γ,A,B ⊢ Δ ⟶ Γ, A ∧ B ⊢ Δ ❘ # andL 5 ❙
    conjunction_leftP : {A,B}{[Γ] Γ,A,B}{Δ} Γ,A,B ⊢ Δ ⟶ Γ, A ∧ B ⊢ Δ ❘ # andLP 1 2 5 ❘
        = [A,B] case [Γ] Γ,A,B ↦ [Δ,p] andL p ❙
❚

theory SequentConjunctionRightSimple =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_right_simple : {A,B,Γ}{Δ} Γ ⊢ Δ,A ⟶ Γ ⊢ Δ,B ⟶ Γ ⊢ Δ,A ∧ B ❘ # andRs 5 6 ❙
    conjunction_right_simpleP : {A,B,Γ}{Δ} Γ ⊢ Δ,A ⟶ Γ ⊢ Δ,B ⟶ Γ ⊢ Δ,A ∧ B ❘ # andRsP 1 2 5 6 ❘
        = [A,B,Γ,Δ,p1,p2] andRs p1 p2 ❙
❚

theory SequentConjunctionRightCompositional =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_right_comp : {A,B,Γ1, Γ2}{[Δ1] Δ1,A}{[Δ2] Δ2,B} Γ1 ⊢ Δ1,A ⟶ Γ2 ⊢ Δ2,B ⟶ Γ1; Γ2 ⊢ Δ1; Δ2 ,A ∧ B ❘ # andRc 7 8 ❙
    conjunction_right_compP : {A,B,Γ1, Γ2}{[Δ1] Δ1,A}{[Δ2] Δ2,B} Γ1 ⊢ Δ1,A ⟶ Γ2 ⊢ Δ2,B ⟶ Γ1; Γ2 ⊢ Δ1; Δ2 ,A ∧ B ❘ # andRcP 1 2 7 8 ❘
        = [A,B, Γ1, Γ2] case [Δ1] Δ1,A ↦ case [Δ2] Δ2,B ↦ [p1,p2] andRc p1 p2 ❙
❚

theory SequentConjunctionSimple =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightSimple ❙
❚

theory SequentConjunctionCompositional =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightCompositional ❙
❚

theory SequentConjunction =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightSimple ❙
    include ?SequentConjunctionRightCompositional ❙
❚

// Disjunction ------------------------------------------------------------------- ❚

theory SequentDisjunctionLeftSimple =
    include ?SequentProofs ❙
    include ?Disjunction ❙

    disjunction_left : {A,B,Δ}{[Γ] Γ,A} Γ,A ⊢ Δ ⟶ Γ,B ⊢ Δ ⟶ Γ,A ∨ B ⊢ Δ ❘ # orLs 5 6 ❙
    disjunction_leftP : {A,B,Δ}{[Γ] Γ,A} Γ,A ⊢ Δ ⟶ Γ,B ⊢ Δ ⟶ Γ,A ∨ B ⊢ Δ ❘ # orLsP 1 2 5 6 ❘
        = [A,B,Δ] case [Γ] Γ,A ↦ [p1,p2] orLs p1 p2 ❙
❚

theory SequentDisjunctionLeftCompositional =
    include ?SequentProofs ❙
    include ?Disjunction ❙

    disjunction_left : {A,B,Δ1,Δ2}{[Γ1] Γ1,A}{[Γ2] Γ2,B} Γ1,A ⊢ Δ1 ⟶ Γ2,B ⊢ Δ2 ⟶ Γ1; Γ2,A ∨ B ⊢ Δ1;Δ2 ❘ # orLc 7 8 ❙
    disjunction_leftP : {A,B,Δ1,Δ2}{[Γ1] Γ1,A}{[Γ2] Γ2,B} Γ1,A ⊢ Δ1 ⟶ Γ2,B ⊢ Δ2 ⟶ Γ1; Γ2,A ∨ B ⊢ Δ1;Δ2 ❘ # orLcP 1 2 7 8 ❘
        = [A,B,Δ1,Δ2] case [Γ1] Γ1,A ↦ case [Γ2] Γ2,B ↦ [p1,p2] orLc p1 p2 ❙
❚

theory SequentDisjunctionRight =
    include ?SequentProofs ❙
    include ?Disjunction ❙

    disjunction_right : {Γ,A,B}{[Δ] Δ,A,B} Γ ⊢ Δ,A,B ⟶ Γ ⊢ Δ,A ∨ B ❘ # orR 5 ❙
    disjunction_rightP : {Γ,A,B}{[Δ] Δ,A,B} Γ ⊢ Δ,A,B ⟶ Γ ⊢ Δ,A ∨ B ❘ # orRP 2 3 5 ❘
     = [Γ,A,B] case [Δ] Δ,A,B ↦ [p] orR p ❙
❚

theory SequentDisjunctionSimple =
    include ?SequentDisjunctionLeftSimple ❙
    include ?SequentDisjunctionRight ❙
❚

theory SequentDisjunctionCompositional =
    include ?SequentDisjunctionLeftCompositional ❙
    include ?SequentDisjunctionRight ❙
❚

theory SequentImplication =
    include ?SequentProofs ❙
    include ?Implication ❙

    implication_left : {A,B}{[Γ] Γ,B}{[Δ] Δ,A } Γ ⊢ Δ,A ⟶ Γ,B ⊢ Δ ⟶ Γ,A ⇒ B ⊢ Δ ❘ # implL 5 6 ❙
    implication_leftP : {A,B}{[Γ] Γ,B}{[Δ] Δ,A } Γ ⊢ Δ,A ⟶ Γ,B ⊢ Δ ⟶ Γ,A ⇒ B ⊢ Δ ❘ # implLP 1 2 5 6 ❘
        = [A,B] case [Γ] Γ,B ↦ case [Δ] Δ,A ↦ [p1,p2] implL p1 p2 ❙

    implication_right : {A,B}{[Γ] Γ,A}{[Δ] Δ,B } Γ,A ⊢ Δ,B ⟶ Γ ⊢ Δ,A ⇒ B ❘ # implR 5 ❙
    implication_rightP : {A,B}{[Γ] Γ,A}{[Δ] Δ,B } Γ,A ⊢ Δ,B ⟶ Γ ⊢ Δ,A ⇒ B ❘ # implRP 1 2 5 ❘
        = [A,B] case [Γ] Γ,A ↦ case [Δ] Δ,B ↦ [p] implR p ❙
❚

theory Test =
    include ?SequentConjunction ❙
    include ?SequentImplication ❙
    include ?Weakening ❙
    include ?Exchange ❙
    include ?Weakening ❙
    include ?InContext ❙

    test : {A,B} ⊦ A ∧ B ⇒ B ∧ A ❘
        = [A,B] implR (
                    andRs
                        (andL (inContext B (∅,A,B) (∅,B)))
                        (andLP A B (inContext A (∅,A,B) (∅,A)))
                ) ❙
❚

theory SequentUniversalQuantification =
    include ?SequentProofs ❙
    include ?UniversalQuantification ❙

    forall_left : {t,A,Γ, Δ} Γ,(A t) ⊢ Δ ⟶ Γ,(∀ A) ⊢ Δ ❙
    forall_right : {Γ, Δ, A} ({x} Γ ⊢ Δ, (A x)) ⟶ Γ ⊢ Δ, (∀ A) ❙
❚

theory SequentExistentialQuantification =
    include ?SequentProofs ❙
    include ?ExistentialQuantification ❙

    existential_left : {Γ, Δ, A} ({x} Γ,(A x) ⊢ Δ) ⟶ Γ,(∃ A) ⊢ Δ ❙
    existential_right : {t, Γ, Δ, A} Γ ⊢ Δ, (A t) ⟶ Γ ⊢ Δ, (∃ A) ❙
❚

theory SequentBigConjunction =
    include ?ContextFold ❙
    include ?Conjunction ❙
    include ?Truth ❙

    bigconj : context ⟶ prop ❘ = [Γ] fold Γ true and ❘ # ⋀ 1 prec 25 ❙
❚

theory SequentBigDisjunction =
    include ?ContextFold ❙
    include ?Disjunction ❙
    include ?Falsity ❙

    bigdisj : context ⟶ prop ❘ = [Γ] fold Γ false or ❘ # ⋁ 1 prec 25 ❙
❚


theory SequentAsND =
    include ?SequentBigConjunction ❙
    include ?SequentBigDisjunction ❙
    include ?Implication ❙
    include ?Proofs ❙
    implicit structure sequentProofs : ?SequentProofs =
        include ?Contexts ❙
       // structure Ded = ?Proofs ❙
        ded = [Γ, Δ] ⊦ (⋀ Γ) ⇒ (⋁ Δ) ❘# 1 ⊢ 2  prec -5❘role Judgment ❙
    ❚
❚
