namespace latin:/❚
fixmeta ur:?LF❚

// Source : P.A. Bonatti, N. Olivetti : Sequent Calculi for Propositional Nonmonotonic Logics,
    AMC Transactions on Computational Logic, Vol. 3, No.2, April 2002 ❚

theory CredProof =
    include ?Propositions ❙
    include ?Contexts ❙
    credproof : context ⟶ context ⟶ context ⟶ type ❘ # 1 + 2 ⊩ 3 prec -5 ❘ role Judgment ❙

❚

theory Default : ur:?LFS =
    include ?Propositions ❙
    default : {n} prop ⟶ prop ⟶ prop ^ n ⟶ prop ❘ # 2 - 4,… / 3 prec 9 ❘ ## 2 : 4,… / 3 prec 9 ❙
❚

theory ResidueCalc =
    include ?CredProof ❙
    include ?SequentProofs ❙
    include ?Antisequent ❙

    residue : prop ⟶ prop ⟶ prop ❘ # 1 / 2 prec 10 ❙

    re1 : {A,B,Γ, Δ} Γ ⊢ Δ ⟶ Γ, A / B ⊢ Δ ❘ # re1 1 2 5 ❙
    re2 : {A,B,Γ, Δ} Γ ⊢ ∅,A ⟶ Γ, B ⊢ Δ ⟶ Γ, A / B ⊢ Δ ❘ # re2 5 6 ❙
    re3 : {A,B, Γ, Δ} Γ ⊬ Δ ⟶ Γ ⊬ ∅, A ⟶ Γ, A / B ⊬ Δ ❘ # re3 2 5 6 ❙
    re4 : {A,B, Γ, Δ} Γ,B ⊬ Δ ⟶ Γ, A / B ⊬ Δ ❘ # re4 1 2 5 ❙
❚

theory DefaultProvable =
    include ?Propositions ❙
    implicit structure Provable : ?Box =
        include ?Propositions ❙
        box # 𝗟 1 prec 20 ❙
    ❚
❚

theory Credulous : ur:?LFS =
    include ?ResidueCalc ❙
    include ?Negation ❙
    include ?DefaultProvable ❙
    include ?Default ❙

    cD1 : {Γ, Δ} Γ ⊢ Δ ⟶ ∅ + Γ ⊩ Δ ❘ # cD1 3 ❙
    cD2 : {Γ, Δ, Σ, A} Γ ⊢ ∅,A ⟶ Σ + Γ ⊩ Δ ⟶ Σ, 𝗟 A + Γ ⊩ Δ ❙
    cD3 : {Γ, Δ, Σ, A} Γ ⊬ ∅,A ⟶ Σ + Γ ⊩ Δ ⟶ Σ, ¬ 𝗟 A + Γ ⊩ Δ ❘ # cD3 4 5 6 ❙
    cD4 : {n}{Σ, Γ, Δ, A, C}{B : prop ^ n} ⟨' Σ, 𝗟 ¬ B..i + Γ ⊩ Δ |i:n '⟩ ⟶ Σ + Γ, ( A - B / C) ⊩ Δ ❘ # cD4 5 << 7,… >> 6 << 8,… >> ❙
    cD5 : {n}{Σ, Γ, Δ}{A,C,B : prop ^ n} (foldL context_extension Σ n ⟨' ¬𝗟¬(B..i) | i:n '⟩) + Γ, A / C ⊩ Δ
        ⟶ Σ + Γ, ( A - B / C) ⊩ Δ ❘ # cD5 5 << 7,… >> 6 8 ❙
❚

// Example 4.12 ❚
theory CredulousExample : ?Credulous =
    include ?PLRefutation ❙
    include ?InContext ❙

    Tweety_is_a_bird : atom ❘ # B ❙
    Tweety_can_fly : atom ❘ # F ❙
    Ostrichs_are_birds : atom ❘ # O ❙

    if_Tweety_is_a_bird_then_assume_they_can_fly = B - F / F ❘ # def ❙

    knowledge_base = ∅, O ⇒ B, O ⇒ ¬ F, B ❘ # base ❙

    tweety_can_probably_fly : ∅ + base, def ⊩ ∅, F ❘
        = cD5 B << F >> F (cD3 (¬F) (re4 B F (RimplL1 O B (RimplL1 O (¬F) (RnotR axiomatically)))) (cD1 (re2 (from_context B) (from_context F))))
    ❙
❚

theory Skeptical : ur:?LFS =
    include ?ResidueCalc ❙
    include ?Negation ❙
    include ?DefaultProvable ❙
    include ?Default ❙

    sD1 : {Γ, Δ, Σ} Γ ⊢ Δ ⟶ Σ + Γ ⊩ Δ ❘ # sD1 3 4 ❙
    sD2 : {Γ, Δ, Σ, A} Γ ⊢ ∅,A ⟶ Σ, ¬ 𝗟 A + Γ ⊩ Δ ❘ # sD2 3 2 5 ❙
    sD3 : {Γ, Δ, Σ, A} Γ ⊬ ∅,A ⟶ Σ, 𝗟 A + Γ ⊩ Δ ❘ # sD3 2 3 5 ❙
    sD4 : {n}{Σ, Γ, Δ, A, C}{B : prop ^ n}
      (foldL context_extension Σ n ⟨' ¬𝗟¬(B..i) | i:n '⟩) + Γ, A / C ⊩ Δ ⟶
       ⟨' Σ, 𝗟 ¬ B..i + Γ ⊩ Δ |i:n '⟩ ⟶
       Σ + Γ, (A - B / C) ⊩ Δ ❘ # sD4 5 << 7,… >> 6 8 << 9,… >> ❙
❚

// Example 4.17 ❚

theory SkepticalExample : ?Skeptical =
    include ?SequentNegation ❙
    include ?SequentImplication ❙
    include ?SequentDisjunctionRight ❙
    include ?InContext ❙
    include ?Exchange ❙
    include ?Weakening ❙
    include ?PLRefutation ❙
    include ?SequentTruthRightWeakened ❙

    A : atom ❙
    B : atom ❙
    C : atom ❙

    proof : ∅ + ∅, ( true - B / ¬ A), ( true - A / ¬ B), ¬ A ∨ ¬ B ⇒ C ⊩ ∅, C ❘
        = sD4 true <<B>> (¬A)
            (sD4 true <<A>> (¬B)
                (sD2 (∅, ¬𝗟¬B) (∅, C) (re2 (trueRW (∅, (true / ¬B), ¬ A ∨ ¬ B ⇒ C)) (inContext (¬A) (∅, (true / ¬B), ¬ A ∨ ¬ B ⇒ C) ∅)))
                <<(sD1 (∅, 𝗟¬A, ¬𝗟¬B) (re2 (trueRW (∅, ¬ A ∨ ¬ B ⇒ C))
                    (notLP A (implLP (¬ A ∨ ¬ B) C (orRP (¬A) (¬B) (notRP B (notRP A (inContext A (∅,B) (∅,C))))) (inContext C ∅ (∅,A))))
                ))>>)
            <<sD4 true <<A>> (¬B)
                (sD1 (∅, ¬𝗟¬A, 𝗟¬B) (re2 (trueRW (∅, ¬ A ∨ ¬ B ⇒ C))
                    (notLP B (implLP (¬ A ∨ ¬ B) C (orRP (¬A) (¬B) (notRP B (notRP A (inContext B (∅,A) (∅,C))))) (inContext C ∅ (∅,B))))
                ))
                <<(sD3 (∅, C) (∅, 𝗟¬B) (RimplL2 (¬ A ∨ ¬ B) C (RnotR axiomatically)))>>
            >> ❙
❚
