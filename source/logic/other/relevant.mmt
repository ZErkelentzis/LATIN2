namespace latin:/❚

fixmeta ?Proofs ❚

theory AxiomIdentity =
    include ?Implication ❙
    axiom_identity : {A} ⊦ A ⇒ A ❙
❚

theory AxiomPrefixing =
    include ?Implication ❙
    axiom_prefixing : {A,B,C} ⊦ (A ⇒ B) ⇒ (C ⇒ A) ⇒ C ⇒ B ❙
❚

theory AxiomSuffixing =
    include ?Implication ❙
    axiom_suffixing : {A,B,C} ⊦ (A ⇒ B) ⇒ (B ⇒ C) ⇒ A ⇒ C ❙
❚

theory AxiomContraction =
    include ?Implication ❙
    axiom_contraction : {A,B} ⊦ (A ⇒ (A ⇒ B)) ⇒ A ⇒ B ❙
❚

theory RelevantT =
    include ?ImplicationNDE ❙
    include ?AxiomIdentity ❙
    include ?AxiomPrefixing ❙
    include ?AxiomSuffixing ❙
    include ?AxiomContraction ❙
❚

theory RuleTransitivity =
    include ?Implication ❙
    include ?Proofs ❙

    rule_transitivity : {A,B,C} ⊦ A ⇒ B ⟶ ⊦ B ⇒ C ⟶ ⊦ A ⇒ C ❙
❚

theory RulePrefixing =
    include ?Implication ❙
    include ?Proofs ❙

    rule_prefixing : {A,B,C} ⊦ A ⇒ B ⟶ ⊦ (C ⇒ A) ⇒ C ⇒ B ❙
❚

theory RuleSuffixing =
    include ?Implication ❙
    include ?Proofs ❙

    rule_suffixing : {A,B,C} ⊦ A ⇒ B ⟶ ⊦ (B ⇒ C) ⇒ A ⇒ C ❙
❚

theory RelevantS =
    include ?AxiomPrefixing ❙
    include ?AxiomSuffixing ❙
    include ?RuleTransitivity ❙
    include ?RulePrefixing ❙
    include ?RuleSuffixing ❙
❚

theory AxiomEntT =
    include ?Implication ❙
    axiom_entT : {A,B} ⊦ ((A ⇒ A) ⇒ B) ⇒ B ❙
❚

theory DisjunctionAsConjunction =
    include ?Conjunction ❙
    include ?Negation ❙
    total structure Disjunction : ?Disjunction =
        include ?Propositions ❙
        or    = [A,B] ¬ (¬ A ∧ ¬ B) ❘ # 1 ∨ 2 prec 15 ❙
    ❚
❚

theory EquivalenceAsImplication =
    include ?Implication ❙
    include ?Conjunction ❙
    total structure Equivalence : ?Equivalence =
        include ?Propositions ❙
        equiv = [A,B] (A ⇒ B) ∧ (B ⇒ A)  ❘# 1 ⇔ 2 prec 10❙
    ❚
❚

theory AxiomConjunctionElimination =
    include ?Implication ❙
    include ?Conjunction ❙
    axiom_andEl : {A,B} ⊦ (A ∧ B) ⇒ A ❙
    axiom_andEr : {A,B} ⊦ (A ∧ B) ⇒ B ❙
❚

theory AxiomDisjunctionIntroduction =
    include ?Implication ❙
    include ?DisjunctionAsConjunction ❙
    axiom_orIl : {A,B} ⊦ A ⇒ (A ∨ B) ❙
    axiom_orIr : {A,B} ⊦ B ⇒ (A ∨ B) ❙
❚

theory AxiomConjunctionIntroduction =
    include ?Implication ❙
    include ?Conjunction ❙
    axiom_andI : {A,B,C} ⊦ ((A ⇒ B) ∧ (A ⇒ C)) ⇒ (A ⇒ (B ∧ C)) ❙
❚

theory AxiomDisjunctionElimination =
    include ?DisjunctionAsConjunction ❙
    include ?EquivalenceAsImplication ❙

    axiom_orE : {A,B,C} ⊦ ((A ∨ B) ⇒ C) ⇔ ((A ⇒ C) ∧ (B ⇒ C)) ❙
❚

theory AxiomDistribution =
    include ?DisjunctionAsConjunction ❙
    include ?Implication ❙

    axiom_distribution : {A,B,C} ⊦ (A ∧ (B ∨ C)) ⇒ ((A ∧ B) ∨ (A ∧ C)) ❙
❚

theory AxiomContraposition =
    include ?Implication ❙
    include ?Negation ❙

    axiom_contraposition : {A,B} ⊦ (A ⇒ ¬ B) ⇒ (B ⇒ ¬ A) ❙
❚

theory AxiomDoubleNegation =
    include ?Implication ❙
    include ?Negation ❙

    axiom_doublenegation : {A} ⊦ ¬¬A ⇒ A ❙
❚


theory RelevantE =
    include ?AxiomIdentity ❙
    include ?AxiomEntT ❙
    include ?AxiomSuffixing ❙
    include ?AxiomContraction ❙
    include ?AxiomConjunctionElimination ❙
    include ?AxiomDisjunctionIntroduction ❙
    include ?AxiomConjunctionIntroduction ❙
    include ?AxiomDisjunctionElimination ❙
    include ?AxiomDistribution ❙
    include ?AxiomContraposition ❙
    include ?AxiomDoubleNegation ❙

    include ?ImplicationNDE ❙
    include ?ConjunctionNDI ❙
❚

theory AxiomAssertion =
    include ?Implication ❙
    axiom_assertion : {A,B} ⊦ A ⇒ (A ⇒ B) ⇒ B ❙
❚

theory RelevantR =
    include ?AxiomIdentity ❙
    include ?AxiomAssertion ❙
    include ?AxiomSuffixing ❙
    include ?AxiomContraction ❙
    include ?AxiomConjunctionElimination ❙
    include ?AxiomDisjunctionIntroduction ❙
    include ?AxiomConjunctionIntroduction ❙
    include ?AxiomDisjunctionElimination ❙
    include ?AxiomDistribution ❙
    include ?AxiomContraposition ❙
    include ?AxiomDoubleNegation ❙

    include ?ImplicationNDE ❙
    include ?ConjunctionNDI ❙
❚

theory AxiomK =
    include ?Box ❙
    include ?Implication ❙

    axiom_k : {A,B} ⊦ □(A ⇒ B) ⇒ (□A ⇒ □B) ❙
❚

theory AxiomKAnd =
    include ?Box ❙
    include ?Implication ❙
    include ?Conjunction ❙

    axiom_k : {A,B} ⊦ (□A ∧ □B) ⇒ □(A ∧ B) ❙
❚

theory RuleNecessitation =
    include ?Box ❙
    include ?Proofs ❙

    rule_necessitation : {A} ⊦ A ⟶ ⊦ □A ❙
❚

theory RelevantNR =
    include ?RelevantR ❙
    include ?AxiomK ❙
    include ?AxiomKAnd ❙

    include ?RuleNecessitation ❙
❚
