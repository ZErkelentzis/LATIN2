file ../../../build_config.msl

// various other logical features
// depends in general on fundamentals and other folders in logic

// no dependency
build MMT/LATIN2 mmt-omdoc logic_extensions/relevant.mmt
build MMT/LATIN2 mmt-omdoc logic_extensions/sequent.mmt

// depends on sequent
build MMT/LATIN2 mmt-omdoc logic_extensions/linear.mmt
build MMT/LATIN2 mmt-omdoc logic_extensions/refutation.mmt

// depends on sequent and refutation
build MMT/LATIN2 mmt-omdoc logic_extensions/defaults.mmt

// depends on sequent, refutation and defaults
build MMT/LATIN2 mmt-omdoc logic_extensions/prolog.mmt
