namespace latin:/❚

fixmeta ur:?LF ❚

import rules scala://sequents.latin2 ❚

theory Contexts =
  include ?Propositions❙
  context : type ❘ // = List prop ❙
  empty_ctx : context ❘ // = nil ❘ # ∅ ❙
  context_extension : context ⟶ prop ⟶ context ❘ // = [Γ,A] cons Γ A ❘ # 1 , 2 prec -4 ❙
  context_concat : context ⟶ context ⟶ context ❘ // = [Γ, Δ]  Γ ++ Δ ❘ # 1 ; 2 prec -5 ❙

   rule rules?ContextEquality ❙
❚

theory ContextMap =
    include ?Contexts ❙

    map : context ⟶ (prop ⟶ prop) ⟶ context ❘ # 2 @ 1 ❙

   rule rules?MapCompute ❙
❚

theory ContextFold =
    include ?Contexts ❙

    fold : context ⟶ prop ⟶ (prop ⟶ prop ⟶ prop) ⟶ prop ❙
   rule rules?FoldCompute ❙
   rule rules?FoldEquality ❙
❚

theory SequentProofs =
  include ?Contexts ❙
  /T Judgement as types (enter notation by "jvdash", not "jder") ❙
  ded   : context ⟶ context ⟶ type❘# 1 ⊢ 2  prec -10❘role Judgment ❙

  structure Ded : ?Proofs =
    include ?Propositions ❙
    ded = [A] ∅ ⊢ ∅, A ❘ # ⊦ 1 ❙
  ❚
❚

theory SequentBase =
   include ?SequentProofs ❙

    base_proof : {A} ∅, A ⊢ ∅, A ❘ # baseP 1 ❘ ## {⋅ / { 1 ⊢ 1 }} axiom ❙
❚

theory InContext =
   include ?SequentBase ❙
   inContext : {A,Γ, Δ} Γ,A ⊢ Δ,A ❘ # from_context 1 %I2 %I3 ❘  ## {⋅ / { 2 , 1 ⊢ 3 , 1 }} axiom ❙
❚

// Structural Rules ------------------------------------------------------------------- ❚

theory Cut =
    include ?SequentProofs ❙

    cut : {A, Γ1, Γ2, Δ1, Δ2} Γ1 ⊢ Δ1,A ⟶ Γ2,A ⊢ Δ2 ⟶ Γ1 ; Γ2 ⊢ Δ1 ; Δ2 ❘ # cut 6 7 ❙
❚

theory Weakening =
    include ?SequentProofs ❙

    rule rules?Weakening ❙
    weaken : {Γ1, Γ2, Δ1, Δ2} Γ1 ⊢ Δ1 ⟶ Γ1; Γ2 ⊢ Δ1; Δ2 ❘ # weaken 5 2 4 ❙
❚

theory Contraction =
    include ?SequentProofs ❙

    rule rules?Contraction ❙
    contractL : {A,Γ,Δ} Γ,A,A ⊢ Δ ⟶ Γ,A ⊢ Δ ❘ # contL 1 4 ❙
    contractR : {A,Γ,Δ} Γ ⊢ Δ,A,A ⟶ Γ ⊢ Δ,A ❘ # contR 1 4 ❙
❚

theory Exchange =
    rule rules?ExchangeEquality ❙
❚

// Truth ------------------------------------------------------------------- ❚

theory SequentTruthLeft =
    include ?SequentProofs ❙
    include ?Truth ❙

    true_left : {Γ, Δ} Γ ⊢ Δ ⟶ Γ, true ⊢ Δ ❘ # trueL 3 ❙
❚

theory SequentTruthRight =
    include ?SequentProofs ❙
    include ?Truth ❙

    true_right : ∅ ⊢ ∅, true ❘ # trueR ❘ ## {⋅ / { ∅ ⊢ true }} true_right ❙
❚

theory SequentTruthRightWeakened =
    include ?SequentProofs ❙
    include ?Truth ❙

    true_right_w : {Γ} Γ ⊢ ∅, true ❘ # trueRW 1 ❘  ## {⋅ / { 1 ⊢ true }} true_right_w ❙
❚

theory SequentTruth =
    include ?SequentTruthLeft ❙
    include ?SequentTruthRight ❙
❚

// Falsity ------------------------------------------------------------------- ❚

theory SequentFalsityLeft =
    include ?SequentProofs ❙
    include ?Falsity ❙

    false_left : ∅, false ⊢ ∅ ❘ # falseL ❘ ## {⋅ / { false ⊢ ∅ }} false_left ❙
❚

theory SequentFalsityRight =
    include ?SequentProofs ❙
    include ?Falsity ❙

    false_right : {Γ, Δ} Γ ⊢ Δ ⟶ Γ ⊢ Δ, false ❘ # falseR 3 ❙
❚

theory SequentFalsity =
    include ?SequentFalsityLeft ❙
    include ?SequentFalsityRight ❙
❚

// Negation ------------------------------------------------------------------- ❚

theory SequentNegationLeft =
    include ?SequentProofs ❙
    include ?Negation ❙

    negation_left : {Γ,Δ,A} Γ ⊢ Δ,A ⟶ Γ, ¬A ⊢ Δ ❘ # notL 4 ❙
    negation_leftP : {Γ,Δ,A} Γ ⊢ Δ,A ⟶ Γ, ¬A ⊢ Δ ❘ # notLP 3 4 ❘
        = [Γ,Δ,A] [p] notL p ❙
❚

theory SequentNegationRight =
    include ?SequentProofs ❙
    include ?Negation ❙

    negation_right : {A, Γ, Δ} Γ, A ⊢ Δ ⟶ Γ ⊢ Δ, ¬A ❘ # notR 4 ❙
    negation_rightP : {A, Γ, Δ} Γ, A ⊢ Δ ⟶ Γ ⊢ Δ, ¬A ❘ # notRP 1 4 ❘
        = [A,Γ,Δ] [p] notR p ❙
❚

theory SequentNegation =
    include ?SequentNegationLeft ❙
    include ?SequentNegationRight ❙
❚

// Conjunction ------------------------------------------------------------------- ❚

theory SequentConjunctionLeft =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_left : {A,B}{Γ,Δ} Γ,A,B ⊢ Δ ⟶ Γ, A ∧ B ⊢ Δ ❘ # andL 5 ❙
    conjunction_leftP : {A,B}{Γ,Δ} Γ,A,B ⊢ Δ ⟶ Γ, A ∧ B ⊢ Δ ❘ # andLP 1 2 5 ❘
        = [A,B][Γ,Δ][p] andL p ❙
❚

theory SequentConjunctionRightSimple =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_right_simple : {A,B,Γ}{Δ} Γ ⊢ Δ,A ⟶ Γ ⊢ Δ,B ⟶ Γ ⊢ Δ,A ∧ B ❘ # andRs 5 6 ❙
    conjunction_right_simpleP : {A,B,Γ}{Δ} Γ ⊢ Δ,A ⟶ Γ ⊢ Δ,B ⟶ Γ ⊢ Δ,A ∧ B ❘ # andRsP 1 2 5 6 ❘
        = [A,B,Γ,Δ,p1,p2] andRs p1 p2 ❙
❚

theory SequentConjunctionRightCompositional =
    include ?SequentProofs ❙
    include ?Conjunction ❙

    conjunction_right_comp : {A,B}{Γ1, Γ2, Δ1,Δ2} Γ1 ⊢ Δ1,A ⟶ Γ2 ⊢ Δ2,B ⟶ Γ1; Γ2 ⊢ Δ1; Δ2 ,A ∧ B ❘ # andRc 7 8 ❙
    conjunction_right_compP : {A,B}{Γ1, Γ2, Δ1,Δ2} Γ1 ⊢ Δ1,A ⟶ Γ2 ⊢ Δ2,B ⟶ Γ1; Γ2 ⊢ Δ1; Δ2 ,A ∧ B ❘ # andRcP 1 2 7 8 ❘
        = [A,B, Γ1, Γ2,Δ1,Δ2] [p1,p2] andRc p1 p2 ❙
❚

theory SequentConjunctionSimple =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightSimple ❙
❚

theory SequentConjunctionCompositional =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightCompositional ❙
❚

theory SequentConjunction =
    include ?SequentConjunctionLeft ❙
    include ?SequentConjunctionRightSimple ❙
    include ?SequentConjunctionRightCompositional ❙
❚

// Disjunction ------------------------------------------------------------------- ❚

theory SequentDisjunctionLeftSimple =
    include ?SequentProofs ❙
    include ?Disjunction ❙

    disjunction_left : {A,B,Γ,Δ} Γ,A ⊢ Δ ⟶ Γ,B ⊢ Δ ⟶ Γ,A ∨ B ⊢ Δ ❘ # orLs 5 6 ❙
    disjunction_leftP : {A,B,Γ,Δ} Γ,A ⊢ Δ ⟶ Γ,B ⊢ Δ ⟶ Γ,A ∨ B ⊢ Δ ❘ # orLsP 1 2 5 6 ❘
        = [A,B,Γ,Δ] [p1,p2] orLs p1 p2 ❙
❚

theory SequentDisjunctionLeftCompositional =
    include ?SequentProofs ❙
    include ?Disjunction ❙

    disjunction_left : {A,B,Γ1,Γ2,Δ1,Δ2} Γ1,A ⊢ Δ1 ⟶ Γ2,B ⊢ Δ2 ⟶ Γ1; Γ2,A ∨ B ⊢ Δ1;Δ2 ❘ # orLc 7 8 ❙
    disjunction_leftP : {A,B,Γ1,Γ2,Δ1,Δ2} Γ1,A ⊢ Δ1 ⟶ Γ2,B ⊢ Δ2 ⟶ Γ1; Γ2,A ∨ B ⊢ Δ1;Δ2 ❘ # orLcP 1 2 7 8 ❘
        = [A,B,Γ1,Γ2,Δ1,Δ2][p1,p2] orLc p1 p2 ❙
❚

theory SequentDisjunctionRight =
    include ?SequentProofs ❙
    include ?Disjunction ❙

    disjunction_right : {A,B,Γ,Δ} Γ ⊢ Δ,A,B ⟶ Γ ⊢ Δ,A ∨ B ❘ # orR 5 ❙
    disjunction_rightP : {A,B,Γ,Δ} Γ ⊢ Δ,A,B ⟶ Γ ⊢ Δ,A ∨ B ❘ # orRP 1 2 5 ❘
     = [A,B,Γ,Δ] [p] orR p ❙
❚

theory SequentDisjunctionSimple =
    include ?SequentDisjunctionLeftSimple ❙
    include ?SequentDisjunctionRight ❙
❚

theory SequentDisjunctionCompositional =
    include ?SequentDisjunctionLeftCompositional ❙
    include ?SequentDisjunctionRight ❙
❚

theory SequentImplication =
    include ?SequentProofs ❙
    include ?Implication ❙

    implication_left : {A,B}{Γ,Δ} Γ ⊢ Δ,A ⟶ Γ,B ⊢ Δ ⟶ Γ,A ⇒ B ⊢ Δ ❘ # implL 5 6 ❙
    implication_leftP : {A,B}{Γ,Δ} Γ ⊢ Δ,A ⟶ Γ,B ⊢ Δ ⟶ Γ,A ⇒ B ⊢ Δ ❘ # implLP 1 2 5 6 ❘
        = [A,B][Γ,Δ][p1,p2] implL p1 p2 ❙

    implication_right : {A,B}{Γ,Δ} Γ,A ⊢ Δ,B ⟶ Γ ⊢ Δ,A ⇒ B ❘ # implR 5 ❙
    implication_rightP : {A,B}{Γ,Δ} Γ,A ⊢ Δ,B ⟶ Γ ⊢ Δ,A ⇒ B ❘ # implRP 1 2 5 ❘
        = [A,B][Γ,Δ] [p] implR p ❙
❚

theory SequentExample =
    include ?SequentConjunction ❙
    include ?SequentImplication ❙
    // include ?Weakening ❙
    include ?Exchange ❙
    include ?InContext ❙

    test : {A,B} ⊦ A ∧ B ⇒ B ∧ A ❘
        = [A,B] implR (
                    andRs
                        (andL (inContext B (∅,A) ∅))
                        (andLP A B (inContext A (∅,B) ∅))
                ) ❙
❚

theory SequentUniversalQuantification =
    include ?SequentProofs ❙
    include ?UniversalQuantification ❙

    forall_left : {t,A,Γ, Δ} Γ,(A t) ⊢ Δ ⟶ Γ,(∀ͧ A) ⊢ Δ ❙
    forall_right : {Γ, Δ, A} ({x} Γ ⊢ Δ, (A x)) ⟶ Γ ⊢ Δ, (∀ͧ A) ❙
❚

theory SequentExistentialQuantification =
    include ?SequentProofs ❙
    include ?ExistentialQuantification ❙

    existential_left : {Γ, Δ, A} ({x} Γ,(A x) ⊢ Δ) ⟶ Γ,(∃ͧ A) ⊢ Δ ❙
    existential_right : {t, Γ, Δ, A} Γ ⊢ Δ, (A t) ⟶ Γ ⊢ Δ, (∃ͧ A) ❙
❚

theory SequentBigConjunction =
    include ?ContextFold ❙
    include ?Conjunction ❙
    include ?Truth ❙

    bigconj : context ⟶ prop ❘ = [Γ] fold Γ true and ❘ # ⋀ 1 prec 25 ❙
❚

theory SequentBigDisjunction =
    include ?ContextFold ❙
    include ?Disjunction ❙
    include ?Falsity ❙

    bigdisj : context ⟶ prop ❘ = [Γ] fold Γ false or ❘ # ⋁ 1 prec 25 ❙
❚

theory SequentAsND =
    include ?SequentBigConjunction ❙
    include ?SequentBigDisjunction ❙
    include ?Implication ❙
    include ?Proofs ❙
    implicit structure sequentProofs : ?SequentProofs =
        include ?Contexts ❙
       // structure Ded = ?Proofs ❙
        ded = [Γ, Δ] ⊦ (⋀ Γ) ⇒ (⋁ Δ) ❘# 1 ⊢ 2  prec -5❘role Judgment ❙
    ❚
❚
