namespace latin:/❚

fixmeta ur:?LF❚

theory PLModel =
  include ?SFOLEQ❙
  include ?Booleans❙
❚

theory PLModelND =
  include ?PLModel❙
  include ?SFOLEQND❙
  include ?BooleansND❙
❚

view PLSemantics : ?PL → ?PLModel =
  prop = tm bool❙
  ded  = [F] ⊦ F ≐ tt❙
  
  true = tt❙
  false = ff❙
  
  and = [x,y] if x then y else ff❙
❚

view PLSemanticsND : ?PLND → ?PLModelND =
  include ?PLSemantics❙
  trueI = refl❙
  falseE = [p][a] (bool_nontrivial notE (p sym)) inconE❙
  
  andI = [F][G][p][q]
          trans3 (p congT [u] if u then G else ff) if_tt q❙

❚
