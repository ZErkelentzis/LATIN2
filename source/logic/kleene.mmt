namespace latin:/❚

theory Kleene : ur:/?LF =

    include ?Propositions❙
    include ?Truth❙
    include ?Falsity❙
    include ?Negation❙
    include ?Conjunction❙
    include ?Disjunction❙

    undef : prop❙
❚

theory FDEND : ?Kleene =

    # Natural Deduction System for First Degree Entailment❙
    # Follows Petrukhin's "Natural deduction for Three-valued regular logics"❙

    # Negation❙
    include ?NegationND❙
    nni : {A} ⊦ A ⟶ ⊦ ¬ ¬ A ❘# notNotIntro 1❙
    nne : {A} ⊦ ¬ ¬ A ⟶ ⊦ A ❘# notNotElim 1❙

    # Conjunction❙
    include ?ConjunctionND❙
    nci : {A,B} ⊦ (¬ A ∨ ¬ B) ⟶ ⊦ ¬ (A ∧ B)❘# notConjIntro 1 2❙
    nce : {A,B} ⊦ ¬ (A ∧ B) ⟶ ⊦ (¬ A ∨ ¬ B)❘# notConjElim 1 2❙

    # Disjunction❙
    include ?DisjunctionND❙
    ndi : {A,B} ⊦ (¬ A ∧ ¬ B) ⟶ ⊦ ¬ (A ∨ B)❘# notDisjIntro 1 2❙
    nde : {A,B} ⊦ ¬ (A ∨ B) ⟶ ⊦ (¬ A ∧ ¬ B)❘# notDisjElim 1 2❙
❚

theory K3ND : ?FDEND =
    em : {A} ⊦ A ∨ ¬ A ❘# ExclMid 1❙
❚

theory K32ND : ?FDEND =
    efq : {A,B} ⊦ A ⟶ ⊦ ¬ A ⟶ ⊦ B❘# ExFalsoQuodlibet 1 2❙
❚