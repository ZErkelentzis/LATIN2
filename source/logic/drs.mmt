namespace latin:/❚

fixmeta ur:?LF❚

theory DRT =
  id: type❙
  lit: type❙
  mode : type❙
  pos: id ⟶ mode❘# 1 ⁺ prec 60❙
  neg: id ⟶ mode❘# 1 ⁻ prec 60❙
  ∅ : mode❙
  union : mode ⟶ mode ⟶ mode❘# 1 ⊎ 2 prec 50❙

  mequal : mode ⟶ mode ⟶ type❘# 1 ≐ 2 prec 30❙
  refl : {x} x ≐ x❙
  // bounded semi-lattice❙
  
  capture: {x} x⁺⊎x⁻ ≐ pos x❙
  
  close : mode ⟶ mode❘# 1 ↓ prec 60❙
  close_pos: {x} x⁺↓ ≐ ∅❙
  close_neg: {x} x⁻↓ ≐ x⁻❙
  
  // normal form of modes: set of id with function into boolean❙

  // realize id as string❙
  
  drs : mode ⟶ type❘# drs 1 prec -5❙
  tm : mode ⟶ type❘# tm 1 prec -5❙
  cond : mode ⟶ type❘# cond 1 prec -5❙
  
  /T DRSs❙
  atomic : {m,n} cond n ⟶ drs m⊎n❘# 1 | 3 prec 10❙  // m is just set of ids, all mapped with pos in the return type❙
  merge : {m,n} drs m ⟶ drs n ⟶ drs m⊎n❙ 
  
  /T conditions❙
  and : {m,n} cond m ⟶ cond n ⟶ cond m⊎n❘# 3 ∧ 4 prec 20❙
  dneg : {m} drs m ⟶ cond m↓❘# ¬* 2 prec 60❙
  dimpl : {m,n} drs m ⟶ drs n ⟶ cond (m⊎n↓)↓ ❘# 3 ⇒*  4 prec 20❙ 

  /T terms❙
  idref : {i:id} tm i⁻❘# ` 1 prec 60❙
❚

theory Example : ?DRT =
  /T example for a predicate❙
  farmer : {m} tm m ⟶ cond m❘# %%prefix 1 1 prec 100❙
  donkey  : {m} tm m ⟶ cond m❘# %%prefix 1 1 prec 100❙
  stick  : {m} tm m ⟶ cond m❘# %%prefix 1 1 prec 100❙
  beat: {l,m,n} tm l ⟶ tm m ⟶ tm n ⟶ cond l⊎m⊎n❘# %%prefix 3 3 prec 100❙
  own: {m,n} tm m ⟶ tm n ⟶ cond m⊎n❘# %%prefix 2 2 prec 100❙
  u: id❙
  v: id❙
  w: id❙
  uv : mode❘ = u⁺ ⊎ v⁺❙
  fod = uv | farmer`u ∧ donkey`v ∧ own(`u)`v❙
  fbds = w⁺ | stick`w ∧ beat(`u)(`v)`w❙
  donkey_sentence = ∅ | fod ⇒* fbds❙
❚