namespace latin:/❚

fixmeta ur:?LF❚

theory InternalEquality =
  include ?InternalLogic❙
  include ?SimpleFunctions❙
  include ?TypedEquality❙
  equalConstant : {A} tm A → (A → bool)❘= [A]λ[x]λ[y]x≐y❙
❚

theory HOL =
  include ?InternalEquality❙
  include ?SimpleFunctions❙
  include ?SFOL❙
❚

theory PowerHOL =
  include ?HOL❙
  implicit view power : powertypes?PowerTypes -> ?PowerHOL =
    include ?InternalLogic/props❙
    include ?TypedEquality❙
    include ?Equivalence❙
    power = [a] a → bool❙
    filter = [A,P] λ P❙
    in = [A,x,S] S @ x❙
  ❚
❚