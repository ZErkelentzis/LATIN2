namespace latin:/❚

fixmeta ur:?LF❚

theory InternalEquality =
  include ?InternalLogic❙
  include ?SimpleFunctions❙
  include ?TypedEquality❙
  equalConstant : {A} tm A → (A → bool)❘= [A]λ[x]λ[y]x≐y❙
❚

theory IHOL =
  include ?InternalEquality❙
  include ?SimpleFunctions❙
  include ?ISFOL❙
❚

theory HOL =
  include ?IHOL❙
  include ?Classical❙
❚

theory PowerHOL =
  include ?HOL❙
  realize powertypes?PowerTypes❙
  power = [a] a → bool❙
  filter = [A,P] λ P❙
  in = [A,x,S] S @ x❙
❚