file ../../../build_config.msl

// first-order logic
// depends in general on fundamentals and propositional

// no dependencies
build MMT/LATIN2 mmt-omdoc logic/fol_like/nonempty.mmt

// basics, depend only on nonempty
build MMT/LATIN2 mmt-omdoc logic/fol_like/fol.mmt
build MMT/LATIN2 mmt-omdoc logic/fol_like/sfol.mmt

// depend on fol
build MMT/LATIN2 mmt-omdoc logic/fol_like/stfol.mmt
build MMT/LATIN2 mmt-omdoc logic/fol_like/fol_hilbert.mmt
build MMT/LATIN2 mmt-omdoc logic/fol_like/fol_derived.mmt
build MMT/LATIN2 mmt-omdoc logic/fol_like/fol-tableaux.mmt

// also depends on ur:?DiagramOperators which fails
// build MMT/LATIN2 mmt-omdoc logic/fol-diagop.mmt

// depend on sfol
build MMT/LATIN2 mmt-omdoc logic/fol_like/sfol_derived.mmt

// depends on sfol
build MMT/LATIN2 mmt-omdoc logic/fol_like/booleans.mmt

// depends on sfol and booleans
build MMT/LATIN2 mmt-omdoc logic/fol_like/pl-sfol.mmt

// depend on some of the above
build MMT/LATIN2 mmt-omdoc logic/fol_like/multimodal.mmt
build MMT/LATIN2 mmt-omdoc logic/fol_like/dynamic.mmt

