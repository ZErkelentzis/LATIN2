file ../../../build_config.msl

// first-order logic
// depends in general on fundamentals and propositional

// no dependencies
build MMT/LATIN2 mmt-omdoc ./nonempty.mmt

// basics, depend only on nonempty
build MMT/LATIN2 mmt-omdoc ./untyped.mmt
build MMT/LATIN2 mmt-omdoc ./ifte.mmt
build MMT/LATIN2 mmt-omdoc ./typed.mmt
build MMT/LATIN2 mmt-omdoc ./softtyped.mmt

// depend on fol
build MMT/LATIN2 mmt-omdoc ./stfol.mmt
build MMT/LATIN2 mmt-omdoc ./fol_hilbert.mmt
build MMT/LATIN2 mmt-omdoc ./fol_derived.mmt
build MMT/LATIN2 mmt-omdoc ./fol-tableaux.mmt

// also depends on ur:?DiagramOperators which fails
// build MMT/LATIN2 mmt-omdoc logic/fol-diagop.mmt

// depend on sfol
build MMT/LATIN2 mmt-omdoc ./sfol_derived.mmt

// depends on sfol
build MMT/LATIN2 mmt-omdoc ./booleans.mmt

// depends on sfol and booleans
build MMT/LATIN2 mmt-omdoc ./pl-sfol.mmt

