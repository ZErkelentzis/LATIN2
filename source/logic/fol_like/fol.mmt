namespace latin:/❚

fixmeta ur:?LF❚

theory UniversalQuantification =
  include ?UntypedLogic❙
  uforall : (term ⟶ prop) ⟶ prop❘# ∀ͧ 1❘## ∀ͧ V1 2❙
❚

theory UniversalQuantificationNDI =
  include ?UniversalQuantification❙
  uforallI  : {P} ({x} ⊦ (P x)) ⟶ ⊦ ∀ͧ P❙
❚

theory UniversalQuantificationNDE =
  include ?UniversalQuantification❙
  uforallE  : {P,X} ⊦ ∀ͧ P ⟶ ⊦ (P X)❘# 3 uforallE 2❘role ForwardRule❙
❚

theory UniversalQuantificationND =
  include ?UniversalQuantificationNDE❙ 
  include ?UniversalQuantificationNDI❙
❚

theory ExistentialQuantification =
  include ?UntypedLogic❙
  uexists : (term ⟶ prop) ⟶ prop❘# ∃ͧ 1❘## ∃ͧ V1 2❙
❚

theory ExistentialQuantificationNDI =
  include ?ExistentialQuantification❙
  uexistsI  : {P,X} ⊦ P X ⟶ ⊦ ∃ͧ P❘# uexistsI 2 3❙
❚

theory ExistentialQuantificationNDE =
  include ?ExistentialQuantification❙
  uexistsE  : {P,C} ⊦ ∃ͧ P ⟶ ({x} ⊦ (P x) ⟶ ⊦ C) ⟶ ⊦ C❘# 3 uexistsE 4❘role EliminationRule❙
❚

theory ExistentialQuantificationND =
  include ?ExistentialQuantificationNDI❙ 
  include ?ExistentialQuantificationNDE❙ 
❚

theory IFOL =
  include ?IPL❙
  include ?UniversalQuantification❙
  include ?ExistentialQuantification❙
❚

theory IFOLND =
  include ?IFOL❙
  include ?IPLND❙
  include ?UniversalQuantificationND❙
  include ?ExistentialQuantificationND❙
❚

theory IFOLEQ =
  include ?IFOL❙
  include ?UntypedEquality❙
❚

theory IFOLEQND =
  include ?IFOLEQ❙
  include ?IFOLND ❙
  include ?UntypedEqualityND❙
❚

theory FOL =
  include ?PL❙ 
  include ?IFOL❙
❚

theory FOLND =
  include ?FOL❙
  include ?PLND❙
  include ?IFOLND❙
❚

theory FOLEQ =
  include ?FOL❙
  include ?UntypedEquality❙
❚

theory FOLEQND =
  include ?FOLEQ❙
  include ?FOLND❙
  include ?UntypedEqualityND❙
❚

theory RelativizedUniversalQuantification =
  include ?SoftTypedTerms❙
  include ?FOLEQ❙
  rforall : tp ⟶ (term ⟶ prop) ⟶ prop❘# ∀ͬ 1 2❘
  	= [A,P] ∀ͧ[x] x⦂A ⇒ P x❙
❚

theory RelativizedUniversalQuantificationND =
  include ?RelativizedUniversalQuantification❙
  include ?FOLEQND❙
  rforallI : {A,F} ({x} ⊦x⦂A ⟶ ⊦ F x) ⟶ ⊦ ∀ͬ A F❘
  	= [A,F,P] uforallI [x] implI [xa] P x xa❙
  rforallE : {A,F} ⊦ ∀ͬ A F ⟶ {x} ⊦x⦂A ⟶ ⊦ F x❘
  	= [A,F,p,x,xa] p uforallE x implE xa❙
❚

theory RelativizedExistentialQuantification =
  include ?SoftTypedTerms❙
  include ?FOLEQ❙
  rexists : tp ⟶ (term ⟶ prop) ⟶ prop❘# ∃ͬ 1 2❘
  	= [A,P] ∃ͧ[x] x⦂A ∧ P x❙
❚

theory RelativizedExistentialQuantificationND =
  include ?RelativizedExistentialQuantification❙
  include ?FOLEQND❙
  rexistsI : {A,F} {x} ⊦x⦂A ⟶ ⊦ F x ⟶ ⊦ ∃ͬ A F❘
  	= [A,F,x,xa,p] uexistsI x andI xa p❙
  rexistsE : {A,F,C} ⊦ ∃ͬ A F ⟶ ({x} ⊦x⦂A ⟶ ⊦ F x ⟶ ⊦ C) ⟶ ⊦ C❘
  	= [A,F,C,p,P] p uexistsE [x,q] P x (q andEl) (q andEr)❙
❚

theory UniqueExistentialQuantification =
  include ?ExistentialQuantification❙
  include ?UntypedEquality❙
  uexistsUnique  : (term ⟶ prop) ⟶ prop❘# ∃ ꜝͧ 1 prec -5 ❙
 ❚

theory UniqueExistentialQuantificationND =
  include ?UniqueExistentialQuantification ❙
  uexistsUniqueI : {P} {x} ⊦ P x ⟶ ({y} ⊦ P y ⟶ ⊦ x =ͧ y) ⟶ ⊦ ∃ꜝͧ P❘# uexistsUniqueI 3 4 ❙
  uexistsUniqueE : {P,C} ⊦ ∃ꜝͧ P ⟶ ({x} ⊦ P x ⟶ ({y} ⊦ P y ⟶ ⊦ x =ͧ y) ⟶ ⊦ C) ⟶ ⊦ C❘# 3 uexistsUniqueE 4❙
❚

theory Description =
  include ?Logic❙
  include ?UniqueExistentialQuantificationND❙
  the : {P} ⊦ ∃ꜝͧ P ⟶ term❘# the 1 2 prec 50❙
  the_ax : {P,p} ⊦ P (the P p)❘# the_ax 1 2❙
❚

theory Choice =
  include ?Logic❙
  include ?ExistentialQuantificationND❙
  include ?UntypedEquality❙
  some : {P} ⊦ ∃ͧ P ⟶ term❘# some 1 2 prec 50❙
  some_ax : {P,p} ⊦ P (some P p)❘# some_ax 1 2❙
  some_eq: {P,Q,p,q} ({x} ⊦ P x ⟶ ⊦ Q x) ⟶ ({x} ⊦ Q x ⟶ ⊦ P x) ⟶
            ⊦ some P p =ͧ some Q q❙
❚

// The variant of choice that always returns a value and whose defining axiom is relativized by existence; only sound if types are guaranteed to be non-empty.❚
theory TotalChoice =
  include ?Logic❙
  include ?ExistentialQuantificationND❙
  include ?UntypedEquality❙
  any : {P:term ⟶ prop} term❘# %n 1 prec 50❙
  any_ax : {P: term ⟶ prop,p} ⊦ ∃ͧ P ⟶ ⊦ P (any p)❘# %n 2 3❙
  any_eq : {P,Q} ({x} ⊦ P x ⟶ ⊦ Q x) ⟶ ({x} ⊦ Q x ⟶ ⊦ P x) ⟶
            ⊦ any P =ͧ any Q❙
  
  realize ?Choice❙
  some = [P,p] any P❙
  some_ax = [P,p] any_ax P p❙
  some_eq = [P,Q,p,q,r,s] any_eq r s❙
❚

theory FOLEQDesc = 
  include ?FOLEQ❙
  include ?Description❙
❚

theory FOLEQDescND =
  include ?FOLEQDesc❙
  include ?FOLEQND❙
❚

theory DependentFOLEQDesc =
  include ?FOLEQDesc❙
  include ?DependentConjunction❙
  include ?DependentDisjunction❙
  include ?DependentImplication❙
❚

theory DependentFOLEQDescND =
  include ?DependentFOLEQDesc❙
  include ?FOLEQDescND❙
  include ?DependentConjunctionND❙
  include ?DependentDisjunctionND❙
  include ?DependentImplicationND❙
❚

view TotalChoiceYieldsNonempty : ?UniverseNonEmpty -> ?TotalChoice =
  include ?UntypedLogic❙
  univ_nonempty = [C,P] P (any [x] x =ͧ x)❙ 
❚

view ChoiceYieldsDescription : ?Description -> ?Choice + ?UniqueExistentialQuantificationND =
  include ?Logic❙
  include ?UniqueExistentialQuantificationND❙
  the = [P,p] some P (p uexistsUniqueE [x,q,F] uexistsI x q)❙
  the_ax = [P,p] some_ax P (p uexistsUniqueE [x,q,F] uexistsI x q)❙
❚
