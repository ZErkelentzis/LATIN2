namespace latin:/❚

fixmeta ?TypedTerms❚

theory TrueFalse =
	include ?Booleans ❙
	tt: tm bool❙
  ff: tm bool❙
❚

theory InternalTruthValues =
  include ?InternalPropositions❙
  include ?TrueFalse❙
  realize ?Truth❙
  true = tt❙
  realize ?Falsity❙
  false = ff❙
❚

theory BooleanExtensionality : ?SFOLEQND =
   include ?TrueFalse❙

   bool_nontrivial : ⊦ ¬ ff =ͭ tt❙
   
   boolext : {F} ⊦ F tt ⟶ ⊦ F ff ⟶ {x:tm bool} ⊦ F x❘# boolext 1 2 3 4❙

   bool_tnd : ⊦ ∀ͭ[b] b =ͭ tt ∨ b =ͭ ff❘
            = tforallI [b] boolext ([x]x =ͭ tt ∨ x =ͭ ff) (trefl orIl) (trefl orIr) b❙
❚
