namespace latin:/❚

fixmeta ur:?LF❚

theory UniversalQuantification =
  include ?UntypedLogic❙
  forall : (term ⟶ prop) ⟶ prop❘# ∀ 1❘## ∀ V1 2❙
  forallI  : {P} ({x} ⊦ (P x)) ⟶ ⊦ ∀ P❙
  forallE  : {P} ⊦ ∀ P ⟶ {x} ⊦ (P x)❘# 2 forallE 3❘role ForwardRule❙
❚

theory ExistentialQuantification =
  include ?UntypedLogic❙
  exists : (term ⟶ prop) ⟶ prop❘# ∃ 1❘## ∃ V1 2❙
  existsI  : {P,x} ⊦ P x ⟶ ⊦ ∃ P❘# existsI 2 3❙
  existsE  : {P,C} ⊦ ∃ P ⟶ ({x} ⊦ (P x) ⟶ ⊦ C) ⟶ ⊦ C❘# 3 existsE 4❙
❚

theory IFOL =
  include ?IPL❙
  include ?UniversalQuantification❙
  include ?ExistentialQuantification❙
❚

theory FOL =
  include ?PL❙ 
  include ?IFOL❙
❚

theory Equality =
  include ?UntypedLogic❙
  equal : term ⟶ term ⟶ prop❘# 1 ≐ 2 prec 30❙
  refl  : {x} ⊦ x ≐ x❘# refl %I1❙
  congP : {x,y} ⊦ x ≐ y ⟶ {P: term ⟶ prop} ⊦ P x ⟶ ⊦ P y❘# 3 congP 4 5❙
  
  view equalityRelation : ?Relation -> ?Equality =
    carrier = term❙
    rel = [x,y] ⊦ x≐y❙
  ❚

  view eqrefl : ?Reflexivity -> ?Equality =
    include ?Equality/equalityRelation❙
    refl = [x] refl❙
  ❚
  
  implicit view eqsym : ?Symmetry -> ?Equality =
    include ?Equality/equalityRelation❙
    sym = [x,y,p] p congP ([u]u≐x) refl❙
  ❚
  
  implicit view eqtrans : ?Transitivity -> ?Equality =
    include ?Equality/equalityRelation❙
    trans = [x,y,z,p,q] q congP ([u]x≐u) p❙
  ❚
  
  implicit view eqcong : ?Congruence -> ?Equality =
    include ?Equality/equalityRelation❙
    congT = [x,y,p,T] p congP ([u] T x ≐ T u) refl❙
  ❚

❚

theory SoftTypedEquality =
  include ?SoftTypedLogic❙
  include ?Equality❙
  eq_wff : {A,X,Y} X∈A ⟶ Y∈A ⟶ wff X≐Y❙
❚  

theory FOLEQ =
  include ?FOL❙
  include ?Equality❙
❚

theory UniqueExistentialQuantification =
  include ?ExistentialQuantification❙
  include ?Equality❙
  existsUnique  : (term ⟶ prop) ⟶ prop❘# ∃¹ 1❙
  existsUniqueI : {P} {x} ⊦ P x ⟶ ({y} ⊦ P y ⟶ ⊦ x ≐ y) ⟶ ⊦ ∃¹ P❘# existsUniqueI 3 4 5❙
  existsUniqueE : {P,C} ⊦ ∃¹ P ⟶ ({x} ⊦ P x ⟶ ({y} ⊦ P y ⟶ ⊦ x ≐ y) ⟶ ⊦ C) ⟶ ⊦ C❘# 4 existsUniqueE 5❘❙
❚

theory Description =
  include ?Logic❙
  include ?UniqueExistentialQuantification❙
  the : {P} ⊦ ∃¹ P ⟶ term❘# the 1 2❙
  the_prop : {P,p} ⊦ P (the P p)❙
❚

theory Choice =
  include ?Logic❙
  include ?ExistentialQuantification❙
  some : {P} ⊦ ∃ P ⟶ term❘# some 1 2❙
  some_prop : {P,p} ⊦ P (some P p)❙
❚

theory FOLEQDesc = 
  include ?FOLEQ❙
  include ?Description❙
❚