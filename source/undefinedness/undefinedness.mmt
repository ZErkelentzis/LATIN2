namespace latin:/❚

fixmeta ur:?LF❚

theory Undefined =
    include ?UntypedLogic❙

    defined   : term ⟶ prop❘# 1 ↓❙
    undefined : term ⟶ prop❘# 1 ↑❙
❚

theory UndefinedND =
    include ?Undefined❙
    include ?IPLND❙
    include ?Equality❙

    def_not_undef : { a } ⊦ ((a ↓) ⟶ ⊦ (¬ (a ↑)))❙
    undef_not_def : { a } ⊦ ((a ↑) ⟶ ⊦ (¬ (a ↓)))❙
❚