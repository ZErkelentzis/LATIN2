namespace latin:/❚

fixmeta ur:?LF❚

theory NonDenoting =
    include ?UntypedLogic❙

    denoting    : term ⟶ prop❘# 1 ⥿❙
    nondenoting : term ⟶ prop❘# 1 ⥾❙
❚

theory NonDenotingND =
    include ?NonDenoting❙
    include ?NegationND❙

    den_not_nonden : { A } (⊦ (A ⥿)) ⟶ (⊦ (¬ (A ⥾)))❙
    nonden_not_den : { A } (⊦ (A ⥾)) ⟶ (⊦ (¬ (A ⥿)))❙
❚

theory Undefined =
    include ?UntypedLogic❙

    defined   : term ⟶ prop❘# 1 ↓❙
    undefined : term ⟶ prop❘# 1 ↑❙
❚

theory UndefinedND =
    include ?Undefined❙
    include ?NegationND❙

    def_not_undef : { A } (⊦ (A ↓)) ⟶ (⊦ (¬ (A ↑)))❙
    undef_not_def : { A } (⊦ (A ↑)) ⟶ (⊦ (¬ (A ↓)))❙
❚