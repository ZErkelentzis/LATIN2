namespace latin:/❚

fixmeta ?SFOLEQND❚

theory Class =
  obj: type❙
❚

theory Category =
  include ?Class❙

  hom: obj ⟶ obj ⟶ tp❙
  Hom: obj ⟶ obj ⟶ type❘= [a,b] tm (hom a b)❙
  ident : {a} Hom a a❘# id %I1❙
  comp : {a,b,c} Hom a b ⟶ Hom b c ⟶ Hom a c❘# 4 ; 5 prec 50❙

  neutLeft : {a,b,f:Hom a b} ⊦ id;f =ͭ f❙
  neutRight : {a,b,f:Hom a b} ⊦ f;id =ͭ f❙
  assoc: {a,b,c,d, f:Hom a b, g:Hom b c, h:Hom c d} ⊦ f;(g;h) =ͭ (f;g);h❙
  assoc_22_121: {a,b,c,d,e, f:Hom a b, g:Hom b c, h:Hom c d, i: Hom d e} ⊦ (f;g);(h;i) =ͭ f;(g;h);i❘
              = [a,b,c,d,e,f,g,h,i] assoc ttrans ((assoc tsym) tcongT ([u] u;i))❙
  
  isos  = [a,b,f:Hom a b,g] f;g =ͭ id ∧ g;f =ͭ id❘ # isos 3 4❙
  iso = [a,b] ∃ͭ[f:Hom a b]∃ͭ[g] isos f g❙
  
  total structure iso_equiv : latin:/?EquivalenceRelation =
    carrier = obj❙
    rel = [a,b] ⊦ iso a b❙
    refl = [a] texistsI id texistsI id andI neutLeft neutLeft❙
    trans = [a,b,c,p,q] p texistsE [abf,pˈ] pˈ texistsE [abg,abi]
                        q texistsE [bcf,qˈ] qˈ texistsE [bcg,bci]
                        texistsI (abf;bcf) texistsI (bcg;abg) andI
                          (assoc_22_121 ttrans
                          (bci andEl tcongT [u] abf;u;abg) ttrans
                          (neutRight tcongT [u] u;abg) ttrans
                          (abi andEl)
                          )
                          (assoc_22_121 ttrans
                          (abi andEr tcongT [u] bcg;u;bcf) ttrans
                          (neutRight tcongT [u] u;bcf) ttrans
                          (bci andEr)
                          )
                          ❙
    sym = [a,b,p] p texistsE [f,pˈ] pˈ texistsE [g,i] texistsI g texistsI f and_swap i❙
  ❚
❚

theory SmallClass =
  sobj: tp❙
  realize ?Class❙
  obj = tm sobj❙ 
❚

theory SmallCategory =
  include ?SmallClass❙
  include ?Category❙
❚
