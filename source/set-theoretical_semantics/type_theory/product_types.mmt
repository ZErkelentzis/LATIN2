namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚


view SimpleProductTypesSet : ?SimpleProductTypes → ?TypeBase + ?CartesianProduct =
	include ?TypesSet❙
	simpprod = [A,B] A ×ͧ B❙
❚	

view DependentProductTypesSet : ?DependentProductTypes → ?TypeBase + ?SigmaMod =
	include ?TypedTermsSet❙	
	depprod = [A,B: (Elem A ⟶ set)] sigmaMod A ([x,p: ⊦ x∈A] B (elem x p))❙
❚

view SoftDependentProductTypesSet : ?SoftDependentProductTypes → ?TypeBase + ?Sigma =
	include ?SoftTypedTermsSet❙
	softprod = [A,B] sigma A B❙
❚

view SimpleProductsSet : ?SimpleProducts → ?TypeBase + ?CartesianProduct =
  include ?SimpleProductTypesSet❙
  include ?TypedEqualityNDSet❙
  
	simppair = [A,B,a: Elem A,b: Elem B] elem (which a,ͧwhich b) (prodI (why a) (why b))❙
  simppi1 = [A,B,e: Elem (A×ͧB)] elem ((which e)₁ͧ) ((why e) prodEl)❙
  simppi2 = [A,B,e: Elem (A×ͧB)] elem ((which e)₂ͧ) ((why e) prodEr)❙
  
  compute1 = [A,B,a: Elem A,b: Elem B] compL ❙
  compute2 = [A,B,a: Elem A,b: Elem B] compR ❙
❚

view DependentProductsSet : ?DependentProducts → ?TypeBase + ?SigmaMod =
	include ?DependentProductTypesSet❙
  include ?TypedEqualitySet❙
  include ?DependentTypeEqualitySet❙
  
  deppair = [A,B: (Elem A ⟶ set),a: Elem A,b: Elem (B a)] elem (which a,ͧ which b)
    (sigmaModI (why a) (in_eq (why b) (simpF B)))❙
  deppi1 = [A,B: (Elem A ⟶ set),e] elem ((which e)₁ͧ) ((why e) sigmaModEl)❙
  deppi2 = [A,B: (Elem A ⟶ set),e] elem ((which e)₂ͧ) ((why e) sigmaModEr)❙
  
  compute1 = [A,B,a: Elem A,b] compL ❙
  // AS: probably this error is related to DependentTypeEqualitySet❙
  // compute2 = [A,B: (Elem A ⟶ set),a,b] _ ❙
  compute2 = [A,B: (Elem A ⟶ set),a,b] compR❙
❚

