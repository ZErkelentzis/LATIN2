  // TODO: Simplify and Solve❙
❚

view SoftTypedProductsSet : ?SoftTypedProducts → ?TypeBase + ?CartesianProduct =
	include ?UntypedEqualitySet❙

	pair = [a,b] a ,ͧ b❙
  pi1 = [p] p ₁ͧ❙
  pi2 = [p] p ₂ͧ❙
  
  compute1 = [a,b] compL❙
  compute2 = [a,b] compR❙
  // TODO: Simplify and Solve❙
❚

view SoftTypedSimpleProductsSet : ?SoftTypedSimpleProducts → ?TypeBase + ?CartesianProduct =
	include ?SoftTypedTermsSet❙
  include ?SoftTypedProductsSet❙
  include ?SimpleProductTypesSet❙	
  fun_typing = [A,B,a,b,p: ⊦ a∈A,q: ⊦ b∈B] prodI p q❙
❚

view SoftTypedDependentProductsSet : ?SoftTypedDependentProducts → ?TypeBase + ?CartesianProduct + ?Sigma =
	include ?SoftTypedTermsSet❙
  include ?SoftTypedProductsSet❙
  include ?SoftDependentProductTypesSet❙
  fun_typing = [A,B,a,b,p: ⊦ a∈A,q: ⊦ b∈(B a)] sigmaI p q❙
❚

// theory SimpleProductsExpandSet =
  include ?Propositions❙
  include ?Proofs❙
  include ?SimpleProductsSet❙
  
  realize ?SimpleProductsExpand❙
  expand = [A,B,u: Elem (A×ͧB)] expand ❙
❚

view SimpleProductsExpandSet : ?SimpleProductsExpand → ?TypeBase + ?CartesianProduct =
	include ?SimpleProductsSet❙
  expand = [A,B,u: Elem (A×ͧB)] expand❙
❚

// theory DependentProductsExpandSet =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?DependentProductsSet❙
  
  realize ?DependentProductsExpand❙
  expand = [A,B,u] expand ❙
❚

view DependentProductsExpandSet : ?DependentProductsExpand → ?TypeBase + ?SigmaMod =
  include ?DependentProductsSet❙
  expand = [A,B,u] expand ❙
❚  

view SoftTypedProductsExpandSet : ?SoftTypedProductsExpand → ?TypeBase + ?CartesianProduct =
	include ?SoftTypedProductsSet❙
	// AS: repr cannot be used, since u does not have to be a pair❙
  // expand = [u] _❙
❚

view SimpleProductsExtensionalitySet : ?SimpleProductsExtensionality → ?TypeBase + ?CartesianProduct =
	include ?SimpleProductsSet❙
	exten = [A,B,u: Elem (A×ͧB),v: Elem (A×ͧB),p,q] ext ((why u) prodE) ((why v) prodE) p q❙
❚

view DependentProductsExtensionalitySet : ?DependentProductsExtensionality → ?TypeBase + ?SigmaMod =
	include ?DependentProductsSet❙
	// AS: probably this error is related to DependentTypeEqualitySet❙
  // exten = [A,B,u,v,p,q] ext ((why u) sigmaE) ((why v) sigmaE) p q❙ 
❚

view SoftTypedProductsExtensionalitySet : ?SoftTypedProductsExtensionality → ?TypeBase + ?CartesianProduct =
	include ?SoftTypedProductsSet❙
	// AS: u and v do not have to be pairs❙
❚
