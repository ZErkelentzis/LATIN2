namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚

view SimpleFunctionTypesSet : ?SimpleFunctionTypes → ?TypeBase + ?Functions =
	include ?TypesSet❙
	simpfun = func❙
❚

