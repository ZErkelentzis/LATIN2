namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚

theory TypesSet =
  include ?TypeBase❙
  
  realize ?Types❙
  tp = set❙
❚

theory TypedTermsSet =
  include ?TypesSet❙
  
  realize ?TypedTerms❙
  tm = [A] Elem A❙
❚

theory SoftTypedTermsSet =
  // AS: Propositions and Terms are part of the fixmeta❙
  include ?Propositions❙
  include ?Terms❙
  include ?TypesSet❙
  
  realize ?SoftTypedTerms❙
  of = in❙
❚

theory TypedLogicSet =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?TypedTermsSet❙
  
  realize ?TypedLogic❙
❚

theory SoftTypedLogicSet =
  // AS: Propositions, Terms and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Terms❙
  include ?Proofs❙
  include ?SoftTypedTermsSet❙
  
  realize ?SoftTypedLogic❙
❚

theory TypedEqualitySet =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?TypedLogicSet❙
  
  realize ?TypedEquality❙
  tequal = Eq❙ 
❚

theory TypedEqualityNDSet =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?TypedEqualitySet❙
  
  realize ?TypedEqualityND❙
  trefl = [A,e: Elem A] Refl❙
  tcongB = EqcongB❙
❚

theory TypeEqualityNDSet =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  
  include ?TypesSet❙
  
  realize ?TypeEqualityND❙
  // AS: a structure mapping untyped equality to types within the 
    transformation of type theory into untyped set theory :D
    → term = tp = set = term❙
  constant tpeq/uequal = [A,B] A =ͧ B❙
  constant tpeq/urefl = [A] urefl❙
  constant tpeq/ucongP = [A,B,p,P,q] p ucongP P q❙
❚

theory DependentTypeEqualitySet =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  
  include ?TypeEqualityNDSet❙
  include ?TypedEqualityNDSet❙
  
  realize ?DependentTypeEquality❙
  transport = [A,B,p,e: Elem A] elem (which e) (p tpeq/ucongP ([T] which e∈T) (why e))❙
  transport_refl = [A,e: Elem A] tpeq/urefl❙ 
  transport_trans = [A,B,C,e: Elem A,p,q] uequal❙ 
❚