namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚

view TypesSet : ?Types → ?TypeBase =
  tp = set❙
❚

view TermsSet : ?Terms → ?TypeBase =
	term = set❙
❚

view TypedTermsSet : ?TypedTerms → ?TypeBase =
  include ?TypesSet❙
  tm = [A] Elem A❙
❚

view SoftTypedTermsSet : ?SoftTypedTerms → ?TypeBase =
  include ?TypesSet❙
  include ?TermsSet❙
  include ?Propositions❙
  
  of = in❙
❚

view UntypedLogicSet : ?UntypedLogic → ?TypeBase =
	include ?Logic❙
	include ?TermsSet❙
❚

view TypedLogicSet : ?TypedLogic → ?TypeBase =
	include ?Logic❙
	include ?TypedTermsSet❙
❚

view SoftTypedLogicSet : ?SoftTypedLogic → ?TypeBase =
	include ?Logic❙
	include ?SoftTypedTermsSet❙
❚

view UntypedEqualitySet : ?UntypedEquality → ?TypeBase =
	include ?UntypedLogicSet❙
	uequal = uequal❙
❚

view TypedEqualitySet : ?TypedEquality → ?TypeBase = 
	include ?TypedLogicSet❙
	tequal = [A,x,y] x Eq y❙
❚

view TypedEqualityNDSet : ?TypedEqualityND → ?TypeBase =
	include ?TypedEqualitySet❙
	trefl = [A,e: Elem A] EqRefl❙
  tcongB = EqcongB❙
❚

view TypeEqualityNDSet : ?TypeEqualityND → ?TypeBase =
	include ?Logic❙
	include ?TypesSet❙
	constant tpeq/uequal = [A,B] A =ͧ B❙
  constant tpeq/urefl = [x] urefl❙
  constant tpeq/ucongP = [A,B,p,P,q] p ucongP P q❙
❚

view DependentTypeEqualitySet : ?DependentTypeEquality → ?TypeBase =
	include ?TypeEqualityNDSet❙
  include ?TypedEqualityNDSet❙
  
  transport = [A,B,p,e] elem (which e) (p ucongP ([T] which e∈T) (why e))❙
  transport_refl = [A,e] urefl❙ 
  transport_trans = [A,B,C,e,p,q] urefl❙ 
❚
