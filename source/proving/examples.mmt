❚

theory Examples : ?ExMeta =



 //   simple_ex : {T  : tp, A: tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
    ❘# simple_ex ❘ = [T , A] ( proof fix x ; assume h ; use h) ❙



//    failing_ex : {T  : tp, A: tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
    ❘ = [T , A] proof fix x ; assume h ❙

//    void_ex :  {T  : tp, A: tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
        ❘ = [T , A] proof fix x;  void ; assume a ; use a  ❙

 //   pps_ex : {T  : tp, A: tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
    ❘ = [T , A] proof pps ❙


 //   ignore_ex : {T  : tp, A: tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
    ❘ = [T , A] proof ignore ❙


    theory bwd_ex_isolated =
    //    T : tp❙
    //    A : tm T ⟶ prop ❙
    //    B : prop ❙
   //     x : tm T ❙
//        tmp : ⊦ B ⇒ A x ⇒ A x ❙
//        tmp0 : ⊦ A x ❙
 //       tmp1 : ⊦ B ❙
   //     tmp2 : ⊦ A x  ⇒ A x  ❙


//        prooflf_ex = proofLF ( ⊦ A x  ⇒ A x) (void)  ❙

    //    bwd_ex : ⊦  A x
        ❘ =  proof   bwd tmp    ; use tmp1 ; use tmp0 ❙

    //    bwd_ex0 : ⊦ A x ❘ = proof  bwd (tmp2 impE tmp0) ❙

        // bwd_ex1 : ⊦ A x ⇒ A x ❘ = proof  assume h ;  bwd (tmp2 impE tmp0) ❙

       // bwd_ex2 : ⊦ A x ⇒ A x ❘= proof assume h ; bwd tmp  ; use tmp1 ; bwd (tmp2 impE tmp0) ❙

   //     theorem_test = theoremLF (⊦  A x ⇒ A x) (proof assume h ; use h ) ❙

    ❚

//   bla = [T A] (simple_ex )❙

//    bwd_ex4 : {T  : tp , A : tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
    ❘ = [T , A] proof fix x ; assume h ; addh hh ((simple_ex T A) forallE x) ; pps   ❙


//    addh_ex : {T : tp , A : tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
    ❘ = [T , A] proof addh hh simple_ex  ; use (hh T A)❙

//    subgoal_ex : {T : tp , A : tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
    ❘ = [T , A] proof fix x ; assume h ; subgoal thm (⊦ A x)  ; use h ; use thm ❙

//    addh_ex0 : {T : tp , A : tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x
    ❘ = [T , A] proof fix  x  ; addh hh ((simple_ex T A) forallE x)  ; pps  ❙

//    simple_ex_lf_tp : {T : tp , A : tm T ⟶ prop} ⊦ ∀ [x] A x ⇒ A x  ❘ = [T , A] holeBuild❙

 //       theorem_test = theoremLF ( {T : tp  , A : tm T ⟶ prop} ⊦ A x ⇒ A x) (proof assume h ; use h ) ❙



