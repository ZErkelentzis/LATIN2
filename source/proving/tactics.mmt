namespace latin:/❚

import proving scala://latin2/proving❚

theory Tactics  =
    include ?SFOLITP ❙

    void # void❙
    rule proving?VoidTactic ❙

    bwd # bwd 1❙
    rule proving?BwdTactic ❙

    pps # pps ❙
    rule proving?PrintProofStateTactic ❙

    ppsr # ppsr ❙
    rule proving?PrintProofStateRawTactic ❙

    ignore # ignore ❙
    rule proving?IgnoreTactic ❙

    subgoal # subgoal L1 2 ❙
    rule proving?SubgoalTactic ❙

    addh # addh L2 1 ❙
    rule proving?AddhTactic ❙

//    fwd # fwd L1 2%w… ❙
//    rule proving?FwdTactic ❙

//    build # build 1 ❙
//    rule proving?BuildTactic ❙

    holeBuild # holeBuild ❙
    rule proving?HoleIaT ❙

    theoremLF # theoremLF 1 2 ❙
    rule proving?theoremLFTactic ❙

    proofLF # proofLF 1 2;… ❙
    rule proving?CheckProofLF ❙


    fixLF # fixLF L1 ❙
    rule proving?FixLFTactic ❙
❚