namespace latin:/❚

fixmeta latin:/?SFOLEQND❚

import rules scala://lf.mmt.kwarc.info❚
import uom scala://uom.api.mmt.kwarc.info❚

theory Nat =
  nat   : tp❙
  Nat = tm nat❘# ℕ❙
  zero  : ℕ❙
  succ  : ℕ ⟶ ℕ❘ # s 1 prec 15❙
  
  even: ℕ ⟶ prop ❘ # even 1 prec 70❙
  uneven: ℕ ⟶ prop ❘ # uneven 1 prec 70❙
  
  rule rules?Realize ℕ uom?StandardNat❙
  rule rules?Realize zero uom?Arithmetic/Zero❙
  rule rules?Realize succ uom?Arithmetic/Succ❙
❚
  
theory NatPlus =
  include ?Nat❙
  plus : ℕ ⟶ ℕ ⟶ ℕ ❘ # 1 + 2 prec 50❙
  plus_zero : ⊦ ∀[n] n+zero ≐ n❙
  plus_succ : ⊦ ∀[m]∀[n] n+(succ m) ≐ succ(n+m)❙
  
  plus_zero_left: ⊦ ∀[n] zero+n ≐ n❘
               // = proof ommited❘
  ❙

  assoc : ⊦ ∀[l]∀[m]∀[n] (l+m)+n ≐ l+(m+n)❘
               // = proof ommited❘  
  ❙
  
  comm : ⊦ ∀[m]∀[n] m+n ≐ n+m❘
               // = proof ommited❘  
  ❙
❚

theory NatPlusTimes =
  include ?NatPlus❙
  times : ℕ ⟶ ℕ ⟶ ℕ ❘ # 1 * 2 prec 60❙
  times_zero : ⊦ ∀[n] n*zero ≐ zero❙
  times_succ : ⊦ ∀[m]∀[n] n*(succ m) ≐ n*m+n❙
  
  times_zero_left: ⊦ ∀[n] zero*n ≐ zero❘
               // = proof ommited❘
  ❙

  assoc : ⊦ ∀[l]∀[m]∀[n] (l*m)*n ≐ l*(m*n)❘
               // = proof ommited❘  
  ❙
  
  comm : ⊦ ∀[m]∀[n] m*n ≐ n*m❘
               // = proof ommited❘  
  ❙
❚

theory Int =
	include ?NatPlusTimes❙
	int   : tp❙
  Int = tm int❘# ℤ❙
  
  inclusion: ℕ ⟶ ℤ❘# int 1 prec 10❙
  isucc: ℤ ⟶ ℤ❘ # s 1 prec 15❙
  ipred: ℤ ⟶ ℤ❘ # p 1 prec 15❙
  ineg: ℤ ⟶ ℤ❘ # - 1 prec 15❙
  iplus: ℤ ⟶ ℤ ⟶ ℤ❘ # 1 + 2 prec 50❙
  itimes: ℤ ⟶ ℤ ⟶ ℤ❘ # 1 * 2 prec 60❙
  
  ieven: ℤ ⟶ prop ❘ # even 1 prec 70❙
  iuneven: ℤ ⟶ prop ❘ # uneven 1 prec 70❙
  
  // how do I actually include natural numbers and make them a unified theory? succ, pred? ❙ 
  
  rule rules?Realize ℤ uom?StandardInt❙
  rule rules?Realize zero uom?Arithmetic/Zero❙
  rule rules?Realize succ uom?Arithmetic/Succ❙
❚