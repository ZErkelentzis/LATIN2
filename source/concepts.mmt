namespace latin:/❚

fixmeta ur:?LF❚

theory Propositions =
  prop  : type❙
❚

theory Proofs =
  include ?Propositions❙
  ded   : prop ⟶ type❘# ⊦ 1  prec -5❘role Judgment❙
  
  contra : type❘= {a} ⊦ a❘# ↯❙
  contraE : contra ⟶ {a} ⊦ a❘= [p,a] p a❘# 1 contraE %I2❙
❚

theory Logic =
  include ?Propositions❙
  include ?Proofs❙
❚

theory Terms =
  term : type❙
❚

theory Types =
  tp: type❙
❚

theory Kinds =
  kd : type❙
❚

theory TypedTerms =
  include ?Types❙
  tm: tp ⟶ type❘# tm 1 prec -5❙
❚

theory SoftTypedTerms =
  include ?Terms❙
  include ?Types❙
  of : term ⟶ tp ⟶ type❘# 1 ∈ 2 prec 30❙
❚

theory KindedTypes =
  include ?Kinds❙
  tf : kd ⟶ type❘# tf 1 prec -5❙
  tpk : kd❙
  realize ?Types❙
  tp = tf tpk❙
❚

theory UntypedLogic =
  include ?Logic❙
  include ?Terms❙
❚

theory TypedLogic =
  include ?Logic❙
  include ?TypedTerms❙
❚

theory SoftTypedLogic =
  include ?SoftTypedTerms❙
  include ?UntypedLogic❙
  wff : prop ⟶ type❘# wff 1 prec -5❙
❚         

theory InternalPropositions =
  include ?TypedTerms❙
  bool: tp❙
  realize ?Propositions❙
  prop = tm bool❙
❚

theory InternalLogic =
  include ?InternalPropositions❙
  include ?Proofs❙
❚