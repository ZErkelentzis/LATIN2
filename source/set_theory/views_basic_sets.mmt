namespace latin:/❚

fixmeta ?SetFOL❚

// Views for EmptySet❚
theory EmptyUniversalComplement =
	include ?Complement❙
	include ?UniversalSet❙
	realize ?EmptySet❙
	
	empty = comp 𝒰❙
❚

view EmptyComprehension : ?EmptySet → ?Comprehension =	
	empty = X | ([x] ¬ x≐x)❙
❚

view EmptyFilter : ?EmptySet → ?Filter =
	// AS: this is basically the same as EmptyComprehension❙
	empty = filter X ([x] ¬ x≐x)❙
❚

theory EmptyIntersection =
	include ?Complement❙
	include ?Intersection❙
	realize ?EmptySet❙
	
	empty = X ∩ comp X❙
❚

theory EmptyBigIntersection =
	// AS: this is a mixture of EmptyIntersection and IntersectionAsBigIntersection.
			Therefore this seems pretty unnecessary.❙
	include ?BigIntersection❙
	include ?Complement❙
	include ?UnorderedPairs❙
	realize ?EmptySet❙
	
	empty = ⋂ (uopair X (comp X))❙
❚

view SelfDifference : ?EmptySet → ?Difference =
	empty = X∖X❙
❚

// Views for UniversalSet❚
theory UniversalEmptyComplement =
	include ?EmptySet❙
	include ?Complement❙
	realize ?UniversalSet❙
	
	universal = comp ∅❙
❚

view UniversalComprehension : ?UniversalSet → ?Comprehension =
	universal = X | ([x] x ≐ x)❙
❚

view UniversalFilter : ?UniversalSet → ?Filter =
	// AS: this is basically the same as UniversalComprehension❙
	universal = filter X ([x] x ≐ x)❙
❚

theory UniversalUnion =
	include ?Complement❙
	include ?Union❙
	realize ?UniversalSet❙
	
	universal = X ∪ comp X❙
❚

theory UniversalBigUnion =
	// AS: this is a mixture of UniversalUnion and UnionAsBigUnion.
			Therefore this seems pretty unnecessary.❙
	include ?BigUnion❙
	include ?Complement❙
	include ?UnorderedPairs❙
	realize ?UniversalSet❙
	
	universal = ⋃ (uopair X (comp X))❙
❚

// Views for Singleton❚
view SelfPair : ?Singletons → ?UnorderedPairs =
  singleton = [X] uopair X X❙
  singletonI = [X] uopairIl❙
  singletonE = [X,x,p] p uopairE ([q] q) ([q] q)❙
❚

view SingleComprehension : ?Singletons → ?Comprehension =
	singleton = [a] X | ([x] x ≐ a)❙
❚

view SingleFilter : ?Singletons → ?Filter =
	// AS: this is basically the same as SingleComprehension❙
	singleton = [a] filter X ([x] x ≐ a)❙
❚

theory SingleIntersection =
	// AS: since uopair would be enough to define singleton, this seems pretty unnecessary.❙
	include ?Complement❙
	include ?Intersection❙
	include ?UnorderedPairs❙
	realize ?Singletons❙
	
	singleton = [x] (uopair x Y) ∩ (uopair x (comp Y))❙
❚

theory SingleAdjoint =
	include ?Adjoint❙
	include ?EmptySet❙
	realize ?Singletons❙
	
	singleton = [x] adjoint ∅ x❙
❚

theory SingleComplement =
	include ?Complement❙
	include ?Erase❙
	include ?UniversalSet❙
	realize ?Singletons❙
	
	singleton = [x] comp (erase 𝒰 x)❙
❚

// Views for Uopairs❚
theory UopairUnion =
	include ?Singletons❙
	include ?Union❙
	realize ?UnorderedPairs❙
	
	uopair = [x,y] (singleton x) ∪ (singleton y)❙ 
❚

view UopairComprehension : ?UnorderedPairs → ?Comprehension =
	uopair = [a,b] X | ([x] x≐a ∨ x≐b)❙
❚

view UopairFilter : ?UnorderedPairs → ?Filter =
	// AS: this is basically the same as UopairComprehension❙
	uopair = [a,b] filter X ([x] x≐a ∨ x≐b)❙
❚

theory UopairAdjointSingleton =
	include ?Adjoint❙
	include ?Singletons❙
	realize ?UnorderedPairs❙
	
	uopair = [x,y] adjoint (singleton x) y❙
❚

theory UopairAdjointEmpty =
	// AS: this is basically the same as UopairAdjointSingleton❙
	include ?Adjoint❙
	include ?EmptySet❙
	realize ?UnorderedPairs❙
	
	uopair = [x,y] adjoint (adjoint ∅ x) y❙
❚

theory UopairComplement =
	include ?Complement❙
	include ?Erase❙
	include ?UniversalSet❙
	realize ?UnorderedPairs❙
	
	uopair = [x,y] comp (erase (erase 𝒰 x) y)❙
❚
