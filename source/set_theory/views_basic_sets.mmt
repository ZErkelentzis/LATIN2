namespace latin:/❚

fixmeta ?SetFOL❚

// Views for EmptySet❚
theory EmptyUniversalComplement =
	include ?Complement❙
	include ?UniversalSet❙
	realize ?EmptySet❙
	
	empty = comp 𝒰❙
❚

view EmptyFilter : ?EmptySet → ?Filter =	
	// AS: X could be any possible (nonempty) set❙
	empty = X | ([x] ¬ x≐x)❙
❚

theory EmptyIntersection =
	include ?Complement❙
	include ?Intersection❙
	realize ?EmptySet❙
	
	// AS: X could be any possible (nonempty) set❙
	empty = X ∩ comp X❙
❚

view SelfDifference : ?EmptySet → ?Difference =
	// AS: X could be any possible (nonempty) set❙
	empty = X∖X❙
❚

// Views for UniversalSet❚
theory UniversalEmptyComplement =
	include ?EmptySet❙
	include ?Complement❙
	realize ?UniversalSet❙
	
	universal = comp ∅❙
❚

theory UniversalUnion =
	include ?Complement❙
	include ?Union❙
	realize ?UniversalSet❙
	
	// AS: X could be any possible (nonempty) set❙
	universal = X ∪ comp X❙
❚

// Views for Singleton❚
view SelfPair : ?Singletons → ?UnorderedPairs =
  singleton = [A] uopair A A❙
  singletonI = [A] uopairIl❙
  singletonE = [A,x,p] p uopairE ([q] q) ([q] q)❙
❚

theory SingleFilter =
	include ?Filter❙
	include ?UniversalSet❙
	realize ?Singletons❙
	
	// AS: 𝒰 was just the safest solution here❙
	singleton = [A] 𝒰 | ([x] x ≐ A)❙
❚

theory SingleAdjoint =
	include ?Adjoint❙
	include ?EmptySet❙
	realize ?Singletons❙
	
	singleton = [A] adjoint ∅ A❙
❚

// Views for Uopairs❚
theory UopairUnion =
	include ?Singletons❙
	include ?Union❙
	realize ?UnorderedPairs❙
	
	uopair = [A,B] (singleton A) ∪ (singleton B)❙ 
❚

theory UopairFilter =
	include ?Filter❙
	include ?UniversalSet❙
	realize ?UnorderedPairs❙
	
	// AS: 𝒰 was just the safest solution here❙
	uopair = [A,B] 𝒰 | ([x] x≐A ∨ x≐B)❙
❚

theory UopairAdjointSingleton =
	include ?Adjoint❙
	include ?Singletons❙
	realize ?UnorderedPairs❙
	
	uopair = [A,B] adjoint (singleton A) B❙
❚
