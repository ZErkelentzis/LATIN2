namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚

theory TheRelation =
  include ?CartesianProduct❙
  include ?Filter❙
  
  // A specific relation on the sets A and B which fulfills some predicate P❙
  theRel: {A:set,B:set} (set ⟶ set ⟶ prop) ⟶ set❘
    = [A,B,P] (A ×ͧ B) | ([p] P (p₁ͧ) (p₂ͧ))❙
  inRel : set ⟶ set ⟶ set ⟶ prop❘
    = [R,a,b] (a,ͧb) ∈ R❙
    
  // helper function to check whether a set is a relation❙
  // AS: ∃ͧ[A,B,P] R =ͧ theRel A B P does not work since we are in FOL!❙
  isrel : set ⟶ prop❘
    = [R] ∃ͧ[A] ∃ͧ[B] R ⊆ A×ͧB❙
  // A special case where A and B are arguments. This is needed whenever A and B are given❙ 
  isrelAB : set ⟶ set ⟶ set ⟶ prop❘
    = [R,A,B] R ⊆ A×ͧB❙
  // helper function to make transformation easier❙
  relABrel : {R,A,B} ⊦ isrelAB R A B ⟶ ⊦ isrel R❘
    = [R,A,B,p] uexistsI A (uexistsI B p)❙
  
  // computation rule❙
  compRel : {A,B,P,a,b} ⊦ inRel (theRel A B P) a b ⇔ a∈A ∧ b∈B ∧ P a b❘
    = [A,B,P,a,b] equivI
      ([p] andI (andI (compL ucongP ([x] x∈A) ((p filterEl) prodEl)) 
      (compR ucongP ([x] x∈B) ((p filterEl) prodEr)))
      (compL ucongP ([x] P x b) (compR ucongP ([y] P ((a,ͧb)₁ͧ) y) (p filterEr))))
      ([q] filterI (prodI (q andEl andEl) (q andEl andEr)) 
      ((eq/sym compL) ucongP ([x] P x ((a,ͧb)₂ͧ)) 
      ((eq/sym compR) ucongP ([y] P a y) (q andEr))))❙
  
  // representation rule❙
  // AS: Probably I'll keep both variants❙
  reprRelAB : {A,B,R} ⊦ isrelAB R A B ⟶ ⊦ R =ͧ theRel A B ([x,y] inRel R x y)❘
    = [A,B,R,rr] extensionalityI ([x] equivI
      ([p] filterI (p subsetE rr)
      (repr (p subsetE rr prodE) ucongP ([y] y∈R) p))
      ([q] (eq/sym repr (q filterEl prodE)) ucongP ([y] y∈R) (q filterEr)))❙
      
  reprRel : {R} ⊦ isrel R ⟶ ⊦ ∃ͧ[A]∃ͧ[B] R =ͧ theRel A B ([x,y] inRel R x y)❘
    = [R,rr] rr uexistsE ([x,px] px uexistsE ([y,py] uexistsI x (uexistsI y (reprRelAB py))))❙
  
  // extensionality rule❙
  extRel : {R,S} ⊦ isrel R ⟶ ⊦ isrel S ⟶ ({x,y} ⊦ inRel R x y ⇔ inRel S x y) ⟶ ⊦ R =ͧ S❘
    = [R,S,rr,rs,Q] extensionalityI ([x] equivI
      ([p] rr uexistsE ([y,py] py uexistsE ([z,pz]
      (eq/sym repr (p subsetE pz prodE)) ucongP ([u] u∈S)
      (Q (x₁ͧ) (x₂ͧ) equivEl (repr (p subsetE pz prodE) ucongP ([u] u∈R) p)))))
      ([q] rs uexistsE ([y,qy] qy uexistsE ([z,qz]
      (eq/sym repr (q subsetE qz prodE)) ucongP ([u] u∈R)
      (Q (x₁ͧ) (x₂ͧ) equivEr (repr (q subsetE qz prodE) ucongP ([u] u∈S) q))))))❙
❚

theory Relations =
  include ?TheRelation❙

  include ?Powersets❙
  // A single relation is a subset of the CartesianProduct.
    The set of all relations is the powerset of the CartesianProduct❙
  // The set of all relations of A and B❙
  rel : set ⟶ set ⟶ set❘
    = [A,B] ℘ (A ×ͧ B)❙
  
  // introduction and elimination rule for the set of all relations of A and B❙
  relI : {A,B,P} ⊦ theRel A B P ∈ rel A B❘# relI 3❘
    = [A,B,P] vpowersetI filter_sub❙
  
  relE : {A,B,R} ⊦ R ∈ rel A B ⟶ ⊦ isrelAB R A B❘# 4 relE❘
    = [A,B,R,p] subsetI ([x,px] p powersetE px)❙
  
  rel_sub : {A,B,C,D} ⊦ A⊆C ⟶ ⊦ B⊆D ⟶ ⊦ rel A B ⊆ rel C D❘
    = [A,B,C,D,pa,pb] subsetI ([x,px] powersetI ([y,py] (px powersetE py)
      subsetE (prod_sub pa pb)))❙
❚

theory PartialFunctions =
  include ?Relations❙
  
  include ?RelationDefinitions❙
  // just a helper to specify isrightunique❙
  isrightu : set ⟶ prop❘
    = [R] isrightunique (inRel R)❙

  // The set of all partial functions of A and B. Partial functions are 
    relations that are right unique.❙
  pfunc : set ⟶ set ⟶ set❘
    = [A,B] rel A B | ([R] isrightu R)❙

  // AS: it's not necessary to define thePFunc and the rules. It is just
    a relation.❙

  // helper function to check whether a set is a right unique relation and
    therefore a partial function❙
  ispfunc : set ⟶ prop❘
    = [R] isrel R ∧ isrightu R❙
  // AS: special case, where A and B are given❙
  ispfuncAB : set ⟶ set ⟶ set ⟶ prop❘
    = [R,A,B] isrelAB R A B ∧ isrightu R❙
  
  // helper fuction for transformation❙
  pfuncABpfunc : {R,A,B} ⊦ ispfuncAB R A B ⟶ ⊦ ispfunc R❘
    = [R,A,B,p] andI (relABrel (p andEl)) (p andEr)❙

  // introduction and elimination rule for the set of all partial functions of X and Y❙
  pfuncI : {A,B,P} ⊦ ispfunc (theRel A B P) ⟶ ⊦ theRel A B P ∈ pfunc A B❘# pfuncI 3 4❘
    = [A,B,P,p] filterI (relI P) (p andEr)❙
    
  pfuncE : {A,B,F} ⊦ F ∈ pfunc A B ⟶ ⊦ ispfuncAB F A B❘# 4 pfuncE❘
    = [A,B,F,p] andI (p filterEl relE) (p filterEr)❙
❚

theory Functions =
  // AS: This is realized with Partial Functions, but it could be done with
    only Relations as well (if isrightunique gets included as well)❙
  include ?PartialFunctions❙
  
  // just a helper to specify islefttotal❙
  isleftt : set ⟶ set ⟶ prop❘
    = [F,A] islefttotal ([x,y] (x,ͧy)∈F) A❙

  // The set of all functions of X and Y. Functions are partial functions that
   are left total.❙
  func : set ⟶ set ⟶ set❘
    = [A,B] pfunc A B | ([F] isleftt F A)❙

  // AS: it's not necessary to define theFunc and the rules. It is just
    a relation.❙

  // helper function to check whether a set is a left total partial function
    and therefore a function❙
  isfunc : set ⟶ prop❘
    = [F] ∃ͧ[A]∃ͧ[B] ispfuncAB F A B ∧ isleftt F A❙
  // special case❙
  isfuncAB : set ⟶ set ⟶ set ⟶ prop❘
    = [F,A,B] ispfuncAB F A B ∧ isleftt F A❙
    
  // helper function for transformation❙
  funcABfunc : {F,A,B} ⊦ isfuncAB F A B ⟶ ⊦ isfunc F❘
    = [F,A,B,p] uexistsI A (uexistsI B p)❙  

  // introduction and elimination rule for the set of all functions of X and Y❙
  // AS: I haven't found a way to do this with isfunc by now. Main problem is
    that after doing existsE I only have islefttotal F x and not islefttotal F A❙
  funcI : {A,B,P} ⊦ isfuncAB (theRel A B P) A B ⟶ ⊦ theRel A B P ∈ func A B❘# funcI 3 4❘
    = [A,B,P,p] filterI (pfuncI P (pfuncABpfunc (p andEl))) (p andEr)❙
  funcE : {A,B,F} ⊦ F ∈ func A B ⟶ ⊦ isfuncAB F A B❘# 4 funcE❘
    = [A,B,F,p] andI (p filterEl pfuncE) (p filterEr)❙
❚
