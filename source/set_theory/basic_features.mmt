namespace latin:/❚

fixmeta ?SetFOL❚

theory Powersets =
  // symbol: jpow❙
  powerset : set ⟶ set❘# ℘ 1 prec 60❙
  powersetI : {A,B} ({x} ⊦ x∈B ⟶ ⊦ x∈A) ⟶ ⊦ B∈ ℘A❙
  powersetE : {A,B} ⊦ B∈ ℘A ⟶ {x} ⊦ x∈B ⟶ ⊦ x∈A❘# 3 powersetE 5❙
❚

theory Image =
  // image f A = {f(x) : x∈A}❙
  // AS: think of a shorter notation❙
  image : (set ⟶ set) ⟶ set ⟶ set❙
  imageI : {f,A,x} ⊦ x∈A ⟶ ⊦ (f x)∈ image f A❙
  imageE : {f,A,y} ⊦ y ∈ image f A ⟶ ⊦ ∃ͧ[x] x∈A ∧ f x =ͧ y❘# 4 imageE❙
❚

theory Filter =
  filter  : set ⟶ (set ⟶ prop) ⟶ set❘# 1 | 2 prec 40❙
  filterI : {A,P,x} ⊦ x∈A ⟶ ⊦ P x ⟶ ⊦ x ∈ A|P❙
  filterEl : {A,P,x} ⊦ x ∈ A|P ⟶ ⊦ x∈A❘# 4 filterEl❙
  filterEr : {A,P,x} ⊦ x ∈ A|P ⟶ ⊦ P x❘# 4 filterEr❙
  
  filter_sub : {A,P} ⊦ A|P ⪽ A❘
    = [A,P] subsetI ([x,p] p filterEl)❙
❚

theory Replace =
  include ?FunctionDefinitions❙
  // AS: is 1 map 2 really right?❙
  replace  : {A:set, f:set ⟶ set} ⊦ isfunction (fun2rel f) A ⟶ set❙
  replaceI : {A,f,x} ⊦ x∈A ⟶ ⊦ (f x) ∈ replace A f isfun_fun2rel❙
  replaceE : {A,f,y,C} ⊦ y ∈ replace A f isfun_fun2rel ⟶ ({x} ⊦ x∈A ⟶ ⊦ f x =ͧ y ⟶ ⊦C) ⟶ ⊦C❘ # 5 replaceE 6❙
❚

