namespace latin:/❚

fixmeta ?SetFOL❚

theory KuratowskiPairs =
	// (a,b) = {{a}, {a, b}}❙
	include ?SingletonDefinition❙
	include ?Singletons❙
	include ?UnorderedPairDefinition❙
	include ?UnorderedPairs❙
	include ?BigIntersection❙
	include ?BigUnion❙
	include ?Difference❙
	
	realize ?OrderedPairs❙
	pair = [A,B] uopair (singleton A) (uopair A B)❙
	pi1 = [p] singleton_inv (⋂p)❙
	pi2 = [p] singleton_inv ((⋃p)∖(⋂p))❙
	
	ispair = [p] ∃¹[A] ∃¹[B] isuopair (singleton A) (uopair A B) p❙
	
	// computation rules❙
	// compL: {A,B} ⊦ singleton_inv (⋂ (uopair (singleton A) (uopair A B))) ≐ A❙
❚

theory WienerPairs =
	// (a,b) = {{{a},∅},{{b}}}❙
	include ?EmptySet❙
	include ?Singletons❙
	include ?UnorderedPairs❙
	
	realize ?OrderedPairs❙
	pair = [A,B] uopair (uopair (singleton A) ∅) (singleton (singleton B))❙
❚
