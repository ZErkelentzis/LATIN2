namespace latin:/❚

fixmeta ?SetFOL❚

theory BasicsZF =
	include ?ZFTyped❙
	// AS: Without these includes the realization is not total. However, they should
		be unnecessary, since Propositions and Proofs are already in SetFOL!❙
	include ?Propositions❙
	include ?Proofs❙

	realize ?Types❙
	tp = set❙
	realize ?TypedTerms❙
	tm = [A] Elem A❙
	realize ?TypedLogic❙
	realize ?TypedEquality❙
  equal = Eq❙
  realize ?TypedEqualityND❙
  refl = [A,e: Elem A] Refl❙
  congB = _❙
❚

theory TypedUniversalZF =
	// AS: same as in BasicsZF❙
	include ?Propositions❙
	include ?Proofs❙
	include ?BasicsZF❙
	
	// dependent implication needed❙
	include ?DependentImplication❙
	include ?DependentImplicationND❙
	
	realize ?TypedUniversalQuantificationND❙
	
	tforall = [A,P: Elem A ⟶ prop] forall [x] (x∈A) ⇒- ([p] P (elem x p))❙
	tforallI = [A,P,p] forallI [x] dimplI ([q] p (elem x q))❙
	tforallE = [A,P,p,e: Elem A] elem_id EqcongEl P ((p forallE (which e)) dimplE (why e))❙
❚

theory TypedExistentialZF =
	// AS: same as in BasicsZF❙
	include ?Propositions❙
	include ?Proofs❙
	include ?BasicsZF❙
	
	// dependent conjunction needed❙
	include ?DependentConjunction❙
	include ?DependentConjunctionND❙
	
	realize ?TypedExistentialQuantificationND❙
	
	texists = [A,P: Elem A ⟶ prop] exists [x] (x∈A) ∧- ([p] P (elem x p))❙
	texistsI = [A,P: Elem A ⟶ prop,e: Elem A,p] existsI (which e) (dandI (why e) (elem_id EqcongEr P p))❙
	textistsE = [A,P,C,p,Q:({e:Elem A} ⊦ P e ⟶ ⊦ C)] p existsE ([x,px: (x∈A) ∧- ([pa: ⊦ x∈A] P (elem x pa))] Q (elem x (px dandEl)) (px dandEr))❙
❚

theory SimpleProductsZF =
	// AS: same as in BasicsZF❙
	include ?Propositions❙
	include ?Proofs❙
  include ?BasicsZF❙
	
  include ?CartesianProduct❙
  
	realize ?SimpleProducts❙
	include ?Logic❙
	simpprod = [A,B] prod A B❙
	
	simppair = [A,B,a: Elem A,b: Elem B] elem (pair (which a) (which b)) (prodI (why a) (why b))❙
	simppi1 = [A,B,e: Elem (prod A B)] elem ((which e)₁) ((why e) prodEl)❙
	simppi2 = [A,B,e: Elem (prod A B)] elem ((which e)₂) ((why e) prodEr)❙
	
	// AS: this needs to be done❙
	compute1 = [A,B,a: Elem A, b: Elem B] _❙
	compute2 = [A,B,a: Elem A, b: Elem B] _❙
❚

theory TypedPredicateSubtypesZF =
	// AS: same as in BasicsZF❙
	include ?Propositions❙
	include ?Proofs❙
  include ?BasicsZF❙
  
  include ?Filter❙
  
	// dependent conjunction needed❙
	include ?DependentConjunction❙
	include ?DependentConjunctionND❙
  
  realize ?TypedPredicateSubtypes❙
  
  predsub = [A,P: Elem A ⟶ prop] filter A ([x] x∈A ∧- ([p] P (elem x p)))❙
  predsubI = [A,P,e: Elem A,p] elem (which e) filterI (why e) (dandI (why e) (elem_id EqcongEr P p))❙
  predsubEl = [A,P,e] elem (which e) ((why e) filterEl)❙
  // AS: check this again❙
  predsubEr = [A,P,e] (why e) filterEr dandEr❙
❚

theory PowerTypesZF =
	// AS: same as in BascicsZF❙
	include ?Propositions❙
	include ?Proofs❙
	include ?BasicsZF❙
	
	include ?Powersets❙
	include ?Filter❙
	include ?UniversalSet❙
	
	realize powertypes/?PowerTypes❙
	power = [A] powerset A❙
	in = [A,a: Elem A,b: Elem powerset A] (which a) ∈ (which b)❙
	filter = [A,P: Elem A ⟶ prop] filter 𝒰 _❙
❚

