namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚

theory BasicsZF =
  include ?TypedZFFeatures❙
  // AS: Without these includes the realization is not total. However, they should
    be unnecessary, since Propositions and Proofs are already in fixmeta!❙
  include ?Propositions❙
  include ?Proofs❙

  realize ?Types❙
  tp = set❙
  realize ?TypedTerms❙
  tm = [A] Elem A❙
  realize ?TypedLogic❙
  realize ?TypedEquality❙
  tequal = Eq❙
  realize ?TypedEqualityND❙
  trefl = [A,e: Elem A] Refl❙
  tcongB = EqcongB❙
❚

theory TypedUniversalZF =
  // AS: same as in BasicsZF❙
  include ?Propositions❙
  include ?Proofs❙
  include ?BasicsZF❙
  
  realize ?TypedUniversalQuantificationND❙
  
  tforall = [A,P: Elem A ⟶ prop] uforall [x] (x∈A) ⇒ͩ ([p] P (elem x p))❙
  tforallI = [A,P,p] uforallI [x] dimplI ([q] p (elem x q))❙
  tforallE = [A,P,p,e: Elem A] elem_id EqcongEl P ((p uforallE (which e)) dimplE (why e))❙
❚

theory TypedExistentialZF =
  // AS: same as in BasicsZF❙
  include ?Propositions❙
  include ?Proofs❙
  include ?BasicsZF❙
	
  realize ?TypedExistentialQuantificationND❙
  
  texists = [A,P: Elem A ⟶ prop] uexists [x] (x∈A) ∧ͩ ([p] P (elem x p))❙
  texistsI = [A,P: Elem A ⟶ prop,e: Elem A,p] uexistsI (which e) (dandI (why e) (elem_id EqcongEr P p))❙
  texistsE = [A,P,C,p,Q] p uexistsE ([x,px] Q (elem x (px dandEl)) (px dandEr))❙
❚

theory SimpleProductsZF =
  // AS: same as in BasicsZF❙
  include ?Propositions❙
  include ?Proofs❙
  include ?BasicsZF❙
 
  realize ?SimpleProducts❙
  include ?Logic❙
  simpprod = [A,B] prod A B❙

  simppair = [A,B,a: Elem A,b: Elem B] elem (which a,ͧwhich b) (prodI (why a) (why b))❙
  simppi1 = [A,B,e: Elem (A×ͧB)] elem ((which e)₁ͧ) ((why e) prodEl)❙
  simppi2 = [A,B,e: Elem (A×ͧB)] elem ((which e)₂ͧ) ((why e) prodEr)❙
	
  // AS: pretty annoying proof since I need the special form of simppi1 (simppair a b)❙
  compute1 = [A,B,a: Elem A,b: Elem B] ((eq_which (prodI (why a) (why b)))
    ucongP ([x] which (elem ((which (elem (which a,ͧwhich b) (prodI (why a) (why b))))₁ͧ)
    ((why elem (which a,ͧwhich b) (prodI (why a) (why b))) prodEl)) =ͧ (x₁ͧ))
    (eq_which (why (elem (which a,ͧwhich b) (prodI (why a) (why b))) prodEl))) eq/trans compL❙
    
  compute2 = [A,B,a: Elem A,b: Elem B] ((eq_which (prodI (why a) (why b)))
    ucongP ([x] which (elem ((which (elem (which a,ͧwhich b) (prodI (why a) (why b))))₂ͧ)
    ((why elem (which a,ͧwhich b) (prodI (why a) (why b))) prodEr)) =ͧ (x₂ͧ))
    (eq_which (why (elem (which a,ͧwhich b) (prodI (why a) (why b))) prodEr))) eq/trans compR❙
❚

theory TypedPredicateSubtypesZF =
  // AS: same as in BasicsZF❙
  include ?Propositions❙
  include ?Proofs❙
  include ?BasicsZF❙

  realize ?TypedPredicateSubtypes❙
  
  predsub = [A,P: Elem A ⟶ prop] filter A ([x] x∈A ∧ͩ ([p] P (elem x p)))❙
  predsubI = [A,P,e: Elem A,p] elem (which e) filterI (why e) (dandI (why e) (elem_id EqcongEr P p))❙
  predsubEl = [A,P,e] elem (which e) ((why e) filterEl)❙
  predsubEr = [A,P,e] (why e) filterEr dandEr❙
  
  predsubElBeta = [A,P,a: Elem A,p: ⊦ P a] (eq_which ((why (elem (which a) 
    filterI (why a) (dandI (why a) (elem_id EqcongEr P p)))) filterEl)) eq/trans
    (eq_which (filterI (why a) (dandI (why a) (elem_id EqcongEr P p))))❙
❚

theory SimpleFunctionsZF =
  // AS: same as in BasicsZF❙
  include ?Propositions❙
  include ?Proofs❙
  include ?BasicsZF❙
  
  realize ?SimpleFunctions❙
  
  simpfun = func❙
  
  // AS: I lack the proofs of ⊦ a∈A and ⊦ b∈B❙
  // simplambda = [A,B,F: Elem A ⟶ Elem B] elem (theRel A B ([a,b] ))
    (funcI (andI ))❙
❚

theory PowerTypesZF =
  // AS: Not quite sure if this makes sense at all❙
  // AS: same as in BascicsZF❙
  include ?Propositions❙
  include ?Proofs❙
  include ?BasicsZF❙

  // AS: EquivalenceND should not have to be realized since it is already in SetFOL❙

  realize powertypes/?PowerTypes❙

  power = [A] powerset A❙
  in = [A,a: Elem A,b: Elem powerset A] (which a) ∈ (which b)❙
  filter = [A,P: Elem A ⟶ prop] elem ❙

  // compute = [A,P,a: Elem A] ❙
❚
