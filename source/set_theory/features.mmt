namespace latin:/❚

fixmeta ?SetFOL❚

theory OrderedPairs =
	// AS: think of a notation❙
	// (x,y)❙
	pair : set ⟶ set ⟶ set❘# pair 1 2 prec 40❙
	// first projection of a pair❙
	pi1 : set ⟶ set❘# 1 ₁ prec 35❙
	pi2 : set ⟶ set❘# 1 ₂ prec 35❙
	
	ispair : set ⟶ prop❙
	
	// computation rules❙
	// (x,y)_1 = x❙
	compL : {x,y} ⊦ (pair x y)₁ ≐ x❙
	compR : {x,y} ⊦ (pair x y)₂ ≐ y❙
	
	// representation rule❙
	repr : {p} ⊦ ispair p ⟶ ⊦ p ≐ pair (p₁) (p₂)❙
	
	// extensionality rule❙
	ext : {p,q} ⊦ ispair p ⟶ ⊦ ispair q ⟶ ⊦ p₁ ≐ q₁ ⟶ ⊦ p₂ ≐ q₂ ⟶ ⊦ p ≐ q❙
❚

theory CartesianProduct =
	include ?OrderedPairs❙
	
	// AS: maybe change prec❙
	// X × Y❙
	// symbol: jtimes❙
	prod : set ⟶ set ⟶ set❘# 1 × 2 prec 40❙
	
	// introduction and elimination rules❙
	prodI : {X,Y,x,y} ⊦ x∈X ⟶ ⊦ y∈Y ⟶ ⊦ pair x y ∈ X×Y❙
 	prodEl : {X,Y,Z} ⊦ Z ∈ X×Y ⟶ ⊦ Z₁∈X❙
	prodEr : {X,Y,Z} ⊦ Z ∈ X×Y ⟶ ⊦ Z₂∈Y❙
❚

theory Relations =
	// AS: maybe include CartesianProduct. A single relation is a subset of the CartesianProduct.
		The set of all relations is a subset (?) of the powerset of the CartesianProduct❙
	// The set of all relations of X and Y❙
	rel : set ⟶ set ⟶ set❙
	
	// A single relation on the sets X and Y which fulfills some predicate P❙
  theRel: {X:set,Y:set} (set ⟶ set ⟶ prop) ⟶ set❙
  inRel : set ⟶ set ⟶ set ⟶ prop❙
  
  // helper function to check whether a set is a relation❙
  isrel : set ⟶ prop❙
  
  // computation rule❙
  comp : {X,Y,P,x,y} ⊦ inRel (theRel X Y P) x y ⇔ x∈X ∧ y∈Y ∧ P x y❙
  
	// representation rule❙
  repr : {X,Y,R} ⊦ isrel R ⟶ ⊦ R ≐ theRel X Y ([x,y] inRel R x y)❙ 
  
  // extensionality rule❙
  ext : {R,S} ⊦ isrel R ⟶ ⊦ isrel S ⟶ ({x,y} ⊦ inRel R x y ⇔ inRel S x y) ⟶ ⊦ R≐S❙
  
  // introduction rule for the set of all relations of X and Y❙
  relI : {X,Y,P} ⊦ theRel X Y P ∈ rel X Y❙
❚

theory PartialFunctions =
	// AS: maybe include Relations here as well.
		Pro: makes it clear that a partial function is a right-unique relation
		Con: it might create more work. I need to think about this a bit longer.❙
	include ?RightUnique❙

	// The set of all partial functions of X and Y❙
	pfunc : set ⟶ set ⟶ set❙
	
	// A single partial function on the sets X and Y which fulfills some predicate P❙
	thePFunc : {X:set,Y:set} (set ⟶ set ⟶ prop) ⟶ set❙
	inPFunc : set ⟶ set ⟶ set ⟶ prop❙
	
	// AS: the definition might need to take care of right-unique as well❙
	ispfunc : set ⟶ prop❙
	
	// computation rule❙
	comp : {X,Y,P,x,y} ⊦ inPFunc (thePFunc X Y P) x y ⇔ x∈X ∧ y∈Y ∧ P x y ∧ isrightunique x Y P❙ 
	
	// representation rule❙
	repr : {X,Y,R} ⊦ ispfunc R ⟶ ⊦ R ≐ thePFunc X Y ([x,y] inPFunc R x y)❙
	
	// extensionality rule❙
	ext : {R,S} ⊦ ispfunc R ⟶ ⊦ ispfunc S ⟶ ({x,y} ⊦ inPFunc R x y ⇔ inPFunc S x y) ⟶ ⊦ R≐S❙
	
	// introduction rule for the set of all partial functions of X and Y❙
	pfuncI : {X,Y,P} ⊦ thePFunc X Y P ∈ pfunc X Y❙
❚

theory Functions =
	// AS: maybe include PartialFunctions here as well.
	Pro: makes it clear that a function is a left-total partial function
	Con: it might create more work. I need to think about this a bit longer.❙
	include ?RightUnique❙
	include ?LeftTotal❙
	
	// The set of all functions of X and Y❙
	func : set ⟶ set ⟶ set❙
	
	// A single function on the sets X and Y which fulfills some predicate P❙
	theFunc : {X:set,Y:set} (set ⟶ set ⟶ prop) ⟶ set❙
	inFunc : set ⟶ set ⟶ set ⟶ prop❙
	
	// AS: the definition might need to take care of left-total and right-unique as well❙
	isFunc : set ⟶ prop❙
	
	// computation rule❙
	// AS: I'm not sure whether left-total and right-unique fit here❙
	comp : {X,Y,P,x,y} ⊦ inFunc (theFunc X Y P) x y ⇔ x∈X ∧ y∈Y ∧ P x y ∧ isrightunique x Y P ∧ islefttotal X Y P❙ 
	
	// representation rule❙
	repr : {X,Y,R} ⊦ isFunc R ⟶ ⊦ R ≐ theFunc X Y ([x,y] inFunc R x y)❙
	
	// extensionality rule❙
	ext : {R,S} ⊦ isFunc R ⟶ ⊦ isFunc S ⟶ ({x,y} ⊦ inFunc R x y ⇔ inFunc S x y) ⟶ ⊦ R≐S❙
	
	// introduction rule for the set of all functions of X and Y❙
	funcI : {X,Y,P} ⊦ theFunc X Y P ∈ func X Y❙
❚
