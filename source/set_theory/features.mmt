namespace latin:/❚

fixmeta ?SetFOL❚

theory EmptySet =
  isempty : set ⟶ prop❘= [x] ¬ ∃[y] y ∈ x❙
  empty : set❘# ∅❙
  empty_prop : ⊦ isempty ∅❙
  emptyE : {x} ⊦ x∈∅ ⟶ ↯❘ = [x,p] empty_prop notE (existsI x p)❙
❚

theory UnorderedPairs =
  uopair : set ⟶ set ⟶ set❙
  uopairIL : {X,Xˈ} ⊦ X ∈ uopair X Xˈ❙
  uopairIR : {X,Xˈ} ⊦ Xˈ ∈ uopair X Xˈ❙
  uopairE  : {U,X,Xˈ} ⊦ U ∈ uopair X Xˈ ⟶ ⊦ U≐X ∨ U≐Xˈ❙
❚

theory Singletons =
  singleton : set ⟶ set❙
  singletonI : {x} ⊦ x ∈ singleton x❙
  singletonE : {x,u} ⊦ u ∈ singleton x ⟶ ⊦ u≐x❙
  
  is_singleton : set ⟶ prop❘= [x] ∃¹[u]u∈x❙
  singleton_the : {x} ⊦ is_singleton x ⟶ set❘= [x,p] the ([u] u ∈ x) p❙
❚

view SelfPair : ?Singletons → ?UnorderedPairs =
  singleton = [x] uopair x x❙
  singletonI = [x] uopairIL❙
  singletonE = [x,u,p] uopairE p orE ([q] q) ([q] q)❙
❚

theory Extensionality =
	is_extensional = [x,y]∀[z] (z∈x ⇔ z∈y) ⇒ x≐y❙
	extensionality_axiom : {x,y} ⊦ is_extensional x y❙
❚

theory Regularity =	
	// FR: only axiom here, no constant; can be a feature a that ZFC includes❙ 
	regularity_axiom : ⊦ ∀[x](∃[t] t∈x) ⇒ ∃[y] y∈x ∧ ¬(∃[z] z∈x ∧ z∈y)❙
❚

theory Comprehension =
  comprehend  : set ⟶ (set ⟶ prop) ⟶ set❘# 1 | 2 prec 40❙
  comprehendI : {A,P,X} ⊦ X∈A ⟶ ⊦ P X ⟶ ⊦ X ∈ A|P❙
  comprehend_sub : {A,P,X} ⊦ X ∈ A|P ⟶ ⊦ X∈A❙
  comprehendE : {A,P,X} ⊦ X ∈ A|P ⟶ ⊦ P X❙
❚

theory Replacement =
  replace  : set ⟶ (set ⟶ set) ⟶ set❘ # 1 map 2 prec 40❙
  replaceI : {A,F,X} ⊦ X∈A ⟶ ⊦ (F X) ∈ A map F❙
  replaceE : {A,F,X,C} ⊦ X ∈ A map F ⟶ ({x} ⊦x∈A ⟶ ⊦(F x) ≐ X ⟶ ⊦C) ⟶ ⊦C❙
❚

theory BigUnion =
  bigunion : set ⟶ set❘ # ⋃ 1❙
  bigunionI : {A,X,x} ⊦ x∈X ⟶ ⊦ X∈A ⟶ ⊦ x ∈ ⋃A❙
  bigunionE : {A,X,x,C} ⊦ x ∈ ⋃A ⟶ (⊦ X∈A ⟶ ⊦ x∈X ⟶ ⊦ C) ⟶ ⊦ C❙
❚

theory SmallUnion =
	union : set ⟶ set ⟶ set❘ # 1 ∪ 2 prec 50❙
	unionIL : {X,Y,x} ⊦ x∈X ⟶ ⊦ x∈X∪Y❙
	unionIR : {X,Y,y} ⊦ y∈Y ⟶ ⊦ y∈X∪Y❙
	unionE : {X,Y,x,C} ⊦ x∈X∪Y ⟶ (⊦x∈X ⟶ ⊦ C) ⟶ (⊦x∈Y ⟶ ⊦ C) ⟶ ⊦ C❙ 
❚

// FR additional features: Union, BigIntersection, Intersection❚
// no changes in zfc.mmt needed to realize those - 
instead we can state here already that, e.g., BigUnion and UnorderedPair are enough to realize SmallUnion;
we can do that with either a realize statement or a view
view is often better; realize A within B in those cases where anybody who includes B can be expected to want A as well
view also helpful when multiple features are needed, e.g., BigUnion and UnorderedPair
❚

// FR: not sure if any syntax like this already works
view SmallUnionAsBigUnion: ?SmallUnion → ?BigUnion, ?UnorderedPair =

❚
// if it doesn't we can use this as a fallback❚
theory SmallUnionAsBigUnion =
  include ?UnorderedPairs❙
  include ?BigUnion❙
  realize ?SmallUnion❙
  
  union = [X,Y] ⋃ (uopair X Y)❙
  unionIL = [X,Y,x,p] bigunionI (uopair X Y) X x p uopairIL❙
  unionIR = [X,Y,x,p] bigunionI (uopair X Y) Y x p uopairIR❙
  // unionE = _ ❙
❚

theory BigIntersection =
	biginter : set ⟶ set❘ # ⋂ 1❙
	biginterI : {A,X,x} (⊦ X∈A ⟶ ⊦ x∈X) ⟶ ⊦ x ∈ ⋂A❙
	biginterE : {A,X,x} ⊦ x ∈ ⋂A ⟶ ⊦ X∈A ⟶ ⊦ x∈X❙
❚

theory Intersection =
	inter : set ⟶ set ⟶ set❘ # 1 ∩ 2 prec 50❙
	interI : {X,Y,x} ⊦ x∈X ⟶ ⊦ x∈Y ⟶ ⊦ x∈X∩Y❙
	interEL : {X,Y,x} ⊦ x∈X∩Y ⟶ ⊦ x∈X❙
	interER : {X,Y,x} ⊦ x∈X∩Y ⟶ ⊦ x∈Y❙
❚

theory PowerSets =
  powerset : set ⟶ set❘# ℘ 1 prec 60❙
  powersetI : {X,A} ({u} ⊦u∈X ⟶ ⊦u∈A) ⟶ ⊦X∈℘ A❙
  powersetE : {X,A} ⊦X∈℘A ⟶ {u} ⊦u∈X ⟶ ⊦u∈A❙
❚

// FR: these two need some abbreviation just to state them; those can be here and then reused in the ZF theory that realizes them❚

// FR: maybe use inifity to define ℕ, either here or in ZFInfinity
somewhere we should then realize the theory of Peano axioms❚
theory Infinity =
	include ?EmptySet❙
	include ?Singletons❙
	include ?SmallUnion❙
	
	// like in the lecture❙
	infinity_axiom : ⊦ ∃[X] ∅∈X ∧ ∀[Y] Y∈X ⇒ (Y ∪ (singleton Y))∈X❙
❚

theory Choice =
	include ?EmptySet❙
	include ?Intersection❙
	include ?Singletons❙
	// AS: ZFTyped needs to be changed. Until it is changed, I cannot include Eq directly❙
	include ?ZFTyped❙
	// AS: define choice like in the lecture or shall Choice from FOL be used? ❙
	// like in KRMT❙
	is_choice = [X,C] ∀[x] x∈X ⇒ ∃¹[c]c∈C∧c∈x❙
  all_nonempty: set ⟶ prop❘ // = ❙
  pairwise_disjoint: set ⟶ prop❘ // = ❙
  choice_axiom : ⊦ ∀[X] (all_nonempty X ∧ pairwise_disjoint X) ⇒ ∃[C] is_choice X C❙
❚
