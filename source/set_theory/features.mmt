namespace latin:/❚

fixmeta ?SetFOL❚

// AS: maybe this should be a basic feature?❚
theory Singletons =
	include ?SingletonDefinition❙
  singleton : set ⟶ set❘# singleton 1 prec 100❙
  singleton_the : {X} ⊦ issingleton X ⟶ set❘ = [X,p] the ([x] x ∈ X) p❙
  singletonI : {X} ⊦ X ∈ singleton X❙
  singletonE : {X,x} ⊦ x ∈ singleton X ⟶ ⊦ x≐X❘# 3 singletonE❙
❚

theory OrderedPairs =
	include ?EmptySet❙
	include ?UnorderedPairs❙
	include ?Singletons❙
	// AS: similar to Wiener's (X,Y) = {{X}, {{Y},∅}};
			would it be better to have no definition here?❙
	// AS: think of a notation❙
	pair : set ⟶ set ⟶ set❘
		= [X,Y] uopair (singleton X) (uopair (singleton Y) ∅)❙

	pi1 : set ⟶ set❙
	pi2 : set ⟶ set❙
❚

theory CartesianProduct =
	include ?OrderedPairs❙
	// AS: maybe change prec❙
	prod : set ⟶ set ⟶ set❘# 1 × 2 prec 40❙
	prodI : {A,B,X,Y} ⊦ X∈A ⟶ ⊦ Y∈B ⟶ ⊦ pair X Y ∈ A×B❙
	prodEl : {A,B,Z} ⊦ Z ∈ A×B ⟶ ⊦ pi1 Z ∈ A❙
	prodEr : {A,B,Z} ⊦ Z ∈ A×B ⟶ ⊦ pi2 Z ∈ B❙
	
	prodEl2 : {A,B,X,Y} ⊦ pair X Y ∈ A×B ⟶ ⊦ X∈A❙
	prodEr2 : {A,B,X,Y} ⊦ pair X Y ∈ A×B ⟶ ⊦ Y∈B❙
❚

theory Relations =
	// AS: TODO❙
	rel : set ⟶ set ⟶ set❙
❚

theory PartialFunctions =
	// AS: TODO❙
	pfunc : set ⟶ set ⟶ set❙
❚

theory Functions =
	// AS: TODO❙
	func : set ⟶ set ⟶ set❙
❚