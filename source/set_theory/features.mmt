namespace latin:/❚

fixmeta ?SetFOL❚

// AS: maybe this should be a basic feature?❚
theory Singletons =
	include ?SingletonDefinition❙
  singleton : set ⟶ set❘# singleton 1 prec 100❙

  singleton_the : {X} ⊦ issingleton X ⟶ set❘ = [X,p] the ([x] x ∈ X) p❙
  singletonI : {X} ⊦ X ∈ singleton X❙
  singletonE : {X,x} ⊦ x ∈ singleton X ⟶ ⊦ x≐X❘# 3 singletonE❙
  
  // AS: this was used in KRMT;
  		however its definition was with Big_Union, which would ruin the modularity here❙
  singleton_inv : set ⟶ set❙
❚

theory OrderedPairs =
	// AS: think of a notation❙
	// (x,y)❙
	pair : set ⟶ set ⟶ set❘# pair 1 2 prec 40❙
	// first projection of a pair❙
	pi1 : set ⟶ set❘# 1 ₁ prec 35❙
	pi2 : set ⟶ set❘# 1 ₂ prec 35❙
	
	ispair : set ⟶ prop❙
	
	// computation rules❙
	// (x,y)_1 = x❙
	compL : {x,y} ⊦ (pair x y)₁ ≐ x❙
	compR : {x,y} ⊦ (pair x y)₂ ≐ y❙
	
	// representation rule❙
	repr : {p} ⊦ ispair p ⟶ ⊦ p ≐ pair (p₁) (p₂)❙
	
	// extensionality rule❙
	ext : {p,q} ⊦ ispair p ⟶ ⊦ ispair q ⟶ ⊦ p₁ ≐ q₁ ⟶ ⊦ p₂ ≐ q₂ ⟶ ⊦ p ≐ q❙
❚

theory CartesianProduct =
	// AS: maybe change prec❙
	// X × Y❙
	prod : set ⟶ set ⟶ set❘# 1 × 2 prec 40❙
	
	prodI : set ⟶ set ⟶ set❙
 	prodEl : set ⟶ set❙
	prodEr : set ⟶ set❙
	
	// AS: the definition needs to take care of having ordered pairs❙
	isprod : set ⟶ prop❙
	
	// computation rules❙
	compL : {X,Y} ⊦ prodEl (X × Y) ≐ X❙
	compR : {X,Y} ⊦ prodEr (X × Y) ≐ Y❙
	
	// representation rule❙
	repr : {p} ⊦ isprod p ⟶ ⊦ p ≐ (prodEl p) × (prodEr p)❙
	
	// extensionality rule❙
	ext : {p,q} ⊦ isprod p ⟶ ⊦ isprod q ⟶ ⊦ prodEl p ≐ prodEl q ⟶ ⊦ prodEr p ≐ prodEr q ⟶ ⊦ p ≐ q❙
❚

theory Relations =
  theRel: {X:set,Y:set} (set ⟶ set ⟶ prop) ⟶ set❙
  inRel : set ⟶ set ⟶ set ⟶ prop❙
  
  isrel : set ⟶ prop❙
  
  // computation rule❙
  comp : {X,Y,P,x,y} ⊦ inRel (theRel X Y P) x y ⇔ x∈X ∧ y∈Y ∧ P x y❙
  
	// representation rule❙
  repr : {X,Y,R} ⊦ isrel R ⟶ ⊦ R ≐ theRel X Y ([x,y] inRel R x y)❙ 
  
  // extensionality rule❙
  ext : {R,S} ⊦ isrel R ⟶ ⊦ isrel S ⟶ ({x,y} ⊦ inRel R x y ⇔ inRel S x y) ⟶ ⊦ R≐S❙
  
  rel : set ⟶ set ⟶ set❙
  relI : {X,Y,P} ⊦ theRel X Y P ∈ rel X Y❙
❚

theory PartialFunctions =
	// AS: a partial function is a relation "right uniqueness" ("Rechtseindeutigkeit")❙
	thePFunc : {X:set,Y:set} (set ⟶ set ⟶ prop) ⟶ set❙
	inPFunc : set ⟶ set ⟶ set ⟶ prop❙
	
	// AS: the definition needs to take care of the property❙
	ispfunc : set ⟶ prop❙
	
	// computation rule❙
	// AS: maybe the property should be checked here❙
	comp : {X,Y,P,x,y} ⊦ inPFunc (thePFunc X Y P) x y ⇔ x∈X ∧ y∈Y ∧ P x y❙ 
	
	// representation rule❙
	repr : {X,Y,R} ⊦ ispfunc R ⟶ ⊦ R ≐ thePFunc X Y ([x,y] inPFunc R x y)❙
	
	// extensionality rule❙
	ext : {R,S} ⊦ ispfunc R ⟶ ⊦ ispfunc S ⟶ ({x,y} ⊦ inPFunc R x y ⇔ inPFunc S x y) ⟶ ⊦ R≐S❙
	
	pfunc : set ⟶ set ⟶ set❙
	pfuncI : {X,Y,P} ⊦ thePFunc X Y P ∈ pfunc X Y❙
❚

theory Functions =
	// AS: a function is a partial function that is "left total" ("Linkstotal")❙
	theFunc : {X:set,Y:set} (set ⟶ set ⟶ prop) ⟶ set❙
	inFunc : set ⟶ set ⟶ set ⟶ prop❙
	
	// AS: the definition needs to take care of the property❙
	isFunc : set ⟶ prop❙
	
	// computation rule❙
	// AS: maybe the property should be checked here❙
	comp : {X,Y,P,x,y} ⊦ inFunc (theFunc X Y P) x y ⇔ x∈X ∧ y∈Y ∧ P x y❙ 
	
	// representation rule❙
	repr : {X,Y,R} ⊦ isFunc R ⟶ ⊦ R ≐ theFunc X Y ([x,y] inFunc R x y)❙
	
	// extensionality rule❙
	ext : {R,S} ⊦ isFunc R ⟶ ⊦ isFunc S ⟶ ({x,y} ⊦ inFunc R x y ⇔ inFunc S x y) ⟶ ⊦ R≐S❙
	
	func : set ⟶ set ⟶ set❙
	funcI : {X,Y,P} ⊦ theFunc X Y P ∈ func X Y❙
❚