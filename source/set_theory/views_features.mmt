namespace latin:/❚

fixmeta ?SetFOL❚

// AS: this file needs to be fixed as soon as I have reorganized modules❚

// FR additional features: Union, BigIntersection, Intersection❚
// no changes in zfc.mmt needed to realize those - 
instead we can state here already that, e.g., BigUnion and UnorderedPair are enough to realize SmallUnion;
we can do that with either a realize statement or a view
view is often better; realize A within B in those cases where anybody who includes B can be expected to want A as well
view also helpful when multiple features are needed, e.g., BigUnion and UnorderedPair
❚

// FR: not sure if any syntax like this already works → AS: no it does not
view SmallUnionAsBigUnion: ?SmallUnion → ?BigUnion, ?UnorderedPair =

❚
// if it doesn't we can use this as a fallback❚

// Views for Axioms❚
view BigUnionFromAxiom : ?BigUnion → ?UnionAx =
	bigunion = [A] the ([Z] isbigunion A Z) union_unique❙
	bigunionI = [A,X,x,p,q] unionAxI p q❙
	bigunionE = [A,x,C,p,q] (p unionAxE A) existsE ([X,P] q X (P andEl) (P andEr))❙
❚

view FilterFromAxiom : ?Filter → ?ComprehensionAx =
	filter = [A,P] the ([Z] iscomprehension A P Z) comprehension_unique❙
	// AS: it would be much simpler, if I could just use filter here❙
	filterI = [A,P,x,p,q] comprehensionAxI A P (the ([Z] iscomprehension A P Z) comprehension_unique) x p q❙
	filterEl = [A,P,x,p] p comprehensionAxEl❙
	filterEr = [A,P,x,p] p comprehensionAxEr P❙
❚

view PowersetFromAxiom : ?Powersets → ?PowersetAx =  
	powerset = [A] the ([Z] ispowerset A Z) powerset_unique❙
	powersetI = [A,B,P] powersetAxI ([x] implI (P x))❙
	powersetE = [A,B,p,x,q] (p powersetAxE x) implE q❙
❚

view ReplacementFromAxiom : ?Replacement → ?ReplacementAx =
	replace = [A,F] the ([Z] isreplacement A F Z) replacement_unique❙
	replaceI = [A,F,x,p] replacementAxI F p❙
	replaceE = [A,F,y,C,p,q] p replacementAxE A F q❙
❚

theory UopairFromAxiom =
	include ?ExtensionalityAx❙
 	include ?PairingAx❙
 	realize ?UnorderedPairs❙
 	
	uopair = [A,B] the ([Z] isuopair A B Z) pairing_unique❙
	uopairIl = [x,B] pairingAxI (orIl (x≐x) (x≐B) refl)❙
	uopairIr = [A,y] pairingAxI (orIr (y≐A) (y≐y) refl)❙
	uopairE = [A,B,x,C,p,pa,pb] (p pairingAxE A B) orE pa pb❙
	
	uopair_comm = [A,B] extensionalityI ([x] equivI ([pa] pairingAxI or_swap (pa pairingAxE A B)) 
			([pb] pairingAxI or_swap (pb pairingAxE B A)))❙
❚

// Views for Union❚
theory UnionAsBigUnion =
  include ?BigUnion❙
  include ?ExtensionalityAx❙
  include ?UnorderedPairs❙
  
  // AS: is there a possibility to get rid of include ?EmptySet and ?UniversalSet?❙
  include ?EmptySet❙
  include ?UniversalSet❙
  realize ?Union❙
  
  union = [A,B] ⋃ uopair A B❙
  unionIl = [A,B,x,p] bigunionI uopairIl p❙
  unionIr = [A,B,y,p] bigunionI uopairIr p❙
  unionE = [A,B,x,C,p,pa,pb] p bigunionE ([X,qa,qb] qa uopairE
    ([q] pa (in_eq qb q)) 
    ([q] pb (in_eq qb q)))❙
  
  // AS: These are not needed anymore❙
  // union_subl = [A,B] bigunion_sub uopairIl❙
  // union_subr = [A,B] bigunion_sub uopairIr❙
  // union_sup = [A,B,C,p,q] subtypeI ([x,r] r bigunionE 
  		([X,pa,pb] pa uopairE ([qa] p subtypeE in_eq pb qa) ([qb] q subtypeE in_eq pb qb)))❙
  
  // union_idem = [A] extensionalityI ([x] equivI ([p] p bigunionE ([X,pa,pb] pa uopairE 
  		([qa] in_eq pb qa) ([qb] in_eq pb qb))) ([q] bigunionI uopairIl q))❙
  // union_comm = [A,B] extensionalityI ([x] equivI 
  		([p] p bigunionE ([X,pa,pb] bigunionI (in_eq pa uopair_comm) pb))
  		([q] q bigunionE ([X,qa,qb] bigunionI (in_eq qa uopair_comm) qb)))❙
❚

theory UnionFilter =
	// AS: This might not be useful in practise❙
	include ?Filter❙
	include ?UniversalSet❙	
	
	// AS: is there a possibility to get rid of include ?EmptySet and ?UniversalSet?❙
  include ?EmptySet❙
  include ?UniversalSet❙  
	realize ?Union❙
	
	union = [A,B] 𝒰 | ([x] x∈A ∨ x∈B)❙
	unionIl = [A,B,x,p] filterI (universal_prop forallE x) (orIl (x∈A) (x∈B) p)❙
	unionIr = [A,B,y,p] filterI (universal_prop forallE y) (orIr (y∈A) (y∈B) p)❙
	unionE = [A,B,x,C,p,pa,pb] p filterEr orE ([qa] pa qa) ([qb] pb qb)❙
	
	// AS: These are not needed anymore❙
	// union_subl = [A,B] subtypeI ([x,p] filterI (universal_prop forallE x) (p orIl))❙
	// union_subr = [A,B] subtypeI ([x,p] filterI (universal_prop forallE x) (p orIr))❙
❚

// Views for Intersection❚
theory IntersectionAsBigIntersection = 
	include ?BigIntersection❙
	include ?UnorderedPairs❙
	
  // AS: is there a possibility to get rid of include ?EmptySet and ?UniversalSet?❙
  include ?EmptySet❙
  include ?UniversalSet❙
	realize ?Intersection❙
	
	inter = [A,B] ⋂ uopair A B❙
	interI = [A,B,x,pa,pb] biginterI (existsI A uopairIl) ([X,q] q uopairE 
	  ([qa] in_eq pa (eq/sym qa))
	  ([qb] in_eq pb (eq/sym qb)))❙	
	interEl = [A,B,x,p] p biginterE uopairIl❙
	interEr = [A,B,y,p] p biginterE uopairIr❙
❚

theory IntersectionFilter =
	include ?Filter❙
	include ?Union❙
	realize ?Intersection❙
	
	inter = [A,B] A∪B | ([x] x∈A ∧ x∈B)❙
	interI = [A,B,x,p,q] filterI (unionIl B p) (andI p q)❙
	interEl = [A,B,x,p] p filterEr andEl❙
	interEr = [A,B,y,p] p filterEr andEr❙
❚

// Views for BigIntersection❚
theory BigIntersectionFilter =
	include ?BigUnion❙
	// AS: is there a possibility to get rid of include ?EmptySetDefinitions?❙
	include ?EmptySetDefinitions❙
	include ?Filter❙
	realize ?BigIntersection❙
	
	biginter = [A] ⋃A|[x]∀[X] X∈A ⇒ x∈X❙
	biginterI = [A,x,ne,P] filterI (nonemptyE ne ([X,p] bigunionI p (P X p))) (forallI [X] implI P X)❙
	biginterE = [A,X,x,p,q] p filterEr forallE X implE q❙
❚


// Views for Difference❚
view DifFilter : ?Difference → ?Filter =
	dif = [A,B] A | ([x] ¬ x∈B)❙
	difI = [A,B,x,p,q] filterI p q❙
	difEl = [A,B,x,p] p filterEl❙
	difEr = [A,B,x,p] p filterEr❙
❚

// Views for Complement❚
theory ComplementFilter =
	include ?Filter❙
	include ?UniversalSet❙
	// AS: is there a possibility to get rid of these includes?❙
	include ?ExtensionalityAx❙
	include ?EmptySet❙
	include ?Union❙
	include ?Intersection❙
	realize ?Complement❙
	
	comp = [A] 𝒰 | ([x] ¬ x∈A)❙
	compI = [A,x,p] filterI (universal_prop forallE x) p❙
	compE = [A,x,p] p filterEr❙
❚

// Views for SymmetricDifference❚
theory SymUnion =
	include ?Difference❙
	include ?Union❙
	realize ?SymmetricDifference❙
	
	symdif = [A,B] (A∖B) ∪ (B∖A)❙
	symdifI = [A,B,x,p,q] unionIl (B∖A) (difI p q)❙
	symdifEl = [A,B,x,p,q] p unionE ([pa] pa difEr)
		([pb] notI ([pf] pb difEr notE q))❙
	symdifEr = [A,B,x,p,q] p unionE ([pa] pa difEl)
		([pb] q notE (pb difEl) inconE)❙
❚

theory SymDifference =
	// AS: this might not be needed since Intersection could be left out❙
	include ?Difference❙
	include ?Intersection❙
	include ?Union❙
	realize ?SymmetricDifference❙
	
	symdif = [A,B] (A∪B) ∖ (A∩B)❙
	symdifI = [A,B,x,p,q] difI (unionIl B p) (notI ([pf: ⊦ x∈A∩B] q notE (pf interEr)))❙
	symdifEl = [A,B,x,p,q] notI ([pf: ⊦ x∈B] (p difEr) notE (interI q pf))❙
	symdifEr = [A,B,x,p,q] p difEl unionE ([pa] pa) ([pb] q notE pb inconE)❙
❚

theory SymFilter =
	include ?Filter❙
	include ?Union❙
	realize ?SymmetricDifference❙
	
	symdif = [A,B] (A∪B) | ([x] (x∈A ∧ ¬ x∈B) ∨ (¬ x∈A ∧ x∈B))❙
	symdifI = [A,B,x,p,q] filterI (unionIl B p) ((andI p q) orIl)❙
	symdifEl = [A,B,x,p,q] p filterEr orE ([pa] pa andEr)
		([pb] notI ([pf] pb andEl notE q))❙
	symdifEr = [A,B,x,p,q] p filterEr orE ([pa] pa andEl)
		([pb] q notE (pb andEr) inconE)❙
❚

// Views for Adjoint❚
theory AdjointUnion =
	include ?Union❙
	include ?Singletons❙
	realize ?Adjoint❙
	
	adjoint = [A,b] A ∪ (singleton b)❙
	adjointIl = [A,b,x,p] unionIl (singleton b) p❙
	adjointIr = [A,b] unionIr A singletonI❙
	adjointE = [A,b,x,C,p,pa,pb] p unionE pa ([q] pb (q singletonE))❙
❚

// Views for Erase❚
view EraseFilter : ?Erase → ?Filter =
	erase = [A,b] A | ([x] ¬ x≐b)❙
	eraseI = [A,b,x,p,q] filterI p q❙
	eraseE = [A,b,x,p] andI (p filterEl) (p filterEr)❙
❚

theory EraseDifference =
	include ?Difference❙
	include ?Singletons❙
	realize ?Erase❙
	
	erase = [A,b] A∖(singleton b)❙
	eraseI = [A,b,x,p,q] difI p (notI ([pf] q notE (pf singletonE)))❙
	eraseE = [A,b,x,p] andI (p difEl) (notI ([pf] (p difEr) notE (eq_in pf singletonI)))❙
❚
