❚

// AS: I commented the definitions, cause it ruins the performance❚

// ZFBase now contains all standard axioms of ZF instead of just Extensionality
  and Existence.❚
theory ZFBase =
  include ?SetBase❙
  include ?PairingAx❙
  include ?UnionAx❙
  include ?PowersetAx❙
  include ?ComprehensionAx❙
  include ?ReplacementAx❙
  include ?RegularityAx❙
❚

theory ZF =
  include ?ZFBase❙
  
  include ?UnorderedPairs❙// = ?UopairFromAxiom❙
  include ?BigUnion❙// = ?BigUnionFromAxiom❙
  include ?Powersets❙// = ?PowersetFromAxiom❙
  include ?Filter❙// = ?FilterFromAxiom❙
  include ?Replace❙// = ?ReplaceFromAxiom❙
  
  // AS: maybe move this somewhere else; This could not be in regularity itself, since
    it is dependent on unordered pairs, so maybe make a view or something❙
  // special cases of regularity❙
  in_acyclic : {A,B} ⊦ A∈B ⟶ ⊦ B∈A ⟶ ⊦ ⊥❘
    = [A,B,p,q] regularity_axiom uforallE (uopair A B) implE (uexistsI A uopairIl)
      uexistsE ([Z,pz] pz andEl uopairE
      ([pa] (pz andEr) notE (uexistsI B (andI uopairIr (in_eq q (eq/sym pa)))) inconE)
      ([pb] (pz andEr) notE (uexistsI A (andI uopairIl (in_eq p (eq/sym pb)))) inconE))❙
  in_acyclic0 : {A} ⊦ A∈A ⟶ ⊦ ⊥❘
    = [A,p] in_acyclic p p❙
❚

// AS: maybe just add features to ZF directly❚
// ZF and features that can be built from ZF❚
theory ZFFeatures =
  include ?ZF❙

  // AS: There are many includes that I wish would not be necessary❙
  include ?ExistFilter❙
  include ?EmptySet❙// = ?EmptyExistFilter❙
  
  include ?BigUnionUnorderedPairs❙
  include ?Union❙// = ?UnionAsBigUnion❙
  include ?UnionEmpty❙
  
  include ?BigUnionFilterEmptyDefinition❙
  include ?BigIntersection❙// = ?BigIntersectionFilter❙
  
  include ?BigIntersectionUnorderedPairs❙
  include ?Intersection❙// = ?IntersectionAsBigIntersection❙
  include ?IntersectionEmpty❙
  
  include ?Difference❙// = ?DifFilter❙
  include ?DifferenceEmpty❙
  
  include ?Complement❙// = ?ComplementFilter❙
  include ?ComplementEmpty❙
  include ?ComplementUnion❙
  include ?ComplementIntersection❙
  
  include ?UnionDifference❙
  include ?SymmetricDifference❙// = ?SymUnion❙
  include ?SymmetricDifferenceEmpty❙

  include ?Singletons❙// = ?SelfPair❙
  
  include ?UnionSingleton❙
  include ?Adjoin❙// = ?AdjoinUnion❙
  
  include ?Remove❙// = ?RemoveFilter❙
  
  include ?Image❙// = ?ImageReplace❙ 
  
  // AS: pairs and so on. WienerPairs lead to errors❙
  // include ?WienerPairs❙
  
  include ?OrderedBigUnionImage❙
  // AS: This would lead to an error, if it was defined!❙
  include ?CartesianProduct❙// = ?CartImage❙
  include ?Sigma❙// = ?SigmaUnion❙
  
  // AS: functions already include relations and partial functions❙
  include ?Functions❙
❚

// FR: maybe this is not needed - can just be included from ZF-independent feature Choice❚
theory ZFChoice =
  // AS: either just include here oder like the rest❙
  include ?ZFBase❙
  include ?ChoiceAx❙
  // realize ?SetChoice❙
❚

theory ZFC = 
  include ?ZF❙
  include ?ZFChoice❙
❚

// AS: same as above❚
theory ZFChoiceFeatures =
  include ?ZFC❙
  include ?ZFFeatures❙
❚
