namespace latin:/❚

fixmeta ?SetFOL❚

// TODO:
	- TODOs in theories
	- check whether everything is right
	- maybe some theories need to be rewritten after changes in axioms
❚

theory ZFBase =
	// AS: should I use UniverseNonEmpty or ExistenceAx here?❙
  include ?UniverseNonEmpty❙
  include ?ExtensionalityAx❙
❚

theory ZFEmptySet =
  include ?ZFBase❙
  include ?EmptySetDefinitions❙
  realize ?EmptySet❙
  
  empty_unique : ⊦ ∃¹ isempty❘ // = ❙
  empty = the isempty empty_unique❙
  empty_prop = the_ax isempty empty_unique❙
  
  // realize empty_sub❙
❚

theory ZFPairing =
  include ?ZFBase❙
  include ?PairingAx❙
  
  realize ?UnorderedPairs❙
  
  uopair : set ⟶ set ⟶ set❘ # uopair 1 2❘
          = [X,Y] the ([M] isuopair X Y M) pairing_unique❙
  // AS: the introduction and elimination rules should be defined❙
  // uopairIL, uopairIR, uopairE❙ 
❚

theory ZFUnion =
  include ?ZFBase❙
  include ?UnionAx❙
	
	realize ?BigUnion❙
	
	bigunion : set ⟶ set❘# ⋃ 1❘
					= [M] the ([Z] isbigunion M Z) union_unique❙
	// AS: the introduction and elimination rules should be defined❙
  // bigunionI, bigunionE❙ 
❚

theory ZFPowerSet =
  include ?ZFBase❙
  include ?PowersetAx❙
  
	realize ?PowerSets❙
	
	powerset : set ⟶ set❘# ℘ 1 prec 60❘
					= [X] the ([M] ispowerset X M) powerset_unique❙
	// AS: the introduction and elimination rules should be defined❙
  // powersetI, powersetE❙ 
❚

theory ZFComprehension =
  include ?ZFBase❙
  include ?ComprehensionAx❙
	
	realize ?Comprehension❙
	
	comprehend  : set ⟶ (set ⟶ prop) ⟶ set❘# 1 | 2 prec 40❘
					= [X,P] the ([Z] iscomprehension X P Z) comprehension_unique❙
	// AS: the introduction and elimination rules should be defined❙
  // comprehendI, comprehend_sub, comprehendE❙ 
❚

theory ZFReplacement =
  include ?ZFBase❙
  include ?ReplacementAx❙
	
	realize ?Replacement❙
	
	replace  : set ⟶ (set ⟶ set) ⟶ set❘# 1 map 2 prec 40❘
					= [X,F] the ([Z] isreplacement X F Z) replacement_unique❙
	// AS: the introduction and elimination rules should be defined❙
  // replaceI, replaceE❙ 
❚

theory ZFInfinity =
  include ?ZFBase❙
  include ?Infinity❙
❚

theory ZF =
  include ?ZFBase❙
  include ?ZFEmptySet❙
  include ?ZFPairing❙
  include ?ZFBigUnion❙
  include ?ZFPowerSet❙
  include ?ZFComprehension❙
  include ?ZFReplacement❙
  include ?Regularity❙
  include ?ZFInfinity❙
❚

// FR: maybe this is not needed - can just be included from ZF-independent feature Choice❚
theory ZFChoice =
  include ?ZFBase❙
  include ?ChoiceAx❙
  // realize ?SetChoice❙
❚

theory ZFC = 
  include ?ZF❙
  include ?ZFChoice❙
❚
