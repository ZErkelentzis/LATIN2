namespace latin:/❚

fixmeta ?SetFOL❚

// TODO:
	- TODOs in theories
	- check whether everything is right
	- maybe some theories need to be rewritten after changes in axioms
	- add ZFBase in each ZF theory?❙
❚

theory ZFBase =
	// AS: should I use UniverseNonEmpty or ExistenceAx here?❙
  include ?UniverseNonEmpty❙
  include ?ExtensionalityAx❙
❚

theory ZFEmptySet =
  include ?ZFBase❙
  include ?EmptySetDefinitions❙
  realize ?EmptySet❙
  
  empty_unique : ⊦ ∃¹ isempty❘ // = ❙
  empty = the isempty empty_unique❙
  empty_prop = the_ax isempty empty_unique❙
  
  // realize empty_sub❙
❚

theory ZFPairing =
  include ?PairingAx❙
  include ?UnorderedPairs❘ = ?UopairFromAxiom❙
❚

theory ZFUnion =
  include ?UnionAx❙
  include ?BigUnion❘ = ?BigUnionFromAxiom❙
❚

theory ZFPowerset =
  include ?PowersetAx❙
 	include ?Powersets❘ = ?PowersetFromAxiom❙
❚

theory ZFComprehension =
  include ?ComprehensionAx❙
	include ?Filter❘ = ?FilterFromAxiom❙
❚

theory ZFReplacement =
  include ?ReplacementAx❙	
	include ?Replacement❘ = ?ReplacementFromAxiom❙
❚

theory ZFInfinity =
	// AS: either just include here oder like the rest❙
  include ?ZFBase❙
  include ?Infinity❙
❚

theory ZF =
  include ?ZFBase❙
  include ?ZFEmptySet❙
  include ?ZFPairing❙
  include ?ZFUnion❙
  include ?ZFPowerset❙
  include ?ZFComprehension❙
  include ?ZFReplacement❙
  include ?Regularity❙
  include ?ZFInfinity❙
❚

// FR: maybe this is not needed - can just be included from ZF-independent feature Choice❚
theory ZFChoice =
	// AS: either just include here oder like the rest❙
  include ?ZFBase❙
  include ?ChoiceAx❙
  // realize ?SetChoice❙
❚

theory ZFC = 
  include ?ZF❙
  include ?ZFChoice❙
❚
