namespace latin:/❚

fixmeta ?SetFOL❚

theory EmptySet =
  include ?EmptySetDefinitions❙
  // symbol: jemptyset❙
  empty : set❘# ∅❙
  empty_prop : ⊦ isempty ∅❙
  emptyE : {x} ⊦ x∈∅ ⟶ ↯❘# 2 emptyE❘
  		= [x,p] isemptyE empty_prop p❙
  
  empty_sub : {X} ⊦ ∅ ⪽ X❘ // = ???❙
❚

theory UniversalSet =
	include ?UniversalSetDefinition❙
	// symbol: jU❙
	universal : set❘# 𝒰❙
	universal_prop : ⊦ isuniversal 𝒰❙
	
	universal_sub: {X} ⊦ X ⪽ 𝒰❘ // = ???❙
❚

theory Singletons =
	include ?SingletonDefinition❙
  singleton : set ⟶ set❘# singleton 1 prec 100❙

  singleton_the : {X} ⊦ issingleton X ⟶ set❘ = [X,p] the ([x] x ∈ X) p❙
  singletonI : {X} ⊦ X ∈ singleton X❙
  singletonE : {X,x} ⊦ x ∈ singleton X ⟶ ⊦ x≐X❘# 3 singletonE❙
  
  // AS: this was used in KRMT;
  		however its definition was with Big_Union, which would ruin the modularity here❙
  singleton_inv : set ⟶ set❙
❚

theory UnorderedPairs =
  uopair : set ⟶ set ⟶ set❘# uopair 1 2 prec 40❙
  uopairIl : {X,Y} ⊦ X ∈ uopair X Y❙
  uopairIr : {X,Y} ⊦ Y ∈ uopair X Y❙
  uopairE  : {U,X,Y,C} ⊦ U ∈ uopair X Y ⟶ (⊦ U≐X ⟶ ⊦C) ⟶ (⊦ U≐Y ⟶ ⊦C) ⟶ ⊦C❘# 5 uopairE 6 7❙
  
  uopair_comm : {X,Y} ⊦ uopair X Y ≐ uopair Y X❙
❚