❚

// AS: Set existence was defined as UniverseNonEmpty; 
		Do I need to declare it again?
		I did a theory, just to be safe❚
theory ExistenceAx =
	// There exists at least one set❙
	existence_axiom : ⊦ ∃[A] true❙
	
	// AS : I can't think of meaningful introduction and elimination rules❙
❚

theory PairingAx =
	// The unordered pair {A,B} consists of exactly the two elements A and B❙
	isuopair = [A,B,Z] ∀[x] x∈Z ⇔ x≐A ∨ x≐B❙
	
	pairing_axiom : {A,B} ⊦ ∃[Z] isuopair A B Z❙
	pairing_unique : {A,B} ⊦ ∃¹[Z] isuopair A B Z❘ // = _ ❙
	pairingAxI : {A,B,Z,x} ⊦ x≐A ∨ x≐B ⟶ ⊦ x∈Z❙
	pairingAxE : {A,B,Z,x} ⊦ x∈Z ⟶ ⊦ x≐A ∨ x≐B❘# 5 pairingAxE 1 2❙
❚

theory UnionAx =
	// The big union of a family of sets A consists of all the elements x of its sets X.❙
	isbigunion = [A,Z] ∀[x]∀[X] X∈A ⇒ x∈X ⇒ x∈Z❙
	
	union_axiom : {A} ⊦ ∃[Z] isbigunion A Z❙
	union_unique : {A} ⊦ ∃¹[Z] isbigunion A Z❘ // = _ ❙
	unionAxI : {A,Z,X,x} ⊦ X∈A ⟶ ⊦ x∈X ⟶ ⊦ x∈Z❙
	unionAxE : {A,Z,x} ⊦ x∈Z ⟶ ⊦ ∃[X] X∈A ∧ x∈X❘# 4 unionAxE 1❙
❚

theory PowersetAx =
	// Each subset B of the set A is an element of the powerset Z❙
	ispowerset = [A,Z] ∀[B] (∀[x] x∈B ⇒ x∈A) ⇒ B∈Z❙
	
	powerset_axiom : {A} ⊦ ∃[Z] ispowerset A Z❙
	powerset_unique : {A} ⊦ ∃¹[Z] ispowerset A Z❘ // = _ ❙
	
	// AS: This definition is dependent on ⪽. So maybe use the alternative definition.❙
	// powersetAxI : {A,B,Z} ⊦ B⪽A ⟶ ⊦ B∈Z❙
	// powersetAxE : {A,B,Z} ⊦ B∈Z ⟶ ⊦ B⪽A❘// # 4 powersetAxE❙
	
	// Alternative definition❙
	powersetAxI : {A,B,Z} ({x} ⊦ x∈B ⇒ x∈A) ⟶ ⊦ B∈Z❙
	powersetAxE : {A,B,Z} ⊦ B∈Z ⟶ {x} ⊦ x∈B ⇒ x∈A❘# 4 powersetAxE 5❙
❚

theory ComprehensionAx =
	// The resulting set consists of all elements x of A that satisfy predicate P❙
	iscomprehension = [A,P,Z] ∀[x] x∈A ∧ (P x) ⇔ x∈Z❙
	
	comprehension_axiom : {A,P} ⊦ ∃[Z] iscomprehension A P Z❙
	comprehension_unique : {A,P} ⊦ ∃¹[Z] iscomprehension A P Z❘ // = _ ❙
	comprehensionAxI : {A,P,Z,x} ⊦ x∈A ⟶ ⊦ P x ⟶ ⊦ x∈Z❙
	comprehensionAxEl : {A,Z,x} ⊦ x∈Z ⟶ ⊦ x∈A❘# 4 comprehensionAxEl❙
	comprehensionAxEr : {P,Z,x} ⊦ x∈Z ⟶ ⊦ P x❘# 4 comprehensionAxEr 1❙
❚

theory ReplacementAx =
	// The resulting set is a replacement for A regarding function f❙
	isreplacement = [A,f,Z] ∀[B] B∈Z ⇔ (∃[x] x∈A ∧ B≐(f x))❙
	
	replacement_axiom : {A,f} ⊦ ∃[Z] isreplacement A f Z❙
	replacement_unique : {A,f} ⊦ ∃¹[Z] isreplacement A f Z❘ // = _ ❙
	replacementAxI : {A,f,Z,x} ⊦ x∈A ⟶ ⊦ (f x)∈Z❘# replacementAxI 2 5❙
	replacementAxE : {A,f,Z,y,C} ⊦ y∈Z ⟶ ({x} ⊦x∈A ⟶ ⊦ f x ≐ y ⟶ ⊦C) ⟶ ⊦C❘# 6 replacementAxE 1 2 7❙ 
❚

theory RegularityAx =
	// Every set has a "smallest" element❙
	isregular = ∀[A](∃[u] u∈A) ⇒ ∃[B] B∈A ∧ ¬(∃[x] x∈A ∧ x∈B)❙
	
	regularity_axiom : ⊦ isregular❙
	regularityAxI : {A} ⊦ (∃[u] u∈A) ⟶ ⊦ ∃[B] B∈A ∧ ¬(∃[x] x∈A ∧ x∈B)❙
	// AS: this is probably unnecessary❙
	regularityAxE : {A} ⊦ (∃[B] B∈A ∧ ¬(∃[x] x∈A ∧ x∈B)) ⟶ ⊦ ∃[u] u∈A❘# 2 regularityAxE❙
❚

theory InfinityAx =
	// There exists an infinite set containing ∅ and all successors of elements of its set.❙
	include ?InfinityDefinition❙
	
	infinity_axiom : ⊦ ∃[A] isinfinite A❙
	// AS: is it possible to define introduction and elimination rules here that make sense?
		Maybe, if I do it similar to choice❙
❚

theory ChoiceAx =
	include ?PairwiseDisjoint❙

	// There exists a set C with an unique element c that each set X of M has in common❙
	ischoice = [A,C] ∀[X] X∈A ⇒ ∃¹[c]c∈C∧c∈X❙
	
	// abstract functions❙
	all_nonempty: set ⟶ prop❘ // = ❙
  
	choice_axiom : ⊦ ∀[A] (all_nonempty A ∧ ispwdisjoint A) ⇒ ∃[C] ischoice A C❙
	choiceI : {A} ⊦ all_nonempty A ⟶ ⊦ ispwdisjoint A ⟶ ⊦ ∃[C] ischoice A C❙
	choiceEl : {A} ⊦ (∃[C] ischoice A C) ⟶ ⊦ all_nonempty A❘# 2 choiceEl❙
	choiceEr : {A} ⊦ (∃[C] ischoice A C) ⟶ ⊦ ispwdisjoint A❘# 2 choiceEr❙
❚
