namespace latin:/❚

// AS: SetFOL shall contain FOL and all definitions which are necessary to formalize set theory❚

theory SetFOL : ur:?LF =
	// AS: I changed FOLEQND + DescriptionND to the already existing combination❙
  include ?FOLEQDescND❙
  // InternalTypes: Terms, Propositions, in, realization of SoftTypedTerms❙
  include ?InternalTypes❙
  include ?SoftSubtyping❙

  include ?RelativizedUniversalQuantificationND❙
  include ?RelativizedExistentialQuantificationND❙

  // AS: this needed to be removed, since these have been rewritten❙
  // include ?DependentConjunctionND❙
  // include ?DependentImplicationND❙

  set = term❙
  
  eq_in : {x,y,A} ⊦ x≐y ⟶ ⊦ y∈A ⟶ ⊦ x∈A❘
        = [x,y,A,p,q] (eq/sym p) congP ([u] u∈A) q❙
  in_eq : {x,A,B} ⊦ x∈A ⟶ ⊦A≐B ⟶ ⊦ x∈B❘
        = [x,A,B,p,q] q congP ([U] x∈U) p❙
❚

// AS: this might be unnecessary
	theory Subsets =
  	include ?SoftSubtyping❙
// ❚

// AS: maybe add Cardinality as well❚ 
