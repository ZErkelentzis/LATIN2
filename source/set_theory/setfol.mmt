namespace latin:/❚

// AS: SetFOL shall contain FOL and all definitions which are necessary to formalize set theory❚

theory SetFOL : ur:?LF =
	// AS: I changed FOLEQND + DescriptionND to the already existing combination❙
  include ?FOLEQDescND❙
  // AS: I tried to remove the following four includes to avoid having the tp error later❙
  // InternalTypes: Terms, Propositions, in, realization of SoftTypedTerms❙
  // include ?InternalTypes❙
  // include ?SoftSubtyping❙

  // AS: These two were not used by now. Maybe I'll make a special version for them as well❙
  // include ?RelativizedUniversalQuantificationND❙
  // include ?RelativizedExistentialQuantificationND❙

  // AS: this needed to be removed, since these have been rewritten❙
  // include ?DependentConjunctionND❙
  // include ?DependentImplicationND❙
  set = term❙
  
  // AS: This would be in InternalTypes❙
  in : set ⟶ set ⟶ prop❘# 1 ∈ 2 prec 30❙
  
  // AS: This would be in SoftSubtyping and its includes❙
  subset : set ⟶ set ⟶ prop❘# 1 ⪽ 2 prec 30❙
  subsetI : {A,B} ({x} ⊦ x∈A ⟶ ⊦ x∈B) ⟶ ⊦ A⪽B❙
  subsetE : {A,B} ⊦ A⪽B ⟶ {x} ⊦ x∈A ⟶ ⊦ x∈B❘# 5 subsetE 3❙
  
  eq_in : {x,y,A} ⊦ x≐y ⟶ ⊦ y∈A ⟶ ⊦ x∈A❘
        = [x,y,A,p,q] (eq/sym p) congP ([u] u∈A) q❙
  in_eq : {x,A,B} ⊦ x∈A ⟶ ⊦A≐B ⟶ ⊦ x∈B❘
        = [x,A,B,p,q] q congP ([U] x∈U) p❙
  
  // AS: This would have been ExtensionalityAx❙
  // Two sets A and B are equal iff they have the same elements❙
	isextensional = [A,B] ∀[x] (x∈A ⇔ x∈B) ⇒ A≐B❙
	
	extensionality_axiom : {A,B} ⊦ isextensional A B❙	
	extensionalityI : {A,B} ({x} ⊦ x∈A ⇔ x∈B) ⟶ ⊦ A≐B❙
	extensionalityE : {A,B} ⊦ A≐B ⟶ {x} ⊦ x∈A ⇔ x∈B❘# 3 extensionalityE❙ 
❚

// AS: maybe add Cardinality as well❚ 
