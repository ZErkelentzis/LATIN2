namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚

theory TypesZF =
  include ?TypedZFFeatures❙
  
  realize ?Types❙
  tp = set❙
❚

theory TypedTermsZF =
  include ?TypesZF❙
  
  realize ?TypedTerms❙
  tm = [A] Elem A❙
❚

theory SoftTypedTermsZF =
  // AS: Propositions and Terms are part of the fixmeta❙
  include ?Propositions❙
  include ?Terms❙
  include ?TypesZF❙
  
  realize ?SoftTypedTerms❙
  of = in❙
❚

theory TypedLogicZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?TypedTermsZF❙
  
  realize ?TypedLogic❙
❚

theory SoftTypedLogicZF =
  // AS: Propositions, Terms and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Terms❙
  include ?Proofs❙
  include ?SoftTypedTermsZF❙
  
  realize ?SoftTypedLogic❙
❚

theory TypedEqualityZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?TypedLogicZF❙
  
  realize ?TypedEquality❙
  tequal = Eq❙ 
❚

theory TypedEqualityNDZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?TypedEqualityZF❙
  
  realize ?TypedEqualityND❙
  trefl = [A,e: Elem A] Refl❙
  tcongB = EqcongB❙
❚

theory TypeEqualityNDZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?TypesZF❙
  
  realize ?TypeEqualityND❙
  // AS: How to realize a structure?❙
❚

theory DependentTypeEqualityZF =
  include ?TypeEqualityNDZF❙
  include ?TypedEqualityNDZF❙
  
  realize ?DependentTypeEquality❙
  // TODO:❙
❚

// AS: move universal and existential into logic_to_set❙
theory TypedUniversalQuantificationZF =
  include ?TypedLogicZF❙
  
  realize ?TypedUniversalQuantificationND❙
  
  tforall = [A,P: Elem A ⟶ prop] uforall [x] (x∈A) ⇒ͩ ([p] P (elem x p))❙
  tforallI = [A,P,p] uforallI [x] dimplI ([q] p (elem x q))❙
  tforallE = [A,P,p,e: Elem A] elem_id EqcongEl P ((p uforallE (which e)) dimplE (why e))❙
❚

theory TypedExistentialQuantificationZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙  
  include ?TypedLogicZF❙
	
  realize ?TypedExistentialQuantificationND❙
  
  texists = [A,P: Elem A ⟶ prop] uexists [x] (x∈A) ∧ͩ ([p] P (elem x p))❙
  texistsI = [A,P: Elem A ⟶ prop,e: Elem A,p] uexistsI (which e) (dandI (why e) (ceq_which EqcongEr P p))❙
  texistsE = [A,P,C,p,Q] p uexistsE ([x,px] Q (elem x (px dandEl)) (px dandEr))❙
❚

theory PowerTypesZF =
  // AS: Not quite sure if this makes sense at all❙
  // AS: same as in BascicsZF❙
  include ?Propositions❙
  include ?Proofs❙
  include ?BasicsZF❙

  // AS: EquivalenceND should not have to be realized since it is already in SetFOL❙

  realize powertypes/?PowerTypes❙

  power = [A] powerset A❙
  in = [A,a: Elem A,b: Elem powerset A] (which a) ∈ (which b)❙
  filter = [A,P: Elem A ⟶ prop] elem ❙

  // compute = [A,P,a: Elem A] ❙
❚
