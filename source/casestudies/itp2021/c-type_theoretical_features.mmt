// TYPE-THEORETICAL FEATURES (Section 4)
   ========================================== ❚
namespace latin:/casestudies/itp2021 ❚
rule scala://parser.api.mmt.kwarc.info?MMTURILexer ❚
fixmeta ?Meta ❚

theory HEqual =
  include ?HTyped ❙
  include ?Proofs ❙
  eq: {A} tm A ⟶ tm A ⟶ prop ❘# 2 ≐ 3 prec 5 ❙
  refl: {A,x: tm A} ⊦ x ≐ x ❘# refl 2 ❙

  eqsub: {A, x: tm A, y: tm A} ⊦ x ≐ y ⟶ {F: tm A ⟶ prop} ⊦ F x ⟶ ⊦ F y ❙

  // TODO(NR@FR): should we keep the decls below? need them for ext <-> exten views ❙

  binder_congruence
    : {A, B, C, binder: (tm A ⟶ tm B) ⟶ tm C, F: tm A ⟶ tm B, G: tm A ⟶ tm B}
        ({x: tm A} ⊦ F x ≐ G x) ⟶ ⊦ binder F ≐ binder G
  ❙

  trans
    : {a, x: tm a, y: tm a, z: tm a} ⊦ x ≐ y ⟶ ⊦ y ≐ z ⟶ ⊦ x ≐ z
    ❘# trans 5 6
    ❘// = proof in terms of binder_congruence omitted
  ❙

  trans3
    : {a, u: tm a, x, y, z} ⊦ u ≐ x ⟶ ⊦ x ≐ y ⟶ ⊦ y ≐ z ⟶ ⊦ x ≐ z
    ❘# trans3 6 7 8
    ❘// = proof in terms of trans omitted
  ❙
❚

theory HProd =
  include ?HEqual ❙
  prod: tp ⟶ tp ⟶ tp  ❘# 1 × 2 ❙
  pair: {A, B} tm A ⟶ tm B ⟶ tm A×B ❘# ⟪ 3 , 4 ⟫ ❙
  projL: {A, B} tm A×B ⟶ tm A ❘# πl 3 ❙
  projR: {A, B} tm A×B ⟶ tm B ❘# πr 3 ❙

  // We don't give beta, eta, or extensionality rules here as the softening operator doesn't work as intended on proof
     rules yet. In the paper, we elaborate on this problem after Theorem 13. ❙
❚

/T Theory of simple hard-typed functions (called HSimpFun in the paper) ❚
theory HFun =
  include ?HEqual ❙
  fun: tp ⟶ tp ⟶ tp ❘# 1 → 2 ❙
  lam: {A, B} (tm A ⟶ tm B) ⟶ tm A→B ❘# λ 3 prec 10 ❙
  app: {A, B} tm A→B ⟶ tm A ⟶ tm B ❘# 3 @ 4 prec 20 ❙
❚
theory HBeta =
  include ?HFun ❙
  beta: {A, B, F: tm A ⟶ tm B, x: tm A} ⊦ (λ F) @ x ≐ F x ❘# beta 3 4 ❙
  xi
    : {A, B, F: tm A ⟶ tm B, G: tm A ⟶ tm B} ({x: tm A} ⊦ F x ≐ G x) ⟶ ⊦ λ F ≐ λ G
   ❘ = [A, B] binder_congruence A B (A→B) (lam A B)
   ❘# xi 3 4 5
 ❙
❚
theory HEta =
  include ?HBeta ❙
  eta: {A, B, f: tm A→B} ⊦ (λ [x: tm A] f @ x) ≐ f ❙
❚
// In Latin1: https://gl.mathhub.info/MMT/LATIN/-/blob/053b1bbb0b3e45053838e8ef22eef899ef5fe2fc/source/logics/higher-order/modules.elf#L146-151 ❚
theory HExten =
  include ?HBeta ❙
  exten: {A, B, f: tm A→B, g: tm A→B} ({x} ⊦ f @ x ≐ g @ x) ⟶ ⊦ f ≐ g ❘# exten 3 4 5 ❙

  realize ?HEta ❙
  // Giving an assignment for eta ultimately amounts to giving an inhabitant of `⊦ λ [x: tm A] f @ x ≐ f`.

    Natural language sketch: By extensionality it suffices to show for all `x: tm A` that
                                 `⊦ (λ [x: tm A] f @ x) @ x ≐ f @ x`.
                             The latter we show by transivity of ≐:
                                 `(λ [x: tm A] f @ x) @ x ≐ f @ x ≐ f @ x`   (by beta and refl)
                             qed.
  ❙
  eta = [A, B, f] exten (λ [x: tm A] f @ x) f ([x: tm A] trans (beta ([y: tm A] f @ y) x) (refl (f @ x))) ❙
❚
// TODO(NR@FR): make this view typecheck (it should almost be correct): ❙
// view EtaGivesExten : ?BetaExten -> ?BetaEta =
  include ?Beta ❙
  /T doesn't work yet ❙
  exten = [A, B, f, g, ext] trans3 (refl f) (xi (λ [x] f @ x) (λ [x] g @ x) ext) (refl g) ❙
❚

theory HDepFun =
  include ?HEqual ❙
  fun
    : {A} (tm A ⟶ tp) ⟶ tp
    ❘# Π 2
    ❘ meta ur:?DiagramOperators?drop_args_keep "1"
  ❙
  lam
    : {A, B: tm A ⟶ tp} ({x: tm A} tm (B x)) ⟶ tm (Π B)
    ❘# λ 3 prec 10
  ❙
  app
    : {A, B: tm A ⟶ tp} tm Π B ⟶ {x: tm A} tm (B x)
    ❘# 3 @ 4 prec 20
  ❙
❚
theory HDepBeta =
  include ?HDepFun ❙
  beta: {A, B: tm A ⟶ tp, F: {x: tm A} tm (B x), x: tm A} ⊦ (λ F) @ x ≐ F x ❘# beta 3 4 ❙
❚
view HSFtoDF : ?HFun -> ?HDepFun =
  include ?HEqual ❙
  fun = [A, B] Π ([x: tm A] B) ❙
  lam = [A, B, f: tm A ⟶ tm B] λ f ❙
  app = [A, B, f, x] f @ x ❙
❚
view HBetaSFtoBetaDF : ?HBeta -> ?HDepBeta =
  include ?HSFtoDF ❙
  beta = [A, B, F, x] beta F x ❙
❚

// SOFTENING: TRANSLATION FROM HARD- TO SOFT-TYPED
   ================================================ ❚

theory SEqual =
  include ?STyped ❙
  include ?Proofs ❙
  /T Equality at a type ❙
  eq: tp ⟶ term ⟶ term ⟶ prop ❙
  refl: {A, x: term} ⊦ x ⦂ A ⟶ ⊦ eq A x x ❘# refl 3 ❙
  trans: {A, x, y, z} ⊦ x ⦂ A ⟶ ⊦ y ⦂ A ⟶ ⊦ z ⦂ A ⟶ ⊦ eq A x y ⟶ ⊦ eq A y z ⟶ ⊦ eq A x z ❙
❚

// TODO(NR@FR): make this view total ❚
view TEEqual : ?HEqual -> ?SEqual =
  include ?TE ❙
  include ?Props ❙
  include ?Proofs ❙
  eq = eq ❙
  // todo NR@FR: assignments for refl, trans, binder_congruence are missing
                 (note that MMT doesn't throw partiality warnings for some reason) ❙
❚

/T Step 1: generate the interface of all partial logical relations over
           the type erasure morphism ?TE ❚
diagram HardTypedLogrel : ?DiagOpsMeta :=
    partial_unary_logrel_operator
      ?TEEqual
      ?Types?tp ?Props?prop ?Proofs?ded
      (DIAG_CLOSURE (RAWDIAG ?Meta) (RAWDIAG ?HTypedLogic)) ❚
    // ! ?HTyped ! ?Props ! ?Proofs ! ?HEqual ! ?HTypedLogic ❚

// Concretely, this generates the interface of partial logical relations that
   (1) are along ?TEEqual,
   (2) are (at least) partial on ?Types?tp, ?Props?prop, and ?Proofs?ded,
   (3) and over ?HTypedLogic (and all transitively included theories up to, but excluding, ?Meta).

   As output, among others, we get the theory ?HTypedLogic_logrel whose constants are all undefined.
   Realizers of that theory are precisely partial logical relations in the sense of (1) - (3) above.
❚

/T Step 2: state type preservation as one such partial logical relation ❚
view TypePres : ?HEqual_logrel -> ?SEqual =
  include ?SEqual ❙
  tm_r = [A: tp, t: term] ⊦ t ⦂ A ❙
❚

/T Step 3: aggregate all type-theoretical features in diagrams on that we want to apply softening ❚
// diagram HTypedFeatures : ?DiagOpsMeta :=
    BDIAG (RAWDIAG ?HTyped) ! ?HProd ! ?HSimpFun ! ?HDepFun ! ?HSFtoDF ❚

// diagram STypedFeatures_cluttered : ?DiagOpsMeta :=
    unary_logrel_pushout_operator
      ?TEEqual
      ?Types?tp
      ?TypePres
      ?HTypedFeatures
❚

// diagram STypedFeatures2_cluttered : ?DiagOpsMeta :=
    unary_logrel_pushout_operator
      ?TELogic
      ?Types?tp ?Props?prop ?Proofs?ded
      ?TypePresLogic
      (BDIAG (RAWDIAG ?HTypedLogic) ! ?HRule ! ?HBeta ! ?HEta ! ?HExten)
❚

// diagram STypedFeatures : ?DiagOpsMeta :=
  DROP_UNUSED_ARGS ?STypedFeatures_cluttered ❚
