theory UEqual_poly : latin:/casestudies/itp2021?HTyped  =
	eq
		: {u:tp}term⟶term⟶prop
		❘ # 2 ≐ 3 prec 25
		❘ ## 2 ≐ 3 prec 25
	❙
	refl
		: {u:tp}{x}⊦x≐x
	❙
	eqsub
		: {u:tp}{x,y}⊦x≐y⟶{P:term⟶prop}⊦(P x)⟶⊦(P y)
	❙

