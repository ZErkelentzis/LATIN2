theory UExistUnique_poly : latin:/casestudies/itp2021?Meta  =
	include ☞latin:/casestudies/itp2021?UEqual_poly ❙
	include ☞latin:/casestudies/itp2021?Conj_poly ❙
	include ☞latin:/casestudies/itp2021?Impl_poly ❙
	include ☞latin:/casestudies/itp2021?UUniv_poly ❙
	include ☞latin:/casestudies/itp2021?UExist_poly ❙
	existsUnique
		: {u:tp}(term⟶prop)⟶prop
		❘ = [u:tp][P]∃[x](P x)∧∀[y](P y)⇒x≐y
		❘ # ∃¹ 2
		❘ ## ∃¹ 2
	❙
	existsIntro
		: {u:tp}{P,x}⊦(P x)⟶⊦∃P
		❘ # existsI 3 4
		❘ ## existsI 3 4
	❙
	existsElim
		: {u:tp}{P}⊦∃P⟶{Q}({x}⊦(P x)⟶⊦Q)⟶⊦Q
		❘ # 4 existsE 5
		❘ ## 4 existsE 5
	❙

