	include ☞latin:/casestudies/itp2021?STyped ❙
	include ☞latin:/casestudies/itp2021?Types ❙
	lam_r
		: {A:tp}{B:tp}{x⁰:term⟶term}⊦(λ x⁰)⦂(A→B)
	❙
