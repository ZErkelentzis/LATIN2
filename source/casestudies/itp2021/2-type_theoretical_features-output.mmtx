theory HDepFun_lopu_result_cleaned : ur:?LF  =
	include ☞latin:/casestudies/itp2021?STyped ❙
	include ☞latin:/casestudies/itp2021?Terms ❙
	include ☞latin:/casestudies/itp2021?Props ❙
	include ☞latin:/casestudies/itp2021?Types ❙
	dep_fun_0
		: (term⟶tp)⟶tp
		❘ @ dep_fun
		❘ # Π 1
		❘ ## Π 1
	❙
	dep_lam_0
		: ({x:term}term)⟶term
		❘ @ dep_lam
		❘ # dλ 1
		❘ ## dλ 1
	❙
	dep_lam_T
		: {A:tp,B:term⟶tp}{x⁰:{x:term}term,x⁰ᕁ:{x:term,xᕁ:⊦x⦂A}⊦(x⁰ x)⦂(B x)}⊦(dλ x⁰)⦂Π B
	❙
	dep_app_0
		: term⟶term
		❘ @ dep_app
	❙
	dep_app_T
		: {A:tp,B:term⟶tp}{x⁰:term,x⁰ᕁ:⊦x⁰⦂Π B,x:term,xᕁ:⊦x⦂A}⊦(dep_app_0 x⁰)⦂(B x)
	❙

