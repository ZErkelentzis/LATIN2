view HSFtoDF_logrel_cleaned : latin:/casestudies/itp2021?HSimpFun_logrel_cleaned  -> latin:/casestudies/itp2021?HDepFun_logrel_cleaned  =
	include ☞latin:/casestudies/itp2021?HDepFun_lopu_result_cleaned  ❘ IDENTITY ?HDepFun_lopu_result_cleaned❙
	include ☞latin:/casestudies/itp2021?Terms  ❘ IDENTITY ?Terms❙
	include ☞latin:/casestudies/itp2021?Props  ❘ IDENTITY ?Props❙
	include ☞latin:/casestudies/itp2021?STyped  ❘ IDENTITY ?HTyped❙
	include ☞ur:?LF  ❘ IDENTITY ?LF❙
	include ☞ur:?TermsTypesKinds  ❘ IDENTITY ?TermsTypesKinds❙
	include ☞http://cds.omdoc.org/mmt?Errors  ❘ IDENTITY ?Errors❙
	include ☞ur:?ModExp  ❘ IDENTITY ?ModExp❙
	include ☞http://cds.omdoc.org/mmt?mmt  ❘ IDENTITY ?mmt❙
	include ☞ur:?Typed  ❘ IDENTITY ?Typed❙
	include ☞ur:?Kinded  ❘ IDENTITY ?Kinded❙
	include ☞ur:?TypedConstants  ❘ IDENTITY ?TypedConstants❙
	include ☞ur:?KindedConstants  ❘ IDENTITY ?KindedConstants❙
	include ☞ur:?LambdaPi  ❘ IDENTITY ?LambdaPi❙
	include ☞ur:?LFRules  ❘ IDENTITY ?LFRules❙
	include ☞latin:/casestudies/itp2021?Types  ❘ IDENTITY ?Types❙
	lam_r
		= [A:tp,B:tp,f:term⟶term,fᕁ:{x⁰:term,x⁰ᕁ:⊦x⁰⦂A}⊦(f x⁰)⦂B]dep_lam_r ([_:term]B) f
	❙
	app_r
		= [A:tp,B:tp,f:term,fᕁ:⊦f⦂Π [x:term]B,x:term,xᕁ:⊦x⦂A]dep_app_r ([x/r:term]B) f x
	❙

