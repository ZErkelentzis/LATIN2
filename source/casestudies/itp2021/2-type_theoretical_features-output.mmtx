view HProd_lopu_logrel_cleaned : latin:/casestudies/itp2021?HProd_logrel_cleaned  -> latin:/casestudies/itp2021?HProd_lopu_result_cleaned  =
	include ☞latin:/casestudies/itp2021?HTyped_logrel  ❘ ?TypePres❙
	include ☞ur:?LF  ❘ IDENTITY ?LF❙
	include ☞latin:/casestudies/itp2021?STyped  ❘ IDENTITY ?STyped❙
	include ☞latin:/casestudies/itp2021?Terms  ❘ IDENTITY ?Terms❙
	include ☞latin:/casestudies/itp2021?Props  ❘ IDENTITY ?Props❙
	include ☞latin:/casestudies/itp2021?Types_logrel  ❘ COMPOSE (IDENTITY ?Types_logrel);?TypePres❙
	include ☞latin:/casestudies/itp2021?Types  ❘ IDENTITY ?Types❙
	pair_r
		= pair_T
	❙
	projL_r
		= projL_T
	❙
	projR_r
		= projR_T
	❙

