theory HDepFun_logrel_cleaned : ur:?LF  =
	include ☞latin:/casestudies/itp2021?HDepFun_lopu_result_cleaned ❙
	include ☞latin:/casestudies/itp2021?Terms ❙
	include ☞latin:/casestudies/itp2021?Props ❙
	include ☞latin:/casestudies/itp2021?STyped ❙
	include ☞latin:/casestudies/itp2021?Types ❙
	dep_lam_r
		: {B:term⟶tp}{x⁰:{x:term}term}⊦(dλ x⁰)⦂Π B
	❙
	dep_app_r
		: {B:term⟶tp}{x⁰:term}{x:term}⊦(dep_app_0 x⁰)⦂(B x)
	❙

