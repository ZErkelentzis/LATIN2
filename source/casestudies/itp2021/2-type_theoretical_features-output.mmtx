theory HProd_lopu_result_cleaned : ur:?LF  =
	include ☞latin:/casestudies/itp2021?STyped ❙
	include ☞latin:/casestudies/itp2021?Terms ❙
	include ☞latin:/casestudies/itp2021?Props ❙
	include ☞latin:/casestudies/itp2021?Types ❙
	prod_0
		: tp⟶(tp⟶tp)
		❘ @ prod
		❘ # 1 × 2
		❘ ## 1 × 2
	❙
	pair_0
		: term⟶(term⟶term)
		❘ @ pair
		❘ # ⟪ 1 , 2 ⟫
		❘ ## ⟪ 1 , 2 ⟫
	❙
	pair_T
		: {A:tp,B:tp}{x⁰:term,x⁰ᕁ:⊦x⁰⦂A,x¹:term,x¹ᕁ:⊦x¹⦂B}⊦⟪x⁰,x¹⟫⦂(A×B)
	❙
	projL_0
		: term⟶term
		❘ @ projL
		❘ # πl 1
		❘ ## πl 1
	❙
	projL_T
		: {A:tp,B:tp}{x⁰:term,x⁰ᕁ:⊦x⁰⦂(A×B)}⊦(πl x⁰)⦂A
	❙
	projR_0
		: term⟶term
		❘ @ projR
		❘ # πr 1
		❘ ## πr 1
	❙
	projR_T
		: {A:tp,B:tp}{x⁰:term,x⁰ᕁ:⊦x⁰⦂(A×B)}⊦(πr x⁰)⦂B
	❙

