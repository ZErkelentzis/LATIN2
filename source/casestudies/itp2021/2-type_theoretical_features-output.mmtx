	include ☞latin:/casestudies/itp2021?Props ❙
	include ☞latin:/casestudies/itp2021?Types ❙
	fun_0
		: tp⟶(tp⟶tp)
		❘ @ fun
		❘ # 1 → 2
		❘ ## 1 → 2
	❙
	lam_0
		: (term⟶term)⟶term
		❘ @ lam
		❘ # λ 1
		❘ ## λ 1
	❙
	lam_T
		: {A:tp,B:tp}{x⁰:term⟶term,x⁰ᕁ:{x⁰/r:term,x⁰ᕁ:⊦x⁰/r⦂A}⊦(x⁰ x⁰/r)⦂B}⊦(λ x⁰)⦂(A→B)
	❙
	app_0
		: term⟶(term⟶term)
		❘ @ app
		❘ # 1 @ 2
		❘ ## 1 @ 2
	❙
	app_T
		: {A:tp,B:tp}{x⁰:term,x⁰ᕁ:⊦x⁰⦂(A→B),x¹:term,x¹ᕁ:⊦x¹⦂A}⊦(x⁰@x¹)⦂B
	❙

