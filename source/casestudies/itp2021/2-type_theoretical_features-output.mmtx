view HSFtoDF_lopu_result_cleaned : latin:/casestudies/itp2021?HSimpFun_lopu_result_cleaned  -> latin:/casestudies/itp2021?HDepFun_lopu_result_cleaned  =
	include ☞latin:/casestudies/itp2021?STyped  ❘ IDENTITY ?STyped❙
	include ☞latin:/casestudies/itp2021?Terms  ❘ IDENTITY ?Terms❙
	include ☞latin:/casestudies/itp2021?Props  ❘ IDENTITY ?Props❙
	include ☞ur:?LF  ❘ IDENTITY ?LF❙
