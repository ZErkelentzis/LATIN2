	include ☞ur:?ModExp  ❘ IDENTITY ?ModExp❙
	include ☞http://cds.omdoc.org/mmt?mmt  ❘ IDENTITY ?mmt❙
	include ☞ur:?Typed  ❘ IDENTITY ?Typed❙
	include ☞ur:?Kinded  ❘ IDENTITY ?Kinded❙
	include ☞ur:?TypedConstants  ❘ IDENTITY ?TypedConstants❙
	include ☞ur:?KindedConstants  ❘ IDENTITY ?KindedConstants❙
	include ☞ur:?LambdaPi  ❘ IDENTITY ?LambdaPi❙
	include ☞ur:?LFRules  ❘ IDENTITY ?LFRules❙
	include ☞latin:/casestudies/itp2021?Types  ❘ IDENTITY ?Types❙
	fun_0
		= [A,B]Π [x:term]B
	❙
	lam_0
		= [A,B,f:term⟶term]dλ f
	❙
	lam_T
	❙
	app_0
		= [A,B,f,x]dep_app_0 f
	❙
	app_T
	❙

