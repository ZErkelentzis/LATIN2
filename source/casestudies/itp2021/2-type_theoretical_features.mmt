/T Step 1: generate the interface of all partial logical relations over
           the type erasure morphism ?TE ❚
// diagram HardTypedLogrel : ?DiagOpsMeta :=
    partial_unary_logrel_operator ?TE ?Types?tp (BDIAG (RAWDIAG ☞ur:?LF) ! ?Types ! ?HTyped) ❚
// Here, we specify ?Types?tp to be partial on that type.

   The diagram operator partial_unary_logrel_operator will generate, among others, the theory ?HTyped_logrel
   acting as an interface for partial logical relations over ?TE.
❚

/T Step 2: state type preservation as one such partial logical relation ❚
// view TypePres : ?HTyped_logrel -> ?STyped =
  include ?STyped ❙
  tm_r = [A: tp, t: term] ⊦ t ⦂ A❙ // cruical assignment making this logrel represent type preservation ❙
❚

/T Step 3: aggregate all type-theoretical features in diagrams on that we want to apply softening ❚
// diagram HTypedFeatures : ?DiagOpsMeta :=
    BDIAG (RAWDIAG ?HTyped) ! ?HProd ! ?HSimpFun ! ?HDepFun ! ?HSFtoDF ❚

// diagram STypedFeatures_cluttered : ?DiagOpsMeta :=
  unary_logrel_pushout_operator ?TE ?Types?tp ?TypePres ?HTypedFeatures ❚

// diagram STypedFeatures : ?DiagOpsMeta :=
  CLEAN_UNUSED_ARG_POSITIONS ?STypedFeatures_cluttered ❚
