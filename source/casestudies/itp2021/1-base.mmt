// Formalizations primarily corresponding to the paper's Sections 2 and 3 ❚
namespace latin:/casestudies/itp2021 ❚
rule scala://parser.api.mmt.kwarc.info?MMTURILexer ❚

/T Meta theory for diagram operator applications in `diagram` statements ❚
theory DiagOpsMeta =
  include ☞ur:?DiagramOperators ❙
❚
/T Meta theory of all MMT theories and views ❚
theory Meta : ur:?LF =
  include ☞ur:?Strings ❙
❚
fixmeta ?Meta ❚

// BASE LANGUAGE DEFINITIONS
   ========================================== ❚

theory Terms =
  term: type ❙
❚

theory Types =
  tp: type ❙
❚
theory Props =
  prop: type ❙
❚

theory Proofs =
  include ?Props ❙
  ded: prop ⟶ type ❘# ⊦ 1 prec -5 ❙
  incon: type ❘ = {p: prop} ⊦ p ❙
❚

theory Classical =
  include ?Proofs ❙
  classical: {a} ((⊦ a ⟶ incon) ⟶ incon) ⟶ ⊦ a ❙
❚

/T Hard-typed (aka intrinsic/Church-flavored): terms carry their type ❚
theory HTyped =
  include ?Types ❙
  tm: tp ⟶ type ❘# tm 1 prec -5 ❙
❚

/T Soft-typed (aka extrinsic/Curry-flavored): types coexist with terms, a typing judgement exists ❚
theory STyped =
  include ?Terms ❙
  include ?Types ❙
  include ?Props ❙
  of: term ⟶ tp ⟶ prop ❘# 1 ⦂ 2 ❙ // TODO: prop or type return type? ❙
❚

/T Type Erasure ❚
view TE : ?HTyped -> ?STyped =
  tp = tp ❙
  tm = [a] term ❙
❚

// CONCEPT MERGERS (corresponding to the paper's Section 3.2) ❚

/T Propositions as types: every proposition `p: prop` is identified with an object type `t_p: tp` (one for every `p`).
   Below, PrAsTy_HTypedProofs extends this by identifying proofs of `p` with object terms of object type `t_p` ❚
theory PrAsTy =
  include ?Types ❙

  realize ?Props ❙
  prop = tp ❙
❚

/T Propositions as types (extended): every proof `pf: ⊦ p` of `p: prop` is identified with an object term of the object
   type `t_p: tp`.

  Observation (NR@FR)
       this makes sense to formalize over STyped too. There, we would
       map ded to `ded = λp: prop. Σ (t: term) . t ⦂ p`
       where Σ are sigma types implemented on LF level. ❚
theory PrAsTy_HTypedProofs =
  include ?PrAsTy ❙
  include ?HTyped ❙

  realize ?Proofs ❙
  ded = [p: prop] tm p ❙
❚

/T Propositions as terms ❚
theory PrAsTe =
  include ?HTyped ❙
  bool: tp ❙

  realize ?Props ❙
  prop = tm bool ❙
❚

/T Types as propositions (predicates): in a soft-typed language, every object type is identified with a predicate
   `term ⟶ prop` and the object typing judgement `of t a` is identified with the "truth value" of the predicate
   associated to `a` applied to `t`. ❚
theory TyAsPr =
  include ?Terms ❙
  include ?Props ❙

  realize ?STyped ❙
  tp = term ⟶ prop ❙
  of = [t: term, a: term ⟶ prop] a t ❙
❚

/T Types as terms: in a soft-typed language, every object type is identified with an object term. Thus, the object
   typing judgement `of: term ⟶ term ⟶ prop` is a relation between terms. ❚
theory TyAsTe =
  include ?Terms ❙
  include ?Props ❙

  realize ?Types ❙
  tp = term ❙

  include ?STyped ❙
❚