namespace latin:/dhol❚

/T DHOL Theory All-in-one before factorization❚
theory DHOL : ur:?LF =
  tp: type❙
  tm: type❙ 

  wftp: tp ⟶ type❘        # $ 1   prec -5❘ role Judgment❙
  wftm: tm ⟶ tp ⟶ type❘  # 1 % 2 prec -5❘ role Judgment❙
  valid: tm ⟶ type❘       # ⊦ 1   prec -5❘ role Judgment❙
  eqtp: tp ⟶ tp ⟶ type❘  # 1 ≡ 2 prec -5❘ role Judgment❙
  subtp: tp ⟶ tp ⟶ type❘ # 1 < 2 prec -2❘ role Judgment❘ 
       = [A,B] {t} t%A ⟶ t%B❙ 
  sub_antisym : {A,B} A<B ⟶ B<A ⟶ A≡B ❘ role Judgment ❙

  eqtp_subtp: {A,B} A≡B ⟶ A<B❙
  eqtp_subtp_map: {A,B,Bˈ} ({x} x%A ⟶ B x ≡ Bˈ x) ⟶ ({x} x%A ⟶ B x < Bˈ x) ❘
                = [A,B,Bˈ,P] [x, r: x%A] eqtp_subtp (P x r) ❙
            
  subtp_trans: {A,B,C} A<B ⟶ B<C ⟶ A<C ❘
             = [A,B,C,P,Q] [t, r: t%A] (Q t (P t r))❙
 
  bool: tp❙
  bool_tp: $bool❙
  contra = {F} ⊦F ❘# ↯❙
  classical: {F} ((⊦F ⟶ ↯) ⟶ ↯) ⟶ ⊦F❙
  contra_implies: {F} ↯ ⟶ ⊦F ❘
                = [F,P] P F ❙
               
  eq: tp ⟶ tm ⟶ tm ⟶ tm❘ # 2 = 1 3 prec 10❙
  eq_tp: {A,s,t} $A ⟶ s%A ⟶ t%A ⟶ s =A t % bool❙
  tp_wf: {A,x} x%A ⟶ $A ❙
  
  eqtp_refl: {A} $A ⟶ A≡A ❙
  eqtp_sym: {A,Aˈ}  A≡Aˈ ⟶ Aˈ≡A ❙
  
  eqtp_param: {A,Aˈ,B,Bˈ} A≡Aˈ ⟶ ({x} x%A ⟶ B x ≡ Bˈ x) ⟶ ({x} x%Aˈ ⟶ B x ≡ Bˈ x) ❘
            = [A,Aˈ,B,Bˈ,P,Q] [x, r: x%Aˈ] Q x ((eqtp_subtp (eqtp_sym P)) x r)❙
  eqtp_sym_map: {A,B,Bˈ} ({x} x%A ⟶ B x ≡ Bˈ x) ⟶ ({x} x%A ⟶ Bˈ x ≡ B x) ❘
              = [A,B,Bˈ,P] [x, r: x%A] eqtp_sym (P x r) ❙
  
  eq_refl: {x,A} x%A ⟶ ⊦ x =A x ❙
  eq_sym: {x,y,A} ⊦ x =A y ⟶ ⊦ y =A x ❙
  eq_wf: {x,y,A} ⊦ x =A y ⟶ x%A ❙
  
  eq_param: {A,Aˈ,p,pˈ} A≡Aˈ ⟶ ({x} x%A ⟶ ⊦ (p x) =bool (pˈ x)) ⟶ ({x} x%Aˈ ⟶ ⊦ (p x) =bool (pˈ x)) ❘
          = [A,Aˈ,p,pˈ,P,Q] [x, r: x%Aˈ] Q x ((eqtp_subtp (eqtp_sym P)) x r)❙

  wftp_eq: {A,B} $A ⟶ A≡B ⟶ $B❙
  wftp_eq_left: {A,B} A≡B ⟶ $A❙
  valid_eq: {F,G} ⊦ F ⟶ ⊦ F =bool G ⟶ ⊦ G ❙
  
  wftp_eq_right: {A,B} A≡B ⟶ $B ❘
               = [A,B,P] wftp_eq_left eqtp_sym P ❙
  eq_impl: {A,p,pˈ} ({x} x%A ⟶ ⊦ (p x) =bool (pˈ x)) ⟶ ({x} x%A ⟶ (⊦ p x ⟶ ⊦ pˈ x)) ❘
         = [A,p,pˈ,P] [x, r: x%A] [v: ⊦ p x] valid_eq v (P x r) ❙
  eq_impl_back: {A,p,pˈ} ({x} x%A ⟶ ⊦ (p x) =bool (pˈ x)) ⟶ ({x} x%A ⟶ (⊦ pˈ x ⟶ ⊦ p x)) ❘
         = [A,p,pˈ,P] [x, r: x%A] [v: ⊦ pˈ x] valid_eq v (eq_sym (P x r)) ❙
  eq_impl_back_eq: {A,Aˈ,p,pˈ} A≡Aˈ ⟶ ({x} x%A ⟶ ⊦ (p x) =bool (pˈ x)) ⟶ ({x} x%Aˈ ⟶ (⊦ pˈ x ⟶ ⊦ p x)) ❘
         = [A,Aˈ,p,pˈ,P,Q] [x, r:x%Aˈ] [s: ⊦ pˈ x] eq_impl_back (Q) x ((eqtp_subtp (eqtp_sym P)) x r) s❙
  wftm_eq: {t,tˈ,A,Aˈ} t%A ⟶ ⊦ t =A tˈ ⟶ A≡Aˈ ⟶ tˈ%Aˈ ❘
         = [t,tˈ,A,Aˈ,P,Q,R] (eqtp_subtp R) tˈ (eq_wf (eq_sym Q)) ❙         
  subtp_eq: {A,Aˈ,B,Bˈ} A<B ⟶ A≡Aˈ ⟶ B≡Bˈ ⟶ Aˈ<Bˈ ❘
          = [A,Aˈ,B,Bˈ,P,Q,R] subtp_trans (subtp_trans (eqtp_subtp eqtp_sym Q) P) (eqtp_subtp R) ❙
  
  prop_ext: {F,G} (⊦ F ⟶ ⊦ G) ⟶ (⊦ G ⟶ ⊦ F) ⟶ ⊦ F = bool G ❙

  pi: tp ⟶ (tm ⟶ tp) ⟶ tp❘ # Π 1 2❙
  lam: tp ⟶ (tm ⟶ tm) ⟶ tm❘ # λ 1 2❙
  app: tm ⟶ tm ⟶ tm❘ # 1 @ 2 prec 20❙
  
  pi_tp : {A,B} ({x} x%A ⟶ $ B x) ⟶ $ Π A [x] B x ❙
  lam_tp: {A,B,T} ({x} x%A ⟶ T x % B x) ⟶ (λ A [x] T x) % (Π A [x] B x) ❙

  lam_eq: {A,Aˈ,B,T,Tˈ} A≡Aˈ ⟶ ({x} x%A ⟶ ⊦ (T x) =(B x) (Tˈ x)) ⟶ ⊦ (λ A [x] T x) =(Π A [x] B x) (λ Aˈ [x] Tˈ x)❙
  app_eq: {A,B,f,fˈ,t,tˈ} ⊦ f =(Π A B) fˈ ⟶ ⊦ t =A tˈ ⟶ ⊦ (f@t) =(B t) (fˈ@tˈ)❙
  
  lam_eta: {A,B,f} f % (Π A [x] B x) ⟶ ⊦ f =(Π A [x] B x) (λ A [x] f @ x) ❙

//  lam_beta: {A,B,t,s} t%A ⟶ (λ A [x] s x) @ t % B t ⟶ (λ A [x] s x) @ t =(B t) (s t) ❙
  lam_beta: {A,B,t,s} ({x} x%A ⟶ t x % B x) ⟶ s%A ⟶ ⊦ (t s) =(B s) ((λ A [x] t x) @ s) ❙
   
  spi: tp ⟶ tp ⟶ tp❘ = [A,B] Π A [x] B❘ # 1 %R→ 2 prec 5❙
  spi_tp: {A,B,x,y} x%A ⟶ y%B ⟶ $(A→B) ❙
  spi_ident: {A,B,f} ({x} x%A ⟶ (f@x) % B) ⟶ f%(A→B) ❙
  spi_ident_back: {A,B,f,x} x%A ⟶ f%(A→B) ⟶ (f@x) % B ❙
  spi_app_eq: {A,B,f,fˈ,t,tˈ} ⊦ f =(A→B) fˈ ⟶ ⊦ t =A tˈ ⟶ ⊦ (f@t) =B (fˈ@tˈ)❙
  
  spi_subtp_r: {A,B,Bˈ} B<Bˈ ⟶ (A→B) < (A→Bˈ) ❘
           = [A,B,Bˈ,P] [f, r: (f%(A→B))] spi_ident [u, v: u%A] P (f@u) (spi_ident_back v r) ❙
  spi_subtp_l: {A,Aˈ,B} A<Aˈ ⟶ (Aˈ→B) < (A→B) ❘
           = [A,Aˈ,B,P] [f, r: (f%(Aˈ→B))] spi_ident [u, v: u%A] (spi_ident_back (P u v) r) ❙
  spi_subtp_lr: {A,Aˈ,B,Bˈ} A<Aˈ ⟶ B<Bˈ ⟶ (Aˈ→B) < (A→Bˈ) ❘
           = [A,Aˈ,B,Bˈ,P,Q] subtp_trans (spi_subtp_l P) (spi_subtp_r Q) ❙
  spi_eq: {A,Aˈ,B,Bˈ} A≡Aˈ ⟶ B≡Bˈ ⟶ (A→B) ≡ (Aˈ→Bˈ) ❘
           = [A,Aˈ,B,Bˈ,P,Q] sub_antisym (spi_subtp_lr (eqtp_subtp eqtp_sym P) (eqtp_subtp Q)) (spi_subtp_lr (eqtp_subtp P) (eqtp_subtp eqtp_sym Q))❙
           
  lam_betav: {A,B,t} ({x} x%A ⟶ t x % B) ⟶ ({s} s%A ⟶ ⊦ (t s) =B ((λ A [x] t x) @ s)) ❙
  spi_reduce: {A,B,t} ({x} x%A ⟶ t x % B) ⟶ (λ A [x] t x)%(A→B) ❘
            = [A,B,t,P] spi_ident [s, r:s%A] (eq_wf (eq_sym (lam_betav P s r))) ❙

  // these 3 rules should be provable❙
  exten_tp: {A,B,f} ({x} x%A ⟶ f@x % B x) ⟶ f % (Π A [x] B x)❘
          // = [A,B,f,P] eq_repl (lam_tp P) (lam_eta (lam_tp P)) eqtp_def    ❙
  app_tp: {A,B,f,t} f%(Π A [x] B x) ⟶ t%A ⟶ f@t % (B t) ❙
  app_tp_spi: {A,B,f} f%(Π A [x] B) ⟶ ({x} x%A ⟶ f@x % B) ❙
  exten_eq: {A,B,f,fˈ} ({x} x%A ⟶ ⊦ (f@x) =(B x) (fˈ@x)) ⟶ ⊦ f =(Π A B) fˈ❙
  pi_sub_r: {A,B,Bˈ} ({x} x%A ⟶ B x < Bˈ x) ⟶ (Π A [x] B x) < (Π A [x] Bˈ x) ❘
          = [A,B,Bˈ,P] [f, r: f%(Π A [x] B x)] exten_tp [u, v:u%A] (P u v (f@u) (app_tp r v)) ❙
  pi_sub_l: {A,Aˈ,B} A<Aˈ ⟶ (Π Aˈ [x] B x) < (Π A [x] B x) ❘
          = [A,Aˈ,B,P] [f, r: f%(Π Aˈ [x] B x)] exten_tp [u, v:u%A] (app_tp r (P u v)) ❙
  pi_sub_lr: {A,Aˈ,B,Bˈ} A<Aˈ ⟶ ({x} x%A ⟶ B x < Bˈ x) ⟶ (Π Aˈ [x] B x) < (Π A [x] Bˈ x) ❘
           = [A,Aˈ,B,Bˈ,P,Q] subtp_trans (pi_sub_l P) (pi_sub_r Q)❙
  pi_eq: {A,Aˈ,B,Bˈ} A≡Aˈ ⟶ ({x} x%A ⟶ B x ≡ Bˈ x) ⟶ (Π A [x] B x) ≡ (Π Aˈ [x] Bˈ x) ❘
       =  [A,Aˈ,B,Bˈ,P,Q] sub_antisym (pi_sub_lr (eqtp_subtp (eqtp_sym P)) (eqtp_subtp_map Aˈ B Bˈ (eqtp_param A Aˈ B Bˈ P Q))) (pi_sub_lr A Aˈ Bˈ B (eqtp_subtp P) (eqtp_subtp_map A Bˈ B (eqtp_sym_map A B Bˈ Q))) ❙
  
  refine: tp ⟶ (tm ⟶ tm) ⟶ tp❘# 1 | 2 prec 5❙
  refine_tp: {A,p} $A ⟶ ({x} x%A ⟶ p x % bool) ⟶ $A|p❙
  refine_I: {A,p,t} t % A ⟶ ⊦ p t ⟶ t % A|p ❙
  refine_E1: {A,p,t} t % A|p ⟶ t % A ❙
  refine_E2: {A,p,t} t % A|p ⟶ ⊦ p t ❙
  refine_eq_pres: {A,p,s,t} ⊦ s =A t ⟶ ({x} x%A ⟶ p x % bool) ⟶ ⊦ p s ⟶ ⊦ s =(A|p) t ❙
//                = [A,p,s,t,P,Q,R] refine_I (eq_wf (eq_sym P)) (valid eq R (spi_app_eq (eq_refl Q) P)) ❙
//  spi_app_eq: {A,B,f,fˈ,t,tˈ} ⊦ f =(A→B) fˈ ⟶ ⊦ t =A tˈ ⟶ ⊦ (f@t) =B (fˈ@tˈ)❙

  refine_sub: {A,p} $A|p ⟶ A|p < A ❘
            = [A,p,P] [x, r: x%A|p] refine_E1 r ❙
  refine_sub_l: {A,Aˈ,p} A<Aˈ ⟶ A|p < Aˈ|p ❘
               = [A,Aˈ,p,P] [f, r: f%A|p] refine_I (P f (refine_E1 r)) (refine_E2 r)❙ 
  refine_sub_r: {A,p,pˈ} ({x} x%A ⟶ (⊦ p x ⟶ ⊦ pˈ x)) ⟶ A|p < A|pˈ ❘
               = [A,p,pˈ,P] [f, r: f%A|p] refine_I (refine_E1 r) (P f (refine_E1 r) (refine_E2 r))❙
  refine_sub_lr: {A,Aˈ,p,pˈ} A<Aˈ ⟶ ({x} x%A ⟶ (⊦ p x ⟶ ⊦ pˈ x)) ⟶ A|p < Aˈ|pˈ ❘
               = [A,Aˈ,p,pˈ,P,Q] subtp_trans (refine_sub_r Q) (refine_sub_l P)❙
  refine_eq: {A,Aˈ,p,pˈ} A≡Aˈ ⟶ ({x} x%A ⟶ ⊦ (p x) =bool (pˈ x)) ⟶ A|p ≡ Aˈ|pˈ ❘
           = [A,Aˈ,p,pˈ,P,Q] sub_antisym (refine_sub_lr (eqtp_subtp P) ((eq_impl A p pˈ) Q)) (refine_sub_lr (eqtp_subtp eqtp_sym P) ((eq_impl_back_eq A Aˈ p pˈ) P Q))  ❙
  
  isBinRel: tp ⟶ (tm ⟶ tm ⟶ tm) ⟶ type ❘ role Judgment ❘
          = [A,r] {x,y} x%A ⟶ y%A ⟶ r x y % bool ❙ 
  isRefl: tp ⟶ (tm ⟶ tm ⟶ tm) ⟶ type ❘ role Judgment ❘
        = [A,r] isBinRel A r ⟶ ({x} x%A ⟶ ⊦r x x) ❙
  isSym: tp ⟶ (tm ⟶ tm ⟶ tm) ⟶ type ❘ role Judgment ❘
       = [A,r] isBinRel A r ⟶ ({x,y} x%A ⟶ y%A ⟶ ⊦r x y ⟶ ⊦r y x) ❙
  isTrans: tp ⟶ (tm ⟶ tm ⟶ tm) ⟶ type ❘ role Judgment ❘
         = [A,r] isBinRel A r ⟶ ({x,y,z} x%A ⟶ y%A ⟶ z%A ⟶ ⊦r x y ⟶ ⊦r y z ⟶ ⊦r x z) ❙ 
  isEqRel: tp ⟶ (tm ⟶ tm ⟶ tm) ⟶ type ❘ role Judgment ❘
         = [A,r] isBinRel A r ⟶ isRefl A r ⟶ isSym A r ⟶ isTrans A r ❙
     
         
  quotient: tp ⟶ (tm ⟶ tm ⟶ tm) ⟶ tp❘# 1 ∕ 2 prec 5❙
  quotient_form: {A,r} isEqRel A r ⟶ $A∕r ❙
  quotient_I: {A,t,r} t%A ⟶ $A∕r ⟶ t%A∕r ❙
  
  quotient_E: {A,B,s,t,r} s%A∕r ⟶ ({x} x%A ⟶ ⊦ x =(A∕r) s ⟶ (t x) % (B x)) ⟶ ({x,xˈ} x%A ⟶ xˈ%A ⟶ ⊦ x =(A∕r) s ⟶ ⊦ xˈ =(A∕r) s ⟶ ⊦ (t x) =(B x) (t xˈ)) ⟶ (t s) % (B s) ❙
  quotient_E_term: {A,B,s,t,r} s%A∕r ⟶ ({x} x%A ⟶ ⊦ x =(A∕r) s ⟶ (t x) % B) ⟶ ({x,xˈ} x%A ⟶ xˈ%A ⟶ ⊦ x =(A∕r) s ⟶ ⊦ xˈ =(A∕r) s ⟶ ⊦ (t x) =B (t xˈ)) ⟶ (t s) % B ❙
  quotient_Ev: {A,B,s,t,r} s%A∕r ⟶ ({x} x%A ⟶ (t x) % (B x)) ⟶ ({x,xˈ} x%A ⟶ xˈ%A ⟶ ⊦ x =(A∕r) s ⟶ ⊦ xˈ =(A∕r) s ⟶ ⊦ (t x) =(B x) (t xˈ)) ⟶ (t s) % (B s) ❙
  quotient_Ev_term: {A,B,s,t,r} s%A∕r ⟶ ({x} x%A ⟶ (t x) % B) ⟶ ({x,xˈ} x%A ⟶ xˈ%A ⟶ ⊦ x =(A∕r) s ⟶ ⊦ xˈ =(A∕r) s ⟶ ⊦ (t x) =B (t xˈ)) ⟶ (t s) % B ❙
  quotient_eq: {A,s,t,r} s%A ⟶ t%A ⟶ isEqRel A r ⟶ ⊦ (s =(A∕r) t) =bool (r s t)❙
  quotient_sub: {A,Aˈ,r,rˈ} A<Aˈ ⟶ isEqRel A r ⟶ isEqRel Aˈ rˈ ⟶ ({x,y} x%A ⟶ y%A ⟶ ⊦ r x y ⟶ ⊦ rˈ x y) ⟶ A∕r < Aˈ∕rˈ❙
   
  quotient_subtp: {A,r} $A∕r ⟶ A < A∕r ❘
                = [A,r,P] [x, s: x%A] (quotient_I A x r) s P ❙
                
//  triv_EqRel: tp ⟶ (tm ⟶ tm ⟶ tm) ❘ = [A] [x, y] x =A y ❙
//  triv_EqRel_wf: {A,x,y} x%A ⟶ y%A ⟶ triv_EqRel A x y % bool❙
//  triv_EqRel_isEqRel: {A} $A ⟶ isBinRel A (triv_EqRel A) ❙
//                    = [A,P] [x, y, r:x%A, s:y%A] (A (triv_EqRel A) (P r s (triv_EqRel_wf r s))) ❙
//  quotient_var: {A,r} $A ⟶ A ≡ A/( λ A [x] λ A [y] x =A y)❙

  // other laws for subtyping that relate multiple type constructors from the paper, should be provable❙
  
  impl: tm ⟶ tm ⟶ tm❘ # 1 ⇒ 2 prec 5❙
  impl_tp: {F,G} F%bool ⟶ (⊦F ⟶ G%bool) ⟶ F⇒G % bool ❙
  impl_tp_nondep: {F,G} F%bool ⟶ G%bool ⟶ F⇒G % bool❘
         = [F,G,p,q] impl_tp p [r] q❙
  impl_I: {F,G} (⊦F ⟶ ⊦G) ⟶ ⊦F⇒G ❙
  impl_E: {F,G} ⊦F⇒G ⟶ ⊦F ⟶ ⊦G ❙
  
  // all of the following should be provable❙
  
  true: tm ❘ = (λ bool [x] x) =bool (λ bool [x] x) ❙
  true_tp: true%bool❙
  trueI : ⊦true❙
  
  false: tm ❘ = (λ bool [x] x) =bool (λ bool [x] true) ❙
  false_tp: false%bool❙
  falseE: ⊦false ⟶ ↯❙
  
  true_rel: tp ⟶ (tm ⟶ tm ⟶ tm) ❙
  true_rel_rule: {A,x,y} x%A ⟶ y%A ⟶ ⊦ true_rel A x y =bool true ❙
  true_rel_isBinRel: {A} $A ⟶ isBinRel A (true_rel A) ❘
                   = [A, P] A (true_rel A) [x,y, r: x%A, s:y%A] (eq_wf x y A (true_rel_rule A x y r s)) ❙
//                  {x,y} x%A ⟶ y%A ⟶ r x y % bool
 
  not: tm ⟶ tm ❘ # ¬ 1 ❘ = [F] F =bool false ❙
  not_I: {F,G} (⊦F ⟶ ⊦G) ⟶ (⊦F ⟶ ⊦¬G) ⟶ ⊦¬F ❙
  not_E: {F} ⊦¬¬F ⟶ ⊦F ❙
  impl_neg: {F,G} ⊦F⇒G ⟶ ⊦¬G⇒¬F ❘
         = [F,G,P] _ ❙
   
  or: tm ⟶ tm ⟶ tm ❘ # 1 ∨ 2 ❘ = [F,G] ¬F ⇒ G ❙ 
  or_tp: {F,G} F%bool ⟶ (⊦¬F ⟶ G%bool) ⟶ F∨G % bool ❙
  or_Il: {F,G} G%bool ⟶ ⊦F ⟶ ⊦F∨G ❙
  or_Ir: {F,G} F%bool ⟶ ⊦G ⟶ ⊦F∨G ❙
  or_E: {F,G,C} ⊦F∨G ⟶ (⊦F ⟶ ⊦C) ⟶ (⊦G ⟶ ⊦C) ⟶ ⊦C ❙
  or_impl: {F,G} ⊦F∨G ⟶ ⊦¬F⇒G ❘
         = [F,G,P] _ ❙
  or_Er_false: {F,G} ⊦F∨G ⟶ ⊦¬F ⟶ ⊦G ❙
  or_El_false: {F,G} ⊦F∨G ⟶ ⊦¬G ⟶ ⊦F ❙
  
  and: tm ⟶ tm ⟶ tm ❘ # 1 ∧ 2 ❘ = [F,G] ¬(F ⇒ ¬G) ❙
  and_tp: {F,G} F%bool ⟶ (⊦F ⟶ G%bool) ⟶ F∧G % bool ❙
  and_I: {F,G} ⊦F ⟶ ⊦G ⟶ ⊦F∧G ❙
  and_El: {F,G} ⊦F∧G ⟶ ⊦F ❙
  and_Er: {F,G} ⊦F∧G ⟶ ⊦G ❙
  and_swap: {F,G} ⊦F∧G ⟶ ⊦G∧F ❘
          = [F,G,P] and_I (and_Er P) (and_El P)❙
  and_El_neg: {F} ⊦¬F∧F ⟶ ⊦¬F ❘
            = [F,P] and_El P ❙
  and_Er_neg: {F} ⊦¬F∧F ⟶ ⊦F ❘
            = [F,P] and_Er P ❙

  neg_impl: {F,G} G%bool ⟶ ⊦¬F ⟶ (⊦F ⟶ ⊦G) ❘
          = [F,G,P,Q] [s: ⊦F] or_Er_false (or_Il P s) Q ❙           
  contra2: {F,G} G%bool ⟶ ⊦¬F∧F ⟶ ⊦G ❘
         = [F,G,P,Q] neg_impl P (and_El_neg Q) (and_Er_neg Q)❙

  contra_implies_formula: {F} (⊦F ⟶ ↯) ⟶ ⊦¬F ❘
                = [F,P] _ ❙
   
  equivalence: tm ⟶ tm ⟶ tm ❘ # 1 ⇔ 2 ❙
  // definition and rules❙
  
  forall: tp ⟶ (tm ⟶ tm) ⟶ tm ❘ # ∀ 1 2 ❘ = [A,F] (λ A [x] F x) =(A→bool) (λ A [x] true) ❙
  forall_tp❙
  forall_I: {A,p} ({x} x%A ⟶ ⊦ p x) ⟶ ⊦ ∀ A [x] p x ❙
  forall_E: {A,p} ⊦ (∀ A [x] p x) ⟶ ({x} x%A ⟶ ⊦ p x) ❙
  
  exists: tp ⟶ (tm ⟶ tm) ⟶ tm ❘ # ∃ 1 2 ❘ = [A,F] ¬(∀ A [x] ¬(F x)) ❙
  exists_tp❙
  exists_I: {A,p} (({x} x%A ⟶ ⊦ ¬(p x)) ⟶ ↯) ⟶ ⊦ ∃ A [x] p x ❙
  exists_E: {A,F,p} ⊦(∃ A [x] p x) ⟶ ({x} x%A ⟶ ⊦p x ⟶ ⊦F) ⟶ ⊦F ❙

  TND: {F} F%bool ⟶ ⊦F∨¬F ❙
  bool_ext: {p} ⊦p true ⟶ ⊦p false ⟶ ({x} x%bool ⟶ ⊦p x)❙
 
  is_in_class: tp ⟶ tm ⟶ tm ⟶ tm ❙
  is_in_class_rule: {A,x,y} x%A ⟶ y%A ⟶ ⊦ (is_in_class A x y) =bool (x =A y) ❙
  quotient_Ev_termv: {A,B,s,t,r} s%A∕r ⟶ ({x} x%A ⟶ (t x) % B) ⟶ ⊦ ¬(∃ A [x] is_in_class (A∕r) x s) ⟶ (t s) % B ❙
  
  quotient_classes: {A,r,y} y%A∕r ⟶ ⊦ ∃ A [x] is_in_class (A∕r) x y ❘
                  = [A,r,y,P] _ ❙ 
  
  true_A: tp ⟶ tm ⟶ tm ❙ 
  true_A_is_true: {A,x} x%A ⟶ ⊦ true_A A x =bool true ❙
  true_type_pred = [x] x =bool true ❙
  true_type: tp ❘ = bool | true_type_pred ❙
  
 
  
  terms_in_class: {A,y} y%A ⟶ ⊦ ∃ A [x] is_in_class A x y ❘
                = [A,y,P] _ ❙
  
//  quotient_ext: {A,B,r,p} ({x} x%A∕r ⟶ p x % B) ⟶ ({x,xˈ} x%A ⟶ xˈ%A ⟶ ⊦ (p x) =B (p xˈ)) ⟶ ({y,yˈ} y%A∕r ⟶ yˈ%A∕r ⟶ ⊦ (p y) =B (p yˈ)) ❙
//                   = [A,B,r,p,P,Q] [y, yˈ, s:y%(A∕r), t:yˈ%(A∕r)] _ ❙
                   
//  quotient_func_ext: {A,B,r,p} ({x} x%A ⟶ p x % B) ⟶ ({x,y} ⊦ r x y ⟶ ⊦ (p x) =B (p y)) ⟶ ({y} y%A∕r ⟶ p y % B) ❙
//                   = [A,B,r,p,P,Q] [y, s:y%(A∕r)] quotient_Ev_term sP ❙

//  quotient_Ev_term: {A,B,s,t,r} s % A∕r ⟶ ({x} x%A ⟶ (t x) % B) ⟶ ({x,xˈ} x%A ⟶ xˈ%A ⟶ ⊦ x =(A∕r) s ⟶ ⊦ xˈ =(A∕r) s ⟶ ⊦ (t x) =B (t xˈ)) ⟶ (t s) % B ❙

  
❚

/T Example 1❚
theory Lists : ?DHOL =
  nat: tp❙
  obj: tp❙

  zero: tm❙
  zero_tp: zero % nat❙
  
  succ: tm❙
  succ_tp: succ % nat → nat❙
  
  llist: tm ⟶ tp❙
  llist_tp: {x} x%nat ⟶  $ llist x❙

  
  lcons: tm❙
  lcons_tp: lcons % Π nat [n] obj → llist n → llist (succ @ n)❙
 
❚
