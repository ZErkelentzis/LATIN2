namespace latin:/casestudies/comptrans/aritypoly ❚
fixmeta ur:?LF ❚
rule scala://parser.api.mmt.kwarc.info?MMTURILexer ❚

/T Nat on meta-level instead of object-level makes it easier to use in Types theory below ❚
theory Nat =
  nat: type ❘ # ℕ ❙
  z: ℕ ❙
  s: ℕ ⟶ ℕ ❙
  plus: ℕ ⟶ ℕ ⟶ ℕ ❘ # 1 + 2 ❙
❚

/T Theory of cumulative hard-typed type theories ❚
theory CumTypes =
  include ?Nat ❙
  univ: ℕ ⟶ type ❙
  tm: {n: ℕ} univ n ⟶ type ❘ # tm 2 prec 10 ❙

  /T _cast_ ty_p_es .❙
  castp: {n} univ n ⟶ univ (s n) ❘ # 2 ↑ prec 20 ❙
  /T _cast_ ter_m_s . ❙
  castm: {n,U: univ n} tm U ⟶ tm U↑ ❘ # 3 ⇑ ❙

  base: univ z ❙
❚

// id_{CumTypes}: identity morphism, comptrans on empty list
   built-in in MMT, hence not given

   Basic Lemma yields:
      true       ===> |- base : univ z
❚

/T comptrans on <incl. morphism Nat -> CumTypes>

   Basic Lemma yields:
      |- n : nat ===> |- base↑…↑ : univ n   (n type casts)
❚
theory CumTypes_TypeCasts =
  include ?Types ❙

  _N: ℕ ⟶ type ❘ = [n: ℕ] univ n ❙
  _z: univ z ❘ = base ❙
  _s: {n: ℕ, U: univ n} univ (s n) ❘ = [n,U] U↑ ❙
❚

/T comptrans on <CumTypes_TypeCasts>

   Basic Lemma yields:
          |- n : nat  /\ |- _z : tm base
     ===> |- _z⇑…⇑ : tm base↑…↑      (n term and type casts)
❚
theory CumTypes_TermCasts =
  include ?Types ❙

  _N: {n: ℕ} univ n ⟶ type ❘ = [n, U] tm U ❙

  /T not defined since this comptrans (and the resulting Basic Lemma) are polymorphic in MMT terms of type `tm base` ❙
  _z: tm base ❙
  _s: {n: ℕ, U: univ n} tm U ⟶ tm U↑ ❘ = [n,U,t] t⇑ ❙

  // further idea: generalize from `base: univ z` to `base: Σn: univ n`. ❙
❚

/T Theory of soft-typed type theories with cumulative type hierarchy ❚
theory InternalCumTypes =
  include ?Nat ❙
  include ☞latin:/?IPLND ❙
  include ☞latin:/?Proofs ❙
  include ☞latin:/?InformalProofs ❙
  include ☞latin:/?SoftTypedTerms ❙
  include ☞latin:/?SoftTypedPredicateSubtypes ❙

  univ: nat ⟶ type ❙
  inj: {n: nat} univ n ⟶ tp ❘ # τ 2 ❙
  has_type : {n: nat} univ n ⟶ term ⟶ prop ❘ = [n,U,t] t ⦂ τ U ❘# 3 ∈ 2 ❙

  castp: {n,U: univ n} univ (s n) ❘ # 2 ↑ prec 20 ❙
  castm: {n,U: univ n,t: term} ⊦ (t ∈ U) ⇒ (t ∈ U↑) ❘# 3 ⇑ 2 ❙

  base: univ z ❙
  // can_cast_to_all: {n,m,U: univ n,t: term} ⊦ (t ⦂ τ U) ⇒ (t ⦂ τ (n + m))
               ❘ = [n,m,t] sketch "provable via induction on m (ignoring the issue that Nat is an LF-level formalization)" ❙
❚

/T Erase types. Concretely, starting with CumTypes

   - on type-level: do nothing (identity on `univ`, `castp`, and `base`)
   - on term-level: erase types in hard-typed terms (assignments to `tm` and `castm`)

   Abbreviated as TE in comments below.
❚
view TypeEras : ?Types -> ?InternalCumTypes =
  include ?Nat ❙
  univ = univ ❙
  tm = [n,U] term ❙
  castp = castp ❙
  castm = [n,U,t] t ❙
  base = base ❙
❚

/T comptrans on <TypeEras>

   Basic Lemma yields:
          |- U : univ n  /\  |- t : tm U
     ===> |- TE(t) : ⊦ t ⦂ (τ U)
❚
theory TypePres =
  include ?CumulativeInternalTypes ❙
  include ?Nat ❙
  // partial on univ and Nat ❙
  _tm: {n,U: univ n} term ⟶ type ❘ = [n,U,t] ⊦ t ∈ U ❙
  // partial on castp ❙

  // does partiality on castp (unfortunately) enforce partiality on castm, too? ❙
  _castm: {n,U: univ n,t: term, tt: ⊦ t ∈ U} ⊦ t ∈ U↑
        ❘ = [n,U,t,tt] (t ⇑ U) implE tt ❙
❚

/T comptrans InternalCumTypes_TermCasts := TE ∘ CumTypes_TermCasts.

   Basic Lemma yields:
          |- n : nat  /\ |- _z : tm base
     ===> ⊦ TE(_z⇑…⇑) ∈ base↑…↑  provable         (n term and type casts)
❚
