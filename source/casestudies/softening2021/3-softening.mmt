// Library of hard-typed features
   ========================================== ❚

namespace latin:/casestudies/softening2021 ❚
fixmeta ?Meta ❚

diagram HAll := baseddiag(diag(?Meta),
  ?Proofs, ?HTyped, ?HProd, ?HEqual, ?HFun, ?HDepFun, ?HBeta, ?HEta, ?HExten, ?HDepBeta
) ❚

diagram HAllLogrels :=
  COMPTRANS OF SKELETON
  ctskel(
    "r",
    ctskel("m", symbols(?Proofs?ded)),
    symbols(?Proofs?prop, ?HTyped?tp)
  )
  OVER ?Meta
  OF ?HAll
❚

view TypePres : ?HTyped_comptrans -> ?STyped =
  constant prop/m = prop ❙
  constant ded/r  = ded  ❙

  constant tp/m   = tp   ❙
  constant tm/m   = [x] term ❙
  constant tm/r   = [A,t] ⊦ t ⦂ A ❙
❚

diagram HLibraryLogrels := (?HAllLogrels EXCEPT diag(?Proofs_comptrans,?HTyped_comptrans)) REBASED TO ?HTyped_comptrans ❚

diagram STypedLibraryDirty := PUSHOUT ?TypePres ?HLibraryLogrels ❚
diagram STypedLibrary := DROP_ARGS_DEFAULT diag(?STyped) ?STypedLibraryDirty ❚
