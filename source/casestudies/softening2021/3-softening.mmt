// Library of hard-typed features
   ========================================== ❚

namespace latin:/casestudies/softening2021 ❚
fixmeta ?Meta ❚

diagram HAll := baseddiag(diag(?Meta),
  ?Proofs, ?HTyped, ?HProd, ?HEqual, ?HFun, ?HDepFun, ?HBeta, ?HEta, ?HExten, ?HDepBeta
) ❚
diagram HAllLogrels :=
  LOGRELS OF ARITY "1"
  OVER ?Meta
  PARTIAL ON symbols(?Proofs?prop, ?Proofs?ded, ?HTyped?tp)
  OF ?HAll
❚

view TypePres : ?HTyped_logrel -> ?STyped =
  prop_0 = prop❙
  ded_0 = ded ❙
  tp_0 = tp ❙
  tm_0 = [x] term ❙
  tm_r = [A, t] ⊦ t ⦂ A ❙
❚

diagram HLibraryLogrels := (?HAllLogrels EXCEPT diag(?Proofs,?HTyped)) REBASED TO ?HTyped_logrel ❚

diagram STypedLibraryDirty := PUSHOUT ?TypePres ?HLibraryLogrels ❚
diagram STypedLibrary := DEFAULT_DROP_ARGS diag(?STyped) ?STypedLibraryDirty ❚ // <-- removes unused arg positions ❚
