// Library of hard-typed features
   ========================================== ❚

namespace latin:/casestudies/softening2021 ❚
fixmeta ?Meta ❚

theory HProd =
  include ?HTyped ❙
  prod: tp ⟶ tp ⟶ tp  ❘# 1 × 2 ❙
  pair: {A, B} tm A ⟶ tm B ⟶ tm A×B ❘# ⟪ 3 , 4 ⟫ ❙
  projL: {A, B} tm A×B ⟶ tm A ❘# πl 3 ❙
  projR: {A, B} tm A×B ⟶ tm B ❘# πr 3 ❙
❚

theory HEqual =
  include ?HTyped ❙

  eq: {A} tm A ⟶ tm A ⟶ prop
    ❘# 2 ≐ 3 prec 5
    ❘ meta http://cds.omdoc.org/urtheories?DiagramOperators?drop_args_keep drop_args_keep_specific "1"
  ❙
  refl: {A,x: tm A} ⊦ x ≐ x ❘# refl 2 ❙
  eqsub: {A, x,y: tm A} ⊦ x ≐ y ⟶ {F: tm A ⟶ prop} ⊦ F x ⟶ ⊦ F y ❘# eqsub 4 5 6 ❙

  sym    : {A,x,y: tm A} ⊦ x ≐ y ⟶ ⊦ y ≐ x ❘# sym 4 ❘
         = [A,x,y,p] eqsub p ([u] u ≐ x) refl x ❙
  trans  : {A,x,y,z: tm A} ⊦ x ≐ y ⟶ ⊦ y ≐ z ⟶ ⊦ x ≐ z ❘# 5 trans 6 ❘
         = [A,x,y,z,p,q] eqsub q ([u] x ≐ u) p ❙
❚

theory HFun =
  include ?HEqual ❙
  fun: tp ⟶ tp ⟶ tp ❘# 1 → 2 ❙
  lam: {A, B} (tm A ⟶ tm B) ⟶ tm A→B
    ❘# λ 3 prec 10
    ❘ meta http://cds.omdoc.org/urtheories?DiagramOperators?drop_args_keep drop_args_keep_specific "1"
  ❙
  app: {A, B} tm A→B ⟶ tm A ⟶ tm B ❘# 3 @ 4 prec 20 ❙
❚

theory HDepFun =
  include ?HEqual ❙
  dfun: {A} (tm A ⟶ tp) ⟶ tp
    ❘ # Π 2
    ❘ meta http://cds.omdoc.org/urtheories?DiagramOperators?drop_args_keep drop_args_keep_specific "1"
  ❙
  dlam: {A, B: tm A ⟶ tp} ({x: tm A} tm (B x)) ⟶ tm (Π B)
    ❘ # λ 3 prec 10
    ❘ meta http://cds.omdoc.org/urtheories?DiagramOperators?drop_args_keep drop_args_keep_specific "1"
  ❙
  dapp: {A, B: tm A ⟶ tp} tm Π B ⟶ {x: tm A} tm (B x) ❘# 3 @ 4 prec 20 ❙
❚

theory HBeta =
  include ?HFun ❙
  beta: {A, B, F: tm A ⟶ tm B, x: tm A} ⊦ (λ F) @ x ≐ F x ❘# beta %I4 ❙

❚

theory HEta =
  include ?HFun ❙
  // TODO order of LHS, RHS of eq is reversed from paper ❙
  eta: {A, B, f: tm A→B} ⊦ (λ [x: tm A] f @ x) ≐ f ❘# eta %I3 ❙
❚

theory HExten =
  include ?HFun ❙
  exten : {A, B, F: tm A ⟶ tm B, G: tm A ⟶ tm B} ({x: tm A} ⊦ F x ≐ G x) ⟶ ⊦ λ F ≐ λ G ❘# xi 5 ❙
❚

theory HDepBeta =
  include ?HDepFun ❙
  beta: {A, B, F: {x:tm A} tm B x, x: tm A} ⊦ (λ F) @ x ≐ F x ❘# beta %I4 ❙
❚

theory HDepEta =
  include ?HDepFun ❙
  xi : {A, B, F: {x:tm A}tm B, G: tm A ⟶ tm B} ({x: tm A} ⊦ F x ≐ G x) ⟶ ⊦ λ F ≐ λ G ❘# xi 5 ❙
❚
