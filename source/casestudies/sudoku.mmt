    c64Hc69 : ⊦ (c₆₄ ℋ c₆₉)❙ c64Hc70 : ⊦ (c₆₄ ℋ c₇₀)❙ c64Hc71 : ⊦ (c₆₄ ℋ c₇₁)❙ c64Hc72 : ⊦ (c₆₄ ℋ c₇₂)❙
    c73Hc74 : ⊦ (c₇₃ ℋ c₇₄)❙ c73Hc75 : ⊦ (c₇₃ ℋ c₇₅)❙ c73Hc76 : ⊦ (c₇₃ ℋ c₇₆)❙ c73Hc77 : ⊦ (c₇₃ ℋ c₇₇)❙
