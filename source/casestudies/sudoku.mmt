    c41given : ⊦ (□ (c₄₁ Π ④))❙ c42given : ⊦ (□ (c₄₂ Π ①))❙ c43given : ⊦ (□ (c₄₃ Π ②))❙ c44given : ⊦ (□ (c₄₄ Π ⑤))❙
    c45given : ⊦ (□ (c₄₅ Π ⑥))❙ c46given : ⊦ (□ (c₄₆ Π ⑤))❙ c47given : ⊦ (□ (c₄₇ Π ⑨))❙ c48given : ⊦ (□ (c₄₈ Π ⑥))❙
    c49given : ⊦ (□ (c₄₉ Π ②))❙ c50given : ⊦ (□ (c₅₀ Π ⑧))❙ c51given : ⊦ (□ (c₅₁ Π ③))❙ c52given : ⊦ (□ (c₅₂ Π ①))❙
    c53given : ⊦ (□ (c₅₃ Π ⑦))❙ c54given : ⊦ (□ (c₅₄ Π ④))❙ c55given : ⊦ (□ (c₅₅ Π ③))❙ c56given : ⊦ (□ (c₅₆ Π ⑤))❙
    c57given : ⊦ (□ (c₅₇ Π ⑧))❙ c58given : ⊦ (□ (c₅₈ Π ①))❙ c59given : ⊦ (□ (c₅₉ Π ⑦))❙ c60given : ⊦ (□ (c₆₀ Π ⑥))❙
