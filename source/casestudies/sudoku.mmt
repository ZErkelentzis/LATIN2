    c07Vc16 : ⊦ (c₀₇ 𝒱 c₁₆)❙ c07Vc25 : ⊦ (c₀₇ 𝒱 c₂₅)❙ c07Vc34 : ⊦ (c₀₇ 𝒱 c₃₄)❙ c07Vc43 : ⊦ (c₀₇ 𝒱 c₄₃)❙
    c07Vc52 : ⊦ (c₀₇ 𝒱 c₅₂)❙ c07Vc61 : ⊦ (c₀₇ 𝒱 c₆₁)❙ c07Vc70 : ⊦ (c₀₇ 𝒱 c₇₀)❙ c07Vc79 : ⊦ (c₀₇ 𝒱 c₇₉)❙
    c08Vc17 : ⊦ (c₀₈ 𝒱 c₁₇)❙ c08Vc26 : ⊦ (c₀₈ 𝒱 c₂₆)❙ c08Vc35 : ⊦ (c₀₈ 𝒱 c₃₅)❙ c08Vc44 : ⊦ (c₀₈ 𝒱 c₄₄)❙
    c08Vc53 : ⊦ (c₀₈ 𝒱 c₅₃)❙ c08Vc62 : ⊦ (c₀₈ 𝒱 c₆₂)❙ c08Vc71 : ⊦ (c₀₈ 𝒱 c₇₁)❙ c08Vc80 : ⊦ (c₀₈ 𝒱 c₈₀)❙
    c09Vc18 : ⊦ (c₀₉ 𝒱 c₁₈)❙ c09Vc27 : ⊦ (c₀₉ 𝒱 c₂₇)❙ c09Vc36 : ⊦ (c₀₉ 𝒱 c₃₆)❙ c09Vc45 : ⊦ (c₀₉ 𝒱 c₄₅)❙
    c09Vc54 : ⊦ (c₀₉ 𝒱 c₅₄)❙ c09Vc63 : ⊦ (c₀₉ 𝒱 c₆₃)❙ c09Vc72 : ⊦ (c₀₉ 𝒱 c₇₂)❙ c09Vc81 : ⊦ (c₀₉ 𝒱 c₈₁)❙

    c01Bc11 : ⊦ (c₀₁ ℬ c₁₁)❙ c02Bc11 : ⊦ (c₀₂ ℬ c₁₁)❙ c03Bc11 : ⊦ (c₀₃ ℬ c₁₁)❙ c10Bc11 : ⊦ (c₁₀ ℬ c₁₁)❙
    c12Bc11 : ⊦ (c₁₂ ℬ c₁₁)❙ c19Bc11 : ⊦ (c₁₉ ℬ c₁₁)❙ c20Bc11 : ⊦ (c₂₀ ℬ c₁₁)❙ c21Bc11 : ⊦ (c₂₁ ℬ c₁₁)❙
    c04Bc14 : ⊦ (c₀₄ ℬ c₁₄)❙ c05Bc14 : ⊦ (c₀₅ ℬ c₁₄)❙ c06Bc14 : ⊦ (c₀₆ ℬ c₁₄)❙ c13Bc14 : ⊦ (c₁₃ ℬ c₁₄)❙
    c15Bc14 : ⊦ (c₁₅ ℬ c₁₄)❙ c22Bc14 : ⊦ (c₂₂ ℬ c₁₄)❙ c23Bc14 : ⊦ (c₂₃ ℬ c₁₄)❙ c24Bc14 : ⊦ (c₂₄ ℬ c₁₄)❙
    c07Bc17 : ⊦ (c₀₇ ℬ c₁₇)❙ c08Bc17 : ⊦ (c₀₈ ℬ c₁₇)❙ c09Bc17 : ⊦ (c₀₉ ℬ c₁₇)❙ c16Bc17 : ⊦ (c₁₆ ℬ c₁₇)❙
    c18Bc17 : ⊦ (c₁₈ ℬ c₁₇)❙ c25Bc17 : ⊦ (c₂₅ ℬ c₁₇)❙ c26Bc17 : ⊦ (c₂₆ ℬ c₁₇)❙ c27Bc17 : ⊦ (c₂₇ ℬ c₁₇)❙
    c28Bc38 : ⊦ (c₂₈ ℬ c₃₈)❙ c29Bc38 : ⊦ (c₂₉ ℬ c₃₈)❙ c30Bc38 : ⊦ (c₃₀ ℬ c₃₈)❙ c37Bc38 : ⊦ (c₃₇ ℬ c₃₈)❙
    c39Bc38 : ⊦ (c₃₉ ℬ c₃₈)❙ c46Bc38 : ⊦ (c₄₆ ℬ c₃₈)❙ c47Bc38 : ⊦ (c₄₇ ℬ c₃₈)❙ c48Bc38 : ⊦ (c₄₈ ℬ c₃₈)❙
    c31Bc41 : ⊦ (c₃₁ ℬ c₄₁)❙ c32Bc41 : ⊦ (c₃₂ ℬ c₄₁)❙ c33Bc41 : ⊦ (c₃₃ ℬ c₄₁)❙ c40Bc41 : ⊦ (c₄₀ ℬ c₄₁)❙
    c42Bc41 : ⊦ (c₄₂ ℬ c₄₁)❙ c49Bc41 : ⊦ (c₄₉ ℬ c₄₁)❙ c50Bc41 : ⊦ (c₅₀ ℬ c₄₁)❙ c51Bc41 : ⊦ (c₅₁ ℬ c₄₁)❙
    c34Bc44 : ⊦ (c₃₄ ℬ c₄₄)❙ c35Bc44 : ⊦ (c₃₅ ℬ c₄₄)❙ c36Bc44 : ⊦ (c₃₆ ℬ c₄₄)❙ c43Bc44 : ⊦ (c₄₃ ℬ c₄₄)❙
    c45Bc44 : ⊦ (c₄₅ ℬ c₄₄)❙ c52Bc44 : ⊦ (c₅₂ ℬ c₄₄)❙ c53Bc44 : ⊦ (c₅₃ ℬ c₄₄)❙ c54Bc44 : ⊦ (c₅₄ ℬ c₄₄)❙
    c55Bc65 : ⊦ (c₅₅ ℬ c₆₅)❙ c56Bc65 : ⊦ (c₅₆ ℬ c₆₅)❙ c57Bc65 : ⊦ (c₅₇ ℬ c₆₅)❙ c64Bc65 : ⊦ (c₆₄ ℬ c₆₅)❙
    c66Bc65 : ⊦ (c₆₆ ℬ c₆₅)❙ c73Bc65 : ⊦ (c₇₃ ℬ c₆₅)❙ c74Bc65 : ⊦ (c₇₄ ℬ c₆₅)❙ c75Bc65 : ⊦ (c₇₅ ℬ c₆₅)❙
    c58Bc68 : ⊦ (c₅₈ ℬ c₆₈)❙ c59Bc68 : ⊦ (c₅₉ ℬ c₆₈)❙ c60Bc68 : ⊦ (c₆₀ ℬ c₆₈)❙ c67Bc68 : ⊦ (c₆₇ ℬ c₆₈)❙
    c69Bc68 : ⊦ (c₆₉ ℬ c₆₈)❙ c76Bc68 : ⊦ (c₇₆ ℬ c₆₈)❙ c77Bc68 : ⊦ (c₇₇ ℬ c₆₈)❙ c78Bc68 : ⊦ (c₇₈ ℬ c₆₈)❙
    c61Bc71 : ⊦ (c₆₁ ℬ c₇₁)❙ c62Bc71 : ⊦ (c₆₂ ℬ c₇₁)❙ c63Bc71 : ⊦ (c₆₃ ℬ c₇₁)❙ c70Bc71 : ⊦ (c₇₀ ℬ c₇₁)❙
    c72Bc71 : ⊦ (c₇₂ ℬ c₇₁)❙ c79Bc71 : ⊦ (c₇₉ ℬ c₇₁)❙ c80Bc71 : ⊦ (c₈₀ ℬ c₇₁)❙ c81Bc71 : ⊦ (c₈₁ ℬ c₇₁)❙

    alldiff_column_1 : ⊦ (⋖ c01 c10 c19 c28 c37 c46 c55 c64 c73⋗)❙
    alldiff_column_2 : ⊦ (⋖ c02 c11 c20 c29 c38 c47 c56 c65 c74⋗)❙
    alldiff_column_3 : ⊦ (⋖ c03 c12 c21 c30 c39 c48 c57 c66 c75⋗)❙
    alldiff_column_4 : ⊦ (⋖ c04 c13 c22 c31 c40 c49 c58 c67 c76⋗)❙
    alldiff_column_5 : ⊦ (⋖ c05 c14 c23 c32 c41 c50 c59 c68 c77⋗)❙
    alldiff_column_6 : ⊦ (⋖ c06 c15 c24 c33 c42 c51 c60 c69 c78⋗)❙
    alldiff_column_7 : ⊦ (⋖ c07 c16 c25 c34 c43 c52 c61 c70 c79⋗)❙
    alldiff_column_8 : ⊦ (⋖ c08 c17 c26 c35 c44 c53 c62 c71 c80⋗)❙
    alldiff_column_9 : ⊦ (⋖ c09 c18 c27 c36 c45 c54 c63 c72 c81⋗)❙

    // If two cells are in one of these relations to each other, they're not equal. ❙
    uneq_H : { c1 : tm cell, c2 : tm cell } (⊦ (c1 ℋ c2)) ⟶ (⊦ (c1 ≠ c2))❙
    uneq_V : { c1 : tm cell, c2 : tm cell } (⊦ (c1 𝒱 c2)) ⟶ (⊦ (c1 ≠ c2))❙
    uneq_B : { c1 : tm cell, c2 : tm cell } (⊦ (c1 ℬ c2)) ⟶ (⊦ (c1 ≠ c2))❙
❚

theory SudokuPencilMarks =
    include ?TypedLogic❙
    include ?SFOLEQND❙
    include ?MLHilbert❙
    include ?ExclusiveOr❙
    include ?AllDifferent❙

    // Pencil Marks❙
    PM  : tp❙
    pm1 : tm PM❘# ①❙ pm2 : tm PM❘# ②❙ pm3 : tm PM❘# ③❙ pm4 : tm PM❘# ④❙ pm5 : tm PM❘# ⑤❙ pm6 : tm PM❘# ⑥❙
    pm7 : tm PM❘# ⑦❙ pm8 : tm PM❘# ⑧❙ pm9 : tm PM❘# ⑨❙

    upper_bound_axiom_pm : {p : tm PM} ⊦ ((p ≐ ①) ⨂ (p ≐ ②) ⨂ (p ≐ ③) ⨂ (p ≐ ④) ⨂ (p ≐ ⑤) ⨂ (p ≐ ⑥) ⨂ (p ≐ ⑦) ⨂ (p ≐ ⑧) ⨂ (p ≐ ⑨))❙

    stndard_alldiff : ⊦ (⋖ ① ② ③ ④ ⑤ ⑥ ⑦ ⑧ ⑨ ⋗)❙
❚

theory Sudoku =
    include ?SudokuBoard❙
    include ?SudokuPencilMarks❙

    // Accessibility relation ❙
    pencil : tm cell ⟶ tm PM ⟶ prop❘# 1 Π 2 prec 30❙ // Pencil Marks❙
❚

// Cell-Based Elimination❚
theory SudokuStrategyCBE =
    include ?Sudoku❙
    cbe : {d1 : tm PM, d2 : tm PM, c : tm cell} (⊦ (d1 ≠ d2)) ⟶ (⊦ (□ (c Π d1))) ⟶ (⊦ (¬ (◇ (c Π d2))))❙
❚

// Pencil Mark Duality❚
theory SudokuStrategyPMD =
    include ?Sudoku❙
    include ?ExclusiveOr❙

    pmd1 : { d1 : tm PM, d2 : tm PM, d3 : tm PM, d4 : tm PM, d5 : tm PM, d6 : tm PM, d7 : tm PM, d8 : tm PM, d9 : tm PM , c : tm cell }
         (⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗))
         ⟶ (⊦ (◇ (c Π d1)))
         ⟶ (⊦ (¬ (◇ (c Π d2)))) ⟶ (⊦ (¬ (◇ (c Π d3)))) ⟶ (⊦ (¬ (◇ (c Π d4)))) ⟶ (⊦ (¬ (◇ (c Π d5))))
         ⟶ (⊦ (¬ (◇ (c Π d6)))) ⟶ (⊦ (¬ (◇ (c Π d7)))) ⟶ (⊦ (¬ (◇ (c Π d8)))) ⟶ (⊦ (¬ (◇ (c Π d9))))
         ⟶ (⊦ (□ (c Π d1)))❙

    pmd2 : { d1 : tm PM, d2 : tm PM, d3 : tm PM, d4 : tm PM, d5 : tm PM, d6 : tm PM, d7 : tm PM, d8 : tm PM, d9 : tm PM , c : tm cell }
         (⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗))
         ⟶ (⊦ (◇ (c Π d1))) ⟶ (⊦ (◇ (c Π d2)))
         ⟶ (⊦ (¬ (◇ (c Π d3)))) ⟶ (⊦ (¬ (◇ (c Π d4)))) ⟶ (⊦ (¬ (◇ (c Π d5)))) ⟶ (⊦ (¬ (◇ (c Π d6))))
         ⟶ (⊦ (¬ (◇ (c Π d7)))) ⟶ (⊦ (¬ (◇ (c Π d8)))) ⟶ (⊦ (¬ (◇ (c Π d9))))
         ⟶ (⊦ (□ ((c Π d1) ⨂ (c Π d2))))❙

    pmd3 : { d1 : tm PM, d2 : tm PM, d3 : tm PM, d4 : tm PM, d5 : tm PM, d6 : tm PM, d7 : tm PM, d8 : tm PM, d9 : tm PM , c : tm cell }
         (⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗))
         ⟶ (⊦ (◇ (c Π d1))) ⟶ (⊦ (◇ (c Π d2))) ⟶ (⊦ (◇ (c Π d3)))
         ⟶ (⊦ (¬ (◇ (c Π d4)))) ⟶ (⊦ (¬ (◇ (c Π d5)))) ⟶ (⊦ (¬ (◇ (c Π d6))))
         ⟶ (⊦ (¬ (◇ (c Π d7)))) ⟶ (⊦ (¬ (◇ (c Π d8)))) ⟶ (⊦ (¬ (◇ (c Π d9))))
         ⟶ (⊦ (□ ((c Π d1) ⨂ (c Π d2) ⨂ (c Π d3))))❙

    pmd4 : { d1 : tm PM, d2 : tm PM, d3 : tm PM, d4 : tm PM, d5 : tm PM, d6 : tm PM, d7 : tm PM, d8 : tm PM, d9 : tm PM , c : tm cell }
         (⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗))
         ⟶ (⊦ (◇ (c Π d1))) ⟶ (⊦ (◇ (c Π d2))) ⟶ (⊦ (◇ (c Π d3))) ⟶ (⊦ (◇ (c Π d4)))
         ⟶ (⊦ (¬ (◇ (c Π d5)))) ⟶ (⊦ (¬ (◇ (c Π d6)))) ⟶ (⊦ (¬ (◇ (c Π d7)))) ⟶ (⊦ (¬ (◇ (c Π d8)))) ⟶ (⊦ (¬ (◇ (c Π d9))))
         ⟶ (⊦ (□ ((c Π d1) ⨂ (c Π d2) ⨂ (c Π d3) ⨂ (c Π d4))))❙

    pmd5 : { d1 : tm PM, d2 : tm PM, d3 : tm PM, d4 : tm PM, d5 : tm PM, d6 : tm PM, d7 : tm PM, d8 : tm PM, d9 : tm PM , c : tm cell }
         (⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗))
         ⟶ (⊦ (◇ (c Π d1))) ⟶ (⊦ (◇ (c Π d2))) ⟶ (⊦ (◇ (c Π d3))) ⟶ (⊦ (◇ (c Π d4))) ⟶ (⊦ (◇ (c Π d5)))
         ⟶ (⊦ (¬ (◇ (c Π d6)))) ⟶ (⊦ (¬ (◇ (c Π d7)))) ⟶ (⊦ (¬ (◇ (c Π d8)))) ⟶ (⊦ (¬ (◇ (c Π d9))))
         ⟶ (⊦ (□ ((c Π d1) ⨂ (c Π d2) ⨂ (c Π d3) ⨂ (c Π d4) ⨂ (c Π d5))))❙

    pmd6 : { d1 : tm PM, d2 : tm PM, d3 : tm PM, d4 : tm PM, d5 : tm PM, d6 : tm PM, d7 : tm PM, d8 : tm PM, d9 : tm PM , c : tm cell }
         (⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗))
         ⟶ (⊦ (◇ (c Π d1))) ⟶ (⊦ (◇ (c Π d2))) ⟶ (⊦ (◇ (c Π d3))) ⟶ (⊦ (◇ (c Π d4))) ⟶ (⊦ (◇ (c Π d5))) ⟶ (⊦ (◇ (c Π d6)))
         ⟶ (⊦ (¬ (◇ (c Π d7)))) ⟶ (⊦ (¬ (◇ (c Π d8)))) ⟶ (⊦ (¬ (◇ (c Π d9))))
         ⟶ (⊦ (□ ((c Π d1) ⨂ (c Π d2) ⨂ (c Π d3) ⨂ (c Π d4) ⨂ (c Π d5) ⨂ (c Π d6))))❙

    pmd7 : { d1 : tm PM, d2 : tm PM, d3 : tm PM, d4 : tm PM, d5 : tm PM, d6 : tm PM, d7 : tm PM, d8 : tm PM, d9 : tm PM , c : tm cell }
         (⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗))
         ⟶ (⊦ (◇ (c Π d1))) ⟶ (⊦ (◇ (c Π d2))) ⟶ (⊦ (◇ (c Π d3))) ⟶ (⊦ (◇ (c Π d4)))
         ⟶ (⊦ (◇ (c Π d5))) ⟶ (⊦ (◇ (c Π d6))) ⟶ (⊦ (◇ (c Π d7)))
         ⟶ (⊦ (¬ (◇ (c Π d8)))) ⟶ (⊦ (¬ (◇ (c Π d9))))
         ⟶ (⊦ (□ ((c Π d1) ⨂ (c Π d2) ⨂ (c Π d3) ⨂ (c Π d4) ⨂ (c Π d5) ⨂ (c Π d6) ⨂ (c Π d7))))❙

    pmd8 : { d1 : tm PM, d2 : tm PM, d3 : tm PM, d4 : tm PM, d5 : tm PM, d6 : tm PM, d7 : tm PM, d8 : tm PM, d9 : tm PM , c : tm cell }
         (⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗))
         ⟶ (⊦ (◇ (c Π d1))) ⟶ (⊦ (◇ (c Π d2))) ⟶ (⊦ (◇ (c Π d3))) ⟶ (⊦ (◇ (c Π d4)))
         ⟶ (⊦ (◇ (c Π d5))) ⟶ (⊦ (◇ (c Π d6))) ⟶ (⊦ (◇ (c Π d7))) ⟶ (⊦ (◇ (c Π d8)))
         ⟶ (⊦ (¬ (◇ (c Π d9))))
         ⟶ (⊦ (□ ((c Π d1) ⨂ (c Π d2) ⨂ (c Π d3) ⨂ (c Π d4) ⨂ (c Π d5) ⨂ (c Π d6) ⨂ (c Π d7) ⨂ (c Π d8))))❙
❚

theory SudokuStrategyHBE =
    include ?Sudoku❙
    hbe_hori : { c1 : tm cell, c2 : tm cell, d : tm PM } (⊦ (□ (c1 Π d))) ⟶ (⊦ (c1 ℋ c2)) ⟶ (⊦ (¬ (◇ (c2 Π d))))❙
    hbe_vert : { c1 : tm cell, c2 : tm cell, d : tm PM } (⊦ (□ (c1 Π d))) ⟶ (⊦ (c1 𝒱 c2)) ⟶ (⊦ (¬ (◇ (c2 Π d))))❙
    hbe_blck : { c1 : tm cell, c2 : tm cell, d : tm PM } (⊦ (□ (c1 Π d))) ⟶ (⊦ (c1 ℬ c2)) ⟶ (⊦ (¬ (◇ (c2 Π d))))❙
❚

// Last Remaining Cell❚
// ”If all the other cells in the same house cannot possibly contain a certain digit, then this cell must contain that digit” ❚
theory SudokuStrategyLRC =
    include ?Sudoku❙

    hH : { c : tm cell, k : tm cell, p : tm PM } prop❘ = [c1,k1,p1] (c1 ≠ k1) ∧ (c1 ℋ k1) ∧ (¬ (◇ (k1 Π p1))) ❘# ℍ 1 2 3❙
    hV : { c : tm cell, k : tm cell, p : tm PM } prop❘ = [c1,k1,p1] (c1 ≠ k1) ∧ (c1 𝒱 k1) ∧ (¬ (◇ (k1 Π p1))) ❘# 𝕍 1 2 3❙
    hB : { c : tm cell, k : tm cell, p : tm PM } prop❘ = [c1,k1,p1] (c1 ≠ k1) ∧ (c1 ℬ k1) ∧ (¬ (◇ (k1 Π p1))) ❘# 𝔹 1 2 3❙

    lrc_hori : { c1 : tm cell, c2 : tm cell, c3 : tm cell, c4 : tm cell, c5 : tm cell, c6 : tm cell, c7 : tm cell, c8 : tm cell, c9 : tm cell, p : tm PM }
             (⊦ (⋖ c1 c2 c3 c4 c5 c6 c7 c8 c9 ⋗))
             ⟶ ⊦ ℍ c1 c2 p ⟶ ⊦ ℍ c1 c3 p ⟶ ⊦ ℍ c1 c4 p ⟶ ⊦ ℍ c1 c5 p ⟶ ⊦ ℍ c1 c6 p ⟶ ⊦ ℍ c1 c7 p ⟶ ⊦ ℍ c1 c8 p ⟶ ⊦ ℍ c1 c9 p
             ⟶ ⊦ (□ (c1 Π p))❙

    lrc_vert : { c1 : tm cell, c2 : tm cell, c3 : tm cell, c4 : tm cell, c5 : tm cell, c6 : tm cell, c7 : tm cell, c8 : tm cell, c9 : tm cell, p : tm PM }
             (⊦ (⋖ c1 c2 c3 c4 c5 c6 c7 c8 c9 ⋗))
             ⟶ ⊦ 𝕍 c1 c2 p ⟶ ⊦ 𝕍 c1 c3 p ⟶ ⊦ 𝕍 c1 c4 p ⟶ ⊦ 𝕍 c1 c5 p ⟶ ⊦ 𝕍 c1 c6 p ⟶ ⊦ 𝕍 c1 c7 p ⟶ ⊦ 𝕍 c1 c8 p ⟶ ⊦ 𝕍 c1 c9 p
             ⟶ ⊦ (□ (c1 Π p))❙

    lrc_box : { c1 : tm cell, c2 : tm cell, c3 : tm cell, c4 : tm cell, c5 : tm cell, c6 : tm cell, c7 : tm cell, c8 : tm cell, c9 : tm cell, p : tm PM }
             (⊦ (⋖ c1 c2 c3 c4 c5 c6 c7 c8 c9 ⋗))
             ⟶ ⊦ 𝔹 c1 c2 p ⟶ ⊦ 𝔹 c1 c3 p ⟶ ⊦ 𝔹 c1 c4 p ⟶ ⊦ 𝔹 c1 c5 p ⟶ ⊦ 𝔹 c1 c6 p ⟶ ⊦ 𝔹 c1 c7 p ⟶ ⊦ 𝔹 c1 c8 p ⟶ ⊦ 𝔹 c1 c9 p
             ⟶ ⊦ (□ (c1 Π p))❙
❚

// Pencil Mark Introduction❚
// ”If in none of the three houses of a cell another cell must contain a digit, this cell can possibly contain this digit”❚
theory SudokuStrategyPMI =
    include ?Sudoku❙

    allH : { c1 : tm cell, c2 : tm cell, c3 : tm cell, c4 : tm cell, c5 : tm cell, c6 : tm cell, c7 : tm cell, c8 : tm cell, c9 : tm cell } prop❘
         = [c1,c2,c3,c4,c5,c6,c7,c8,c9] (c1 ℋ c2) ∧ (c2 ℋ c3) ∧ (c3 ℋ c4) ∧ (c4 ℋ c5) ∧ (c5 ℋ c6) ∧ (c6 ℋ c7) ∧ (c7 ℋ c8) ∧ (c8 ℋ c9)❙

    allV : { c1 : tm cell, c2 : tm cell, c3 : tm cell, c4 : tm cell, c5 : tm cell, c6 : tm cell, c7 : tm cell, c8 : tm cell, c9 : tm cell } prop❘
         = [c1,c2,c3,c4,c5,c6,c7,c8,c9] (c1 𝒱 c2) ∧ (c2 𝒱 c3) ∧ (c3 𝒱 c4) ∧ (c4 𝒱 c5) ∧ (c5 𝒱 c6) ∧ (c6 𝒱 c7) ∧ (c7 𝒱 c8) ∧ (c8 𝒱 c9)❙

    allB : { c1 : tm cell, c2 : tm cell, c3 : tm cell, c4 : tm cell, c5 : tm cell, c6 : tm cell, c7 : tm cell, c8 : tm cell, c9 : tm cell } prop❘
         = [c1,c2,c3,c4,c5,c6,c7,c8,c9] (c1 ℬ c2) ∧ (c2 ℬ c3) ∧ (c3 ℬ c4) ∧ (c4 ℬ c5) ∧ (c5 ℬ c6) ∧ (c6 ℬ c7) ∧ (c7 ℬ c8) ∧ (c8 ℬ c9)❙

    house : { c1 : tm cell, c2 : tm cell, c3 : tm cell, c4 : tm cell, c5 : tm cell, c6 : tm cell, c7 : tm cell, c8 : tm cell, c9 : tm cell, p : tm PM } prop❘
           = [c1,c2,c3,c4,c5,c6,c7,c8,c9,p] (¬(□(c2 Π p))) ∧ (¬(□(c3 Π p))) ∧ (¬(□(c4 Π p)))
           ∧ (¬(□(c5 Π p))) ∧ (¬(□(c6 Π p))) ∧ (¬(□(c7 Π p))) ∧ (¬(□(c8 Π p))) ∧ (¬(□(c9 Π p)))❙

    pmi : { pivot : tm cell, p : tm PM,
            c12 : tm cell, c13 : tm cell, c14 : tm cell, c15 : tm cell, c16 : tm cell, c17 : tm cell, c18 : tm cell, c19 : tm cell,
            c22 : tm cell, c23 : tm cell, c24 : tm cell, c25 : tm cell, c26 : tm cell, c27 : tm cell, c28 : tm cell, c29 : tm cell,
            c32 : tm cell, c33 : tm cell, c34 : tm cell, c35 : tm cell, c36 : tm cell, c37 : tm cell, c38 : tm cell, c39 : tm cell }
          (⊦ (⋖ pivot c12 c13 c14 c15 c16 c17 c18 c19 ⋗)) ⟶ ⊦ (allV pivot c12 c13 c14 c15 c16 c17 c18 c19) ⟶ ⊦ (house pivot c12 c13 c14 c15 c16 c17 c18 c19 p)
        ⟶ (⊦ (⋖ pivot c22 c23 c24 c25 c26 c27 c28 c29 ⋗)) ⟶ ⊦ (allH pivot c12 c13 c14 c15 c16 c17 c18 c19) ⟶ ⊦ (house pivot c22 c23 c24 c25 c26 c27 c28 c29 p)
        ⟶ (⊦ (⋖ pivot c32 c33 c34 c35 c36 c37 c38 c39 ⋗)) ⟶ ⊦ (allB pivot c12 c13 c14 c15 c16 c17 c18 c19) ⟶ ⊦ (house pivot c32 c33 c34 c35 c36 c37 c38 c39 p)
        ⟶ ⊦ (◇ (pivot Π p))❙
❚

theory SudokuSolve =
    // General❙

    // Implicit Strategies❙
    include ?SudokuStrategyCBE❙
    include ?SudokuStrategyPMD❙

    // Beginner Strategies❙
    include ?SudokuStrategyHBE❙
    include ?SudokuStrategyLRC❙
    include ?SudokuStrategyPMI❙
❚

