namespace latin:/❚

fixmeta ur:?LF❚

// Based on Daan Luca Di Scala's 2020 Bachelor Thesis: https://dspace.library.uu.nl/handle/1874/396282 ❚

theory ExclusiveOr =
    // Exclusive OR is necessary for some Strategies.❙
    include ?IPL❙
    xor : prop ⟶ prop ⟶ prop❘ = [p,q] ¬(p ⇔ q) ❘# 1 ⨂ 2 prec 15❙
❚

theory AllDifferent =
        include ?TypedLogic❙
        include ?SFOLEQND❙

        all_different : { T, a : tm T, b : tm T, c : tm T, d : tm T, e : tm T, f : tm T, g : tm T, h : tm T, i : tm T } prop❘
                      = [T,p1,p2,p3,p4,p5,p6,p7,p8,p9]
                        ((p1 ≠ p2) ∧ (p1 ≠ p3) ∧ (p1 ≠ p4) ∧ (p1 ≠ p5) ∧ (p1 ≠ p6) ∧ (p1 ≠ p7) ∧ (p1 ≠ p8) ∧ (p1 ≠ p9) ∧ (p2 ≠ p3)
                      ∧ (p2 ≠ p4) ∧ (p2 ≠ p5) ∧ (p2 ≠ p6) ∧ (p2 ≠ p7) ∧ (p2 ≠ p8) ∧ (p2 ≠ p9) ∧ (p3 ≠ p4) ∧ (p3 ≠ p5) ∧ (p3 ≠ p6)
                      ∧ (p3 ≠ p7) ∧ (p3 ≠ p8) ∧ (p3 ≠ p9) ∧ (p4 ≠ p5) ∧ (p4 ≠ p6) ∧ (p4 ≠ p7) ∧ (p4 ≠ p8) ∧ (p4 ≠ p9) ∧ (p5 ≠ p6)
                      ∧ (p5 ≠ p7) ∧ (p5 ≠ p8) ∧ (p5 ≠ p9) ∧ (p6 ≠ p7) ∧ (p6 ≠ p8) ∧ (p6 ≠ p9) ∧ (p7 ≠ p8) ∧ (p7 ≠ p9) ∧ (p8 ≠ p9))
                      ❘# ⋖ 2 3 4 5 6 7 8 9 10 ⋗❙

        swap12 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }
               ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (⋖ d2 d1 d3 d4 d5 d6 d7 d8 d9 ⋗)❙

        swap13 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }
               ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (⋖ d3 d2 d1 d4 d5 d6 d7 d8 d9 ⋗)❙

        swap14 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }
               ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (⋖ d4 d2 d3 d1 d5 d6 d7 d8 d9 ⋗)❙

        swap15 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }
               ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (⋖ d5 d2 d3 d4 d1 d6 d7 d8 d9 ⋗)❙

        swap16 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }
               ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (⋖ d6 d2 d3 d4 d5 d1 d7 d8 d9 ⋗)❙

        swap17 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }
               ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (⋖ d7 d2 d3 d4 d5 d6 d1 d8 d9 ⋗)❙

        swap18 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }
               ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (⋖ d8 d2 d3 d4 d5 d6 d7 d1 d9 ⋗)❙

        swap19 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }
               ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (⋖ d9 d2 d3 d4 d5 d6 d7 d8 d1 ⋗)❙

        proj_uneq_12 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d1 ≠ d2)❙
        proj_uneq_13 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d1 ≠ d3)❙
        proj_uneq_14 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d1 ≠ d4)❙
        proj_uneq_15 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d1 ≠ d5)❙
        proj_uneq_16 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d1 ≠ d6)❙
        proj_uneq_17 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d1 ≠ d7)❙
        proj_uneq_18 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d1 ≠ d8)❙
        proj_uneq_19 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d1 ≠ d9)❙
        proj_uneq_23 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d2 ≠ d3)❙
        proj_uneq_24 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d2 ≠ d4)❙
        proj_uneq_25 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d2 ≠ d5)❙
        proj_uneq_26 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d2 ≠ d6)❙
        proj_uneq_27 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d2 ≠ d7)❙
        proj_uneq_28 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d2 ≠ d8)❙
        proj_uneq_29 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d2 ≠ d9)❙
        proj_uneq_34 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d3 ≠ d4)❙
        proj_uneq_35 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d3 ≠ d5)❙
        proj_uneq_36 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d3 ≠ d6)❙
        proj_uneq_37 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d3 ≠ d7)❙
        proj_uneq_38 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d3 ≠ d8)❙
        proj_uneq_39 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d3 ≠ d9)❙
        proj_uneq_45 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d4 ≠ d5)❙
        proj_uneq_46 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d4 ≠ d6)❙
        proj_uneq_47 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d4 ≠ d7)❙
        proj_uneq_48 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d4 ≠ d8)❙
        proj_uneq_49 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d4 ≠ d9)❙
        proj_uneq_56 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d5 ≠ d6)❙
        proj_uneq_57 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d5 ≠ d7)❙
        proj_uneq_58 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d5 ≠ d8)❙
        proj_uneq_59 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d5 ≠ d9)❙
        proj_uneq_67 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T }⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d6 ≠ d7)❙
        proj_uneq_68 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d6 ≠ d8)❙
        proj_uneq_69 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d6 ≠ d9)❙
        proj_uneq_78 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d7 ≠ d8)❙
        proj_uneq_79 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d7 ≠ d9)❙
        proj_uneq_89 : { T, d1 : tm T, d2 : tm T, d3 : tm T, d4 : tm T, d5 : tm T, d6 : tm T, d7 : tm T, d8 : tm T, d9 : tm T } ⊦ (⋖ d1 d2 d3 d4 d5 d6 d7 d8 d9 ⋗) ⟶ ⊦ (d8 ≠ d9)❙
❚

theory SudokuBoard =
    include ?TypedLogic❙
    include ?SFOLEQND❙
    include ?MLHilbert❙
    include ?AllDifferent❙

    cell : tp❙ // type or tp? or tm W? ❙

    c01 : tm cell❘# c₀₁❙ c02 : tm cell❘# c₀₂❙ c03 : tm cell❘# c₀₃❙ c04 : tm cell❘# c₀₄❙ c05 : tm cell❘# c₀₅❙
    c06 : tm cell❘# c₀₆❙ c07 : tm cell❘# c₀₇❙ c08 : tm cell❘# c₀₈❙ c09 : tm cell❘# c₀₉❙ c10 : tm cell❘# c₁₀❙
    c11 : tm cell❘# c₁₁❙ c12 : tm cell❘# c₁₂❙ c13 : tm cell❘# c₁₃❙ c14 : tm cell❘# c₁₄❙ c15 : tm cell❘# c₁₅❙
    c16 : tm cell❘# c₁₆❙ c17 : tm cell❘# c₁₇❙ c18 : tm cell❘# c₁₈❙ c19 : tm cell❘# c₁₉❙ c20 : tm cell❘# c₂₀❙
    c21 : tm cell❘# c₂₁❙ c22 : tm cell❘# c₂₂❙ c23 : tm cell❘# c₂₃❙ c24 : tm cell❘# c₂₄❙ c25 : tm cell❘# c₂₅❙
    c26 : tm cell❘# c₂₆❙ c27 : tm cell❘# c₂₇❙ c28 : tm cell❘# c₂₈❙ c29 : tm cell❘# c₂₉❙ c30 : tm cell❘# c₃₀❙
    c31 : tm cell❘# c₃₁❙ c32 : tm cell❘# c₃₂❙ c33 : tm cell❘# c₃₃❙ c34 : tm cell❘# c₃₄❙ c35 : tm cell❘# c₃₅❙
    c36 : tm cell❘# c₃₆❙ c37 : tm cell❘# c₃₇❙ c38 : tm cell❘# c₃₈❙ c39 : tm cell❘# c₃₉❙ c40 : tm cell❘# c₄₀❙
    c41 : tm cell❘# c₄₁❙ c42 : tm cell❘# c₄₂❙ c43 : tm cell❘# c₄₃❙ c44 : tm cell❘# c₄₄❙ c45 : tm cell❘# c₄₅❙
    c46 : tm cell❘# c₄₆❙ c47 : tm cell❘# c₄₇❙ c48 : tm cell❘# c₄₈❙ c49 : tm cell❘# c₄₉❙ c50 : tm cell❘# c₅₀❙
    c51 : tm cell❘# c₅₁❙ c52 : tm cell❘# c₅₂❙ c53 : tm cell❘# c₅₃❙ c54 : tm cell❘# c₅₄❙ c55 : tm cell❘# c₅₅❙
    c56 : tm cell❘# c₅₆❙ c57 : tm cell❘# c₅₇❙ c58 : tm cell❘# c₅₈❙ c59 : tm cell❘# c₅₉❙ c60 : tm cell❘# c₆₀❙
    c61 : tm cell❘# c₆₁❙ c62 : tm cell❘# c₆₂❙ c63 : tm cell❘# c₆₃❙ c64 : tm cell❘# c₆₄❙ c65 : tm cell❘# c₆₅❙
    c66 : tm cell❘# c₆₆❙ c67 : tm cell❘# c₆₇❙ c68 : tm cell❘# c₆₈❙ c69 : tm cell❘# c₆₉❙ c70 : tm cell❘# c₇₀❙
    c71 : tm cell❘# c₇₁❙ c72 : tm cell❘# c₇₂❙ c73 : tm cell❘# c₇₃❙ c74 : tm cell❘# c₇₄❙ c75 : tm cell❘# c₇₅❙
    c76 : tm cell❘# c₇₆❙ c77 : tm cell❘# c₇₇❙ c78 : tm cell❘# c₇₈❙ c79 : tm cell❘# c₇₉❙ c80 : tm cell❘# c₈₀❙
    c81 : tm cell❘# c₈₁❙

    // Accessibility Relations❙

    hrzntl : tm cell ⟶ tm cell ⟶ prop❘# 1 ℋ 2 prec 30❙ // Same Horizontal❙
    vrtcl  : tm cell ⟶ tm cell ⟶ prop❘# 1 𝒱 2 prec 30❙ // Same Vertical❙
    blck   : tm cell ⟶ tm cell ⟶ prop❘# 1 ℬ 2 prec 30❙ // Same Block❙

    // Same Line = Vertical or Horizontal❙
    ln : tm cell ⟶ tm cell ⟶ prop❘ = [a,b] (a ℋ b) ∨ (a 𝒱 b)❘# 1 ℒ 2 prec 30❙

    // Same Group = Same Line or Block❙
    grp : tm cell ⟶ tm cell ⟶ prop❘ = [a,b] (a ℒ b) ∨ (a ℬ b) ❘# 1 𝒢 2 prec 30❙

    // Symmetry Axioms❙
    symH : {c1,c2 : tm cell} (⊦ (c1 ℋ c2)) ⟶ (⊦ (c2 ℋ c1))❙
    symV : {c1,c2 : tm cell} (⊦ (c1 𝒱 c2)) ⟶ (⊦ (c2 𝒱 c1))❙
    symB : {c1,c2 : tm cell} (⊦ (c1 ℬ c2)) ⟶ (⊦ (c2 ℬ c1))❙

    symL : {c1,c2 : tm cell} (⊦ (c1 ℒ c2)) ⟶ (⊦ (c2 ℒ c1))❙
    symG : {c1,c2 : tm cell} (⊦ (c1 𝒢 c2)) ⟶ (⊦ (c2 𝒢 c1))❙

    // Transitivity Axioms❙
    transH : {c1,c2,c3 : tm cell} (⊦ (c1 ℋ c2)) ⟶ (⊦ (c2 ℋ c3)) ⟶ (⊦ (c1 ℋ c3))❙
    transV : {c1,c2,c3 : tm cell} (⊦ (c1 𝒱 c2)) ⟶ (⊦ (c2 𝒱 c3)) ⟶ (⊦ (c1 𝒱 c3))❙
    transB : {c1,c2,c3 : tm cell} (⊦ (c1 ℬ c2)) ⟶ (⊦ (c2 ℬ c3)) ⟶ (⊦ (c1 ℬ c3))❙

    // Connection Axioms❙

    c01Hc02 : ⊦ (c₀₁ ℋ c₀₂)❙ c01Hc03 : ⊦ (c₀₁ ℋ c₀₃)❙ c01Hc04 : ⊦ (c₀₁ ℋ c₀₄)❙ c01Hc05 : ⊦ (c₀₁ ℋ c₀₅)❙
    c01Hc06 : ⊦ (c₀₁ ℋ c₀₆)❙ c01Hc07 : ⊦ (c₀₁ ℋ c₀₇)❙ c01Hc08 : ⊦ (c₀₁ ℋ c₀₈)❙ c01Hc09 : ⊦ (c₀₁ ℋ c₀₉)❙
    c10Hc11 : ⊦ (c₁₀ ℋ c₁₁)❙ c10Hc12 : ⊦ (c₁₀ ℋ c₁₂)❙ c10Hc13 : ⊦ (c₁₀ ℋ c₁₃)❙ c10Hc14 : ⊦ (c₁₀ ℋ c₁₄)❙
    c10Hc15 : ⊦ (c₁₀ ℋ c₁₅)❙ c10Hc16 : ⊦ (c₁₀ ℋ c₁₆)❙ c10Hc17 : ⊦ (c₁₀ ℋ c₁₇)❙ c10Hc18 : ⊦ (c₁₀ ℋ c₁₈)❙
    c19Hc20 : ⊦ (c₁₉ ℋ c₂₀)❙ c19Hc21 : ⊦ (c₁₉ ℋ c₂₁)❙ c19Hc22 : ⊦ (c₁₉ ℋ c₂₂)❙ c19Hc23 : ⊦ (c₁₉ ℋ c₂₃)❙
    c19Hc24 : ⊦ (c₁₉ ℋ c₂₄)❙ c19Hc25 : ⊦ (c₁₉ ℋ c₂₅)❙ c19Hc26 : ⊦ (c₁₉ ℋ c₂₆)❙ c19Hc27 : ⊦ (c₁₉ ℋ c₂₇)❙
    c28Hc29 : ⊦ (c₂₈ ℋ c₂₉)❙ c28Hc30 : ⊦ (c₂₈ ℋ c₃₀)❙ c28Hc31 : ⊦ (c₂₈ ℋ c₃₁)❙ c28Hc32 : ⊦ (c₂₈ ℋ c₃₂)❙
    c28Hc33 : ⊦ (c₂₈ ℋ c₃₃)❙ c28Hc34 : ⊦ (c₂₈ ℋ c₃₄)❙ c28Hc35 : ⊦ (c₂₈ ℋ c₃₅)❙ c28Hc36 : ⊦ (c₂₈ ℋ c₃₆)❙
    c37Hc38 : ⊦ (c₃₇ ℋ c₃₈)❙ c37Hc39 : ⊦ (c₃₇ ℋ c₃₉)❙ c37Hc40 : ⊦ (c₃₇ ℋ c₄₀)❙ c37Hc41 : ⊦ (c₃₇ ℋ c₄₁)❙
    c37Hc42 : ⊦ (c₃₇ ℋ c₄₂)❙ c37Hc43 : ⊦ (c₃₇ ℋ c₄₃)❙ c37Hc44 : ⊦ (c₃₇ ℋ c₄₄)❙ c37Hc45 : ⊦ (c₃₇ ℋ c₄₅)❙
    c46Hc47 : ⊦ (c₄₆ ℋ c₄₇)❙ c46Hc48 : ⊦ (c₄₆ ℋ c₄₈)❙ c46Hc49 : ⊦ (c₄₆ ℋ c₄₉)❙ c46Hc50 : ⊦ (c₄₆ ℋ c₅₀)❙
    c46Hc51 : ⊦ (c₄₆ ℋ c₅₁)❙ c46Hc52 : ⊦ (c₄₆ ℋ c₅₂)❙ c46Hc53 : ⊦ (c₄₆ ℋ c₅₃)❙ c46Hc54 : ⊦ (c₄₆ ℋ c₅₄)❙
    c55Hc56 : ⊦ (c₅₅ ℋ c₅₆)❙ c55Hc57 : ⊦ (c₅₅ ℋ c₅₇)❙ c55Hc58 : ⊦ (c₅₅ ℋ c₅₈)❙ c55Hc59 : ⊦ (c₅₅ ℋ c₅₉)❙
    c55Hc60 : ⊦ (c₅₅ ℋ c₆₀)❙ c55Hc61 : ⊦ (c₅₅ ℋ c₆₁)❙ c55Hc62 : ⊦ (c₅₅ ℋ c₆₂)❙ c55Hc63 : ⊦ (c₅₅ ℋ c₆₃)❙
