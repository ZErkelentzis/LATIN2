    c02Vc11 : ⊦ (c₀₂ 𝒱 c₁₁)❙ c02Vc20 : ⊦ (c₀₂ 𝒱 c₂₀)❙ c02Vc29 : ⊦ (c₀₂ 𝒱 c₂₉)❙ c02Vc38 : ⊦ (c₀₂ 𝒱 c₃₈)❙
