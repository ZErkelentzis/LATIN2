    c04Vc13 : ⊦ (c₀₄ 𝒱 c₁₃)❙ c04Vc22 : ⊦ (c₀₄ 𝒱 c₂₂)❙ c04Vc31 : ⊦ (c₀₄ 𝒱 c₃₁)❙ c04Vc40 : ⊦ (c₀₄ 𝒱 c₄₀)❙
