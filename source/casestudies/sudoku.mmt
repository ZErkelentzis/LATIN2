    c05Vc14 : ⊦ (c₀₅ 𝒱 c₁₄)❙ c05Vc23 : ⊦ (c₀₅ 𝒱 c₂₃)❙ c05Vc32 : ⊦ (c₀₅ 𝒱 c₃₂)❙ c05Vc41 : ⊦ (c₀₅ 𝒱 c₄₁)❙
