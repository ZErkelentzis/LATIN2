namespace latin:/casestudies/_2022-tptp❚

theory Cat : latin:/?DHOL =
    obj : tp❙
    mor : {x:tm obj,y:tm obj} tp ❙
    id: Πͭ ([x:tm obj] (mor x x)) ❙
    comp: Πͭ ([x:tm obj] Πͭ ([y:tm obj] Πͭ ([z:tm obj] Πͭ ([f:tm mor x y] Πͭ ([g:tm mor y z] mor x z))))) ❘# 5 ◦ 4 prec 50 ❙
    ax1: ⊦ ∀ͭ[x: tm obj] ∀ͭ[y: tm obj] ∀ͭ[m: tm (mor x y)] m ◦ id x =ͭ m ❙
    ax2: ⊦ ∀ͭ[x: tm obj] ∀ͭ[y: tm obj] ∀ͭ[m: tm (mor x y)] id y ◦ m =ͭ m ❙
    
    conj: ⊦ ∀ͭ[x: tm obj] ∀ͭ[y: tm obj] x =ͭ y ⇒ id x =ͭ id y ❘ = PROVE ❙
❚