namespace latin:/❚

fixmeta latin:/?SFOLEQND❚

import rules scala://lf.mmt.kwarc.info❚
import uom scala://uom.api.mmt.kwarc.info❚

theory IntUnary =
  include ?NatUnary❙
  
  pred: tm num ⟶ tm num❙
  // axioms for succ and pred inverse❙
❚

theory IntPlus =
  include ?IntUnary❙
  include ?NatPlus❙
  
  // axiom for + and pred❙
❚

theory IntPlusTimes =
  include ?IntUnary❙
  include ?NatPlusTimes❙
  
  // axiom for * and pred❙
❚


theory Int =
  include ?IntPlusTimes❙
❚