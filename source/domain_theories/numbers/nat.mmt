namespace latin:/❚

fixmeta latin:/?SFOLEQND❚

import rules scala://lf.mmt.kwarc.info❚
import uom scala://uom.api.mmt.kwarc.info❚

theory Nat =
  nat   : tp❙
  Nat = tm nat❘# ℕ❙
  zero  : ℕ❙
  succ  : ℕ ⟶ ℕ❘ # 1 ' prec 15❙
❚

theory NatPeano =
  include ?Nat❙
  
  // ist es notwendig / moeglich, dies zu definieren?❙
  p1 : ⊦ zero ∈ͯ ℕ❙
  p2 : ⊦ ∀ͭ[n] n ∈ͯ ℕ ⇒ n' ∈ͯ ℕ❙

  p3 : ⊦ ∀ͭ[n : Nat] ¬(n' =ͭ zero)❙
  p4 : ⊦ ∀ͭ[m : Nat]∀ͭ[n : Nat] (m') =ͭ (n') ⇒ m =ͭ n❙

  // wie formalisiert man das?❙

  p5 : ⊦ ∀ͭ[X] zero ∈ͯ X ∧ (∀ͭ[n : Nat] n ∈ͯ X ⇒ n' ∈ͯ X) ⇒ ℕ ⊆ͯ X❙

❚

theory NatPlus =
  include ?Nat❙
  
  plus : ℕ ⟶ ℕ ⟶ ℕ ❘ # 1 + 2 prec 50❙
  
  plus_zero : ⊦ ∀ͭ[n] n + zero =ͭ n❙
  plus_succ : ⊦ ∀ͭ[m]∀ͭ[n] n + (m') =ͭ ((n + m)')❙
❚

theory NatPlusTimes =
  include ?NatPlus❙
  
  times : ℕ ⟶ ℕ ⟶ ℕ ❘ # 1 * 2 prec 60❙
  
  times_zero : ⊦ ∀ͭ[n] zero * n =ͭ zero❙
  times_succ : ⊦ ∀ͭ[m]∀ͭ[n] (n') * m =ͭ (n * m) + m❙
❚

view NatToBinary : ?Nat → ?Binary =
  
❚


// Sollen diese Theories uberhaupt drinbleiben? Denn fuer case study irrelevant❙


theory NatLiterals =
  include ?Nat❙
  
  rule rules?Realize ℕ uom?StandardNat❙
  rule rules?Realize zero uom?Arithmetic/Zero❙
  rule rules?Realize succ uom?Arithmetic/Succ❙
❚

// How do I define even and odd without using times?❙

theory NatParity =
  include ?Nat❙
 
  even: ℕ ⟶ prop❘ 
  uneven: ℕ ⟶ prop ❙
❚

