namespace latin:/❚

fixmeta latin:/?SFOLEQND❚

import rules scala://lf.mmt.kwarc.info❚
import uom scala://uom.api.mmt.kwarc.info❚

// Natural Numbers❙
theory Nat =
  nat   : tp❙
  Nat = tm nat❘# ℕ❙
  zero  : ℕ❙
  succ  : ℕ ⟶ ℕ❘ # 1 ' prec 15❙
❚

// Peano Axioms ❙
theory NatPeano =
  include ?Nat❙
  
  // is it necessary / possible to formulate p1, p2❙
  // p1 : ⊦ zero ∈ͯ ℕ❙
  // p2 : ⊦ ∀ͭ[n] n ∈ͯ ℕ ⇒ n' ∈ͯ ℕ❙

  p3 : ⊦ ∀ͭ[n : Nat] ¬(n' =ͭ zero)❙
  p4 : ⊦ ∀ͭ[m : Nat]∀ͭ[n : Nat] (m') =ͭ (n') ⇒ m =ͭ n❙

  // how can p5 be formulated?❙
  // p5 : ⊦ ∀ͭ[X] zero ∈ͯ X ∧ (∀ͭ[n : Nat] n ∈ͯ X ⇒ n' ∈ͯ X) ⇒ ℕ ⊆ͯ X❙

❚

// inductive definition of plus❙
theory NatPlus =
  include ?Nat❙
  
  plus : ℕ ⟶ ℕ ⟶ ℕ ❘ # 1 + 2 prec 50❙
  
  plus_zero : ⊦ ∀ͭ[n] n + zero =ͭ n❙
  plus_succ : ⊦ ∀ͭ[m]∀ͭ[n] n + (m') =ͭ ((n + m)')❙
❚

// inductive definition of times❙
theory NatPlusTimes =
  include ?NatPlus❙
  
  times : ℕ ⟶ ℕ ⟶ ℕ ❘ # 1 * 2 prec 60❙
  
  times_zero : ⊦ ∀ͭ[n] zero * n =ͭ zero❙
  times_succ : ⊦ ∀ͭ[m]∀ͭ[n] (n') * m =ͭ (n * m) + m❙
❚

// should these theories stay in here? they are irrelevant for our case study❙

theory NatLiterals =
  include ?Nat❙
  
  rule rules?Realize ℕ uom?StandardNat❙
  rule rules?Realize zero uom?Arithmetic/Zero❙
  rule rules?Realize succ uom?Arithmetic/Succ❙
❚

theory NatParity =
  include ?Nat❙
 
  even: ℕ ⟶ prop❙
  uneven: ℕ ⟶ prop❙
❚

// took out Int as it's not relevant for our case study❙