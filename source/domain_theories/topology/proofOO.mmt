namespace latin:/❚

fixmeta latin:/powertypes?PowerSFOL❚

theory OpenTopology_Eq =
	include ?OpenTopology❙
	structure ot : ?OpenTopology❘ abbrev COMPOSE ?OpenTopologyToClosedTopology;
											   ?ClosedTopologyToClosenessTopology;
											   ?ClosenessTopologyToClosureTopology;
											   ?ClosureTopologyToInteriorTopology;
											   ?InteriorTopologyToNeighborhoodTopology;
											   ?NeighborhoodTopologyToOpenTopology❙
	
	OO_subs1 : ⊦ OO ⊆ͯ ot/OO❘ = subsetI [A, p] pfilterI pfilterI tforallI [x] implI [q] complI [r] complE q 
											  pfilterI pfilterI texistsI A  
											   andI (andI p r) (compl_compl tsym tcongP ([B] A ⊆ͯ B) subset_refl)❙
												  
	lemma1 : {A} ⊦ A ∈ͯ (pfilter [A2] (∁ͯA2) ∈ͯ pfilter [B] ∁ͯ(pfilter [y] (∁ͯB) ∈ͯ pfilter [D] (∃ͭ[O] O ∈ͯ OO ∧ y ∈ͯ O ∧ O ⊆ͯ D)) ⊆ͯ B)
				⟶ ⊦ (⋃ͯ pfilter [O] O ∈ͯ OO ∧ O ⊆ͯ A) =ͭ A❘
				= [A, p] subset_antisym
					      (subset_bigunion_lub [S, q] q pfilterE andEr)
					       subsetI [x, q] compl_compl tcongP ([B] x ∈ͯ B) complI [r] complE 
						    (subsetE p pfilterE pfilterE complI [s] [a] s pfilterE pfilterE texistsE [O, t]
							  complE r bigunionI (pfilterI andI t andEl andEl (compl_compl tcongP ([B] O ⊆ͯ B) (t andEr)))
												(t andEl andEr) inconE) q❙
	OO_subs2 : ⊦ ot/OO ⊆ͯ OO❘ = subsetI [A, p] lemma1 p tcongP ([B] B ∈ͯ OO) union_open subsetI [O, q] q pfilterE andEl❙
	
	OO_eq : ⊦ OO =ͭ ot/OO❘ = subset_antisym OO_subs1 OO_subs2❙
❚