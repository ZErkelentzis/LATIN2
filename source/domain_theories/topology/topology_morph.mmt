namespace latin:/❚

// views
   ClosureSystem ⟶ ClosureOperator: A closed if A fixed point of cl
   ClosureOperator ⟶ ClosureSystem: cl A = intersection of closed supersets of A
   Closeness ↔ ClosureOperator: X close A ⇔ X ‍∈ cl A
   ClosureSystem ⟶ Closeness: A closed if A contains all points close to it 
   Closeness ↔ ClosureSystem: X close A if X in every closed superset of A

for functions f: X ⟶ Y
  f(cl A) ⊆‍ cl f(A)  ⇔  preservation of closeness   ⇔  reflection of closedness  (= continuous)
  f(cl A) ⊇ cl f(A)  ⇔  preservation of closedness
  
view ClosureSystemToClosureOperator : ?ClosureSystem -> ?ClosureOperator =
	X = X
	CC = pfilter [A] cl A =ͭ A
	intersection = [Q,p] pfilterI 
	full_closed = pfilterI closureFixI subset_full


view ClosureOperatorToCloseness : ?ClosureOperator → ?Closeness =
	X = X
	closure = [A] pfilter [x] x|A
	extensive = [A] subsetI 
	monotone =  
	idempotent = 


view ClosenessToClosureSystem : ?Closeness → ?ClosureSystem =
	X = X
	close = [x,A] (∀[B] (A ⊆ͯ cl B ⇒ x ∈ͯ cl B))
	in_close = 
	bigger_close = 
	transitive = 
❚

view ClosureSystemToCloseness : ?ClosureSystem → ?Closeness =
	X = X❙
	CC = pfilter [A] (∀ͭ[x] (x | A ⇒ x ∈ͯ A))❙
	intersection = _ ❙
❚

view ClosureOperatorToClosureSystem : ?ClosureOperator → ?ClosureSystem =
	X = X❙
	closure = [A] biginter X (pfilter [B] (B ∈ͯ CC ∧ A ⊆ͯ B))❙
	extensive = subsetI ❙
	monotone = _ ❙
	idempotent = _ ❙
❚

view ClosenessToClosureOperator : ?Closeness → ?ClosureOperator =
	X = X❙
	close = [x,A] x ∈ͯ cl A❙
	in_close = [x,A,p] subsetE extensive p❙
	bigger_close = [x,A,B,p,q] subsetE (monotone q) p❙
	transitive = [A,B,x,p,q] subsetE (subset_trans (monotone (subsetI [y, r] q tforallE y implE r) )(subsetI (eq_in_left idempotent))) p❙
❚

//   views:
      Neighborhood ⟶ Open: NN = supersets of open sets
      Open ⟶ Neighborhood: OO = sets that are neightborhoods for every element
      Open ⟶ Closed: OO = complements of CC
      Closed ⟶ Open: CC = complements of OO
❚

view ClosedTopologyToClosenessTopology : ?ClosedTopology → ?ClosenessTopology =
	include ?ClosureSystemToCloseness❙
	empty_closed = _ ❙ 
	finite_union = _ ❙
❚

view ClosenessTopologyToClosureTopology : ?ClosenessTopology → ?ClosureTopology =
	include ?ClosenessToClosureOperator❙

	empty_union = _ ❙
	finite_union = _ ❙
❚

