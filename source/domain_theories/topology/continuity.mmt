namespace latin:/❚

fixmeta latin:/powertypes?PowerSFOL❚

// for functions f: X ⟶ Y
  f(cl A) ⊆‍ cl f(A)  ⇔  preservation of closeness   ⇔  reflection of closedness  (= continuous)
  f(cl A) ⊇ cl f(A)  ⇔  preservation of closedness
❚

theory Homomorphism =
  structure dom : ?Topology❙
  structure cod : ?Topology❙
  homX : tm dom/X ⟶ tm cod/X❙
❚

theory Continuous = 
  include ?Homomorphism❙
❚

theory ReflectsClosedness =
  include ?Homomorphism❙
  reflectsClosedness : ⊦ ∀ͭ[A] A ∈ͯ cod/CC ⇒ A preimage homX ∈ͯ dom/CC❙
❚

theory ReflectsOpenness =
  include ?Homomorphism❙
  reflectsOpenness : ⊦ ∀ͭ[A] A ∈ͯ cod/OO ⇒ A preimage homX ∈ͯ dom/OO❙
❚

theory ReflectsNeighborhood =
  include ?Homomorphism❙
  reflectsNeighborhood : ⊦ ∀ͭ[x]∀ͭ[V] homX x cod/∶ V ⇒ x dom/∶ V preimage homX❙
❚

theory Interior =
  include ?Homomorphism❙
  interior : ⊦ ∀ͭ[A] A ⊆ͯ cod/X ⇒ (cod/interior A) preimage homX ⊆ͯ dom/interior (A preimage homX)❙

❚

theory Closure =
  include ?Homomorphism❙
  closure : ⊦ ∀ͭ[A] A ⊆ͯ dom/X ⇒ (dom/cl A) map homX ⊆ͯ cod/cl (A map homX)❙
❚

theory PreservesCloseness =
  include ?Homomorphism❙
  preservesCloseness : ⊦ ∀ͭ[A]∀ͭ[x] x dom/⋶ A ⇒ (homX x) cod/⋶ (A map homX)❙
❚




