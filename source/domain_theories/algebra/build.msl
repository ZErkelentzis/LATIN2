file ../../../build_config.msl

// algebra
// depends in general on fundamentals and logic

// fixed order
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/magmas.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/monoids.mmt

// depend on magmas
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/lattices.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/additive_magmas.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/groups.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/bands.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/algebra_to_order.mmt

// depend on magmas, sets and groups
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/ringoids.mmt

