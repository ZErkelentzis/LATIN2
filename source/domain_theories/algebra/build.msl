file ../../../build_config.msl

// algebra
// depends in general on fundamentals and logic (these dependencies are not mentioned here)!

// fixed order
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/sets.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/relations.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/magmas.mmt

// dependent on magmas
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/additive_magmas.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/groups.mmt
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/bands.mmt

// dependent on magmas, sets and groups
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/ringoids.mmt

// dependent on power_types, groups and ringoids
// needs complete redesign
// build MMT/LATIN2 mmt-omdoc domain_theories/algebra/modules.mmt

// dependent on power_types, topology and files from before
build MMT/LATIN2 mmt-omdoc domain_theories/algebra/generated.mmt

// independent of the rest
// build MMT/LATIN2 mmt-omdoc algebra/diagop-theories.mmt
