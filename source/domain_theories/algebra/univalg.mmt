// theory ExamplesUsingWTypes =
  induct OneInduct ()❘ =
    One : type ❙
    one : One ❙
  ❚
  // induct TwoInduct ()❘=
    Two : type ❙
    two1 : Two ❙
    two2 : Two ❙
  ❚
  // magma : UFunSig ❘ = [' F := One, ar := [x: One] Two '] ❙
  build_magma: {A: type} (A ⟶ A ⟶ A) ⟶ UFunMod magma ❘= [A,op] ['
    univ := A,
    interp := [f] [args] (f match x.
                            op (args (CASE 0)) (args (CASE 1))
                          | x
                         to A)
  '] ❘ # as_magma 2 ❙

  	def addition (n : ℕ) ❘ =
  		add : ℕ ⟶ ℕ ❘ # 1 + 2 ❙
  		Zero = n ❙
  		Succ = [m] S (add m) ❙
  	❚
❚
