namespace latin:/algebraic❚

fixmeta latin:/?SFOLEQND❚

theory DivGroup =
	include ?Set❙
	
	e : U❙
	div : U ⟶ U ⟶ U ❘# 1 ÷ 2 prec 50❙
	
	unit_unique : {x,y} ⊦ x ÷ x =ͭ y ÷ y❙
	unit_neutral : {x} ⊦ x ÷ e =ͭ x❙
	reciprocal : {x, y} ⊦ e ÷ (x ÷ y) =ͭ y ÷ x❙
	reduce : {x, y, z} ⊦ (x ÷ z) ÷ (y ÷ z) =ͭ x ÷ y❙                                                                                               
❚

view GroupToDivGroup : ?Group → ?DivGroup =
    include ?Set❙
    unit = e❙
    op = [x, y] x ÷ (e ÷ y)❙
    inv = [x] e ÷ x❙

    assoc_ax = tforallI [x] tforallI [y] tforallI [z] 
    		   unit_neutral tcongP 
    		   ([u] x ÷ (e ÷ y) ÷ u =ͭ x ÷ (e ÷ y) ÷ (e ÷ z)) trefl 
    		   ttrans (reduce tcongP 
    		   ([u] x ÷ (e ÷ y) ÷ u =ͭ x ÷ (e ÷ y) ÷ (e ÷ z ÷ y ÷ (e ÷ y))) trefl) 
    		   ttrans reduce 
    		   ttrans (reciprocal tcongP ([u] x ÷ u =ͭ x ÷ (e ÷ (y ÷ (e ÷ z)))) trefl)❙
    neutralL = tforallI [x] reciprocal ttrans unit_neutral❙
    neutralR = tforallI [x] unit_neutral tsym tcongP ([u] x ÷ u =ͭ x) unit_neutral❙
    inverseLeft = tforallI [x] unit_unique❙
    inverseRight = tforallI [x] reciprocal tsym tcongP ([u] x ÷ u =ͭ e) 
     							(unit_neutral tsym tcongP ([u] x ÷ u =ͭ e) unit_unique)❙

❚

view DivGroupToGroup : ?DivGroup → ?Group =
	include ?Set❙
	e = e❙
	div = [x, y] x∘y⁻❙
	
	unit_unique = [x, y] invR ttrans (invR tsym)❙
	unit_neutral = [x, y] inv_op tsym tcongP ([u] x∘u =ͭ x) (invL tsym tcongP ([u] x∘u =ͭ x) neutR)❙
	reciprocal = [x, y, z] invR tsym tcongP ([u] u∘(y∘z⁻)⁻ =ͭ (y∘z⁻)⁻) neutL ttrans inv_op 
						   ttrans (inv_inv tsym tcongP ([u] u∘y⁻=ͭz∘y⁻) trefl)❙
	reduce = [x, y, z] (inv_op tsym) tcongP ([u] x∘z⁻∘u=ͭx∘y⁻) (assoc4M ttrans 
					   (invR tsym tcongP ([u] x∘u∘y⁻ =ͭ x∘y⁻)(neutL tcongP ([u] x∘u =ͭ x∘y⁻) trefl)))❙
❚

theory t =
	include ?Group❙
	structure g : ?Group❘ abbrev COMPOSE ?GroupToDivGroup; ?DivGroupToGroup❙
	
	opeq : {x,y} ⊦ x ∘ y =ͭ x g/∘ y❘ = [x,y] _ ❙

❚

