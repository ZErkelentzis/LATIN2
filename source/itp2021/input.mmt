namespace latin:/itp2021 ❚
fixmeta ur:?LF❚

// BASE LANGUAGE DEFINITIONS
   ========================================== ❚

/T (1) base language: untyped ❚
theory Untyped =
  term: type❙
❚

/T (2) base language: hard-typed (aka extensional/Church-flavored type theory) ❚
theory HardTyped =
  tp: type ❙
  tm: tp ⟶ type ❘# tm 1 prec -5❙
❚

/T (3) base language: soft-typed (aka intensional/Curry-flavored type theory) ❚
theory SoftTyped =
  tp: type ❙
  term: type ❙
  of: term ⟶ tp ⟶ type ❘# 1 ⦂ 2 prec 30❙
❚

// FEATURE DEFINITIONS OVER BASE LANGUAGES
   ========================================== ❚

// (1) exemplary features of untyped: PL, FOL quantification and choice operator ❚
theory PropLogic =
  prop: type ❙
  ded: prop ⟶ type ❘# ⊦ 1 prec -5❙

  and: prop ⟶ prop ⟶ prop ❘# 1 ∧ 2 prec 15❙
  andI: {F,G} ⊦ F ⟶ ⊦ G ⟶ ⊦ F ∧ G❙
  andEl: {F,G} ⊦ F∧G ⟶ ⊦ F ❘# 3 andEl❙
  andEr: {F,G} ⊦ F∧G ⟶ ⊦ G ❘# 3 andEr❙

  impl: prop ⟶ prop ⟶ prop ❘# 1 ⇒ 2 prec 10 ❙
  // implI, implE omitted ❙
❚

theory Quantification =
  include ?PropLogic❙
  include ?Untyped❙

  // do we really need forall or would exists suffice for paper? ❙
  forall: (term ⟶ prop) ⟶ prop ❘# ∀ 1❙
  forallI: {P} ({x} ⊦ (P x)) ⟶ ⊦ ∀ P❙
  forallE: {P, X} ⊦ ∀ P ⟶ ⊦ (P X) ❘# 3 forallE 2❙

  exists: (term ⟶ prop) ⟶ prop ❘# ∃ 1❙
  existsI: {P, X} ⊦ P X ⟶ ⊦ ∃ P ❘# existsI 2 3❙
  existsE: {P, C} ⊦ ∃ P ⟶ ({x} ⊦ (P x) ⟶ ⊦ C) ⟶ ⊦ C ❘# 3 existsE 4❙
❚
theory Choice =
  include ?Quantification❙
  some : {P} ⊦ ∃ P ⟶ term ❘# some 1 2❙
  some_ax : {P,p} ⊦ P (some P p) ❘# some_ax 1 2❙
❚

theory Equality =
  include ?PropLogic ❙
  include ?Untyped❙
  equal : term ⟶ term ⟶ prop ❘# 1 ≐ 2 prec 30❙
❚
theory Description =
  include ?Quantification❙
  include ?Equality❙
  existsUnique: (term ⟶ prop) ⟶ prop ❘= [P] ∃[x] (P x) ∧ ∀[y] P y ⇒ x ≐ y ❘# ∃¹ 1❙
  the: {P} ⊦ ∃¹ P ⟶ term ❘# the 1 2❙
❚

theory FOL =
  include ?PropLogic❙
  include ?Quantification❙
  include ?Choice❙
  include ?Description❙
❚
// Description operator: left out, needs formalization of ∃!, which is long-ish ❚

// (2) features of hard-typed: products, simple function, and dependent function types ❚
theory Products =
  include ?HardTyped❙
  prod: tp ⟶ tp ⟶ tp  ❘# 1 × 2❙
  pair: {A, B} tm A ⟶ tm B ⟶ tm A×B ❘# ⟪ 3 , 4 ⟫❙
❚
theory SimplyTypedFunctions =
  include ?HardTyped❙
  fun: tp ⟶ tp ⟶ tp ❘# 1 → 2❙
  lam: {A, B} (tm A ⟶ tm B) ⟶ tm A→B ❘# λ 3❙
  app: {A, B} tm A→B ⟶ tm A ⟶ tm B ❘# 3 @ 4❙
❚
theory DependentyTypedFunctions =
  include ?HardTyped❙
  dep_fun: {A} (tm A ⟶ tp) ⟶ tp ❘# Π 2❙
  dep_lam: {A, f} ({a: tm A} tm (f a)) ⟶ tm (Π f) ❘# dλ 3❙
  dep_app: {A, f, a: tm A} tm Π f ⟶ tm (f a) ❘# 4 d@ 3❙
❚
view SimpleAsDependentFunctions : ?SimplyTypedFunctions -> ?DependentyTypedFunctions =
  include ?HardTyped❙
  fun = [A, B] Π ([x: tm A] B)❙
  lam = [A, B, f] dλ f❙
  app = [A, B, fun, arg] fun d@ arg❙
❚

// (3): features of soft-typed: will be autogenerated below (and saved to output.mmt) ❚

// FEATURE TRANSLATIONS ACROSS BASE LANGUAGES
   ========================================== ❚

theory DiagOps : ur:?DiagramOperators =
  typify_operator # TYPIFY ❙ rule ☞scala://diagops.odk.mmt.kwarc.info?TypifyOperator_ITP2021 ❙
❚

// Translating Untyped to HardTyped
   ------------------------------------------ ❚
diagram UntypedFeatures : ?DiagOps :=
        BDIAG (RAWDIAG ?Untyped) ! ?Quantification ! ?Choice ! ?Equality ! ?Description ! ?FOL ❚

diagram UntypedAsHardTyped : ?DiagOps :=
        TYPIFY ?UntypedFeatures ❚

// Translating HardTyped to SoftTyped
   ------------------------------------------ ❚
view TypeErasure : ?HardTyped -> ?SoftTyped =
  tp = tp❙
  tm = [x] term❙ // <-- "type erasure"❙
❚

diagram HardTypedLogrels : ?DiagOps :=
        UNARY_LOGREL ?TypeErasure (BDIAG (RAWDIAG ☞ur:?LF) ! ?HardTyped) ❚

theory SemanticDomain =
  include ?SoftTyped❙
  Unit: type ❘ # %D1❙
  unit: Unit ❘ # ∗❙
❚
view TypePreservation : ?HardTyped_logrel -> ?SemanticDomain =
  include ?SoftTyped ❙
  tp_r = [x] Unit❙                  // uninteresting, technically necessary assignment ❙
  tm_r = [A: tp, x, t: term] t ⦂ A❙ // cruical assignment making this logrel represent type preservation ❙
❚


// Translating Untyped to SoftTyped
   ------------------------------------------ ❚
diagram UntypedAsSoftTyped : ?DiagOps :=
        UNARY_LOGREL_PUSHOUT ?TypeErasure ?TypePreservation ?UntypedAsHardTyped ❚

/T Aggregate hard-typed features… ❚
// diagram HardTypedFeatures : ?DiagOps :=
        BDIAG (RAWDIAG ☞ur:?LF) ! ?Products ! ?SimplyTypedFunctions ! ?DependentyTypedFunctions !
        ?SimpleAsDependentFunctions ❚

/T and translate them to soft-typed: ❚
