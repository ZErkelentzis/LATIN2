namespace latin:/algebraic❚

fixmeta latin:/?SFOLEQ ❚

theory Set = 
  universe : tp❙
  U = tm universe❙
❚

theory Hom = 
   structure domain : ?Set =
   ❚
   structure codomain : ?Set =
   ❚
   U : domain/U ⟶ codomain/U ❙
❚

theory Magma = 
  include ?Set ❙
  op : U ⟶ U ⟶ U ❘# 1 ∘ 2 prec 50 ❙
❚

theory MagmaHom = 
  include ?Hom ❙
  structure domain : ?Magma =
    U = domain/U ❙
  ❚
  structure codomain : ?Magma = 
    U = codomain/U ❙
  ❚
  op : ⊦ ∀[x]∀[y] U (domain/op x y) ≐ codomain/op (U x) (U y) ❙
❚

theory Commutative = 
  include ?Magma ❙
  comm : ⊦ ∀[x]∀[y] x∘y ≐ y∘x❙
❚

view OppositeMagma : ?Magma → ?Magma = 
  universe = universe ❙
  U = U ❙
  op = [x, y] y ∘ x ❙
❚

theory Idempotent = 
  include ?Magma ❙
  idem: ⊦ ∀[x] (x ∘ x) ≐ x ❙
❚

view OppositeCommMagma : ?Commutative → ?Commutative =
  include ?OppositeMagma ❙
  op = op ❙
  comm = comm ❙
❚

theory Semigroup = 
  include ?Magma ❙
  assoc : ⊦ ∀[x]∀[y]∀[z] (x∘y)∘z ≐ x∘(y∘z) ❙
  
  
  // from a previous version of magmas.mmt
  // assocR: {x,y,z} x∘(y∘z) = (x∘y)∘z❘
  //       = [x,y,z] sym assoc❙
  // assoc4:  {w,x,y,z} ((w∘x)∘y)∘z = w∘(x∘(y∘z))❘
  //       =  [w,x,y,z] trans3 (assoc congT [u]u∘z) assoc (assoc congT [u]w∘u)❙
  // assoc4R: {w,x,y,z} w∘(x∘(y∘z)) = ((w∘x)∘y)∘z❘
  //        = [w,x,y,z] sym assoc4❙
  // assoc5: {v,w,x,y,z} (((v∘w)∘x)∘y)∘z = v∘(w∘(x∘(y∘z)))❘
  //       = [v,w,x,y,z] trans4 (assoc4 congT [u]u∘z) assoc
  //                            (assoc congT [u]v∘u) (assoc congT [u]v∘(w∘u))❙
❚

view OppositeSemigroup : ?Semigroup → ?Semigroup = 
  include ?OppositeMagma ❙
  op = op ❙
  assoc = assoc ❙
❚

theory CommSemigroup = 
  include ?Commutative ❙
  include ?Semigroup ❙
❚

theory Pointed = 
  include ?Set❙
  elem : U ❘# e❙
❚

theory RightUnital =
  include ?Magma❙
  include ?Pointed❙
  neutralR : ⊦ ∀[x] x∘e ≐ x ❙
❚

theory LeftUnital = 
  include ?Magma❙
  include ?Pointed❙
  neutralL : ⊦ ∀[x] e∘x ≐ x ❙
❚

theory Unital = 
  include ?LeftUnital ❙
  include ?RightUnital ❙
❚

theory Monoid = 
  include ?Semigroup ❙
  include ?Unital ❙
❚

theory IdempotentMonoid = 
  include ?Idempotent ❙
  include ?Monoid ❙
❚

theory CommMonoid = 
  include ?Commutative❙
  include ?Monoid❙
❚

theory Quasigroup = 
  include ?Magma ❙
  div_left : ⊦ ∀[x] ∀[y] ∃[a] (a∘x ≐ y) ❙
  div_right: ⊦ ∀[x] ∀[y] ∃[b] (x∘b ≐ y) ❙ 
❚

theory Band = 
  include ?Idempotent ❙
  include ?Semigroup ❙
❚

theory Loop = 
  include ?Quasigroup ❙
  include ?Monoid❙
❚

theory InverseFun = 
  include ?Monoid❙
  inv : U ⟶ U❘# 1 ⁻ prec 60❙
  inverseLeft:  ⊦ ∀[x] x⁻∘x ≐ e❙
  inverseRight: ⊦ ∀[x] x∘x⁻ ≐ e❙
❚

theory Semilattice = 
  include ?Semigroup ❙
  include ?Idempotent ❙
❚

theory BoundedSemilattice =
  include ?Semilattice ❙
  include ?CommMonoid ❙
❚

theory InverseExistence = 
  include ?Monoid ❙
  inverseLeft:  ⊦ ∀[x]∃[i] i∘x ≐ e ❙
  inverseRight: ⊦ ∀[x]∃[i] x∘i ≐ e ❙
❚

