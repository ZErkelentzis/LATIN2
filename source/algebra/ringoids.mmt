namespace latin:/algebraic ❚

fixmeta latin:/?SFOLEQ ❚

theory BiMagma = 
  include ?Set ❙
  structure add : ?Magma = 
    universe = universe ❙
    U = U ❙
    op # 1 + 2 prec 40 ❙
  ❚
  
  structure mult : ?Magma = 
    universe = universe ❙
    U = U ❙
    op # 1 ⋅ 2 prec 50 ❙
  ❚
❚

theory Ringoid =
  include ?BiMagma ❙
  structure add : ?Commutative = 
    include ?BiMagma/add ❙
  ❚
  
  left_distrib: ⊦ ∀[r]∀[x]∀[y] r ⋅ (x + y) ≐ r⋅x + r ⋅ y ❙
  right_distrib: ⊦ ∀[r]∀[x]∀[y] (x + y) ⋅ r ≐ x ⋅ r + y ⋅ r ❙
❚

theory CommRingoid =
  include ?Ringoid ❙
  structure mult : ?CommSemigroup =
    include ?BiMagma/mult ❙
  ❚
❚

theory Semiring = 
	include ?Ringoid ❙
	structure add : ?CommMonoid =                                                                   
	  include ?Ringoid/add ❙
	  elem # zero ❙
	❚
	structure mult : ?Monoid =
	  include ?BiMagma/mult ❙
	  elem # one ❙
	❚
❚

theory CommSemiring = 
  include ?CommRingoid ❙
  include ?Semiring ❙
❚

theory NearRing = 
  include ?Semiring ❙
  structure add : ?Group =
    include ?BiMagma/add ❙
  ❚
❚

theory CommNearRing = 
  include ?CommRingoid ❙
  include ?NearRing ❙
❚

theory Ring = 
  include ?Semiring ❙
  structure add : ?CommGroup =
    include ?BiMagma/add ❙
  ❚
❚

theory BooleanRing = 
  include ?Ring ❙
  structure mult : ?IdempotentMonoid =
    include ?Semiring/mult ❙
  ❚
❚

theory CommRing = 
  include ?CommRingoid ❙
  include ?Ring ❙
❚

theory IntegralDomain =  
  include ?CommRing ❙
  no_zero_div: ⊦ ∀[x]∀[y] (x⋅y ≐ zero) ⇒ ((x ≐ zero) ∨ (y ≐ zero)) ❙
❚

theory SkewField = 
  include ?Ring ❙
  structure mult : ?Group = 
    include ?Semiring/mult ❙
  ❚
  neq01: ⊦ ¬(zero ≐ one) ❙
❚

theory DivisionRing = 
  include ?SkewField ❙
❚

theory Field = 
  include ?SkewField ❙
  include ?CommRingoid ❙
❚

theory BilinearRingoid = 
  include ?Ringoid ❙
  f: U ⟶ U ⟶ U ❙
  bilinear: ⊦ ∀[x]∀[y]∀[z] (f (x + y) z) ≐ (f x z) + (f y z) ∧ (f x (y + z)) ≐ (f x y) + (f y z) ❙
  homogen: ⊦ ∀[r]∀[x]∀[y] f (r⋅x) y ≐ r⋅ (f x y) ∧ f x (r⋅y) ≐ r⋅(f x y) ❙
❚

theory LieRing = 
  include ?BilinearRingoid ❙
  structure A : ?CommGroup = 
    include ?Ringoid/add ❙
  ❚
  bracket = f ❘# ⟨ 1  2 ⟩ prec 40 ❙ 
  bracket_defn: ⊦ ∀[x]∀[y] ⟨x y⟩ ≐ x ⋅ y - y ⋅ x ❙
  jacobi: ⊦ ∀[x]∀[y]∀[z] ⟨x ⟨y z⟩⟩ + ⟨y ⟨z x⟩⟩ + ⟨z ⟨x y⟩⟩ ≐ O ❙
  alternating: ⊦ ∀[x] ⟨x x⟩ ≐ O ❙
❚
