namespace latin:/algebraic ❚

fixmeta latin:/?SFOLEQ ❚

theory Ringoid =
  include ?Set ❙
  structure A : ?Commutative = 
    universe = universe ❙
    U = U ❙
    op @ plus ❘# 1 + 2 prec 40 ❙
  ❚

  structure M : ?Magma =
    universe = universe ❙
    U = U ❙
    op @ mult ❘# 1 ⋅ 2 prec 50 ❙
  ❚
  
  left_distrib: ⊦ ∀[r]∀[x]∀[y] r ⋅ (x + y) ≐ r⋅x + r ⋅ y ❙
  right_distrib: ⊦ ∀[r]∀[x]∀[y] (x + y) ⋅ r ≐ x ⋅ r + y ⋅ r ❙

❚

theory CommRingoid =
  include ?Ringoid ❙
  structure M : ?Commutative =
    include ?Ringoid/M ❙
  ❚
❚

theory Semiring = 
	include ?Ringoid ❙
	structure A : ?CommMonoid =
	  include ?Ringoid/A ❙
	  elem @ zero ❙
	❚
	structure M : ?Monoid =
	  include ?Ringoid/M ❙
	  elem @ one ❙
	❚
❚

theory CommSemiring = 
  include ?CommRingoid ❙
  include ?Semiring ❙
❚

theory NearRing = 
  include ?Semiring ❙
  structure A : ?Group =
    // include ?Ringoid/A ❙
  ❚
❚

theory CommNearRing = 
  include ?CommRingoid ❙
  include ?NearRing ❙
❚

theory Ring = 
  include ?Semiring ❙
  structure A : ?CommGroup =
    universe = universe ❙
    U = U ❙
  ❚
❚

theory BooleanRing = 
  include ?Ring ❙
  structure M : ?IdempotentMonoid =
    universe = universe ❙
    U = U ❙
  ❚
❚

theory CommRing = 
  include ?CommRingoid ❙
  include ?Ring ❙
❚

theory IntegralDomain =  
  include ?CommRing ❙
  no_zero_div: ⊦ ∀[x]∀[y] (x⋅y ≐ zero) ⇒ ((x ≐ zero) ∨ (y ≐ zero)) ❙
❚

theory SkewField = 
  include ?Ring ❙
  structure M : ?Group = 
    universe = universe ❙
    U = U ❙
  ❚
  neq01: ⊦ ¬(zero ≐ one) ❙
❚

theory DivisionRing = 
  include ?SkewField ❙
❚

theory Field = 
  include ?SkewField ❙
  include ?CommRingoid ❙
❚

theory BilinearRingoid = 
  include ?Ringoid ❙
  f: U ⟶ U ⟶ U ❙
  bilinear: ⊦ ∀[x]∀[y]∀[z] (f (x + y) z) ≐ (f x z) + (f y z) ∧ (f x (y + z)) ≐ (f x y) + (f y z) ❙
  homogen: ⊦ ∀[r]∀[x]∀[y] f (r⋅x) y ≐ r⋅ (f x y) ∧ f x (r⋅y) ≐ r⋅(f x y) ❙
❚

theory LieRing = 
  include ?BilinearRingoid ❙
  structure A : ?CommGroup = 
    include ?Ringoid/A ❙
    elem @ zero ❙
    inv @ minus ❙
    sub # 1 - 2 prec 50 ❙
  ❚
  bracket = f ❙ 
  bracket_defn: ⊦ ∀[x]∀[y] (bracket x y) ≐ (mult x y) - (mult y x) ❙
  jacobi: ⊦ ∀[x]∀[y]∀[z] (bracket x (bracket y z)) + (bracket y (bracket z x)) + (bracket z (bracket x y)) ≐ zero ❙
  alternating: ⊦ ∀[x] (bracket x x) ≐ zero ❙
❚
