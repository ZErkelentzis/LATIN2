namespace latin:/algebraic❚

fixmeta latin:/?SFOLEQ ❚

theory Set = 
  universe : tp❙
  U = tm universe❙
❚

theory Magma = 
  include ?Set ❙
  op : U ⟶ U ⟶ U ❘# 1 ∘ 2 prec 50 ❙
❚

theory Commutative = 
  include ?Magma ❙
  comm : ⊦ ∀[x]∀[y] x∘y ≐ y∘x❙
❚

view OppositeMagma : ?Magma → ?Magma = 
  universe = universe ❙
  U = U ❙
  op = [x, y] y ∘ x ❙
❚

theory Idempotent = 
  include ?Magma ❙
  idem: ⊦ ∀[x] (x ∘ x) ≐ x ❙
❚

view OppositeCommMagma : ?Commutative → ?Commutative =
  include ?OppositeMagma ❙
  op = op ❙
  comm = comm ❙
❚

theory Semigroup = 
  include ?Magma ❙
  assoc : ⊦ ∀[x]∀[y]∀[z] (x∘y)∘z ≐ x∘(y∘z)❙
❚

view OppositeSemigroup : ?Semigroup → ?Semigroup = 
  include ?OppositeMagma ❙
  op = op ❙
  assoc = assoc ❙
❚

theory CommSemigroup = 
  include ?Commutative❙
  include ?Semigroup❙
❚

theory Pointed = 
  include ?Set❙
  elem : U ❘# e❙
❚

theory RightNeutral =
  include ?Magma❙
  include ?Pointed❙
  neutralR : ⊦ ∀[x]x∘e ≐ x❙
❚

theory LeftNeutral = 
  include ?Magma❙
  include ?Pointed❙
  neutralL : ⊦ ∀[x]e∘x ≐ x❙
❚

theory Monoid = 
  include ?Semigroup❙
  include ?RightNeutral❙
  include ?LeftNeutral❙
❚

theory IdempotentMonoid = 
  include ?Idempotent ❙
  include ?Monoid ❙
❚

theory CommMonoid = 
  include ?Commutative❙
  include ?Monoid❙
❚

theory Quasigroup = 
  include ?Magma ❙
  divisibility: ⊦ ∀[x]∀[y]∃[a]∃[b] (a∘x ≐ y) ∧ (x∘b ≐ y)❙ 
❚

theory Band = 
  include ?Idempotent ❙
  include ?Semigroup ❙
❚

theory Loop = 
  include ?Quasigroup ❙
  include ?Monoid❙
❚

theory InverseFun = 
  include ?Monoid❙
  inv : U ⟶ U❘# 1 ⁻ prec 60❙
  inverseLeft:  ⊦ ∀[x] x⁻∘x ≐ e❙
  inverseRight: ⊦ ∀[x] x∘x⁻ ≐ e❙
❚

theory SemiLattice = 
  include ?Semigroup ❙
  include ?Idempotent ❙
❚

theory InverseExistence = 
  include ?Monoid ❙
  inverseLeft:  ⊦ ∀[x]∃[i] i∘x ≐ e❙
  inverseRight: ⊦ ∀[x]∃[i] x∘i ≐ e❙
❚

theory Group = 
  include ?Monoid ❙
  include ?InverseFun❙
❚

theory CommGroup = 
  include ?Group❙
  include ?Commutative❙
  zero = e ❘# O ❙
  add = op ❘# 1 + 2 prec 70 ❙
  minus = inv ❘# -1 prec 40 ❙
  sub = [x,y] op x (inv y) ❘# 1 - 2 prec 70 ❙
❚
