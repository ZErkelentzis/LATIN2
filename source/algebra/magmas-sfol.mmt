namespace latin:/algebraic❚

fixmeta latin:/?SFOLEQ ❚

theory Set = 
  universe : tp❙
  U = tm universe❙
❚

theory Magma = 
  include ?Set ❙
  op : U ⟶ U ⟶ U ❘# 1 ∘ 2 prec 50 ❙
❚

theory Commutative = 
  include ?Magma ❙
  comm : ⊦ ∀[x]∀[y] x∘y ≐ y∘x❙
❚

theory Semigroup = 
  include ?Magma❙
  assoc : ⊦ ∀[x]∀[y]∀[z] (x∘y)∘z ≐ x∘(y∘z)❙
❚

theory CommSemigroup = 
  include ?Commutative❙
  include ?Semigroup❙
❚

theory Pointed = 
  include ?Set❙
  elem : U ❘# e❙
❚

theory RightNeutral =
  include ?Magma❙
  include ?Pointed❙
  neutralR : ⊦ ∀[x]x∘e ≐ x❙
❚

theory LeftNeutral = 
  include ?Magma❙
  include ?Pointed❙
  neutralL : ⊦ ∀[x]e∘x ≐ x❙
❚

theory Monoid = 
  include ?Semigroup❙
  include ?RightNeutral❙
  include ?LeftNeutral❙
❚

theory CommMonoid = 
  include ?Commutative❙
  include ?Monoid❙
❚

theory Quasigroup = 
  include ?Magma ❙
  divisibility: ⊦ ∀[x]∀[y]∃[a]∃[b] (a∘x ≐ y) ∧ (x∘b ≐ y)❙ 
❚

theory Loop = 
  include ?Quasigroup ❙
  include ?Monoid❙
❚

theory InverseFun = 
  include ?Monoid❙
  inv : U ⟶ U❘# 1 ⁻ prec 60❙
  inverseLeft:  ⊦ ∀[x] x⁻∘x ≐ e❙
  inverseRight: ⊦ ∀[x] x∘x⁻ ≐ e❙
❚

theory InverseExistence = 
  include ?Monoid ❙
  inverseLeft:  ⊦ ∀[x]∃[i] i∘x ≐ e❙
  inverseRight: ⊦ ∀[x]∃[i] x∘i ≐ e❙
❚

theory Group = 
  include ?Monoid ❙
  include ?InverseFun❙
❚

theory CommGroup = 
  include ?Group❙
  include ?Commutative❙
❚