   	U_d
   		   : tp
   ❙
   	U_c
   		   : tp
   ❙
   	U_h
   		   : tm U_d⟶tm U_c
   ❙

   ❚

fixmeta latin:/?SFOLEQND ❚

// theory TrivialSetHom =
  include ?Set ❙

  realize ?Set_hom ❙
  U_d = U ❙
  U_c = U ❙
  U_h = [x] x ❙
❚

 // theory Magma_hom : latin:/?SFOLEQND  =
   	include ☞latin:/algebraic/diagop-test?Set_hom ❙
   	op_d
   		   : tm U_d⟶tm U_d⟶tm U_d
   ❙
   	op_c
   		   : tm U_c⟶tm U_c⟶tm U_c
   ❙
   	op_h
   		   : ⊦∀[x_0:tm U_d]∀[x_1:tm U_d](U_h (op_d x_0 x_1))≐(op_c (U_h x_0) (U_h x_1))
   ❙

   ❚

// theory TrivialMagmaHom =
  include ?Magma ❙
  include ?TrivialSetHom ❙
  include ☞latin:/?InformalProofs ❙

  realize ?Magma_hom ❙
