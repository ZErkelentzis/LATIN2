// Runs the algebra diagram operators on the test input declared in diagop-theories.mmt.

   Responsible: Navid ❚
namespace latin:/algebraic/diagop-test ❚

rule scala://parser.api.mmt.kwarc.info?MMTURILexer ❚

import operators scala://diagop.odk.mmt.kwarc.info ❚
import alg latin:/algebraic ❚

theory AlgebraicDiagOps : ur:?DiagramOperators =
  hom_operator       # HOM_OP 1       ❙ rule ☞operators:?HomOperator          ❙
  hom_dom_connector  # HOM_DOM 1      ❙ rule ☞operators:?HomDomConnector      ❙
  hom_cod_connector  # HOM_COD 1      ❙ rule ☞operators:?HomCodConnector      ❙
  hom_img_connector  # HOM_IMG 1      ❙ rule ☞operators:?HomImgConnector      ❙ // depends on HOM and SUB ❙
  hom_id_connector   # HOM_ID 1       ❙ rule ☞operators:?HomIdConnector       ❙

  hom = hom_operator ~> hom_id_connector ~> hom_dom_connector ~> hom_cod_connector ❘ # HOM 1 ❙

  sub_operator        # SUB_OP 1       ❙ rule ☞operators:?SubOperator          ❙
  sub_full_connector  # SUB_FULL 1     ❙ rule ☞operators:?SubFullConnector     ❙
  sub_par_connector   # SUB_PAR 1      ❙ rule ☞operators:?SubParentConnector   ❙
  sub_sub_connector   # SUB_SUBMODEL 1 ❙ rule ☞operators:?SubSubmodelConnector ❙

  sub = sub_operator ~> sub_full_connector ~> sub_par_connector ~> sub_sub_connector ❘ # SUB 1 ❙

  hom_sub = hom ~> sub ~> hom_img_connector ❘ # HOMSUB 1 ❙

  quot_operator      # QUOT_OP 1    ❙ rule ☞operators:?QuotOperator         ❙
  quot_par_connector # QUOT_PAR 1   ❙ rule ☞operators:?QuotParentConnector  ❙
  quot_mod_connector # QUOT_MOD 1   ❙ rule ☞operators:?QuotModConnector     ❙
  quot_hom_connector # QUOT_HOM 1   ❙ rule ☞operators:?QuotHomConnector     ❙ // depends on QUOT and HOM ❙
  quot = quot_operator ~> quot_par_connector ~> quot_mod_connector ❘ # QUOT 1 ❙

  // careful ordering of operators with dependencies ❙
  universal_algebra = hom_sub ~> quot_operator ~> quot_hom_connector ~> quot ❘ # UNIVALG 1 ❙

  modrel_operator    # MODREL 1 2 3 ❙  rule ☞operators:?ModRelOperator      ❙

  // copy_operator     # COPY 1     ❙ // rule ☞oprscala://modules.api.mmt.kwarc.info?CopyOperator copy_operator ☞latin:/?SFOLEQND ☞latin:/?SFOLEQND ❙

  /T Some diagram operators (e.g. MODREL) take natural numbers as parameters.
         Only do inclusion here such that the notations above generate OMAs, not ApplySpines❙
  include ☞ur:?NatLiterals ❙
❚

theory StrengthenedSFOL =
  include ☞latin:/?SFOLEQND ❙
  include ☞http://gl.mathhub.info/MMT/LFX/Records?LFRecords ❙
❚

theory Diagram : ?AlgebraicDiagOps =
  // diagForHom = BDIAG ☞latin:/?SFOLEQND ?Set ! ?Magma ! ?OppositeMagma ❙
  // diagForSub = BDIAG ☞latin:/?SFOLEQND ?Set ?Magma ?Monoid ?Graph ❙
  // diagForSub = BDIAG ☞latin:/?SFOLEQND ?Set ?Pointed ?PointedSet ❙

  // subOutput = SUB diagForSub ❙

  playDiag = BDIAG ☞latin:/?SFOLEQND ! ?Set ! ?Magma ! ?Pointed ! ?PointedSet ! ?TertiaryStructure ❙

  // realDiag =
    BDIAG
        ☞latin:/?SFOLEQND
        ☞alg:?Set
        ☞alg:?Magma
        ☞alg:?Commutative
        ☞alg:?OppositeMagma
        ☞alg:?Idempotent
        ☞alg:?OppositeCommMagma
        ☞alg:?PowerAssociative
        ☞alg:?Semigroup
        ☞alg:?Pointed ☞alg:?UnitElement ☞alg:?LeftUnital ☞alg:?RightUnital ☞alg:?Unital ☞alg:?Monoid
  ❙
❚

// diagram HomTest : ?AlgebraicDiagOps := QUOT_OP ?Diagram?playDiag ❚
diagram PlayTest : ?AlgebraicDiagOps := UNIVALG ?Diagram?playDiag ❚

