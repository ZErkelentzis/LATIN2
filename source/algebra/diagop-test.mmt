// Runs the algebra diagram operators on the test input declared in diagop-theories.mmt.

   Responsible: Navid ❚
namespace latin:/algebraic/diagop-test ❚

rule scala://parser.api.mmt.kwarc.info?MMTURILexer ❚

import operators scala://newoperators.moduleexpressions.mmt.kwarc.info ❚
import alg latin:/algebraic ❚

//

theory Magma =
  U: tp
  op: tm U -> tm U -> tm U
||

theory Monoid =
  include ?Magma
  ...
||

theory Hom(Magma) =
  struct dom : ?Magma = ||
  struct cod : ?Magma = ||

  h: tm dom/U -> tm cod/U |
  hom_condition: |- h(a op b) = h(a) op h(b)
||

theory Hom(Monoid) =
  include ?Hom(Magma) // include-preserving
  ...
|||

❚

// Operatoren in Mathematik, Modelltheorie ❚


theory AlgebraicDiagOps : ur:?DiagramOperators =
  hom_operator       # HOM_OP       ❙ rule ☞operators:?HomOperator          ❙
  hom_dom_connector  # HOM_DOM      ❙ rule ☞operators:?HomDomConnector      ❙
  hom_cod_connector  # HOM_COD      ❙ rule ☞operators:?HomCodConnector      ❙
  hom_img_connector  # HOM_IMG      ❙ rule ☞operators:?HomImgConnector      ❙
  hom_all = HOM_OP :+: HOM_DOM :+: HOM_COD ❘ # HOM ❙

  sub_operator       # SUB_OP       ❙ rule ☞operators:?SubOperator          ❙
  submodel_conector  # SUB_SUBMODEL ❙ rule ☞operators:?SubSubmodelConnector ❙
  sub_all = SUB_OP :+: SUB_SUBMODEL ❘ # SUB ❙

  hom_sub = HOM :+: SUB :+: HOM_IMG ❘ # HOMSUB ❙

  quot_operator      # QUOT_OP      ❙ rule ☞operators:?QuotOperator         ❙
  quot_mod_connector # QUOT_MOD     ❙ rule ☞operators:?QuotModConnector     ❙
  quot_all = QUOT_OP :+: QUOT_MOD ❘ # QUOT ❙

  universal_algebra = HOMSUB :+: QUOT ❘ # UNIVALG ❙

  // copy_operator     # COPY         ❙ // rule ☞oprscala://modules.api.mmt.kwarc.info?CopyOperator copy_operator ☞latin:/?SFOLEQND ☞latin:/?SFOLEQND ❙
❚

theory Diagram : ?AlgebraicDiagOps =
  diagForHom = SDIAG ☞latin:/?SFOLEQND ?Set ?Magma ?OppositeMagma ❙
  // diagForSub = SDIAG ☞latin:/?SFOLEQND ?Set ?Magma ?Monoid ?Graph ❙
  diagForSub = SDIAG ☞latin:/?SFOLEQND ?Set ?Pointed ?PointedSet ❙

  // subOutput = SUB diagForSub ❙

  playDiag = SDIAG ☞latin:/?SFOLEQND ?Set ?Magma ?TertiaryStructure ❙

  realDiag =
    SDIAG
        ☞latin:/?SFOLEQND
        ☞alg:?Set
        ☞alg:?Magma
        ☞alg:?Commutative
        ☞alg:?OppositeMagma
        ☞alg:?Idempotent
        ☞alg:?OppositeCommMagma
        ☞alg:?PowerAssociative
        ☞alg:?Semigroup
        ☞alg:?Pointed ☞alg:?UnitElement ☞alg:?LeftUnital ☞alg:?RightUnital ☞alg:?Unital ☞alg:?Monoid
  ❙
❚

// diagram HomTest : ?AlgebraicDiagOps := QUOT_OP ?Diagram?playDiag ❚
diagram PlayTest : ?AlgebraicDiagOps := QUOT ?Diagram?playDiag ❚

