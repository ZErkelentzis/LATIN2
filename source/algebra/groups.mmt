namespace latin:/algebraic❚

fixmeta latin:/?SFOLEQ ❚

theory Group = 
  include ?Monoid ❙
  include ?InverseFun ❙
❚

theory CommGroup = 
  include ?Group❙
  include ?CommMonoid❙
❚

theory GroupHom = 
  include ?MagmaHom ❙
  structure domain : ?Group =
    U = domain/U ❙
  ❚
  structure codoamin : ?Group = 
    U = codomain/U ❙
  ❚
  // e: ⊦ U domain/e ≐ codomain/e ❙
❚
