namespace latin:/ ❚

fixmeta ur:?LF ❚

theory Generated = 
  include ☞latin:/powertypes?PowerSFOL❙
  generate   : {S} tm ℘S ⟶  tm ℘S ❘# ⟨ 2 ⟩ prec 10 ❙
  generating : {S, A: tm ℘S} ⊦ A ⊆ ⟨A⟩ ❙
  monotone   : {S, A: tm ℘S, B: tm ℘S } ⊦ A ⊆ B ⟶ ⊦ ⟨A⟩ ⊆ ⟨B⟩ ❙
  idempotent : {S, A: tm ℘S} ⊦ ⟨⟨A⟩⟩ ≐ ⟨A⟩ ❙
❚

