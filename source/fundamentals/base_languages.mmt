namespace latin:/❚

fixmeta ur:?LF❚

/T This file defines a number of alternative base languages for language features.
   
   Typically,
   - every language extends exactly one of them
   - every language feature can be defined relative to all or at least multiple of them.
❚

/T logics without any typing
   paradigmatic languages: first-order logic❚
theory UntypedLogic =
  include ?Logic❙
  include ?Terms❙
❚

/T typed logics
   paradigmatic languages: sorted/typed first-order logic, λ-cube logics❚
theory TypedLogic =
  include ?Logic❙
  include ?TypedTerms❙
  liftPred2: {S,A,B} (          tm A ⟶           tm B  ⟶          prop)
                   ⟶ (tm S ⟶ tm A) ⟶ (tm S ⟶ tm B) ⟶ (tm S ⟶ prop)❘
      = [S,A,B,o,f,g] [x] o (f x) (g x)❘
      # liftFun2 4❙

  lift0: {S} prop ⟶ (tm S ⟶ prop)❘
      = [S,o] [x]o❘
      # lift0 2❙
  lift1: {S} (prop ⟶ prop) ⟶ (tm S ⟶ prop) ⟶ (tm S ⟶ prop)❘
      = [S,o,f] [x]o (f x)❘
      # lift1 2❙
  lift2: {S} (prop ⟶ prop ⟶ prop) ⟶ (tm S ⟶ prop) ⟶ (tm S ⟶ prop) ⟶ (tm S ⟶ prop)❘
      = [S,o,f,g] [x]o (f x) (g x)❘
      # lift2 2❙
❚

/T logics with flexible type systems
   paradigmatic languages: mathematics (arguably)❚
theory SoftTypedLogic =
  include ?SoftTypedTerms❙
  include ?Logic❙
❚         

/T logics whose propositions are terms
   paradigmatic languages: higher-order logic❚
theory InternalLogic =
  include ?InternalPropositions❙
  include ?Proofs❙
❚

/T logics whose types are terms
   paradigmatic languages: set theory❚
theory InternallyTypedLogic =
  include ?InternalTypes❙
  include ?Logic❙
❚
