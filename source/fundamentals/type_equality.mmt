namespace latin:/❚

fixmeta ur:?LF❚

theory TypeEqualityND =
  include ?Types❙
  include ?Logic❙

  structure tpeq : ?UntypedEqualityND =
     include ?Logic❙     
     term = tp❙
     equal # 1 ≛ 2 prec 50❘role Eq❙
  ❚    
❚

theory DependentTypeEquality =
  include ?TypeEqualityND❙
  include ?TypedEqualityND❙
  
  congType: {A,x,y} ⊦ x≐y ⟶ {B:tm A ⟶ tp} ⊦ B x ≛ B y❘
          = [A,x,y,p,B] p congP ([u] B x ≛ B u) tpeq/refl❘
          # 4 congType 5❙
  transport: {A,B} ⊦ A ≛ B ⟶ tm A ⟶ tm B❘ # 4 ↑ 3 prec 70❙ 
  
  transport_refl: {A,x: tm A} ⊦ x↑tpeq/refl ≐ x❙
  transport_trans: {A,B,C, x, p:⊦ A ≛ B, q: ⊦ B ≛ C} ⊦ x↑p↑q ≐ x↑(p tpeq/eq/trans q)❙
❚
