namespace latin:/ ❚

theory MizarPatterns : ur:?LF =
  include ?Mizar ❙
	include ?HIDDEN ❙
	pattern directPartFuncDef(n:NAT, argTps:(term^n ⟶ tp)^n, ret:tp, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ term)^m, defRes: term^n ⟶ term) ❘ =
    funct: term^n ⟶ term❙
		rtype: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ((funct x) ⦂ ret) ❙
		means: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' ((cases..j) x) ⇒ (funct x ≐ (caseRes..j) x) | j:m '⟩)
						∧  ((nary_and m ⟨' ¬ ((cases..k) x) | k:m '⟩) ⇒ ((funct x) ≐ defRes x)) ❙
  ❚
	pattern indirectPartFuncDef(n:NAT, argTps:(term^n ⟶ tp)^n, ret:tp, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m, defRes: term^(succ n) ⟶ prop) ❘ =
    funct: term^n ⟶ term❙
		rtype: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ((funct x) ⦂ ret) ❙
		means: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' ((cases..j) x) ⇒ (caseRes..j) ⟨ x, (funct x) ⟩ | j:m '⟩)
						∧  ((nary_and m ⟨' ¬ ((cases..k) x) | k:m '⟩) ⇒ (defRes ⟨ x, funct x ⟩)) ❙
  ❚
	pattern directComplFuncDef(n:NAT, argTps:(term^n ⟶ tp)^n, ret:tp, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ term)^m) ❘ =
    funct: term^n ⟶ term❙
		rtype: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ((funct x) ⦂ ret) ❙
		means: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' ((cases..j) x) ⇒ (funct x ≐ (caseRes..j) x) | j:m '⟩) ❙
		completeness: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦
						(nary_or m ⟨' ((cases..j) x) | j:m '⟩) ❙
  ❚
	pattern indirectComplFuncDef(n:NAT, argTps:(term^n ⟶ tp)^n, ret:tp, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m) ❘ =
    funct: term^n ⟶ term❙
		rtype: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ((funct x) ⦂ ret) ❙
		means: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' ((cases..j) x) ⇒ (caseRes..j) ⟨ x, (funct x) ⟩ | j:m '⟩) ❙
		completeness: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦
						(nary_or m ⟨' ((cases..j) x) | j:m '⟩) ❙
  ❚
	pattern directParPredDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ prop)^m, defRes: term^n ⟶ prop) ❘ =
    pred: term^n ⟶ prop ❙
		means: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' (((cases..j) x) ⇒ (pred x)) ⇔ ((caseRes..j) x) | j:m '⟩)
						∧  ((nary_and m ⟨' ¬ ((cases..k) x) | k:m '⟩) ⇒ (pred x ≐ defRes x)) ❙
  ❚
	pattern directComplPredDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ prop)^m) ❘ =
    pred: term^n ⟶ prop ❙
		means: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' (((cases..i) x) ⇒ (pred x)) ⇔ (caseRes..i) x | i:m '⟩) ❙
		completeness: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦
						(nary_or m ⟨' ((cases..i) x) | i:m '⟩) ❙
  ❚
	pattern indirectParAttrDef(n:NAT, argTps:(term^n ⟶ tp)^n, motherTp:(term^n ⟶ tp), m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m, defRes: term^(succ n) ⟶ prop) ❘ =
    attr: {x:term^n} (motherTp x) ⟶ prop ❙
		mtype: {x:term^n, p: ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩} ⟶ forall ([y] y ⦂ (adjective motherTp (attr x p)) ⇒ y ⦂ (motherTp x)) ❙
		means: {x:term^n, p: ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩} ⟶ ⊦ 
						(nary_and m ⟨' (((cases..j) x) ⇒ forall ([y] y ⦂ (adjective motherTp (attr x p)) ⇔ (caseRes..j) ⟨ x, y ⟩)) | j:m '⟩)
						∧  ((nary_and m ⟨' ¬ ((cases..k) x) | k:m '⟩) ⇒ forall ([y] y ⦂ (adjective motherTp (attr x p)) ⇔ defRes ⟨ x, y ⟩)) ❙
  ❚
	pattern indirectComplAttrDef(n:NAT, argTps:(term^n ⟶ tp)^n, motherTp:(term^n ⟶ tp), m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m) ❘ =
    attr: {x:term^n} (motherTp x) ⟶ prop ❙
		mtype: {x:term^n} {p: ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩} forall ([y] y ⦂ (adjective motherTp (attr x p)) ⇒ y ⦂ (motherTp x)) ❙
		means: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' (((cases..j) x) ⇒ forall ([y] y ⦂ (adjective motherTp (attr x p)) ⇔ (caseRes..j) ⟨ x, y ⟩)) | j:m '⟩) ❙
		completeness: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦
						(nary_or m ⟨' ((cases..j) x) | j:m '⟩) ❙
  ❚
	pattern directParModeDef(n:NAT, argTps:(set^n ⟶ tp)^n, m:NAT, cases:(set^n ⟶ prop)^m, caseRes:(set^n ⟶ tp)^m, defRes: set^n ⟶ tp) ❘ =
    mode: set^n ⟶ tp ❙
		means: {x:set^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' (((cases..j) x) ⇒ mode x ≐ caseRes x) | j:m '⟩)
						∧  ((nary_and m ⟨' ¬ ((cases..k) x) | k:m '⟩) ⇒ mode x ≐ defRes x) ❙
  ❚
	pattern indirectParModeDef(n:NAT, argTps:(set^n ⟶ tp)^n, m:NAT, cases:(set^n ⟶ prop)^m, caseRes:(set^(succ n) ⟶ prop)^m, defRes: set^(succ n) ⟶ prop) ❘ =
    mode: set^n ⟶ tp ❙
		means: {x:set^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' (((cases .. j) x) ⇒ (caseRes ⟨ x, mode x⟩)) | j:m '⟩)
						∧  ((nary_and m ⟨' ¬ ((cases..k) x) | k:m '⟩) ⇒ (defRes ⟨ x, mode x⟩)) ❙
  ❚
	pattern directComplModeDef(n:NAT, argTps:(set^n ⟶ tp)^n, m:NAT, cases:(set^n ⟶ prop)^m, caseRes:(set^n ⟶ tp)^m) ❘ =
    mode: set^n ⟶ tp ❙
		means: {x:set^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' (((cases..j) x) ⇒ (mode x ≐ caseRes x)) | j:m '⟩) ❙
		completeness: {x:set^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦
						(nary_or m ⟨' ((cases..j) x) | j:m '⟩) ❙
  ❚
	pattern indirectComplModeDef(n:NAT, argTps:(set^n ⟶ tp)^n, m:NAT, cases:(set^n ⟶ prop)^m, caseRes:(set^(succ n) ⟶ prop)^m) ❘ =
    mode: set^n ⟶ tp ❙
		means: {x:set^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ 
						(nary_and m ⟨' (((cases..j) x) ⇒ (mode x ≐ caseRes x)) | j:m '⟩) ❙
		completeness: {x:set^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦
						(nary_or m ⟨' ((cases..j) x) | j:m '⟩) ❙
  ❚
	pattern schemeDef(n:NAT, argTps:(set^n ⟶ tp)^n, m:NAT, asumptions:(set^n ⟶ prop)^m, p: set^n ⟶ prop) ❘ =
  	scheme: {x:set^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ ⊦ (nary_and m ⟨' ((assumptions..j) x) | j:m '⟩) ⟶ ⊦ p x ❙
  ❚
	pattern synonymicNotation(n:NAT, argTps:(term^n ⟶ tp)^n, v: term^n ⟶ prop) ❘ =
  	notation: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ prop ❘ = [x] [p] v x ❙
  ❚
	pattern antonymicNotation(n:NAT, argTps:(term^n ⟶ tp)^n, v: term^n ⟶ prop) ❘ =
  	notation: {x:term^n} ⟨' (x..i) ⦂ ((argTps..i) x) | i:n '⟩ ⟶ prop ❘ = [x] [p] ¬ (v x) ❙
  ❚
	pattern attrRegistration(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, t:Lsynonymic term^n ⟶ tp, a: (dep_typed_attr n t)^m) ❘ =
  	registration: {x:term^n} ⟨' (x .. i) ⦂ ((argTps .. i) x) | i:n '⟩ ⟶ ⊦ ∃ [y] (y ⦂ (a @ t)) ❙
  ❚
	
❚

theory patternTests : ☞latin:/?MizarPatterns =
  
❚
