namespace latin:/ ❚

import rules scala://mmtwrapper.newxml.mizar.mmt.kwarc.info ❚

theory MizarPatterns : ?HIDDEN =
	consistencyTpDirTmres: {n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ term)^m} type ❘ = [n, argTps, m, cases, caseRes] {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ nary_and m ⟨' (cases..k) argumentSequence ⇒ (caseRes..j) argumentSequence ≐ (caseRes..k) argumentSequence | k:m '⟩ | j:m '⟩ ❙
	consistencyTpIndirTmres: {n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m} type ❘ = [n, argTps, m, cases, caseRes] {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ nary_and m ⟨' (cases..k) argumentSequence ⇒ forall [y] (caseRes..j) ⟨ argumentSequence, y ⟩ ⇔ (caseRes..k) ⟨ argumentSequence, y ⟩ | k:m '⟩ | j:m '⟩ ❙
	consistencyTpDirPropres: {n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ prop)^m} type ❘ = [n, argTps, m, cases, caseRes] {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ nary_and m ⟨' (cases..k) argumentSequence ⇒ (caseRes..j) argumentSequence ⇔ (caseRes..k) argumentSequence | k:m '⟩ | j:m '⟩ ❙
	consistencyTpIndirPropres: {n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m} type ❘ = [n, argTps, m, cases, caseRes] {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ nary_and m ⟨' (cases..k) argumentSequence ⇒ forall [y] (caseRes..j) ⟨ argumentSequence, y ⟩ ⇔ (caseRes..k) ⟨ argumentSequence, y ⟩ | k:m '⟩ | j:m '⟩ ❙
	consistencyTpDirModeres: {n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ term ⟶ prop)^m} type ❘ = [n, argTps, m, cases, caseRes] {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ nary_and m ⟨' (cases..k) argumentSequence ⇒ forall [s] (caseRes..j) argumentSequence s ⇔ (caseRes..k) argumentSequence s | k:m '⟩ | j:m '⟩ ❙
	pattern directPartFuncDef(n:NAT, argTps:(term^n ⟶ tp)^n, ret:tp, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ term)^m, consistencyProof: consistencyTpDirTmres n argTps m cases caseRes, defRes: term^n ⟶ term) ❘ =
    funct: term^n ⟶ term ❙
		rtype: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ funct argumentSequence ⦂ ret ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ (argumentSequence..i) ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ funct argumentSequence ≐ (caseRes..j) argumentSequence | j:m '⟩
						∧  (nary_and m ⟨' ¬ (cases..k) argumentSequence | k:m '⟩ ⇒ (funct argumentSequence) ≐ defRes argumentSequence) ❙
  ❚
	pattern indirectPartFuncDef(n:NAT, argTps:(term^n ⟶ tp)^n, ret:tp, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m, consistencyProof: consistencyTpIndirTmres n argTps m cases caseRes, defRes: term^(succ n) ⟶ prop) ❘ =
    funct: term^n ⟶ term❙
		rtype: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ (funct argumentSequence) ⦂ ret ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ (caseRes..j) ⟨ argumentSequence, (funct argumentSequence) ⟩ | j:m '⟩
						∧  nary_and m ⟨' ¬ (cases..k) argumentSequence | k:m '⟩ ⇒ defRes ⟨ argumentSequence, funct argumentSequence ⟩ ❙
  ❚
	pattern directComplFuncDef(n:NAT, argTps:(term^n ⟶ tp)^n, ret:tp, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ term)^m, consistencyProof: consistencyTpDirTmres n argTps m cases caseRes) ❘ =
    funct: term^n ⟶ term❙
		rtype: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ (funct argumentSequence) ⦂ ret ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ funct argumentSequence ≐ (caseRes..j) argumentSequence | j:m '⟩ ❙
		completeness: {argumentSequence:term^n} ⟨' ⊦ (argumentSequence..i) ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦
						nary_or m ⟨' (cases..j) argumentSequence | j:m '⟩ ❙
  ❚
	pattern indirectComplFuncDef(n:NAT, argTps:(term^n ⟶ tp)^n, ret:tp, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m, consistencyProof: consistencyTpIndirTmres n argTps m cases caseRes) ❘ =
    funct: term^n ⟶ term❙
		rtype: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ (funct argumentSequence) ⦂ ret ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ (caseRes..j) ⟨ argumentSequence, (funct argumentSequence) ⟩ | j:m '⟩ ❙
		completeness: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦
						nary_or m ⟨' (cases..j) argumentSequence | j:m '⟩ ❙
  ❚
	pattern directPartPredDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ prop)^m, consistencyProof: consistencyTpDirPropres n argTps m cases caseRes, defRes: term^n ⟶ prop) ❘ =
    pred: term^n ⟶ prop ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ (pred argumentSequence) ⇔ (caseRes..j) argumentSequence | j:m '⟩
						∧  nary_and m ⟨' ¬ (cases..k) argumentSequence | k:m '⟩ ⇒ pred argumentSequence ⇔ defRes argumentSequence ❙
  ❚
	pattern directComplPredDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ prop)^m, consistencyProof: consistencyTpDirPropres n argTps m cases caseRes) ❘ =
    pred: term^n ⟶ prop ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..i) argumentSequence ⇒ (pred argumentSequence) ⇔ (caseRes..i) argumentSequence | i:m '⟩ ❙
		completeness: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦
						nary_or m ⟨' (cases..i) argumentSequence | i:m '⟩ ❙
  ❚
	pattern directPartAttrDef(n:NAT,
	    argTps:(term^n ⟶ tp)^n,
	    motherTp:term^n ⟶ tp,
	    m:NAT,
	    cases:(term^n ⟶ prop)^m,
			caseRes:(term^n ⟶ prop)^m,
			consistencyProof: consistencyTpDirPropres n argTps m cases caseRes,
			defRes: term^n ⟶ prop) ❘ =
    attribute: {argumentSequence: term^n} attr (motherTp argumentSequence) ❙
		mtype: {argumentSequence:term^n, p: ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩} ⊦ 
		   forall [y] y ⦂ adjective (motherTp argumentSequence) (attribute argumentSequence) ⇒ y ⦂ motherTp argumentSequence ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n, p: ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩} ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ forall [y] attribute argumentSequence y ⇔ (caseRes..j) ⟨ argumentSequence, y ⟩ | j:m '⟩
						∧  nary_and m ⟨' ¬ (cases..k) argumentSequence | k:m '⟩ ⇒ forall [y] attribute argumentSequence y ⇔ defRes ⟨ argumentSequence, y ⟩ ❙
  ❚
	pattern directComplAttrDef(n:NAT, argTps:(term^n ⟶ tp)^n, motherTp:(term^n ⟶ tp), m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ prop)^m, consistencyProof: consistencyTpDirPropres n argTps m cases caseRes) ❘ =
    attribute: {argumentSequence:term^n} term ⟶ prop ❙
		mtype: {argumentSequence:term^n} {p: ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩} ⊦ forall [y] y ⦂ adjective (motherTp argumentSequence) (attribute argumentSequence) ⇒ y ⦂ (motherTp argumentSequence) ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} {p: ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩} ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ forall [y] attribute argumentSequence y ⇔ (caseRes..j) ⟨ argumentSequence, y ⟩ | j:m '⟩ ❙
		completeness: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦
						nary_or m ⟨' (cases..j) argumentSequence | j:m '⟩ ❙
  ❚
	pattern indirectPartAttrDef(n:NAT,
	    argTps:(term^n ⟶ tp)^n,
	    motherTp:term^n ⟶ tp,
	    m:NAT,
	    cases:(term^n ⟶ prop)^m,
			caseRes:(term^(succ n) ⟶ prop)^m, 
			consistencyProof: consistencyTpIndirPropres n argTps m cases caseRes,
			defRes: term^(succ n) ⟶ prop) ❘ =
    attribute: {argumentSequence: term^n} attr (motherTp argumentSequence) ❙
		mtype: {argumentSequence:term^n, p: ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩} ⊦ 
		   forall [y] y ⦂ adjective (motherTp argumentSequence) (attribute argumentSequence) ⇒ y ⦂ motherTp argumentSequence ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n, p: ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩} ⊦ 
						(nary_and m ⟨' (cases..j) argumentSequence ⇒ forall [y] y ⦂ adjective (motherTp argumentSequence) (attribute argumentSequence) ⇔ (caseRes..j) ⟨ argumentSequence, y ⟩ | j:m '⟩)
						∧  nary_and m ⟨' ¬ (cases..k) argumentSequence | k:m '⟩ ⇒ forall [y] y ⦂ adjective (motherTp argumentSequence) (attribute argumentSequence) ⇔ defRes ⟨ argumentSequence, y ⟩ ❙
  ❚
	pattern indirectComplAttrDef(n:NAT, argTps:(term^n ⟶ tp)^n, motherTp:(term^n ⟶ tp), m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^(succ n) ⟶ prop)^m, consistencyProof: consistencyTpIndirPropres n argTps m cases caseRes) ❘ =
    attribute: {argumentSequence:term^n} term ⟶ prop ❙
		mtype: {argumentSequence:term^n} {p: ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩} ⊦ forall [y] y ⦂ (adjective (motherTp argumentSequence) (attribute argumentSequence)) ⇒ y ⦂ (motherTp argumentSequence) ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} {p: ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩} ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ forall [y] y ⦂ adjective (motherTp argumentSequence) (attribute argumentSequence) ⇔ (caseRes..j) ⟨ argumentSequence, y ⟩ | j:m '⟩ ❙
		completeness: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦
						(nary_or m ⟨' (cases..j) argumentSequence | j:m '⟩) ❙
  ❚
	pattern directPartModeDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ term ⟶ prop)^m, consistencyProof: consistencyTpDirModeres n argTps m cases caseRes, defRes: term^n ⟶ term ⟶ prop) ❘ =
    mode: term^n ⟶ term ⟶ prop ❙
		madeMode: term^n ⟶ tp ❘ = [argumentSequence] makeMode (mode argumentSequence) ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ forall [y] mode argumentSequence y ⇔ (caseRes..j) argumentSequence y | j:m '⟩
						∧  nary_and m ⟨' ¬ (cases..k) argumentSequence | k:m '⟩ ⇒ forall [y] mode argumentSequence y ⇔  defRes argumentSequence y ❙
  ❚
  /T Here we can't give consistencyProof the correct type 
  {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ nary_and m ⟨' (cases..k) argumentSequence ⇒ (caseRes..j) argumentSequence (mode argumentSequence) ⇔ (caseRes..k) argumentSequence (mode argumentSequence) | k:m '⟩ | j:m '⟩
		since that would require a forward reference to the external declaration mode. ❙
	pattern indirectPartModeDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ (term ⟶ prop) ⟶ prop)^m, consistencyProof: type, defRes: term^n ⟶ (term ⟶ prop) ⟶ prop) ❘ =
    mode: term^n ⟶ term ⟶ prop ❙
		madeMode: term^n ⟶ tp ❘ = [argumentSequence] makeMode (mode argumentSequence) ❙
		consistency	= consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases .. j) argumentSequence ⇒ (caseRes..j) argumentSequence (mode argumentSequence) | j:m '⟩
						∧  nary_and m ⟨' ¬ (cases..k) argumentSequence | k:m '⟩ ⇒ defRes argumentSequence (mode argumentSequence) ❙
  ❚
	pattern directComplModeDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ term ⟶ prop)^m, consistencyProof: consistencyTpDirModeres n argTps m cases caseRes) ❘ =
    mode: term^n ⟶ term ⟶ prop ❙
		madeMode: term^n ⟶ tp ❘ = [argumentSequence] makeMode (mode argumentSequence) ❙
		consistency = consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ forall [y] mode argumentSequence y ⇔ (caseRes..j) argumentSequence y | j:m '⟩ ❙
		completeness: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦
						nary_or m ⟨' (cases..j) argumentSequence | j:m '⟩ ❙
  ❚
	pattern indirectComplModeDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, cases:(term^n ⟶ prop)^m, caseRes:(term^n ⟶ (term ⟶ prop) ⟶ prop)^m, consistencyProof: type) ❘ =
    mode: term^n ⟶ term ⟶ prop ❙
		madeMode: term^n ⟶ tp ❘ = [argumentSequence] makeMode (mode argumentSequence) ❙
		consistency =  consistencyProof ❙
		means: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ 
						nary_and m ⟨' (cases..j) argumentSequence ⇒ (caseRes..j) argumentSequence (mode argumentSequence) | j:m '⟩ ❙
		completeness: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦
						nary_or m ⟨' (cases..j) argumentSequence | j:m '⟩ ❙
  ❚
	pattern schemeDef(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, assumptions:(term^n ⟶ prop)^m, p: term^n ⟶ prop) ❘ =
  	scheme: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ nary_and m ⟨' (assumptions..j) argumentSequence | j:m '⟩ ⟶ ⊦ (p argumentSequence) ❙
  ❚
	pattern synonymicNotation(n:NAT, argTps:(term^n ⟶ tp)^n, v: term^n ⟶ prop) ❘ =
  	notation: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ prop ❘ = [argumentSequence] [p] v argumentSequence ❙
  ❚
	pattern antonymicNotation(n:NAT, argTps:(term^n ⟶ tp)^n, v: term^n ⟶ prop) ❘ =
  	notation: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ prop ❘ = [argumentSequence] [p] ¬ (v argumentSequence) ❙
  ❚
	pattern existRegistration(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, t:term^n ⟶ tp, a: (dep_typed_attr n t)^m) ❘ =
  	registration: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ ∃ [y] y ⦂ (a @ t) ❙
  ❚
	pattern condRegistration(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, t:term^n ⟶ tp, a: (dep_typed_attr n t)^m, p: NAT, b: (dep_typed_attr n t)^p) ❘ =
  	registration: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ ∀ [y] y ⦂ (a @ t) ⇒ y ⦂ (b @ t) ❙
	❚
	pattern unqualFuncRegistration(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, t: term^n ⟶ tp, tm:term^n ⟶ term, a: (dep_typed_attr n t)^m) ❘ =
  	registration: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ tm argumentSequence ⦂ (a @ t) ❙
  ❚
	pattern qualFuncRegistration(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, t:term^n ⟶ tp, tm:term^n ⟶ term, a: (dep_typed_attr n t)^m) ❘ =
  	registration: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ tm argumentSequence ⦂ t argumentSequence ⟶ ⊦ tm argumentSequence ⦂ (a @ t) ❙
  ❚
	pattern identify(n:NAT, argTps:(term^n ⟶ tp)^n, m:NAT, a:(term^n ⟶ term)^m, b: (term^n ⟶ term)^m) ❘ =
  	registration: {argumentSequence:term^n} ⟨' ⊦ argumentSequence..i ⦂ (argTps..i) argumentSequence | i:n '⟩ ⟶ ⊦ nary_and m ⟨' (a..j) argumentSequence ≐ (b..j) argumentSequence | j:m '⟩ ❙
  ❚

	rule rules?MizarStructure ❙
❚

theory patternTests : ☞latin:/?MizarPatterns =
	/T This structure is from struct_0 ❙
	mizarStructure oneSorted() ❘ =
		carrier: tp ❙
	❚

	/T The following example is from algstr_0 ❙
	binOp: {t: tp} tp ❙
	mizarStructure addMagma() ❘ = 
		include ?patternTests/oneSorted ❙
		carrier: tp ❙
		addF: tp ❘ = binOp carrier ❙
	❚
❚
