namespace latin:/❚

import rules scala://lf.mmt.kwarc.info❚
fixmeta ur:?LF❚

theory ProofIrrelevance =
  include ?Propositions❙
  rule rules?TermIrrelevanceRule ded❙
❚

theory Classical =
  include ?Propositions❙
  dne : {F} ((⊦ F ⟶ ↯) ⟶ ↯) ⟶ ⊦ F❙
❚

theory Truth =
  include ?Propositions❙
  true  : prop❙
  trueI : ⊦ true❙
❚

theory Falsity =
  include ?Propositions❙
  false  : prop❙
  falseE : ⊦ false ⟶ ↯❘# 1 falseE❙
❚

theory Negation =
  include ?Propositions❙
  not   : prop ⟶ prop❘# ¬ 1   prec 20❙
  notI  : {F} (⊦ F ⟶ ↯) ⟶ ⊦ ¬ F❘# notI 2❙
  notE  : {F} ⊦ ¬ F ⟶ ⊦ F ⟶ ↯❘# 2 notE 3❘role ForwardRule❙
❚

theory Conjunction =
  include ?Propositions❙
  and   : prop ⟶ prop ⟶ prop❘# 1 ∧ 2 prec 15❙
  andI  : {F,G} ⊦ F ⟶ ⊦ G ⟶ ⊦ F ∧ G❙
  andEl : {F,G} ⊦ F ∧ G ⟶ ⊦ F❘# 3 andEl❘role ForwardRule❙
  andEr : {F,G} ⊦ F ∧ G ⟶ ⊦ G❘# 3 andEr❘role ForwardRule❙
❚

theory Disjunction =
  include ?Propositions❙
  or    : prop ⟶ prop ⟶ prop❘# 1 ∨ 2 prec 15❙
  orIl  : {F,G} ⊦ F ⟶ ⊦ F ∨ G❙
  orIr  : {F,G} ⊦ G ⟶ ⊦ F ∨ G❙
  orE   : {F,G,C} ⊦ F ∨ G ⟶ (⊦ F ⟶ ⊦ C) ⟶ (⊦ G ⟶ ⊦ C) ⟶ ⊦ C❘# 4 orE 5 6❙
❚

theory Implication =
  include ?Propositions❙
  impl  : prop ⟶ prop ⟶ prop❘# 1 ⇒ 2 prec 10❙
  impI  : {F,G} (⊦ F ⟶ ⊦ G) ⟶ ⊦ F ⇒ G❙
  impE  : {F,G} ⊦ F ⇒ G ⟶ ⊦ F ⟶ ⊦ G❘# 3 impE 4❘role ForwardRule❙
  
  view impl_preorder : ?Preorder -> ?Implication =
    carrier = prop❙
    rel = [x,y] ⊦ x ⇒ y❙
    refl = [F] impI [f] f❙
    trans = [F,G,H,fg,gh] impI [f] gh impE (fg impE f)❙ 
  ❚
❚

theory Equivalence =
  include ?Propositions❙
  equiv : prop ⟶ prop ⟶ prop❘# 1 ⇔ 2 prec 10❙
  equivI : {F,G} (⊦ F ⟶ ⊦ G) ⟶ (⊦ G ⟶ ⊦ F) ⟶ ⊦ F ⇔ G❙
  equivEl : {F,G} ⊦ F ⇔ G ⟶ ⊦ F ⟶ ⊦ G❘# 3 equivEl 4❘role ForwardRule❙
  equivEr : {F,G} ⊦ F ⇔ G ⟶ ⊦ G ⟶ ⊦ F❘# 3 equivEr 4❘role ForwardRule❙
  
  view equiv_equivalence : ?EquivalenceRelation -> ?Equivalence =
    carrier = prop❙
    rel = [x,y] ⊦ equiv x y❙
    refl = [F] equivI ([p]p) ([p]p)❙
    sym  = [F,G,p] equivI ([q] p equivEr q) ([q] p equivEl q)❙
    trans = [F,G,H,fg,gh] equivI ([f] gh equivEl (fg equivEl f))
                                 ([h] fg equivEr (gh equivEr h))❙
❚

theory IPL =
  include ?Propositions❙
  include ?Truth❙
  include ?Falsity❙
  include ?Negation❙
  include ?Conjunction❙
  include ?Disjunction❙
  include ?Implication❙
  include ?Equivalence❙
  
  view impl_order : ?Order -> ?IPL =
    include ?Implication/impl_preorder❙ 
    structure equalityRel = ?Equivalence/equiv_equivalence❙
    antisym = [F,G,fg,gf] equivI ([f] fg impE f) ([g] gf impE g)❙
❚

theory PL =
  include ?IPL❙
  include ?ProofIrrelevance❙
  include ?Classical❙
❚