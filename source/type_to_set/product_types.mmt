namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚

theory SimpleProductTypesZF =
  include ?TypesZF❙
  realize ?SimpleProductTypes❙
  simpprod = [A,B] A ×ͧ B❙
❚

theory DependentProductTypesZF =
  include ?TypedTermsZF❙
  
  realize ?DependentProductTypes❙
  // AS: I need set, but dependent implication needs a prop❙
  depprod = [A,B: Elem A ⟶ set] Σͧ A ([x] x∈A ⇒ͩ ([p] B (elem x p)))❙
❚

theory SoftDependentProductTypesZF =
  // AS: Propositions and Terms are part of the fixmeta❙
  include ?Propositions❙
  include ?Terms❙
  include ?SoftTypedTermsZF❙
  
  realize ?SoftDependentProductTypes❙
  softprod = [A,B] sigma A B❙
❚

theory SimpleProductsZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?TypedEqualityZF❙
  include ?SimpleProductTypesZF❙
 
  realize ?SimpleProducts❙

  simppair = [A,B,a: Elem A,b: Elem B] elem (which a,ͧwhich b) (prodI (why a) (why b))❙
  simppi1 = [A,B,e: Elem (A×ͧB)] elem ((which e)₁ͧ) ((why e) prodEl)❙
  simppi2 = [A,B,e: Elem (A×ͧB)] elem ((which e)₂ͧ) ((why e) prodEr)❙
  
  // AS: pretty annoying proof since I need the exact form of simppi1 (simppair a b)❙
  compute1 = [A,B,a: Elem A,b: Elem B] compL❙
  // compute1 = [A,B,a: Elem A,b: Elem B] ((eq_which (prodI (why a) (why b)))
    ucongP ([x] which (elem ((which (elem (which a,ͧwhich b) (prodI (why a) (why b))))₁ͧ)
    ((why elem (which a,ͧwhich b) (prodI (why a) (why b))) prodEl)) =ͧ (x₁ͧ))
    (eq_which (why (elem (which a,ͧwhich b) (prodI (why a) (why b))) prodEl))) eq/trans compL❙
  
  compute2 = [A,B,a: Elem A,b: Elem B] compR❙
  // compute2 = [A,B,a: Elem A,b: Elem B] ((eq_which (prodI (why a) (why b)))
    ucongP ([x] which (elem ((which (elem (which a,ͧwhich b) (prodI (why a) (why b))))₂ͧ)
    ((why elem (which a,ͧwhich b) (prodI (why a) (why b))) prodEr)) =ͧ (x₂ͧ))
    (eq_which (why (elem (which a,ͧwhich b) (prodI (why a) (why b))) prodEr))) eq/trans compR❙
❚

theory DependentProductsZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  
  include ?DependentProductTypesZF❙
  include ?TypedEqualityZF❙
  include ?DependentTypeEqualityZF❙
  
  realize ?DependentProducts❙
  // AS: dependent product types need to be fixed first❙
  // deppair = [A,B: (Elem A ⟶ set),a: Elem A,b: Elem (B a)]❙
❚

theory SoftTypedProductsZF =
  // AS: Propositions, Proofs, Terms and UntypedEquality are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?Terms❙
  include ?UntypedEquality❙
  include ?TypedZFFeatures❙
  
  realize ?SoftTypedProducts❙
  pair = [a,b] a,ͧb❙
  pi1 = [p] p₁ͧ❙
  pi2 = [p] p₂ͧ❙
  
  compute1 = [a,b] compL❙
  compute2 = [a,b] compR❙
  // TODO: Simplify and Solve❙
❚

theory SoftTypedSimpleProductsZF =
  // AS: Propositions, Proofs, Terms and UntypedEquality are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?Terms❙
  include ?UntypedEquality❙
  
  include ?SoftTypedTermsZF❙
  include ?SoftTypedProductsZF❙
  include ?SimpleProductTypesZF❙
  
  realize ?SoftTypedSimpleProducts❙
  fun_typing = [A,B,a,b,p: ⊦ a∈A,q: ⊦ b∈B] prodI p q❙
❚

theory SoftTypedDependentProductsZF =
  // AS: Propositions, Proofs, Terms and UntypedEquality are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?Terms❙
  include ?UntypedEquality❙
  
  include ?SoftTypedTermsZF❙
  include ?SoftTypedProductsZF❙
  include ?SoftDependentProductTypesZF❙
  
  realize ?SoftTypedDependentProducts❙
  fun_typing = [A,B,a,b,p: ⊦ a∈A,q: ⊦ b∈(B a)] sigmaI p q❙
❚

theory SimpleProductsExpandZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?SimpleProductsZF❙
  
  realize ?SimpleProductsExpand❙
  expand = [A,B,u: Elem (A×ͧB)] eq/sym (repr ((why u) prodE))❙
❚

theory DependentProductsExpandZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?DependentProductsZF❙
  
  realize ?DependentProductsExpand❙
  // AS: dependent products have to be done first❙
  expand = [A,B,u: Elem (A×ͭB)] _❙
❚

theory SoftTypedProductsExpandZF =
  // AS: Propositions, Proofs, Terms and UntypedEquality are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?Terms❙
  include ?UntypedEquality❙
  
  include ?SoftTypedProductsZF❙
  
  realize ?SoftTypedProductsExpand❙
  // AS: repr cannot be used, since u does not have to be a pair❙
  expand = _❙
❚

theory SimpleProductsExtensionalityZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  
  include ?SimpleProductsZF❙
  
  realize ?SimpleProductsExtensionality❙
  exten = [A,B,u: Elem (A×ͭB),v: Elem (A×ͭB),p,q] ext ((why u) prodE) ((why v) prodE) p q❙
❚

theory DependentProductsExtensionalityZF =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  
  include ?DependentProductsZF❙
  
  realize ?DependentProductsExtensionality❙
  // TODO❙
❚

theory SoftTypedProductsExtensionalityZF =
  // AS: Propositions, Proofs, Terms and UntypedEquality are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  include ?Terms❙
  include ?UntypedEquality❙
  
  include ?SoftTypedProductsZF❙
  
  realize ?SoftTypedProductsExtensionality❙
