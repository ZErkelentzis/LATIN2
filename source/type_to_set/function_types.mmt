namespace latin:/❚

fixmeta ?DependentFOLEQDescND❚

theory SimpleFunctionTypesSet =
  include ?TypesSet❙
  include ?Functions❙
  
  realize ?SimpleFunctionTypes❙
  simpfun = func❙
❚

// AS: I don't think I can do this❚
theory DependentFunctionTypesSet =
  include ?TypedTermsSet❙
  
  realize ?DependentFunctionTypes❙
  // TODO❙
❚

theory SimpleFunctionsSet =
  // AS: Propositions and Proofs are part of the fixmeta❙
  include ?Propositions❙
  include ?Proofs❙
  
  include ?SimpleFunctionTypesSet❙
  include ?TypedEqualityNDSet❙
  
  realize ?SimpleFunctions❙
