namespace latin:/wuvtest❚
fixmeta ur:?LF❚

// to be replaced by LATIN's official sorted FOL sometime ❚
theory ScratchSFOL =
  include ☞http://cds.omdoc.org/urtheories?LF ❙
  tp: type ❙
  tm: tp ⟶ type ❙
  prop: type ❙
  exists: (tm ⟶ prop) ⟶ prop ❘ # ∃ 1 ❙
  der: prop ⟶ type ❘ # ⊦ 1 ❙
❚

theory Vocabularies =
  include ?ScratchSFOL ❙

  vocabularies: tp ❙
  vocabularies_terms = tm vocabularies ❘ # Voc ❙
❚

theory Contexts =
  include ?Vocabularies ❙

  contexts: Voc ⟶ tp ❙
  contexts_terms = [V] tm (contexts V) ❘ # Ctx 1 ❙
  empty_context: {V} Ctx V ❘ # empty 1 ❙
❚

theory NoContexts =
  include ?Vocabularies ❙
  singleton_context_type: tp ❙
  singleton_context: tm singleton_context_type ❘ # ⋅ ❙
❚

view ContextErasure : ?Contexts -> ?NoContexts =
  include ?Vocabularies ❙
  contexts = [V] singleton_context_type ❙
  empty_context = [V] singleton_context ❙
❚

theory Expressions =
  include ?Contexts ❙

  expressions: {V} Ctx V ⟶ tp ❙
  expressions_terms = [V,ctx] tm (expressions V ctx) ❘ # Exp 2 ❙
  ground_expressions = [V] Exp (empty V) ❘ # GExp 1 ❙
❚

theory Propositions =
  include ?Expressions ❙

  // pay attention to not name-clash with SFOL's prop and eq here! ❙
  prop_for_vocabulary: {V} GExp V ❘ # vprop 1 ❙
❚

theory Equality =
  include ?Expressions ❙

  // pay attention to not name-clash with SFOL's prop and eq here! ❙
  eq_for_vocabulary: {V} GExp V ⟶ GExp V ⟶ GExp V ❘ # 2 ≡ 3 ❙
❚

theory Typing =
  include ?Expressions ❙
  typing_relation: {V,Γ: Ctx V} Exp Γ ⟶ Exp (empty V) ⟶ prop ❙
  typing_relation_terms = [V,Γ: Ctx V,e: Exp Γ,E: GExp V] tm (typing_relation V Γ e E) ❘ # 2 |- 3 ∶ 4 ❙
❚

// Takes ?Propositions and enriches ?Equality with judgement that it types against prop ❚
theory TypedEquality =
  include ?Equality ❙
  include ?Typing ❙

  eq_types_against_prop: {V, Γ: Ctx V, e,f} ⊦ Γ |- (e ≡ f) ∶ vprop V ❙
❚

theory Substitutions =
  include ?Contexts ❙

  substitutions: {V} Ctx V ⟶ Ctx V ⟶ tp ❙
  substitutions_terms = [V,Γ,Δ] tm (substitutions V Γ Δ) ❘ # Subst 2 3 ❙
  substituation_app: {V,Γ: Ctx V,Δ: Ctx V} Exp Γ ⟶ Subst Γ Δ ⟶ Exp Δ ❘ # 4[5] ❙
  ground_substitutions: {V, Γ: Ctx V} Ctx Γ (ε V) ❙
❚

// A formal system is a combination of contexts, expressions, substitutions, and typing ❚
theory FormalSystem =
  include ?Typing ❙
  include ?Substitutions ❙

  // note: ⊦ from base logic (e.g. SFOL), |- for here ❙
  subst_pres_typing: {V,Γ,Δ,γ: Subst Γ Δ,e: Exp Γ,E: GExp V} ⊦ (Γ |- e ∶ E) ⟶ (Δ |- e[γ] ∶ E[γ]) ❙
❚

theory DeductiveSemantics =
  include ?FormalSystem ❙
  thm: {V,Γ: Ctx V} Exp Γ ⟶ prop ❘ # IsThm 3 ❘ // Subset of expressions designated as theorems❙
  ground_theorems = [V: Voc,F: Exp (empty V)] IsThm F ❘ # IsGroundThm 1 ❙

  subst_pres_thm: {V, Γ: Ctx V, Δ: Ctx V, γ: Subst Γ Δ, F: Exp Γ} ⊦ (IsThm F) ⟶ ⊦ (IsThm F[γ]) ❙

  true_instance
       : {V, Γ: Ctx V, γ: Subst Γ (empty V), F: Exp V}  (Γ |- F ∶ (vprop V)) ⟶ prop
    ❘ = [V, Γ, γ, F, judgement] IsThm F[γ]
    ❙
❚

theory ComputationalSemantics =
  include ?FormalSystem ❙
  eval_on_exp: {V, Γ: Ctx V} Exp Γ ⟶ Exp Γ ❘ # Eval 3 ❙
  eval_on_subst: {V, Γ: Ctx V, Δ: Ctx V} Subst Γ Δ ⟶ Subst Γ Δ  ❘ # EvalSubst 4 ❙
  // subst_pres_thm: {V, Γ, Δ, γ: Subst Γ Δ} ❙
  eval_pres_subst: {V, Γ: Ctx V, Δ: Ctx V, γ: Subst Γ Δ, e: Exp Γ} ⊦ Eval (e[γ]) ≐ (Eval e)[(EvalSubst γ)] ❙
❚

theory ConcreteSemantics =
  include ?FormalSystem ❙

  // concrete semantics provide a subset of substitutions from Γ to empty context ❙
  ground_substitutions: {V, Γ: Ctx V, F: Exp Γ} (Γ |- F ∶ (vprop V)) ⟶ Subst Γ (empty V) ⟶ prop ❙
❚

// Formalize interdefinability of semantics via views❚
view DedToComp : ?DeductiveSemantics -> ?ComputationalSemantics = ❚
view CompToDed : ?ComputationalSemantics -> ?DeductiveSemantics = ❚

view DedToConcr : ?DeductiveSemantics -> ?ConcreteSemantics = ❚
view CompToConcr : ?ComputationalSemantics -> ?ConcreteSemantics = ❚
view ConcrToDed : ?ConcreteSemantics -> ?DeductiveSemantics = ❚
view ConcrToComp : ?ConcreteSemantics -> ?ComputationalSemantics = ❚

theory VocabularyTranslation =
  include ?Expressions ❙

  structure L : ?Vocabularies = ❚
  structure K : ?Vocabularies = ❚

  voc_translation: L/Voc ⟶ K/Voc ❘ # TransVoc 1❙
❚

theory ContextTranslation =
  include ?VocabularyTranslation ❙

  // broadening the domain of inherited structures does not work yet in MMT ❙
  structure L : ?Contexts = ❚
  structure K : ?Contexts = ❚
  ctx_translation: {V: L/Voc} L/Ctx V ⟶ K/Ctx (TransVoc V) ❘ # TransCtx 2 ❙
❚

theory ExpressionTranslation =
  include ?ContextTranslation ❙

  // broadening the domain of inherited structures does not work yet in MMT ❙
  structure L : ?Expressions = ❚
  structure K : ?Expressions = ❚
  expr_translation: {V: L/Voc, Γ: L/Ctx V} L/Exp Γ ⟶ K/Exp (TransCtx Γ} ❘ # TransExp 3 ❙

  type_preservation: {V: L/Voc, Γ: L/Ctx V, e: L/Exp Γ, E: L/GExp V}
       ⊦ L/(Γ |- e ∶ E)
    ⟶ ⊦ K/((TransCtx Γ) |- (TransExp e) ∶ (TransExp E))
  ❙

  conservativity: {V: L/Voc, Γ: L/Ctx V, e: L/Exp Γ, E: L/GExp V}
       ⊦ K/((TransCtx Γ) |- e : (TransExp E))
    ⟶ ⊦ ∃ [f] L/(Γ |- f ∶ E)
  ❙
❚

theory SubstitutionTranslations =
  include ?ExpressionTranslation ❙

  // broadening the domain of inherited structures does not work yet in MMT ❙
  structure L : ?Substitutions = ❚
  structure K : ?Substitutions = ❚

  subst_translation: {V: L/Voc, Γ: L/Ctx V, Δ: L/Ctx V} L/(Subst Γ Δ) ⟶ K/(Subst (TransCtx Γ) (TransCtx Δ)) ❘ # TransSubst 4 ❙

  subst_thm: {V: L/Voc, Γ: L/Ctx V, Δ: L/Ctx V, e: L/Exp Γ, E: L/GExp V, γ: Subst Γ Δ}
       ⊦ L/(Γ |- e ∶ E)
    ⟶ ⊦ K/((TransCtx Γ) |- (TransExp (e[γ])) ≣ (TransExp e)[(TransSubst γ)]
  ❙
❚
