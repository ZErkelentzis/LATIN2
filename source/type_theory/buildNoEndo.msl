file ../../build_config.msl

// type_theory
// depends in general on fundamentals

// no dependency
build MMT/LATIN2 mmt-omdoc type_theory/empty_type.mmt
build MMT/LATIN2 mmt-omdoc type_theory/unit_type.mmt
build MMT/LATIN2 mmt-omdoc type_theory/function_types.mmt
build MMT/LATIN2 mmt-omdoc type_theory/product_types.mmt
build MMT/LATIN2 mmt-omdoc type_theory/coproduct_types.mmt
build MMT/LATIN2 mmt-omdoc type_theory/predicate_subtypes.mmt
build MMT/LATIN2 mmt-omdoc type_theory/quotient_types.mmt

// non-canonical
// build MMT/LATIN2 mmt-omdoc type_theory/quotient_types-equiv.mmt

build MMT/LATIN2 mmt-omdoc type_theory/undefinedness.mmt

// depends on function_types
build MMT/LATIN2 mmt-omdoc type_theory/type_erasure.mmt

// depends on function_types and undefinedness
build MMT/LATIN2 mmt-omdoc type_theory/quotation.mmt

// depends on logic/fol_like
build MMT/LATIN2 mmt-omdoc type_theory/power_types.mmt