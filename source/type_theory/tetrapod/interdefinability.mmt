// Formalize interdefinability of semantics via views ❚
namespace latin:/wuvtest❚
fixmeta ur:?LF❚

view TheoremsViaEvaluationToTrueEq : ?DeductionEq -> ?DecidableComputation =
  include ?FormalSystem ❙
  include ?Propositions ❙

  // redefine what it means to be a theorem ❙
  thm = [V, Γ, e] e ⇝ ctrue ❙

  // same equality notion ≡ as in domain ❙
  include ?TypedEquality ❙

  // in domain: eq_refl : {V, Γ: Ctx V, e: Exp Γ} ⊦ IsThm (e ≡ e) ❙
  eq_refl = [V, Γ, e] sketch "In base logic can prove `e ≐ e`, hence by canonical forms also `IsThm (e ≡ e)`" ❙

  // in domain: eq_symm : {V, Γ: Ctx V, e: Exp Γ, f: Exp Γ} ⊦ IsThm (e ≡ f) ⇒ IsThm (f ≡ e) ❙
  eq_symm = [V, Γ, e, f] sketch "By canonical forms we have that `IsThm (e ≡ f)` implies `e ≐ f` in base logic, then apply symmetry there" ❙

  // in domain: eq_trans : {V, Γ: Ctx V, e: Exp Γ, f: Exp Γ, g: Exp Γ} ⊦ (IsThm (e ≡ f) ∧ IsThm (f ≡ g)) ⇒ IsThm (e ≡ g) ❙
  eq_trans = [V, Γ, e, f, g] sketch "Similarly as above: get `e ≐ f`, `f ≐ g` in base logic, then `e ≐ g` via transitivity in base logic, and transport back via canonical forms once more" ❙

  // in domain: subst_pres_thm : {V, Γ: Ctx V, Δ: Ctx V, γ: Subst Γ Δ, F: Exp Γ} ⊦ (IsThm F) ⇒ (IsThm F[γ]) ❙
  // eval_pres_subst: {V, Γ: Ctx V, Δ: Ctx V, γ: Subst Γ Δ, e: Exp Γ} ⊦ e[γ] ⇝ (Eval e)[(EvalSubst γ)] ❙
  subst_pres_thm = [V, Γ, Δ, γ, F] sketch "By definition, our goal is to show `F[γ] ⇝ (vtrue in Γ)`. By eval_pres_subst we have `F[γ] ⇝ (Eval F)[(EvalSubst γ)]. By our assumption of `IsThm F`, we have `Eval F ≐ (vtrue in V)`. Then by ground_expressions_unaffected_by_subst we have `(vtrue in V)[(Eval Subst γ)] ≐ vtrue in Γ`. Hence we overall have `F[γ] ⇝ (vtrue in Γ)`. Then by our mapping of `thm` and because of `(vtrue in Γ) ⇝ (vtrue in Γ)` by vprop_normal and ground_expr_normal_in_all_contexts, we have the goal `IsThm F[γ]`." ❙
❚

view EqualityViaComputation : ?DeductionEq -> ?DecidableComputation =
  include ?FormalSystem ❙
  include ?Propositions ❙

  // redefine what it means to be a theorem ❙
  thm = [V, Γ, e] e ⇝ ctrue ❙

  eq_for_vocabulary = eq_for_vocabulary ❙ // <-- redundant and morally inconsistent with next assignment? ❙
  eq_application = [V, Γ, e, f] (Eval e) ≡ (Eval f) ❙

  eq_types_against_prop = [V, Γ, e, f, E] sketch "should come from subject redunction and ≡ properties" ❙

  eq_refl = [V, Γ, e] sketch "..." ❙

  // in domain: eq_symm : {V, Γ: Ctx V, e: Exp Γ, f: Exp Γ} ⊦ IsThm (e ≡ f) ⇒ IsThm (f ≡ e) ❙
  eq_symm = [V, Γ, e, f] sketch "..." ❙

  // in domain: eq_trans : {V, Γ: Ctx V, e: Exp Γ, f: Exp Γ, g: Exp Γ} ⊦ (IsThm (e ≡ f) ∧ IsThm (f ≡ g)) ⇒ IsThm (e ≡ g) ❙
  eq_trans = [V, Γ, e, f, g] sketch "..." ❙

  // in domain: subst_pres_thm : {V, Γ: Ctx V, Δ: Ctx V, γ: Subst Γ Δ, F: Exp Γ} ⊦ (IsThm F) ⇒ (IsThm F[γ]) ❙
  subst_pres_thm = [V, Γ, ⊦, γ, F] sketch "..." ❙
❚

view TheoremsViaGroundSubstitutions : ?Deduction -> ?Concretization =
  include ?FormalSystem ❙
  include ?Propositions ❙

  // in codomain: concrete_substitutions: {V, Γ: Ctx V, F: Exp Γ} (⊦ Γ |- F ∶ cprop) ⟶ GSubst Γ ⟶ prop ❙
  thm = [V, Γ, F] ∃ [p] ∃ [γ] concrete_substitutions V Γ F p γ❙

  // partiality: the axiom that substitutions preserve theorems (subst_pres_thm) of the domain does *not* hold! ❙
❚

// view CompToConcr : ?Computation -> ?Concretization =
  include ?FormalSystem ❙

  // in codomain: ground_substitutions: {V, Γ: Ctx V, F: Exp Γ} (Γ |- F ∶ (vprop V)) ⟶ Subst Γ (empty V) ⟶ prop ❙
  eval_on_exp = [V, Γ, e, e'] ground_substitutions V Γ

    eval_notation
      :    {V, Γ: Ctx V} Exp Γ ⟶ Exp Γ ⟶ prop
      ❘ = [V, Γ, e, f] Eval e ≐ f
      ❘ # 3 ⇝ 4 ❙

    eval_on_subst: {V, Γ: Ctx V, Δ: Ctx V} Subst Γ Δ ⟶ Subst Γ Δ  ❘ # EvalSubst 4 ❙
    // subst_pres_thm: {V, Γ, Δ, γ: Subst Γ Δ} ❙
    eval_pres_subst: {V, Γ: Ctx V, Δ: Ctx V, γ: Subst Γ Δ, e: Exp Γ} ⊦ e[γ] ⇝ (Eval e)[(EvalSubst γ)] ❙

    subject_reduction: {V, Γ: Ctx V, e: Exp Γ, E: GExp V} ⊦ (Γ |- e ∶ E) ⇒ (Γ |- (Eval e) ∶ E) ❙
❚

view GroundSubstitutionsViaTheorems : ?Concretization -> ?Deduction =
  include ?FormalSystem ❙
  include ?Propositions ❙

  // in practice cannot compute IsThm ❙
  // in domain: concrete_substitutions: {V, Γ: Ctx V, F: Exp Γ} (⊦ Γ |- F ∶ cprop) ⟶ GSubst Γ ⟶ prop ❙
  concrete_substitutions = [V, Γ, F, p, γ] IsThm F⟬γ⟭ ❙
❚
view ConcrToComp : ?Concretization -> ?ComputationProp =
  include ?FormalSystem ❙
  include ?Propositions ❙

  // in domain: concrete_substitutions: {V, Γ: Ctx V, F: Exp Γ} (⊦ Γ |- F ∶ cprop) ⟶ GSubst Γ ⟶ prop ❙
  concrete_substitutions = [V, Γ, F, p, γ] (normalSubst γ) ∧ (F⟬γ⟭ ⇝ ctrue) ❙
❚
