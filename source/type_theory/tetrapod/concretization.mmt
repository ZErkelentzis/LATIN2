namespace latin:/wuvtest❚
fixmeta ur:?LF❚

theory Concretization =
  include ?FormalSystem ❙
  include ?Propositions ❙

  // Concretization semantics provide a subset of substitutions from Γ to empty context ❙
  concrete_substitutions: {V, Γ: Ctx V, F: Exp Γ} (⊦ Γ |- F ∶ cprop) ⟶ GSubst Γ ⟶ prop ❙
❚
