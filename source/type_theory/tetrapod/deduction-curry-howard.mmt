namespace latin:/wuvtest❚
fixmeta ur:?LF❚

view TheoremsViaPropositionsAsTypes : ?Deduction -> ?FormalSystemWithPropositions =
  include ?FormalSystemWithPropositions ❙

  thm = [V, Γ, F] ∃[p: Exp Γ] Γ |- p ∶ F ❙
  // in domain: subst_pres_thm: {V, Γ: Ctx V, Δ: Ctx V, γ: Subst Γ Δ, F: Exp Γ} ⊦ (IsThm F) ⇒ (IsThm F⟬γ⟭) ❙
  subst_pres_thm = [V, Γ, Δ, γ, F]
                  sketch "By assumption, we have a `p: Exp Γ` such that `Γ |- p ∶ F`.
                          By subst_pres_typing we have `Δ |- p⟬γ⟭ ∶ F⟬γ⟭`, hence `F⟬γ⟭` is a theorem, too." ❙
❚
