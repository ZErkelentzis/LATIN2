namespace latin:/wuvtest❚
fixmeta ur:?LF❚

// to be replaced by LATIN's official sorted FOL sometime ❚
theory ScratchSFOL =
  include ☞http://cds.omdoc.org/urtheories?LF ❙
  include ☞http://cds.omdoc.org/urtheories?Strings ❙

  tp: type ❙
  tm: tp ⟶ type ❙
  prop_tp: tp ❙
  prop_terms = tm prop_tp ❘ # prop ❙
  exists: {A: tp} (tm A ⟶ prop) ⟶ prop ❘ # ∃ 2 ❙
  der_op: prop ⟶ tp ❙
  der_notation = [p] tm (der_op p) ❘ # ⊦ 1 prec 100❙
  not: prop ⟶ prop ❘ # ¬ 1 prec 200 ❙
  true: prop ❙
  eq: {A: tp} tm A ⟶ tm A ⟶ prop ❘ # 2 ≐ 3 prec 150 ❙
  and: prop ⟶ prop ⟶ prop ❘ # 1 ∧ 2 prec 130 ❙
  rimpl: prop ⟶ prop ⟶ prop ❘ # 1 ⇒ 2 prec 125 ❙
  lrimpl: prop ⟶ prop ⟶ prop ❘ # 1 ⇔ 2 prec 125 ❙

  sketch_op: {F: prop} string ⟶ ⊦ F ❘ # sketch 2 ❙

  // copied from predicate_subtypes.mmt ❙
  predsub : {A} (tm A ⟶ prop) ⟶ tp❘# ⦃ 2 ⦄  prec -10050❙
❚

theory Vocabularies =
  include ?ScratchSFOL ❙

  vocabularies: tp ❙
  vocabularies_terms = tm vocabularies ❘ # Voc ❙
❚

theory Contexts =
  include ?Vocabularies ❙

  contexts: Voc ⟶ tp ❙
  contexts_terms = [V] tm (contexts V) ❘ # Ctx 1 ❙
  empty_context: {V} Ctx V ❘ # empty %I1 ❙
  empty_context_alias = empty_context ❘ # ⋅ %I1 ❙
❚

theory NoContexts =
  include ?Vocabularies ❙
  singleton_context_type: tp ❙
  singleton_context: tm singleton_context_type ❘ # ⋅ ❙
❚

view ContextErasure : ?Contexts -> ?NoContexts =
  include ?Vocabularies ❙
  contexts = [V] singleton_context_type ❙
  empty_context = [V] singleton_context ❙
❚

theory Expressions =
  include ?Contexts ❙

  expressions: {V} Ctx V ⟶ tp ❙
  expressions_terms = [V,ctx] tm (expressions V ctx) ❘ # Exp 2 ❙
  ground_expressions = [V] Exp (empty_context V) ❘ # GExp 1 ❙

  incl_from_ground_expr_to_ctx: {V, Γ: Ctx V} GExp V ⟶ Exp Γ ❘ # 3 in 2 ❙
  incl_is_equality_on_empty_ctx: {V, e: GExp V} ⊦ (e in (empty_context V)) ≐ e ❙
❚

theory Propositions =
  include ?Expressions ❙

  // pay attention to not name-clash with SFOL's prop and eq here! ❙
  designated_prop: {V} GExp V ❙
  prop_in_context: {V, Γ: Ctx V} Exp Γ ❘ = [V, Γ] (designated_prop V) in Γ ❘ # cprop %I1 %I2 ❙
❚

theory Equality =
  include ?Expressions ❙

  // pay attention to not name-clash with SFOL's prop and eq here! ❙
  eq_for_vocabulary: {V} GExp V ❙

  // in most logics this is defined as application of eq_for_vocabulary to the arguments,
     but we don't assume the notion of application (e.g. OMA) here ❙
  eq_application: {V, Γ: Ctx V} Exp Γ ⟶ Exp Γ ⟶ Exp Γ ❘ # 3 ≡ 4 prec 140❙
❚

theory Typing =
  include ?Expressions ❙
  typing_relation: {V,Γ: Ctx V} Exp Γ ⟶ Exp Γ ⟶ tp ❙
  typing_relation_terms = [V,Γ: Ctx V,e: Exp Γ,E: Exp Γ] ∃[x: tm (typing_relation V Γ e E)] x ≐ x ❘ # 2 |- 3 ∶ 4 prec 500❙
❚

// Takes ?Propositions and enriches ?Equality with judgement that it types against prop ❚
theory TypedEquality =
  include ?Typing ❙

  include ?Equality ❙
  include ?Propositions ❙

  eq_types_against_prop: {V, Γ: Ctx V, e, f, E} ⊦ (Γ |- e ∶ E) ∧ (Γ |- f ∶ E) ⇒ Γ |- (e ≡ f) ∶ cprop ❙
❚

theory PropositionalTrue =
  include ?Expressions ❙
  include ?Propositions ❙
  include ?Typing ❙

  // don't name clash with base logic ❙
  designated_true: {V} GExp V ❙
  designated_true_in_context: {V, Γ: Ctx V} Exp Γ ❘ = [V, Γ] (designated_true V) in Γ ❘ # ctrue %I1 %I2 ❙
  true_types_against_prop: {V, Γ: Ctx V} ⊦ Γ |- ctrue ∶ cprop ❙
❚

theory Substitutions =
  include ?Contexts ❙
  include ?Expressions ❙

  substitutions: {V} Ctx V ⟶ Ctx V ⟶ tp ❙
  substitutions_terms = [V,Γ,Δ] tm (substitutions V Γ Δ) ❘ # Subst 2 3 ❙
  substituation_app: {V,Γ: Ctx V,Δ: Ctx V} Exp Γ ⟶ Subst Γ Δ ⟶ Exp Δ ❘ # 4 ⟬ 5 ⟭ prec 200❙
  ground_substitutions = [V, Γ: Ctx V] Subst Γ ⋅ ❘ # GSubst 2 ❙

  ground_expressions_unaffected_by_subst: {V, Γ: Ctx V, Δ: Ctx V, γ: Subst Γ Δ, e: GExp V} ⊦ (e in Γ)⟬γ⟭ ≐ (e in Δ) ❙
❚

// A formal system is a combination of contexts, expressions, substitutions, and typing ❚
theory FormalSystem =
  include ?Typing ❙
  include ?Substitutions ❙

  // note: ⊦ from base logic (e.g. SFOL), |- for here ❙
  subst_pres_typing: {V,Γ: Ctx V,Δ: Ctx V,γ: Subst Γ Δ,e: Exp Γ,E: Exp Γ} ⊦ (Γ |- e ∶ E) ⇒ (Δ |- (e⟬γ⟭) ∶ (E⟬γ⟭)) ❙
❚
