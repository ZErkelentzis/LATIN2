namespace latin:/wuvtest/mmt-view-inclusion-bug-test ❚

fixmeta http://cds.omdoc.org/urtheories?LF ❚

theory A = ❚
theory B = ❚
theory C =
  include ?A ❙
  include ?B ❙
❚

theory domain =
  include ?C ❙
❚

theory codomain =
  include ?A ❙
  include ?B ❙
  include ?C ❙
❚

view v : ?domain -> ?codomain =
  include ?C ❙
❚
