namespace latin:/❚

fixmeta ?BigSFOL❚

theory Collection =
  include ?EndoMagma❙
  include ?EndoNeutral❙
  include ?Nat❙
  
  empty: {a} tm &a❘ # %n 1❘= [a] neutral❙

  singleton : {a} tm a ⟶ tm &a❘# %n 2 prec 100❙
  cons : {a} tm a ⟶ tm &a ⟶ tm &a❘# %n 2 3 prec 60❘= [a,x,xs] singleton x ∘ xs❙
  
  
  inductive_proof: {a,P: tm & a ⟶ prop} ⊦ P neutral ⟶ ({x,xs} ⊦ P xs ⟶ ⊦ P (cons x xs)) ⟶ {xs} ⊦ P xs ❙

  is_empty : {a} tm &a ⟶ prop❘# %n 2 prec 40❙
  is_empty_neutral: {a} ⊦ is_empty (empty a)❙
  is_empty_cons : {a,x,xs: tm & a} ⊦ ¬(is_empty (cons x xs))❙
  is_empty_singelton : {a,x: tm a} ⊦ ¬(is_empty (singleton x))❙
  is_empty_op : {a,l, m: tm &a} ⊦ is_empty l ⟶ ⊦ is_empty m ⟶ ⊦ is_empty l∘m❙

  is_nonempty : {a} tm &a ⟶ prop❘# %n 2 prec 50❘
  	= [a,xs] ¬(is_empty xs)❙ 	         
  	 
  length: {a} tm &a ⟶ ℕ❘# %n 2 prec 40❙
  length_neutral : {a} ⊦ length (empty a) =ͭ zero ❙
	length_cons : {a,x,xs: tm &a} ⊦(length (cons x xs)) =ͭ  (length xs)'❙
	length_singelton : {a,x: tm a} ⊦ length (singleton x) =ͭ one❙
	length_op : {a,l, m: tm &a} ⊦ length l∘m =ͭ (length l) + (length m)❙
	
	contain : {a} tm & a ⟶ tm a ⟶ prop❘# %n 2 3 prec 50❙
	contain_neutral: {a,x: tm a} ⊦ ¬ contain (empty a) x❙
	contain_cons : {a,x:tm a,xs} ⊦  contain (cons x xs) x ❙
	contain_cons2 : {a,x,y,ys: tm & a} ⊦ contain (cons y ys) x  ⇔ contain ys x❙
	
	map2 : {a,b} (tm a ⟶ tm & b) ⟶ tm & a ⟶ tm & b❘# %n 3 4 prec 50❙
  map2_neutral : {a,b,f: tm a ⟶ tm  & b} ⊦ (map2 f neutral) =ͭ neutral ❙
  map2_cons : {a,b, f: tm a ⟶ tm & b,x,xs} ⊦ map2 f (cons x xs) =ͭ ((f x) ∘ (map2 f xs))❙
  map2_singleton1 : {a,b,f: tm a ⟶ tm & b,x} ⊦ map2 f (singleton x) =ͭ f x❙
  map2_op: {a,b,f: tm a ⟶ tm & b,l, m} ⊦ map2 f (l ∘ m) =ͭ ((map2 f l)∘ (map2 f m))❙
❚

theory ListSpec =
  include ?Collection❙
  include ?EndoMonoid❙
❚


theory MultisetSpec =
  include ?ListSpec❙
  include ?EndoCommutative❙
❚


theory FiniteSetSpec =
  include ?MultisetSpec❙
  include ?EndoIdempotent❙
❚

theory BinaryTreeSpec =
	include ?Collection ❙
❚


theory OptionSpec =
  include ?ListSpec❙
  include ?EndoFirstNonNeutral❙
❚


theory ResultSpec =
	include ?Collection❙
  include ?EndoMonoid❙
  
❚

theory Lists =
	include ?Nat❙
  structure list : ?ListSpec =
  	  include ?Nat❙
    applyType # List 1❙
    op # 2 concat 3 prec 50❙
    neutral # nil %I1❙
 ❚ 	
❚

theory Multisets =
	include ?Nat❙
  structure multiset : ?MultisetSpec =
  	  include ?Nat❙
    applyType # Multiset 1❙
    op # 2 munion 3❙
    neutral # mempty %I1❙ 
    singleton # multiset 2❙
 ❚
❚

theory FiniteSets =
	include ?Nat❙
  structure finset : ?FiniteSetSpec =
    	include ?Nat❙
    applyType # FinSet 1❙
    op # 2 union 3❙
    neutral # empty %I1❙ 
    singleton # finset 2❙
 ❚
❚

theory BinaryTree =
	structure binarytree : ?BinaryTreeSpec =
		applyType # BinaryTree 1❙
    op # 2 union 3❙
    neutral # none %I1❙ 
    singleton # leaf 2❙
    cons # node 2 3 ❙
	❚
❚

theory Options =
  structure option : ?OptionSpec =
    applyType # Option 1❙
    op # 2 orelse 3❙
    neutral # none %I1❙ 
    singleton # option 2❙
 ❚
❚
