file ../../../build_config.msl

// type_theory
// depends in general on fundamentals, type_theory and category_theory (these dependencies are not mentioned here)!

// no dependency
build MMT/LATIN2 mmt-omdoc ./endofunctors.mmt

// dependent on endofunctors
build MMT/LATIN2 mmt-omdoc ./endomagmas.mmt

// dependent on endomagmas
build MMT/LATIN2 mmt-omdoc ./collection_types.mmt

// dependent on endofunctors and hol
build MMT/LATIN2 mmt-omdoc type_theory/endofunctors/monads.mmt

// collection types as monads, depends on monads and collection types as well as strings
build MMT/LATIN2 mmt-omdoc type_theory/endofunctors/collection_monads.mmt

