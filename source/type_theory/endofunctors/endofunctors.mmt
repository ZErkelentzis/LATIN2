namespace latin:/❚

fixmeta ?TypedEqualityND❚

theory TypeOperator =
  applyType: tp ⟶ tp❘# & 1 prec 60❙
❚

theory EndoFunctor =
  include ?TypeOperator❙
  applyFun: {a,b} (tm a ⟶ tm b) ⟶ tm &a ⟶ tm &b❘# 4 map 3 prec 50❙
  applyId : {a,xs: tm &a} ⊦ xs map ([x] x) =ͭ xs❙
  applyComp : {a,b,c,f:tm a ⟶ tm b, g: tm b ⟶ tm c, xs: tm &a} ⊦ xs map f map g =ͭ xs map [x] g (f x)❙
❚

/T View currently not total, needs Extensionality❚
implicit view CategoryOfTypes : ?Category → ?SimpleFunctionsEta =
  obj = tp❙
  hom = [a,b] a→b❙
  ident = [a] λ[x]x❙
  comp = [a,b,c,f,g] λ[x] g@(f@x)❙
  neutLeft = [a,b,f] eta tsym ❙
  neutRight = [a,b,f] eta tsym ❙
  assoc = [a,b,c,d,f,g,h] trefl❙
❚

theory InternalEndoFunctor =
  include ?TypeOperator❙
  include ?SimpleFunctionsEta❙
  fmap : {a,b} tm a→b ⟶ tm &a→&b❘# fmap 3 prec 50❙
  fmapApply : {a,b} tm a→b ⟶ tm &a ⟶ tm &b❘= [a,b,f,x] (fmap f)@x❘# 3 <$> 4❙
  fmapId : {a} ⊦ fmap (ident a) =ͭ ident (&a)❙
  fmapComp : {a,b,c,f:tm a→b,g:tm b→c} ⊦ fmap (f;g) =ͭ (fmap f);(fmap g)❙
  
  // Remaining implementation is missing
  realize ?EndoFunctor❙
  // applyFun = [a,b,f:tm a ⟶ tm b,x] (fmap λ f) @ x❙
❚