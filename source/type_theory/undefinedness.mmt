namespace latin:/❚

fixmeta ur:?LF❚

theory UndefinedTerms =
  include ?UntypedLogic❙
  udefined : term ⟶ prop❘# 1 ↓ͧ prec 70❙
  ustrict_equal : term ⟶ term ⟶ prop❘ # 1 ≚ͧ 2 prec 50❙ 
❚ 

theory UndefinedTypedTerms =
  include ?TypedLogic❙
  tdefined : {A} tm A ⟶ prop❘# 2 ↓ͭ prec 70❙
  tstrict_equal : {A} tm A ⟶ tm A ⟶ prop❘# 2 ≚ͭ 3 prec 50❙ 
❚

theory UndefinedSoftTypedTerms =
  include ?SoftTypedTerms❙
  rdefined : term ⟶ tp ⟶ prop❘# 1 ↓ͬ 2 prec 70❙
  rstrict_equal : tp ⟶ term ⟶ term ⟶ prop❘# 2 ≚ͬ 3 prec 50❙
❚
