namespace latin:/❚

fixmeta ur:?LF❚

theory TypedQuotients =
  include ?TypedLogic❙
  include ?TypedEquality❙
  quotient: {A} (tm A ⟶ tm A ⟶ prop) ⟶ tp❘ # 1 ⧸ 2 prec 30❙
  class: {A,R} tm A ⟶ tm A⧸R❘# 3 class 2 prec 35❙
  equiv: {A,R,x:tm A,y} ⊦ R x y ⟶ ⊦ x class R ≐ y class R❙ 
  welldefined : {A,R} tm A⧸R ⟶ {B,F:tm A ⟶ tm B} ({x,y} ⊦ R x y ⟶ ⊦ F x ≐ F y) ⟶ tm B❘
              # 3 wldf 5 6❙ 
❚

theory SoftTypedQuotients =
  include ?SoftTypedLogic❙
  include ?SoftTypedEquality❙
  quotient: tp ⟶ (term ⟶ term ⟶ prop) ⟶ tp❘ # 1 ⧸ 2 prec 30❙
  equiv: {A,R,x,y} ⊦x⦂A ⟶ ⊦y⦂A ⟶ ⊦ R x y ⟶ ⊦ x ≐(A⧸R) y❙ 
  welldefined : {A,R,B,F:term ⟶ term} ({x,y, p:⊦x⦂A, q:⊦x⦂A} ⊦ R x y ⟶ ⊦ F ↑p ≐B F ↑q)
            ⟶ {x,p:⊦x⦂(A⧸R)} ⊦ F ↑p ⦂ B❙ 
❚