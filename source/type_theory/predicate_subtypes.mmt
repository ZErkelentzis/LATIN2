namespace latin:/❚

fixmeta ur:?LF❚

theory TypedPredicateSubtypes =
  include ?TypedLogic❙
  include ?TypedEquality❙
  
  predsub : {A} (tm A ⟶ prop) ⟶ tp ❘# 1 | 2  prec 40 ❙
  predsubI  : {A, P, x:tm A} ⊦ P x ⟶ tm A|P ❘ # 3 ↓ 4 prec 40 ❙
  predsubEl : {A, P, x:tm A|P} tm A ❘# predsubEl 3 ❙
  predsubEr : {A, P, x:tm A|P} ⊦ P (predsubEl x) ❘# predsubEr 3 ❙

  blah: {A, P, a: tm A, p: ⊦ P a} tm A|P ❘= [A,P,a,p] a ↓ p ❙
  // predsubEl_beta: {A, P, a: tm A, p: ⊦ P a} ⊦ (predsubEl (blah A P a p)) ≐ a ❘role Simplify ❙
  predsubEl_fail: {A, P, a: tm A, p: ⊦ P a} ⊦ (predsubEl (a ↓ p)) ≐ a ❘role Simplify ❙



  // predsubEr_beta: {A, P, a: tm A, p: ⊦ P a} ⊦ ((predsubEr (blah A P a p)) ≐ p) ❘role Simplify ❙
❚

theory SoftTypedPredicateSubtypes =
  include ?SoftTypedLogic❙
  
  predsub : tp ⟶ (term ⟶ prop) ⟶ tp❘# 1 | 2  prec 50❙
  predsubI : {A,P,x} ⊦ x⦂A ⟶ ⊦P x ⟶ ⊦ x⦂A|P❙
  predsubEl: {A,P,x}⊦ x⦂A|P ⟶ ⊦x⦂A❙
  predsubEr: {A,P,x}⊦ x⦂A|P ⟶ ⊦ P x❙
❚
