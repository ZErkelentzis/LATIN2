namespace latin:/❚

fixmeta ur:?LF❚

theory TypedPredicateSubtypes =
  include ?TypedLogic❙
  include ?TypedEquality❙
  include ?ProofEquality❙
  
  predsub : {A} (tm A ⟶ prop) ⟶ tp ❘ # 1 | 2  prec 40 ❙
  /T introductory form (downcast to subtype) ❙
  predsubI  : {A, P, x:tm A} ⊦ P x ⟶ tm A|P ❘ # 3 ↓ 4 prec 40 ❙
  /T eliminating form left (upcast to supertype) ❙
  predsubEl : {A, P} tm A|P ⟶ tm A ❘# predsubEl 3 ❘@ predsubEl_long ❙
  /T eliminating form right (cast to proof of predicate that qualified for subtype membership) ❙
  predsubEr : {A, P, x:tm A|P} ⊦ P (predsubEl x) ❘# predsubEr 3 ❘@ predsubEr_long ❙

  predsubElBeta
    : {A, P, a, p: ⊦ P a}  ⊦ ?TypedPredicateSubtypes?predsubEl A P (a ↓ p) ≐ a
    ❘role Simplify
  ❙
  predsubErBeta
    : {A, P, a, p: ⊦ P a} (?TypedPredicateSubtypes?predsubEr A P (a ↓ p)) ⟺ p
    ❘role Simplify
  ❙
❚

theory SoftTypedPredicateSubtypes =
  include ?SoftTypedLogic❙
  
  predsub : tp ⟶ (term ⟶ prop) ⟶ tp❘# 1 | 2  prec 50❙
  predsubI : {A,P,x} ⊦ x⦂A ⟶ ⊦P x ⟶ ⊦ x⦂A|P❙
  predsubEl: {A,P,x}⊦ x⦂A|P ⟶ ⊦x⦂A❙
  predsubEr: {A,P,x}⊦ x⦂A|P ⟶ ⊦ P x❙
❚
