file ../../build_config.msl

// type_theory
// depends in general on fundamentals (these dependencies are not mentioned here)!

// dependent on logic (e.g. SFOLEQND)
// dependent on category_theory and function_types
build MMT/LATIN2 mmt-omdoc type_theory/endofunctors/endofunctors.mmt

// dependent on endofunctors
build MMT/LATIN2 mmt-omdoc type_theory/endofunctors/endomagmas.mmt

// dependent on endomagmas
build MMT/LATIN2 mmt-omdoc type_theory/collection_types.mmt

// dependent on HOLND, endofunctors and category_theory
build MMT/LATIN2 mmt-omdoc type_theory/endofunctors/monads.mmt

