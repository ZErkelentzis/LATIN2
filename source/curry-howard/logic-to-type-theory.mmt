/T Curry-Howard correspondence as morphisms XCH that translate logical theories X to type-theoretical theories
❚

namespace latin:/❚
fixmeta ur:?LF❚

view PropositionsAsTypes : ?Propositions -> ?Types =
  prop = tp❙
❚

view ProofsAsTerms : ?Proofs -> ?TypedTerms =
  include ?PropositionsAsTypes ❙
  ded  = tm❙
❚

view LogicCH : ?Logic -> ?TypedTerms =
  include ?ProofsAsTerms ❙
❚

/T falsity as empty type ❚
view FalsityCH : ?Falsity -> ?EmptyType =
  include ?PropositionsAsTypes ❙
  false = void❙
❚
view FalsityNDCH : ?FalsityND -> ?EmptyType =
  include ?LogicCH❙
  include ?FalsityCH❙
  falseE = throw❙
❚

/T truth as unit type ❚
view TruthCH : ?Truth -> ?UnitType =
  include ?PropositionsAsTypes ❙
  true = unitType❙
❚
view TruthNDCH : ?TruthND -> ?UnitType =
  include ?LogicCH❙
  include ?TruthCH❙
  trueI = unit❙
❚

/T conjunctions as product types ❚
view ConjunctionCH : ?Conjunction -> ?SimpleProductTypes =
  include ?PropositionsAsTypes ❙
  and = simpprod ❙
❚
view ConjunctionNDCH : ?ConjunctionND -> ?SimpleProducts =
  include ?ConjunctionCH ❙
  include ?ProofsAsTerms ❙
  andI = simppair ❙
  andEl = simppi1 ❙
  andEr = simppi2 ❙
❚

/T dependent conjunctions as dependent product types ❚
view DependentConjunctionCH : ?DependentConjunction -> ?DependentProductTypes =
  include ?LogicCH ❙
  dand = depprod ❙
❚
view DependentConjunctionNDCH : ?DependentConjunctionND -> ?DependentProducts =
  include ?DependentConjunctionCH ❙
  dandI = deppair ❙
  dandEl = deppi1 ❙
  dandEr = deppi2 ❙
❚

/T implications as functions types ❚
view ImplicationCH : ?Implication -> ?SimpleFunctionTypes =
  include ?PropositionsAsTypes ❙
  impl = simpfun ❙
❚
view ImplicationCHND : ?ImplicationND -> ?SimpleFunctions =
  include ?ImplicationCH ❙
  include ?ProofsAsTerms ❙
  implI = simplambda ❙
  implE = simpapply ❙
❚

/T dependent implication as dependent function types ❚
view DependentImplicationCH : ?DependentImplication -> ?DependentFunctionTypes =
  include ?LogicCH ❙
  dimpl = depfun ❙
❚
view DependentImplicationCHND : ?DependentImplicationND -> ?DependentFunctions =
  include ?DependentImplicationCH ❙
  dimplI = deplambda ❙
  dimplE = depapply ❙
❚

/T disjunction as coproduct types ❚
view DisjunctionCH : ?Disjunction -> ?CoproductTypes =
  include ?PropositionsAsTypes❙
  or = coprod ❙
❚
/T disjunction as coproduct types ❚
view DisjunctionNDCH : ?DisjunctionND -> ?Coproducts =
  include ?LogicCH❙
  include ?DisjunctionCH❙
  orIl = inj1❙
  orIr = inj2❙
  orE = cases❙
❚
