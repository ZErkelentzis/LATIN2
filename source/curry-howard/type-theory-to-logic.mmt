/T Curry-Howard correspondence as morphisms XCH that translate type-theoretical theories X to logical ones
❚

namespace latin:/❚
fixmeta ur:?LF❚

view TypesAsPropositions : ?Types -> ?Propositions =
  tp = prop❙
❚

view TermsAsProofs : ?TypedTerms -> ?Proofs =
  include ?TypesAsPropositions ❙
  tm = ded❙
❚

view TypedEqualityCH : ?TypedEqualityND -> ?Logic + ?ProofIrrelevance =
  include ?TermsAsProofs ❙
  // propositions in type theory mostly occur as equalities between terms
     Thus, we need a type that can hold equalities between proofs of F. 
     In the presence of proof irrelevance, they are equal anyway and we can simply use F.❙
  prop = prop ❙
  ded = ded❙
  tequal = [F,pf1,pf2] F❙
  trefl = _ ❙
  tcongB = [A,B,X,Y,p,P,q] q ❙
❚

view EmptyTypeCH : ?EmptyType -> ?FalsityND + ?ProofIrrelevance =
  include ?TypedEqualityCH❙
  void = false❙
  throw = falseE❙
  voidUnique = [A,B,F,e] e falseE B❙
❚

view UnitTypeCH : ?UnitType -> ?TruthND + ?ProofIrrelevance =
  include ?TypedEqualityCH❙
  unitType = true❙
  unit = trueI❙
  unitUnique = _ ❙
❚

view SimpleFunctionsCH : ?SimpleFunctions -> ?ImplicationND + ?ProofIrrelevance =
  include ?TypedEqualityCH ❙
  simpfun = impl ❙
  simplambda = implI ❙
  simpapply = implE ❙
  simpbeta = _ ❙
❚

view SimpleProductsCH : ?SimpleProducts -> ?ConjunctionND + ?ProofIrrelevance =
  include ?TypedEqualityCH ❙
  simpprod = and ❙
  simppair = andI ❙
  simppi1 = andEl ❙
  simppi2 = andEr ❙
  compute1 = _ ❙
  compute2 = _ ❙
❚

view CoproductsCH : ?Coproducts -> ?DisjunctionND + ?ProofIrrelevance =
  include ?TypedEqualityCH❙
  coprod = or ❙
  inj1 = orIl❙
  inj2 = orIr❙
  cases = orE❙
  compute1 = [A,B,C,a,f,g] f a ❙
  compute2 = [A,B,C,b,f,g] g b ❙
❚

view DependentFunctionsCH : ?DependentFunctions -> ?DependentImplicationND + ?ProofIrrelevance =
  include ?TypedEqualityCH ❙
  // We have depfun: {A: tp} (tm A ⟶ tp) ⟶ tp
     and thus need to {p: prop} (⊦ p ⟶ prop) ⟶ prop.
     The intuitive map of depfun to ∀ does not work because we would need to translate
     - the domain type to a logical type
     - the codomain type to a proposition
     Instead, the CH-analog of depfun is dependent implication.❙
  depfun = dimpl ❙
  deplambda = dimplI ❙
  depapply = dimplE ❙
  depbeta = _ ❙
❚

view DependentProductsCH : ?DependentProducts -> ?DependentConjunctionND + ?ProofIrrelevance =
  include ?TypedEqualityCH❙
  depprod = dand ❙
  deppair = dandI ❙
  deppi1 = dandEl ❙
  deppi2 = dandEr ❙
  compute1 = _ ❙
  // this requires mapping type-equality to equivalence of propositions❙
  // compute2 = _ ❙
❚