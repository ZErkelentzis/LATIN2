mytest P :- P (undefined (foo zero)).
mytest P :- P (not (defined (foo zero))).
mytest P :- P (undefined (foo (foo zero))).
mytest P :- P (undefined (foo (foo (foo (foo (foo (foo (foo (foo (foo (foo (foo (foo (foo (foo (foo zero)))))))))))))))).
mytest P :- P (defined (foo (succ zero))).
mytest P :- P (defined (succ (succ (succ (succ (succ (succ (succ (succ (succ (succ zero))))))))))).

%mytest P :- P (not (equal zero (succ zero))).
%mytest P :- P (not (equal (succ zero) zero)).

main :- mytest id_prove.
