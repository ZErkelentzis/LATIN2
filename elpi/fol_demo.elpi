% accumulate "../export/lf-elpi/content/latin..NONE/$F$O$L$N$D".
accumulate "../export/lf-elpi/content/latin..NONE/$Proofs".
accumulate "../export/lf-elpi/content/latin..NONE/$Implication$N$D$I".


bc/aux A A.

bc/val (bc/fwdLocked M) M :- !.
bc/val M M.

bc/pos (bc/fwdLocked _) :- !, fail.
bc/pos M :- M > 0.

bc/fwdable A :- ded/hyp _ T, bc/aux T A.

prove_aux N _ F :- N > 0, ded (bccert N) F, !.

prove_aux N M F :-
    N < M, N' is N + 1, print "New depth: " N',
    prove_aux N' M F, !.
prove F :-
    print "Proving " F,
    prove_aux 0 15 F,
    print "Result: Success", !, fail.
prove F :-
    print "Result: Failure", !, fail.


mytest P :- pi a \ pi b \ P (impl a (impl b a)).
% mytest P :- pi f \ pi p \ P (impl (exists x \ (and (p x) f)) (exists x \ p x)).
% mytest P :- pi f \ pi p \ P (impl (forall x \ p (f x)) (exists x \ p (f (f x)))).
% mytest P :- pi f \ pi p \ P (impl (p f) (exists x \ p x)).
% mytest P :- pi a \ pi b \ P (impl (disjunction a b) (disjunction b a)).
% mytest P :- pi a \ pi b \ pi c \ P (impl (impl a (disjunction b c)) (impl (impl b c) (impl a c))).
% mytest P :- pi a \ pi b \ pi c \ P (disjunction (not a) a).
% 
% % tableau: and^F
% mytest P :- pi a \ pi b \ P (impl (not (and a b))
%             (impl (impl (not a) false)
%             (impl (impl (not b) false)
%             false))).
% % tableau: and^T
% mytest P :- pi a \ pi b \ P (impl (and a b)
%             (impl (impl a (impl b false)) false)).
% 
% % test forall intro
% mytest P :- pi q \ P (impl (exists x \ forall y \ q x y) (forall y \ exists x \ q x y)).
% 
% % test forall^T
% mytest P :- pi p \ P (impl (forall y \ (p y)) (forall x \ (impl (impl (p x) false) false))).
% % test forall^F
% % mytest P :- pi p \ P (impl (not (forall y \ (p y))) (impl (forall x \ (impl (not (p x)) false)) false)).
% mytest P :- pi p \ P (impl (exists y \ (not (p y))) (impl (forall x \ (impl (not (p x)) false)) false)).

main :- mytest prove.
main.


