marktrue X P :- !, marktrue/hyp _ P.
markfalse X P :- !, markfalse/hyp _ P.

accumulate "generic/tab".
accumulate "generated/pltab".
accumulate "generated/foltab".



prove F :-
    print "Proving " F,
    markfalse/hyp X F => closedbranch (ucert nil),
    print "Success", !, fail.
prove _ :- print "Fail", fail.


mytest P :- pi f \ pi p \ P (impl (exists x \ (and (p x) f)) (exists x \ p x)).
mytest P :- pi q \ P (impl (exists x \ forall y \ q x y) (forall y \ exists x \ q x y)).
mytest P :- pi f \ pi p \ P (impl (forall x \ p (f x)) (exists x \ p (f (f x)))).
mytest P :- pi p \ P (impl (forall y \ (p y)) (forall x \ (impl (impl (p x) false) false))).
mytest P :- pi f \ pi p \ P (impl (exists x \ (p ( f (f x)))) (exists x \ p (f x))).
mytest P :- pi a \ pi b \ pi p \ pi q \ P (impl (or (p a) (p b)) (exists x \ p x)).
mytest P :- pi a \ pi b \ pi p \ pi q \ P (impl (forall x \ p x) (and (p a) (p b))).
mytest P :- pi a \ pi b \ pi p \ pi q \ P (not (forall x \ (and (p x) (not (p x))))).


% and some false ones
mytest P :- pi f \ pi p \ P (impl (exists x \ (or (p x) f)) (exists x \ p x)).
mytest P :- pi f \ pi p \ P (forall x \ impl (f x) (p x)).
mytest P :- pi f \ pi p \ P (impl (exists x \ (p ( f x))) (exists x \ p (f (f x)))).


main :- mytest prove.
main.
